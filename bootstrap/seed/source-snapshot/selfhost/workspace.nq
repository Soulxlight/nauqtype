use files;
use text;
use workspace_json;

pub type workspace_entry {
    valid: bool,
    source_root: str,
    module_name: str,
    error_message: str,
}


pub type workspace_module_identity {
    valid: bool,
    workspace_name: str,
    module_name: str,
    error_message: str,
}

pub type workspace_locked_dependency {
    alias: str,
    path: str,
    workspace_name: str,
    manifest_sha256: str,
    source_sha256: str,
    lock_version: str,
    legacy_source_sha256: str,
    source_tree_format: str,
    source_tree_sha256: str,
    manifest_text: str,
    source_root: str,
    lock_text: str,
}

pub type workspace_capture {
    valid: bool,
    source_root: str,
    module_name: str,
    workspace_root: str,
    workspace_name: str,
    manifest_text: str,
    lock_text: str,
    error_message: str,
}

pub type workspace_captured_source {
    alias: str,
    workspace_name: str,
    module_name: str,
    relative_path: str,
    source_path: str,
    source_text: str,
}

pub type workspace_capture_module {
    valid: bool,
    captured: bool,
    source_path: str,
    source_text: str,
    error_message: str,
}


fn make_workspace_entry(valid: bool, source_root: str, module_name: str, error_message: str) -> workspace_entry {
    return workspace_entry { valid: valid, source_root: source_root, module_name: module_name, error_message: error_message };
}


fn make_workspace_module_identity(valid: bool, workspace_name: str, module_name: str, error_message: str) -> workspace_module_identity {
    return workspace_module_identity { valid: valid, workspace_name: workspace_name, module_name: module_name, error_message: error_message };
}


fn find_literal(text: str, pattern: str) -> i32 {
    return find_literal_between(text, pattern, 0, str_len(text));
}

fn find_literal_between(text: str, pattern: str, start: i32, end: i32) -> i32 {
    let mut index = start;
    while index + str_len(pattern) <= end {
        if starts_with_at(text, index, pattern) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}


fn module_path_from_source(source_path: str, source_root: str) -> str {
    let prefix = str_concat(source_root, "/");
    if not str_starts_with(source_path, prefix) or not str_ends_with(source_path, ".nq") { return ""; }
    let stem = slice_text(source_path, str_len(prefix), str_len(source_path) - 3);
    let mut out = "";
    let mut index = 0;
    while index < str_len(stem) {
        let ch = char_at(stem, index);
        if ch == 47 or ch == 92 { out = str_concat(out, "::"); } else { out = str_concat(out, slice_text(stem, index, index + 1)); }
        index = index + 1;
    }
    return out;
}

fn module_file_path(source_root: str, module_name: str) -> str {
    let mut relative = "";
    let mut index = 0;
    while index < str_len(module_name) {
        if starts_with_at(module_name, index, "::") {
            relative = str_concat(relative, "/");
            index = index + 2;
        } else {
            relative = str_concat(relative, slice_text(module_name, index, index + 1));
            index = index + 1;
        }
    }
    return join_path(source_root, str_concat(relative, ".nq"));
}

fn first_module_segment(module_name: str) -> str {
    let separator = find_literal(module_name, "::");
    if separator < 0 {
        return module_name;
    }
    return slice_text(module_name, 0, separator);
}

fn module_suffix(module_name: str) -> str {
    let separator = find_literal(module_name, "::");
    if separator < 0 {
        return "";
    }
    return slice_text(module_name, separator + 2, str_len(module_name));
}


pub fn resolve_workspace_entry(source_path: str) -> workspace_entry
audit {
    intent("Resolve an explicit source path through an optional manifest-authoritative workspace root");
    mutates();
    effects(io);
}
{
    let manifest = wc_find_root_manifest(source_path);
    if not manifest.valid { return make_workspace_entry(false, "", "", manifest.error_message); }
    if not manifest.captured { return make_workspace_entry(true, path_dir(source_path), path_stem(source_path), ""); }
    let root = path_dir(manifest.source_path);
    let mut declarations: list<workspace_json_dependency> = list();
    let document = parse_workspace_document(manifest.source_text, false, mutref declarations);
    if not document.valid { return make_workspace_entry(false, "", "", document.error_message); }
    // Routing preflight only. The command-ready path captures and validates once.
    let source_root = join_path(root, document.source_root);
    let module_name = module_path_from_source(source_path, source_root);
    if module_name == "" { return make_workspace_entry(false, "", "", "source path is not inside the declared workspace source root"); }
    return make_workspace_entry(true, source_root, module_name, "");
}

fn wc_failure(message: str) -> workspace_capture {
    return workspace_capture { valid: false, source_root: "", module_name: "", workspace_root: "", workspace_name: "", manifest_text: "", lock_text: "", error_message: message };
}

fn wc_module_failure(message: str) -> workspace_capture_module {
    return workspace_capture_module { valid: false, captured: false, source_path: "", source_text: "", error_message: message };
}

fn wc_less(left: str, right: str) -> bool {
    let mut at = 0;
    while at < str_len(left) and at < str_len(right) {
        let a = char_at(left, at);
        let b = char_at(right, at);
        if a != b { return a < b; }
        at = at + 1;
    }
    return str_len(left) < str_len(right);
}

fn wc_metadata_error(path: str, directory: bool) -> str
audit {
    intent("Require non-following metadata to identify an ordinary directory or regular file");
    mutates();
    effects(io);
}
{
    match path_metadata(path, false) {
        Ok(info) => {
            if info.is_symlink { return str_concat("workspace capture rejects symlink: ", path); }
            if directory {
                if not info.is_directory { return str_concat("workspace capture requires directory: ", path); }
            } else {
                if not info.is_file { return str_concat("workspace capture rejects non-regular file: ", path); }
            }
            return "";
        },
        Err(err) => { return concat3("workspace capture metadata failed: ", path, str_concat(": ", io_err_text(err))); },
    }
}

fn wc_path_error(path: str, directory: bool) -> str
audit {
    intent("Check each traversed ancestor without following symlinks before accessing a capture path");
    mutates();
    effects(io);
}
{
    if path == "" { return "workspace capture path is empty"; }
    let mut absolute = path;
    if char_at(path, 0) != 47 {
        match current_dir() {
            Ok(cwd) => { absolute = join_path(cwd, path); },
            Err(err) => { return io_err_text(err); },
        }
    }
    let mut cursor = 1;
    while cursor < str_len(absolute) {
        let ch = char_at(absolute, cursor);
        if ch < 32 or ch > 126 or ch == 92 { return "workspace capture path must be printable ASCII with forward slashes"; }
        if ch == 47 {
            let error = wc_metadata_error(slice_text(absolute, 0, cursor), true);
            if error != "" { return error; }
        }
        cursor = cursor + 1;
    }
    return wc_metadata_error(absolute, directory);
}

fn wc_read_regular(path: str) -> workspace_capture_module
audit {
    intent("Capture a regular file once, retaining original path and rejecting observed metadata drift");
    mutates();
    effects(io);
}
{
    let error = wc_path_error(path, false);
    if error != "" { return wc_module_failure(error); }
    let before_result = path_metadata(path, false);
    let Ok(before) = before_result else { return wc_module_failure(str_concat("workspace capture metadata failed: ", path)); };
    let text_result = read_file(path);
    let Ok(value) = text_result else { return wc_module_failure(str_concat("workspace capture read failed: ", path)); };
    let after_error = wc_path_error(path, false);
    if after_error != "" { return wc_module_failure(after_error); }
    let after_result = path_metadata(path, false);
    let Ok(after) = after_result else { return wc_module_failure(str_concat("workspace capture metadata failed: ", path)); };
    if before.size != after.size or before.mode != after.mode or before.modified_ns != after.modified_ns {
        return wc_module_failure(str_concat("workspace capture file changed while reading: ", path));
    }
    return workspace_capture_module { valid: true, captured: true, source_path: path, source_text: value, error_message: "" };
}

pub fn workspace_sha256_captured(value: str) -> str
audit {
    intent("Hash captured bytes through sha256sum on a private temporary file, never on an original source path");
    mutates();
    effects(io);
}
{
    let created = create_temp_dir(".", ".nauqtype-capture-");
    let Ok(directory) = created else { return ""; };
    let path = join_path(directory, "bytes");
    let mut digest = "";
    match write_file(path, value) {
        Ok(_) => {
            let mut args: list<str> = list();
            list_push(mutref args, "--");
            list_push(mutref args, path);
            match run_process("sha256sum", ref args, ".") {
                Ok(result) => {
                    if result.exit_code == 0 {
                        let expected_suffix = concat3("  ", path, "\n");
                        if str_len(result.stdout) == 64 + str_len(expected_suffix) and slice_text(result.stdout, 64, str_len(result.stdout)) == expected_suffix {
                            let value_hash = slice_text(result.stdout, 0, 64);
                            if workspace_valid_sha256(value_hash) { digest = value_hash; }
                        }
                    }
                },
                Err(_) => {},
            }
        },
        Err(_) => {},
    }
    match remove_file(path) { Ok(_) => {}, Err(_) => { digest = ""; }, }
    match remove_dir(directory) { Ok(_) => {}, Err(_) => { digest = ""; }, }
    return digest;
}

fn wc_collect_paths(source_root: str, relative_dir: str, out: mutref list<str>) -> str
audit {
    intent("Enumerate every dependency source without skipping invalid metadata, paths, or directory failures");
    mutates(out);
    effects(io);
}
{
    let directory = join_path(source_root, relative_dir);
    let error = wc_path_error(directory, true);
    if error != "" { return error; }
    let entries_result = read_dir(directory);
    let Ok(entries) = entries_result else { return str_concat("workspace capture enumeration failed: ", directory); };
    let mut seen: list<str> = list();
    let mut index = 0;
    while index < list_len(ref entries) {
        let entry = list_get(ref entries, index);
        let Some(name) = entry else { return "workspace capture enumeration lost an entry"; };
        if not workspace_valid_relative_path(name, false) or text_contains(name, "/") or list_contains(ref seen, name) {
            return str_concat("workspace capture invalid or duplicate directory entry: ", name);
        }
        list_push(mutref seen, name);
        let relative = join_path(relative_dir, name);
        if not workspace_valid_relative_path(relative, false) { return str_concat("workspace capture invalid source path: ", relative); }
        let path = join_path(source_root, relative);
        let metadata_result = path_metadata(path, false);
        let Ok(info) = metadata_result else { return str_concat("workspace capture metadata failed: ", path); };
        if info.is_symlink { return str_concat("workspace capture rejects symlink: ", path); }
        if info.is_directory {
            let nested_error = wc_collect_paths(source_root, relative, mutref out);
            if nested_error != "" { return nested_error; }
        } else {
            if not info.is_file { return str_concat("workspace capture rejects special file: ", path); }
            if str_ends_with(name, ".nq") {
                if list_contains(ref out, relative) { return str_concat("workspace capture duplicate source path: ", relative); }
                list_push(mutref out, relative);
            }
        }
        index = index + 1;
    }
    return wc_path_error(directory, true);
}

fn wc_capture_sources(source_root: str, alias: str, workspace_name: str, out: mutref list<workspace_captured_source>) -> str
audit {
    intent("Read each enumerated dependency source exactly once in unsigned-byte path order");
    mutates(out);
    effects(io);
}
{
    let mut paths: list<str> = list();
    let error = wc_collect_paths(source_root, "", mutref paths);
    if error != "" { return error; }
    let mut previous = "";
    let mut count = 0;
    while count < list_len(ref paths) {
        let mut next = "";
        let mut index = 0;
        while index < list_len(ref paths) {
            match list_get(ref paths, index) {
                Some(path) => { if wc_less(previous, path) and (next == "" or wc_less(path, next)) { next = path; } },
                None => { return "workspace capture missing source path"; },
            }
            index = index + 1;
        }
        if next == "" { return "workspace capture duplicate or unordered source paths"; }
        let path = join_path(source_root, next);
        let captured = wc_read_regular(path);
        if not captured.valid { return captured.error_message; }
        let suffix = module_path_from_source(path, source_root);
        if module_file_path(source_root, suffix) != path { return str_concat("dependency source path has ambiguous module spelling: ", next); }
        list_push(mutref out, workspace_captured_source { alias: alias, workspace_name: workspace_name, module_name: concat3(alias, "::", suffix), relative_path: next, source_path: path, source_text: captured.source_text });
        previous = next;
        count = count + 1;
    }
    // Re-enumeration checks the set without rereading any captured file contents.
    let mut final_paths: list<str> = list();
    let final_error = wc_collect_paths(source_root, "", mutref final_paths);
    if final_error != "" { return final_error; }
    if list_len(ref final_paths) != list_len(ref paths) { return "workspace source file set changed during capture"; }
    let mut index = 0;
    while index < list_len(ref final_paths) {
        match list_get(ref final_paths, index) {
            Some(path) => { if not list_contains(ref paths, path) { return "workspace source file set changed during capture"; } },
            None => { return "workspace capture missing final source path"; },
        }
        index = index + 1;
    }
    return "";
}

pub type workspace_capture_hashes {
    valid: bool,
    legacy_source_sha256: str,
    source_tree_sha256: str,
    error_message: str,
}

pub fn hash_captured_workspace_sources(sources: ref list<workspace_captured_source>) -> workspace_capture_hashes
audit {
    intent("Hash only captured texts with exact v2 file framing and the validated legacy concatenation");
    mutates();
    effects(io);
}
{
    let mut framed = concat3("nauqtype-source-tree/v2\nfiles:", i32_to_str(list_len(ref sources)), "\n");
    let mut legacy = "";
    let mut previous = "";
    let mut index = 0;
    while index < list_len(ref sources) {
        let item = list_get(ref sources, index);
        let Some(source) = item else { return workspace_capture_hashes { valid: false, legacy_source_sha256: "", source_tree_sha256: "", error_message: "missing captured source" }; };
        if not workspace_valid_relative_path(source.relative_path, false) or not str_ends_with(source.relative_path, ".nq") or not wc_less(previous, source.relative_path) {
            return workspace_capture_hashes { valid: false, legacy_source_sha256: "", source_tree_sha256: "", error_message: "captured source paths must be valid, unique, and byte-sorted" };
        }
        framed = str_concat(framed, concat5("path-bytes:", i32_to_str(str_len(source.relative_path)), "\n", source.relative_path, "\n"));
        framed = str_concat(framed, concat5("content-bytes:", i32_to_str(str_len(source.source_text)), "\n", source.source_text, "\n"));
        legacy = str_concat(legacy, source.source_text);
        previous = source.relative_path;
        index = index + 1;
    }
    let legacy_hash = workspace_sha256_captured(legacy);
    let framed_hash = workspace_sha256_captured(framed);
    if legacy_hash == "" or framed_hash == "" {
        return workspace_capture_hashes { valid: false, legacy_source_sha256: "", source_tree_sha256: "", error_message: "workspace captured-byte SHA-256 failed" };
    }
    return workspace_capture_hashes { valid: true, legacy_source_sha256: legacy_hash, source_tree_sha256: framed_hash, error_message: "" };
}

fn wc_find_lock(dependencies: ref list<workspace_json_dependency>, alias: str) -> option<workspace_json_dependency> {
    let mut at = 0;
    while at < list_len(ref dependencies) {
        match list_get(ref dependencies, at) {
            Some(dep) => { if dep.alias == alias { return Some(dep); } },
            None => { return None; },
        }
        at = at + 1;
    }
    return None;
}

fn wc_dependency(root: str, declared: workspace_json_dependency, locked: workspace_json_dependency, sources: mutref list<workspace_captured_source>, dependencies: mutref list<workspace_locked_dependency>) -> str
audit {
    intent("Validate one direct dependency from captured manifest, optional lock metadata, and source bytes");
    mutates(sources, dependencies);
    effects(io);
}
{
    if declared.path != locked.path or declared.workspace_name != locked.workspace_name { return str_concat("workspace dependency lock does not match: ", declared.alias); }
    let dep_root = join_path(root, declared.path);
    let error = wc_path_error(dep_root, true);
    if error != "" { return error; }
    let manifest = wc_read_regular(join_path(dep_root, "nauqtype.workspace.json"));
    if not manifest.valid { return manifest.error_message; }
    let mut dep_declarations: list<workspace_json_dependency> = list();
    let dep_document = parse_workspace_document(manifest.source_text, false, mutref dep_declarations);
    if not dep_document.valid { return str_concat("dependency manifest: ", dep_document.error_message); }
    if dep_document.workspace_name != declared.workspace_name { return str_concat("workspace dependency identity does not match: ", declared.alias); }
    // The bounded direct-dependency resolver must not silently ignore transitive authority.
    if list_len(ref dep_declarations) != 0 { return "transitive workspace dependency declarations are not supported"; }
    let manifest_hash = workspace_sha256_captured(manifest.source_text);
    if manifest_hash == "" { return "workspace captured manifest SHA-256 failed"; }
    if manifest_hash != locked.manifest_sha256 { return str_concat("workspace dependency manifest hash is stale: ", declared.alias); }
    let mut dep_lock_text = "";
    let lock_path = join_path(dep_root, "nauqtype.workspace.lock.json");
    match path_metadata(lock_path, false) {
        Ok(_) => {
            let lock = wc_read_regular(lock_path);
            if not lock.valid { return lock.error_message; }
            let mut dep_locks: list<workspace_json_dependency> = list();
            let lock_document = parse_workspace_document(lock.source_text, true, mutref dep_locks);
            if not lock_document.valid { return lock_document.error_message; }
            if lock_document.workspace_name != declared.workspace_name or list_len(ref dep_locks) != 0 { return "dependency lock has mismatched identity or extra entries"; }
            dep_lock_text = lock.source_text;
        },
        Err(err) => {
            if io_err_kind(ref err) != "not_found" { return str_concat("dependency lock metadata failed: ", lock_path); }
            if dep_document.has_dependencies { return "dependency manifest declares dependencies but its lock is missing"; }
        },
    }
    let source_root = join_path(dep_root, dep_document.source_root);
    let mut captured: list<workspace_captured_source> = list();
    let source_error = wc_capture_sources(source_root, declared.alias, declared.workspace_name, mutref captured);
    if source_error != "" { return source_error; }
    let hashes = hash_captured_workspace_sources(ref captured);
    if not hashes.valid { return hashes.error_message; }
    if hashes.legacy_source_sha256 != locked.legacy_source_sha256 { return str_concat("workspace dependency legacy source hash is stale: ", declared.alias); }
    if hashes.source_tree_sha256 != locked.source_tree_sha256 { return str_concat("workspace dependency framed source hash is stale: ", declared.alias); }
    let mut at = 0;
    while at < list_len(ref captured) {
        match list_get(ref captured, at) { Some(item) => { list_push(mutref sources, item); }, None => { return "workspace capture lost a source record"; }, }
        at = at + 1;
    }
    list_push(mutref dependencies, workspace_locked_dependency { alias: declared.alias, path: declared.path, workspace_name: declared.workspace_name, manifest_sha256: manifest_hash, source_sha256: hashes.legacy_source_sha256, lock_version: "workspace-lock/v2", legacy_source_sha256: hashes.legacy_source_sha256, source_tree_format: "nauqtype-source-tree/v2", source_tree_sha256: hashes.source_tree_sha256, manifest_text: manifest.source_text, source_root: source_root, lock_text: dep_lock_text });
    return "";
}

fn wc_find_root_manifest(source_path: str) -> workspace_capture_module
audit {
    intent("Discover the nearest manifest without silently skipping metadata failures or reading special files");
    mutates();
    effects(io);
}
{
    let path_error = wc_path_error(path_dir(source_path), true);
    if path_error != "" { return wc_module_failure(path_error); }
    let mut root = path_dir(source_path);
    while true {
        let path = join_path(root, "nauqtype.workspace.json");
        match path_metadata(path, false) {
            Ok(_) => { return wc_read_regular(path); },
            Err(err) => {
                if io_err_kind(ref err) != "not_found" { return wc_module_failure(str_concat("workspace manifest metadata failed: ", path)); }
                let parent = path_dir(root);
                if parent == root {
                    return workspace_capture_module { valid: true, captured: false, source_path: "", source_text: "", error_message: "" };
                }
                root = parent;
            },
        }
    }
    return wc_module_failure("workspace manifest discovery failed");
}

pub fn capture_workspace(source_path: str, sources: mutref list<workspace_captured_source>, dependencies: mutref list<workspace_locked_dependency>) -> workspace_capture
audit {
    intent("Capture command-local root identity and strictly validated direct dependencies once, publishing only a complete valid capture");
    mutates(sources, dependencies);
    effects(io);
}
{
    if list_len(ref sources) != 0 or list_len(ref dependencies) != 0 { return wc_failure("workspace capture requires empty output lists"); }
    let manifest = wc_find_root_manifest(source_path);
    if not manifest.valid { return wc_failure(manifest.error_message); }
    if not manifest.captured {
        return workspace_capture { valid: true, source_root: path_dir(source_path), module_name: path_stem(source_path), workspace_root: "", workspace_name: "legacy", manifest_text: "", lock_text: "", error_message: "" };
    }
    let root = path_dir(manifest.source_path);
    let root_manifest = manifest.source_text;
    let mut declared: list<workspace_json_dependency> = list();
    let document = parse_workspace_document(root_manifest, false, mutref declared);
    if not document.valid { return wc_failure(document.error_message); }
    let source_root = join_path(root, document.source_root);
    let module_name = module_path_from_source(source_path, source_root);
    if module_name == "" { return wc_failure("source path is not inside the captured workspace source root"); }
    let mut lock_text = "";
    let mut locks: list<workspace_json_dependency> = list();
    let lock_path = join_path(root, "nauqtype.workspace.lock.json");
    match path_metadata(lock_path, false) {
        Ok(_) => {
            let captured = wc_read_regular(lock_path);
            if not captured.valid { return wc_failure(captured.error_message); }
            lock_text = captured.source_text;
            let lock_document = parse_workspace_document(lock_text, true, mutref locks);
            if not lock_document.valid { return wc_failure(lock_document.error_message); }
            if lock_document.workspace_name != document.workspace_name { return wc_failure("workspace lock identity does not match captured manifest"); }
        },
        Err(err) => {
            if io_err_kind(ref err) != "not_found" { return wc_failure(str_concat("workspace lock metadata failed: ", lock_path)); }
            if document.has_dependencies { return wc_failure("workspace dependencies require nauqtype.workspace.lock.json"); }
        },
    }
    if list_len(ref declared) != list_len(ref locks) { return wc_failure("workspace lock has missing or extra dependency entries"); }
    let mut pending_sources: list<workspace_captured_source> = list();
    let mut pending_dependencies: list<workspace_locked_dependency> = list();
    let mut previous = "";
    let mut count = 0;
    while count < list_len(ref declared) {
        let mut next = "";
        let mut at = 0;
        while at < list_len(ref declared) {
            match list_get(ref declared, at) {
                Some(dep) => { if wc_less(previous, dep.alias) and (next == "" or wc_less(dep.alias, next)) { next = dep.alias; } },
                None => { return wc_failure("workspace capture lost a declaration"); },
            }
            at = at + 1;
        }
        if next == "" { return wc_failure("workspace capture has duplicate dependency aliases"); }
        let declared_result = wc_find_lock(ref declared, next);
        let Some(dep) = declared_result else { return wc_failure("workspace capture lost a declaration"); };
        if dep.workspace_name == document.workspace_name { return wc_failure("dependency workspace identity duplicates the root workspace"); }
        if dep.alias == first_module_segment(module_name) { return wc_failure("root entry module conflicts with a dependency alias"); }
        let lock_result = wc_find_lock(ref locks, next);
        let Some(locked) = lock_result else { return wc_failure(str_concat("workspace lock does not contain dependency: ", next)); };
        let error = wc_dependency(root, dep, locked, mutref pending_sources, mutref pending_dependencies);
        if error != "" { return wc_failure(error); }
        previous = next;
        count = count + 1;
    }
    let mut at = 0;
    while at < list_len(ref pending_sources) {
        match list_get(ref pending_sources, at) { Some(item) => { list_push(mutref sources, item); }, None => { return wc_failure("workspace capture lost a source"); }, }
        at = at + 1;
    }
    at = 0;
    while at < list_len(ref pending_dependencies) {
        match list_get(ref pending_dependencies, at) { Some(item) => { list_push(mutref dependencies, item); }, None => { return wc_failure("workspace capture lost a dependency"); }, }
        at = at + 1;
    }
    return workspace_capture { valid: true, source_root: source_root, module_name: module_name, workspace_root: root, workspace_name: document.workspace_name, manifest_text: root_manifest, lock_text: lock_text, error_message: "" };
}

pub fn resolve_captured_workspace_module(capture: workspace_capture, sources: ref list<workspace_captured_source>, dependencies: ref list<workspace_locked_dependency>, module_name: str) -> workspace_capture_module
audit {
    intent("Route local source paths or verified dependency text exclusively from command-local capture");
    mutates();
    effects();
}
{
    if not capture.valid { return wc_module_failure(capture.error_message); }
    let alias = first_module_segment(module_name);
    let mut at = 0;
    while at < list_len(ref dependencies) {
        match list_get(ref dependencies, at) {
            Some(dep) => {
                if dep.alias == alias {
                    if module_suffix(module_name) == "" { return wc_module_failure("dependency import must name a module after its alias"); }
                    let mut source_at = 0;
                    while source_at < list_len(ref sources) {
                        match list_get(ref sources, source_at) {
                            Some(item) => {
                                if item.module_name == module_name and item.alias == dep.alias and item.workspace_name == dep.workspace_name {
                                    return workspace_capture_module { valid: true, captured: true, source_path: item.source_path, source_text: item.source_text, error_message: "" };
                                }
                            },
                            None => { return wc_module_failure("workspace capture lost a dependency source"); },
                        }
                        source_at = source_at + 1;
                    }
                    return wc_module_failure(str_concat("module is absent from verified dependency capture: ", module_name));
                }
            },
            None => { return wc_module_failure("workspace capture lost a dependency"); },
        }
        at = at + 1;
    }
    return workspace_capture_module { valid: true, captured: false, source_path: module_file_path(capture.source_root, module_name), source_text: "", error_message: "" };
}

pub fn resolve_captured_workspace_identity(capture: workspace_capture, dependencies: ref list<workspace_locked_dependency>, module_name: str) -> workspace_module_identity
audit {
    intent("Resolve evidence identity solely from the validated immutable workspace capture");
    mutates();
    effects();
}
{
    if not capture.valid { return make_workspace_module_identity(false, "", "", capture.error_message); }
    let alias = first_module_segment(module_name);
    let mut at = 0;
    while at < list_len(ref dependencies) {
        match list_get(ref dependencies, at) {
            Some(dep) => {
                if dep.alias == alias {
                    let suffix = module_suffix(module_name);
                    if suffix == "" { return make_workspace_module_identity(false, "", "", "dependency module identity requires a module after its alias"); }
                    return make_workspace_module_identity(true, dep.workspace_name, suffix, "");
                }
            },
            None => { return make_workspace_module_identity(false, "", "", "workspace capture lost a dependency"); },
        }
        at = at + 1;
    }
    return make_workspace_module_identity(true, capture.workspace_name, module_name, "");
}
