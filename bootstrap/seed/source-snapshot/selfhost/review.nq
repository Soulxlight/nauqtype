use ast;
use diag;
use handoff;
use lexer;
use source;
use text;
use token;
use typecheck;

pub type review_function_fact {
    module: str,
    name: str,
    at: i32,
    is_public: bool,
    has_audit: bool,
    intent: str,
}

pub type review_direct_mutation {
    module: str,
    function_name: str,
    binding_id: i32,
    param_index: i32,
    name: str,
}

pub type review_mutation_coverage {
    module: str,
    function_name: str,
    partial: bool,
}

pub fn emit_review_v4(entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, summary: review_summary, uses: ref list<module_use>, items: ref list<top_item>, variants: ref list<variant_fact>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, writes: ref list<review_direct_mutation>, coverage: ref list<review_mutation_coverage>) -> review_summary
audit {
    intent("Emit checked syntactic parameter may-write evidence with explicit per-function coverage");
    mutates();
    effects(print);
}
{
    if summary.error_count > 0 { return summary; }
    let mut lines: list<str> = list();
    append_review_v2_json(mutref lines, entry_module, ref functions, ref decls, ref function_facts, ref function_params, ref assignments, ref calls, ref uses, ref items, ref variants, ref locals, ref writes, ref coverage, 4);
    emit_lines(ref lines);
    return summary;
}

type review_param_window {
    start: i32,
    count: i32,
}

type review_mutation_edge {
    caller_binding: i32,
    callee_binding: i32,
}

type review_call_edge {
    caller: i32,
    callee: i32,
}

fn review_mutation_has(writes: ref list<review_direct_mutation>, binding_id: i32) -> bool {
    let mut index = 0;
    while index < list_len(ref writes) {
        match list_get(ref writes, index) {
            Some(write) => { if write.binding_id == binding_id { return true; } },
            None => {},
        }
        index = index + 1;
    }
    return false;
}

fn review_mutation_add(bindings: ref list<checked_binding>, binding_id: i32, writes: mutref list<review_direct_mutation>) -> bool {
    if review_mutation_has(ref writes, binding_id) { return false; }
    match list_get(ref bindings, binding_id - 1) {
        Some(binding) => {
            if review_is_param(binding.kind) and binding.is_borrow and binding.borrow_mutable {
                list_push(mutref writes, review_direct_mutation { module: binding.module_name, function_name: binding.function_name, binding_id: binding.id, param_index: binding.param_index, name: binding.name });
                return true;
            }
        },
        None => {},
    }
    return false;
}

fn review_builtin_mutation_profile(name: str) -> i32 {
    if name == "list_push" { return 0; }
    if name == "print_line" or name == "eprint_line" or name == "read_file" or name == "write_file" or name == "arg_count" or name == "arg_get" or name == "create_dir_all" or name == "run_process" or name == "io_err_text" { return -1; }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "stdout_flush" or name == "stderr_flush" { return -1; }
    if name == "env_get" or name == "current_dir" or name == "read_file_bytes" or name == "write_file_bytes" or name == "path_metadata" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" or name == "rename_path" { return -1; }
    if name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" or name == "str_from_bytes" or name == "io_err_kind" or name == "io_err_operation" or name == "io_err_path" or name == "io_err_other_path" or name == "io_err_os_code" { return -1; }
    if name == "str_len" or name == "str_get" or name == "str_slice" or name == "str_concat" or name == "bytes_from_str" or name == "bytes_len" or name == "bytes_get" or name == "list" or name == "list_len" or name == "list_get" { return -1; }
    return -2;
}

fn review_mutation_partial(coverage: ref list<review_mutation_coverage>, module: str, function_name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref coverage) {
        match list_get(ref coverage, index) {
            Some(value) => { if value.module == module and value.function_name == function_name { return value.partial; } },
            None => {},
        }
        index = index + 1;
    }
    return true;
}

fn review_child_before(left: checked_expr_child, right: checked_expr_child) -> bool {
    return left.parent_expr_id < right.parent_expr_id or (left.parent_expr_id == right.parent_expr_id and left.index <= right.index);
}

fn review_sort_children(children: ref list<checked_expr_child>, start: i32, end: i32) -> list<checked_expr_child> {
    let mut out: list<checked_expr_child> = list();
    if end - start <= 1 {
        if start < end { match list_get(ref children, start) { Some(value) => { list_push(mutref out, value); }, None => {}, } }
    } else {
        let middle = start + (end - start) / 2;
        let left = review_sort_children(ref children, start, middle);
        let right = review_sort_children(ref children, middle, end);
        let mut l = 0;
        let mut r = 0;
        while l < list_len(ref left) or r < list_len(ref right) {
            let mut take_left = r == list_len(ref right);
            match list_get(ref left, l) {
                Some(a) => { match list_get(ref right, r) { Some(b) => { take_left = review_child_before(a, b); }, None => {}, } },
                None => { take_left = false; },
            }
            if take_left {
                match list_get(ref left, l) { Some(value) => { list_push(mutref out, value); }, None => {}, }
                l = l + 1;
            } else {
                match list_get(ref right, r) { Some(value) => { list_push(mutref out, value); }, None => {}, }
                r = r + 1;
            }
        }
    }
    return out;
}

fn review_value_type_id(type_id: i32, is_borrow: bool, mutable: bool, shapes: ref list<checked_type_shape>) -> i32 {
    match list_get(ref shapes, type_id - 1) {
        Some(shape) => {
            if shape.id != type_id { return -1; }
            match shape.kind {
                checked_type_ref => {
                    if not is_borrow or shape.mutable != mutable { return -1; }
                    match list_get(ref shapes, shape.arg1_id - 1) {
                        Some(value) => { if value.id != shape.arg1_id { return -1; } match value.kind { checked_type_ref => { return -1; }, _ => {}, } },
                        None => { return -1; },
                    }
                    return shape.arg1_id;
                },
                _ => { if is_borrow or mutable { return -1; } return type_id; },
            }
        },
        None => { return -1; },
    }
}

fn review_expr_value_type_id(expr: checked_expr, shapes: ref list<checked_type_shape>) -> i32 {
    // Name types are pointees; their borrow bits record binding provenance.
    match expr.kind {
        checked_expr_name => { return review_value_type_id(expr.type_id, false, false, ref shapes); },
        _ => { return review_value_type_id(expr.type_id, expr.is_borrow, expr.borrow_mutable, ref shapes); },
    }
}

fn review_builtin_field_type(field: checked_expr, owner: checked_type_shape) -> str {
    if field.field_owner_module != "" or owner.origin_module != "" or field.is_borrow or field.borrow_mutable { return ""; }
    match owner.kind {
        checked_type_process_result => {
            if field.field_owner_type != "process_result" { return ""; }
            if field.field_name == "exit_code" { return "i32"; }
            if field.field_name == "stdout" or field.field_name == "stderr" { return "str"; }
        },
        checked_type_path_metadata => {
            if field.field_owner_type != "path_metadata" { return ""; }
            if field.field_name == "is_file" or field.field_name == "is_directory" or field.field_name == "is_symlink" { return "bool"; }
            if field.field_name == "size" or field.field_name == "modified_ns" { return "i64"; }
            if field.field_name == "mode" { return "i32"; }
        },
        _ => {},
    }
    return "";
}

fn review_validate_field_target(field: checked_expr, base: checked_expr, shapes: ref list<checked_type_shape>, types: ref list<checked_type_decl>, fields: ref list<checked_field_decl>) -> bool {
    if field.type_id < 1 or field.field_owner_type == "" or field.field_name == "" { return false; }
    let base_type_id = review_expr_value_type_id(base, ref shapes);
    if base_type_id < 1 or review_value_type_id(field.type_id, field.is_borrow, field.borrow_mutable, ref shapes) < 1 { return false; }
    match list_get(ref shapes, base_type_id - 1) {
        Some(shape) => {
            if field.field_owner_module == "" {
                let expected = review_builtin_field_type(field, shape);
                if expected == "" { return false; }
                match list_get(ref shapes, field.type_id - 1) {
                    Some(result) => {
                        match result.kind {
                            checked_type_i32 => { return expected == "i32"; },
                            checked_type_i64 => { return expected == "i64"; },
                            checked_type_str => { return expected == "str"; },
                            checked_type_bool => { return expected == "bool"; },
                            _ => { return false; },
                        }
                    },
                    None => { return false; },
                }
            }
            match shape.kind { checked_type_named => {}, _ => { return false; }, }
            if shape.origin_module != field.field_owner_module or shape.name != field.field_owner_type { return false; }
        },
        None => { return false; },
    }
    let mut owner_id = -1;
    let mut index = 0;
    while index < list_len(ref types) {
        match list_get(ref types, index) {
            Some(owner) => {
                if owner.module_name == field.field_owner_module and owner.name == field.field_owner_type {
                    if owner_id > 0 or owner.id != index + 1 { return false; }
                    owner_id = owner.id;
                }
            },
            None => { return false; },
        }
        index = index + 1;
    }
    if owner_id < 1 { return false; }
    let mut matches = 0;
    index = 0;
    while index < list_len(ref fields) {
        match list_get(ref fields, index) {
            Some(decl) => {
                if decl.module_name == field.field_owner_module and decl.type_name == field.field_owner_type and decl.name == field.field_name {
                    if decl.type_id != owner_id or decl.field_type_id != field.type_id or decl.field_is_borrow != field.is_borrow or decl.field_borrow_mutable != field.borrow_mutable { return false; }
                    matches = matches + 1;
                }
            },
            None => { return false; },
        }
        index = index + 1;
    }
    return matches == 1;
}

fn review_validate_borrow_root(expr: checked_expr, bindings: ref list<checked_binding>, expressions: ref list<checked_expr>, first_children: ref list<i32>, shapes: ref list<checked_type_shape>, types: ref list<checked_type_decl>, fields: ref list<checked_field_decl>) -> bool {
    if expr.binding_id < 1 { return false; }
    let borrowed_type = review_value_type_id(expr.type_id, expr.is_borrow, expr.borrow_mutable, ref shapes);
    if borrowed_type < 1 or not expr.is_borrow { return false; }
    match expr.kind {
        checked_expr_ref => { if expr.borrow_mutable { return false; } },
        checked_expr_mutref => { if not expr.borrow_mutable { return false; } },
        _ => { return false; },
    }
    match list_get(ref bindings, expr.binding_id - 1) {
        Some(binding) => { if binding.id != expr.binding_id or binding.function_id != expr.function_id or binding.module_name != expr.module_name or binding.function_name != expr.function_name { return false; } },
        None => { return false; },
    }
    let mut parent = expr.id;
    let mut depth = 0;
    while depth < list_len(ref expressions) {
        match list_get(ref first_children, parent - 1) {
            Some(child_id) => {
                match list_get(ref expressions, child_id - 1) {
                    Some(child) => {
                        if child.id != child_id or child.function_id != expr.function_id or child.module_name != expr.module_name or child.function_name != expr.function_name { return false; }
                        if parent == expr.id and review_expr_value_type_id(child, ref shapes) != borrowed_type { return false; }
                        match child.kind {
                            checked_expr_name => {
                                if child.binding_id != expr.binding_id { return false; }
                                match list_get(ref bindings, expr.binding_id - 1) {
                                    Some(binding) => { return child.type_id == review_value_type_id(binding.type_id, binding.is_borrow, binding.borrow_mutable, ref shapes) and child.is_borrow == binding.is_borrow and child.borrow_mutable == binding.borrow_mutable and review_expr_value_type_id(child, ref shapes) > 0; },
                                    None => { return false; },
                                }
                            },
                            checked_expr_field => {
                                match list_get(ref first_children, child.id - 1) {
                                    Some(base_id) => {
                                        match list_get(ref expressions, base_id - 1) {
                                            Some(base) => { if not review_validate_field_target(child, base, ref shapes, ref types, ref fields) { return false; } },
                                            None => { return false; },
                                        }
                                    },
                                    None => { return false; },
                                }
                                parent = child.id;
                            },
                            _ => { return false; },
                        }
                    },
                    None => { return false; },
                }
            },
            None => { return false; },
        }
        depth = depth + 1;
    }
    return false;
}

fn review_validate_call_children(shapes: ref list<checked_type_shape>, types: ref list<checked_type_decl>, fields: ref list<checked_field_decl>, bindings: ref list<checked_binding>, expressions: ref list<checked_expr>, targets: ref list<i32>, windows: ref list<review_param_window>, children: ref list<checked_expr_child>, diags: mutref list<diag>) -> bool {
    let mut cursor = 0;
    let mut index = 0;
    let mut first_children: list<i32> = list();
    while index < list_len(ref expressions) {
        match list_get(ref expressions, index) {
            Some(expr) => {
                let mut count = 0;
                let mut first_child = -1;
                let mut scanning = true;
                while scanning and cursor < list_len(ref children) {
                    match list_get(ref children, cursor) {
                        Some(link) => {
                            if link.parent_expr_id < expr.id { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; }
                            if link.parent_expr_id == expr.id {
                                if link.index != count { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; }
                                if count == 0 { first_child = link.child_expr_id; }
                                count = count + 1;
                                cursor = cursor + 1;
                            } else { scanning = false; }
                        },
                        None => { return false; },
                    }
                }
                match list_get(ref targets, index) {
                    Some(target) => {
                        if target > 0 {
                            match list_get(ref windows, target - 1) {
                                Some(window) => { if count != window.count { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; } },
                                None => { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; },
                            }
                        } else {
                            if target == -1 and review_builtin_mutation_profile(expr.name) == 0 and count != 2 { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; }
                        }
                    },
                    None => { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; },
                }
                list_push(mutref first_children, first_child);
                let mut single_child = false;
                match expr.kind {
                    checked_expr_ref => { single_child = true; },
                    checked_expr_mutref => { single_child = true; },
                    checked_expr_field => { single_child = true; },
                    _ => {},
                }
                if single_child and count != 1 { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; }
            },
            None => { return false; },
        }
        index = index + 1;
    }
    if cursor != list_len(ref children) { review_mutation_identity_error(mutref diags, "", -1); return false; }
    index = 0;
    while index < list_len(ref expressions) {
        match list_get(ref expressions, index) {
            Some(expr) => {
                let mut explicit_borrow = false;
                match expr.kind {
                    checked_expr_ref => { explicit_borrow = true; },
                    checked_expr_mutref => { explicit_borrow = true; },
                    _ => {},
                }
                if explicit_borrow and not review_validate_borrow_root(expr, ref bindings, ref expressions, ref first_children, ref shapes, ref types, ref fields) { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return false; }
            },
            None => { review_mutation_identity_error(mutref diags, "", -1); return false; },
        }
        index = index + 1;
    }
    return true;
}

pub fn collect_review_mutations(functions: ref list<checked_function>, bindings: ref list<checked_binding>, params: ref list<checked_param>, statements: ref list<checked_stmt>, expressions: ref list<checked_expr>, children: ref list<checked_expr_child>, shapes: ref list<checked_type_shape>, types: ref list<checked_type_decl>, fields: ref list<checked_field_decl>, writes: mutref list<review_direct_mutation>, coverage: mutref list<review_mutation_coverage>, diags: mutref list<diag>) -> unit
audit {
    intent("Compute checked parameter may-writes over resolved calls without inferring purity or path feasibility");
    mutates(writes, coverage, diags);
    effects();
}
{
    if diagnostics_have_errors(ref diags) { return; }
    let mut windows: list<review_param_window> = list();
    let mut param_cursor = 0;
    let mut index = 0;
    while index < list_len(ref functions) {
        match list_get(ref functions, index) {
            Some(function) => {
                if function.id != index + 1 { review_mutation_identity_error(mutref diags, function.module_name, function.at); return; }
                let start = param_cursor;
                let mut scanning = true;
                while scanning and param_cursor < list_len(ref params) {
                    match list_get(ref params, param_cursor) {
                        Some(param) => {
                            if param.function_id != function.id {
                                scanning = false;
                            } else {
                                if param.index != param_cursor - start or param.module_name != function.module_name or param.function_name != function.name or param.type_id < 1 {
                                    review_mutation_identity_error(mutref diags, function.module_name, param.at); return;
                                }
                                match list_get(ref bindings, param.binding_id - 1) {
                                    Some(binding) => {
                                        if binding.id != param.binding_id or binding.function_id != function.id or binding.module_name != param.module_name or binding.function_name != param.function_name or binding.name != param.name or binding.param_index != param.index or not review_is_param(binding.kind) or binding.type_id != param.type_id or binding.is_borrow != param.is_borrow or binding.borrow_mutable != param.borrow_mutable {
                                            review_mutation_identity_error(mutref diags, function.module_name, param.at); return;
                                        }
                                    },
                                    None => { review_mutation_identity_error(mutref diags, function.module_name, param.at); return; },
                                }
                                param_cursor = param_cursor + 1;
                            }
                        },
                        None => { review_mutation_identity_error(mutref diags, function.module_name, function.at); return; },
                    }
                }
                list_push(mutref windows, review_param_window { start: start, count: param_cursor - start });
            },
            None => { review_mutation_identity_error(mutref diags, "", -1); return; },
        }
        index = index + 1;
    }
    if param_cursor != list_len(ref params) { review_mutation_identity_error(mutref diags, "", -1); return; }
    collect_review_direct_mutations(ref bindings, ref params, ref statements, mutref writes, mutref diags);
    if diagnostics_have_errors(ref diags) { return; }

    // Resolve each call once. Child indexes are already in canonical parameter order.
    let mut targets: list<i32> = list();
    let mut calls: list<review_call_edge> = list();
    let mut partial: list<i32> = list();
    index = 0;
    while index < list_len(ref expressions) {
        match list_get(ref expressions, index) {
            Some(expr) => {
                if expr.id != index + 1 { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; }
                let mut target = 0;
                match expr.kind {
                    checked_expr_call => {
                        match list_get(ref functions, expr.function_id - 1) {
                            Some(owner) => {
                                if owner.module_name != expr.module_name or owner.name != expr.function_name { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; }
                            },
                            None => { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; },
                        }
                        match expr.target_kind {
                            checked_target_function => {
                                let mut fn_index = 0;
                                while fn_index < list_len(ref functions) {
                                    match list_get(ref functions, fn_index) {
                                        Some(callee) => {
                                            if callee.module_name == expr.target_origin_module and callee.name == expr.name {
                                                if target != 0 { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; }
                                                target = callee.id;
                                            }
                                        },
                                        None => {},
                                    }
                                    fn_index = fn_index + 1;
                                }
                                if target < 1 { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; }
                                list_push(mutref calls, review_call_edge { caller: expr.function_id, callee: target });
                            },
                            checked_target_builtin_function => {
                                target = -1;
                                let profile = review_builtin_mutation_profile(expr.name);
                                if profile == -2 and not list_contains_i32(ref partial, expr.function_id) { list_push(mutref partial, expr.function_id); }
                            },
                            checked_target_constructor => {},
                            checked_target_builtin_constructor => {},
                            _ => { review_mutation_identity_error(mutref diags, expr.module_name, expr.at); return; },
                        }
                    },
                    _ => {},
                }
                list_push(mutref targets, target);
            },
            None => { review_mutation_identity_error(mutref diags, "", -1); return; },
        }
        index = index + 1;
    }

    let ordered_children = review_sort_children(ref children, 0, list_len(ref children));
    if not review_validate_call_children(ref shapes, ref types, ref fields, ref bindings, ref expressions, ref targets, ref windows, ref ordered_children, mutref diags) { return; }
    let mut edges: list<review_mutation_edge> = list();
    index = 0;
    while index < list_len(ref children) {
        match list_get(ref children, index) {
            Some(link) => {
                match list_get(ref expressions, link.parent_expr_id - 1) {
                    Some(parent) => {
                        match list_get(ref targets, parent.id - 1) {
                            Some(target) => {
                                if target != 0 {
                                    let mut mutated_param = 0;
                                    if target > 0 {
                                        match list_get(ref windows, target - 1) {
                                            Some(window) => {
                                                if link.index >= window.count { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; }
                                                match list_get(ref params, window.start + link.index) {
                                                    Some(param) => { if param.is_borrow and param.borrow_mutable { mutated_param = param.binding_id; } },
                                                    None => { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; },
                                                }
                                            },
                                            None => { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; },
                                        }
                                    } else {
                                        if review_builtin_mutation_profile(parent.name) == link.index { mutated_param = -1; }
                                    }
                                    match list_get(ref expressions, link.child_expr_id - 1) {
                                        Some(child) => {
                                            if child.function_id != parent.function_id or child.module_name != parent.module_name or child.function_name != parent.function_name { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; }
                                            if mutated_param != 0 {
                                                let mut borrow_node = false;
                                                match child.kind {
                                                    checked_expr_mutref => { borrow_node = true; },
                                                    checked_expr_name => { borrow_node = child.is_borrow and child.borrow_mutable; },
                                                    _ => {},
                                                }
                                                if not borrow_node or child.binding_id < 1 { review_mutation_identity_error(mutref diags, parent.module_name, child.at); return; }
                                                match list_get(ref bindings, child.binding_id - 1) {
                                                    Some(binding) => {
                                                        if binding.id != child.binding_id or binding.function_id != parent.function_id or binding.module_name != parent.module_name or binding.function_name != parent.function_name { review_mutation_identity_error(mutref diags, parent.module_name, child.at); return; }
                                                        if review_is_param(binding.kind) {
                                                            if not binding.is_borrow or not binding.borrow_mutable { review_mutation_identity_error(mutref diags, parent.module_name, child.at); return; }
                                                            if mutated_param == -1 {
                                                                let added = review_mutation_add(ref bindings, binding.id, mutref writes);
                                                            } else {
                                                                list_push(mutref edges, review_mutation_edge { caller_binding: binding.id, callee_binding: mutated_param });
                                                            }
                                                        }
                                                    },
                                                    None => { review_mutation_identity_error(mutref diags, parent.module_name, child.at); return; },
                                                }
                                            }
                                        },
                                        None => { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; },
                                    }
                                }
                            },
                            None => { review_mutation_identity_error(mutref diags, parent.module_name, parent.at); return; },
                        }
                    },
                    None => { review_mutation_identity_error(mutref diags, "", -1); return; },
                }
            },
            None => { review_mutation_identity_error(mutref diags, "", -1); return; },
        }
        index = index + 1;
    }
    let mut changed = true;
    let mut rounds = 0;
    while changed {
        if rounds > list_len(ref bindings) + list_len(ref functions) { review_mutation_identity_error(mutref diags, "", -1); return; }
        changed = false;
        index = 0;
        while index < list_len(ref edges) {
            match list_get(ref edges, index) {
                Some(edge) => {
                    if review_mutation_has(ref writes, edge.callee_binding) {
                        if review_mutation_add(ref bindings, edge.caller_binding, mutref writes) { changed = true; }
                    }
                },
                None => {},
            }
            index = index + 1;
        }
        index = 0;
        while index < list_len(ref calls) {
            match list_get(ref calls, index) {
                Some(call) => {
                    if list_contains_i32(ref partial, call.callee) and not list_contains_i32(ref partial, call.caller) { list_push(mutref partial, call.caller); changed = true; }
                },
                None => {},
            }
            index = index + 1;
        }
        rounds = rounds + 1;
    }
    index = 0;
    while index < list_len(ref functions) {
        match list_get(ref functions, index) {
            Some(function) => { list_push(mutref coverage, review_mutation_coverage { module: function.module_name, function_name: function.name, partial: list_contains_i32(ref partial, function.id) }); },
            None => {},
        }
        index = index + 1;
    }
    return;
}

fn review_mutation_identity_error(diags: mutref list<diag>, module: str, at: i32) -> unit {
    list_push(mutref diags, make_error("NQ-INTERNAL-012", diag_internal, module, at, at + 1, "stage1 internal error: review mutation has inconsistent checked binding, parameter, or expression identity"));
    return;
}

fn review_is_assignment(kind: checked_stmt_kind) -> bool {
    match kind {
        checked_stmt_assign => { return true; },
        _ => { return false; },
    }
}

fn review_is_param(kind: checked_binding_kind) -> bool {
    match kind {
        checked_binding_param => { return true; },
        _ => { return false; },
    }
}

pub fn collect_review_direct_mutations(bindings: ref list<checked_binding>, params: ref list<checked_param>, statements: ref list<checked_stmt>, out: mutref list<review_direct_mutation>, diags: mutref list<diag>) -> unit
audit {
    intent("Collect direct mutable-parameter writes by checked identity without inferring call writes");
    mutates(out, diags);
    effects();
}
{
    let mut seen: list<i32> = list();
    let mut index = 0;
    while index < list_len(ref statements) {
        match list_get(ref statements, index) {
            Some(stmt) => {
                if review_is_assignment(stmt.kind) {
                    if stmt.target_binding_id < 1 {
                        review_mutation_identity_error(mutref diags, stmt.module_name, stmt.at);
                        return;
                    }
                    match list_get(ref bindings, stmt.target_binding_id - 1) {
                        Some(binding) => {
                            if binding.id != stmt.target_binding_id or binding.function_id != stmt.function_id or binding.module_name != stmt.module_name or binding.function_name != stmt.function_name {
                                review_mutation_identity_error(mutref diags, stmt.module_name, stmt.at);
                                return;
                            }
                            if review_is_param(binding.kind) {
                                let mut matches = 0;
                                let mut param_index = 0;
                                while param_index < list_len(ref params) {
                                    match list_get(ref params, param_index) {
                                        Some(param) => {
                                            if param.binding_id == binding.id {
                                                if param.function_id != binding.function_id or param.module_name != binding.module_name or param.function_name != binding.function_name or param.index != binding.param_index or param.name != binding.name or not param.is_borrow or not param.borrow_mutable or not binding.is_borrow or not binding.borrow_mutable or param.type_id != binding.type_id {
                                                    review_mutation_identity_error(mutref diags, stmt.module_name, stmt.at);
                                                    return;
                                                }
                                                matches = matches + 1;
                                            }
                                        },
                                        None => {},
                                    }
                                    param_index = param_index + 1;
                                }
                                if matches != 1 or binding.param_index < 0 or binding.type_id < 1 {
                                    review_mutation_identity_error(mutref diags, stmt.module_name, stmt.at);
                                    return;
                                }
                                if not list_contains_i32(ref seen, binding.id) {
                                    list_push(mutref seen, binding.id);
                                    list_push(mutref out, review_direct_mutation { module: binding.module_name, function_name: binding.function_name, binding_id: binding.id, param_index: binding.param_index, name: binding.name });
                                }
                            }
                        },
                        None => {
                            review_mutation_identity_error(mutref diags, stmt.module_name, stmt.at);
                            return;
                        },
                    }
                }
            },
            None => {},
        }
        index = index + 1;
    }
    return;
}

fn inferred_checked_mutates(writes: ref list<review_direct_mutation>, module: str, function_name: str) -> list<str> {
    let mut names: list<str> = list();
    let mut previous = -1;
    let mut searching = true;
    while searching {
        let mut next = -1;
        let mut name = "";
        let mut index = 0;
        while index < list_len(ref writes) {
            match list_get(ref writes, index) {
                Some(write) => {
                    if write.module == module and write.function_name == function_name and write.param_index > previous {
                        if next < 0 or write.param_index < next {
                            next = write.param_index;
                            name = write.name;
                        }
                    }
                },
                None => {},
            }
            index = index + 1;
        }
        if next < 0 {
            searching = false;
        } else {
            list_push(mutref names, name);
            previous = next;
        }
    }
    return names;
}

pub fn make_review_function_fact(module: str, name: str, at: i32, is_public: bool, has_audit: bool, intent: str) -> review_function_fact
audit {
    intent("Build a flat review-function fact record for stage1 review output");
    mutates();
    effects();
}
{
    return review_function_fact {
        module: module,
        name: name,
        at: at,
        is_public: is_public,
        has_audit: has_audit,
        intent: intent,
    };
}

pub enum review_decl_kind {
    review_decl_mutates,
    review_decl_effects,
    review_decl_propagates,
}

pub type review_decl_entry {
    module: str,
    function_name: str,
    name: str,
    at: i32,
    kind: review_decl_kind,
    target_id: str,
}

pub fn make_review_decl_entry(module: str, function_name: str, name: str, at: i32, kind: review_decl_kind) -> review_decl_entry
audit {
    intent("Build a flat review declaration entry for stage1 review output");
    mutates();
    effects();
}
{
    return review_decl_entry {
        module: module,
        function_name: function_name,
        name: name,
        at: at,
        kind: kind,
        target_id: "",
    };
}

pub type review_summary {
    function_count: i32,
    declaration_count: i32,
    warning_count: i32,
    error_count: i32,
}

type review_io_kind_fact {
    function_id: str,
    kind: str,
}

pub fn make_review_summary(function_count: i32, declaration_count: i32, warning_count: i32, error_count: i32) -> review_summary
audit {
    intent("Build a stage1 review summary record");
    mutates();
    effects();
}
{
    return review_summary {
        function_count: function_count,
        declaration_count: declaration_count,
        warning_count: warning_count,
        error_count: error_count,
    };
}

fn make_review_io_kind_fact(function_id: str, kind: str) -> review_io_kind_fact {
    return review_io_kind_fact {
        function_id: function_id,
        kind: kind,
    };
}

fn token_at(tokens: ref list<token>, index: i32) -> token {
    let found = list_get(ref tokens, index);
    match found {
        Some(value) => {
            return value;
        },
        None => {
            return eof_token(index);
        },
    }
}

fn advance(cursor: mutref i32) -> unit {
    cursor = cursor + 1;
    return;
}

fn push_if_missing(items: mutref list<str>, value: str) -> unit {
    if not list_contains(ref items, value) {
        list_push(mutref items, value);
    }
    return;
}

fn function_internal_name(module: str, name: str) -> str {
    return concat3(module, "::", name);
}

fn function_identity(module: str, name: str) -> str {
    return concat4("fn:", module, "::", name);
}

fn builtin_identity(name: str) -> str {
    return str_concat("builtin:", name);
}

fn call_identity(module: str, function_name: str, at: i32) -> str {
    return concat6("call:", module, "::", function_name, "@", i32_to_str(at));
}

fn propagation_identity(module: str, function_name: str, at: i32) -> str {
    return concat6("propagation:", module, "::", function_name, "@", i32_to_str(at));
}

fn emit_lines(lines: ref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref lines) {
        let entry = list_get(ref lines, index);
        match entry {
            Some(value) => {
                print_line(value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn append_named_string_array(lines: mutref list<str>, indent: str, name: str, values: ref list<str>, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    if list_len(ref values) == 0 {
        list_push(mutref lines, concat5(indent, json_quote(name), ": []", suffix, ""));
        return;
    }

    list_push(mutref lines, concat5(indent, json_quote(name), ": [", "", ""));
    let mut index = 0;
    while index < list_len(ref values) {
        let entry = list_get(ref values, index);
        match entry {
            Some(value) => {
                let mut value_suffix = "";
                if index + 1 < list_len(ref values) {
                    value_suffix = ",";
                }
                list_push(mutref lines, concat5(indent, "  ", json_quote(value), value_suffix, ""));
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, concat3(indent, "]", suffix));
    return;
}

fn append_span(lines: mutref list<str>, indent: str, at: i32, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, concat5(indent, "\"span\": { \"start\": ", i32_to_str(at), " }", suffix));
    return;
}

fn is_function_fact(entry: review_function_fact, module: str, name: str) -> bool {
    return entry.module == module and entry.name == name;
}

fn module_has_local_function(functions: ref list<review_function_fact>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if is_function_fact(value, module, name) {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn module_exports_function(functions: ref list<review_function_fact>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if is_function_fact(value, module, name) and value.is_public {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn is_builtin_function(name: str) -> bool {
    if name == "print_line" or name == "eprint_line" or name == "read_file" or name == "write_file" or name == "arg_count" or name == "arg_get" or name == "create_dir_all" or name == "run_process" or name == "io_err_text" {
        return true;
    }
    if name == "str_len" or name == "str_get" or name == "str_slice" or name == "str_concat" or name == "bytes_from_str" or name == "bytes_len" or name == "bytes_get" {
        return true;
    }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "stdout_flush" or name == "stderr_flush" {
        return true;
    }
    if name == "env_get" or name == "current_dir" or name == "read_file_bytes" or name == "write_file_bytes" or name == "path_metadata" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" or name == "rename_path" {
        return true;
    }
    if name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" or name == "str_from_bytes" or name == "io_err_kind" or name == "io_err_operation" or name == "io_err_path" or name == "io_err_other_path" or name == "io_err_os_code" {
        return true;
    }
    if name == "list" or name == "list_push" or name == "list_len" or name == "list_get" {
        return true;
    }
    return false;
}

fn is_builtin_variant(name: str) -> bool {
    if name == "Some" or name == "None" or name == "Ok" or name == "Err" {
        return true;
    }
    return false;
}

fn visible_function_origin(functions: ref list<review_function_fact>, uses: ref list<module_use>, module: str, name: str) -> str {
    if is_builtin_function(name) {
        return "__builtin__";
    }
    if module_has_local_function(ref functions, module, name) {
        return module;
    }
    let mut use_index = 0;
    while use_index < list_len(ref uses) {
        let entry = list_get(ref uses, use_index);
        match entry {
            Some(value) => {
                if value.module == module and module_exports_function(ref functions, value.name, name) {
                    return value.name;
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }
    return "";
}

fn module_exports_variant(items: ref list<top_item>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name and value.is_public {
                    match value.kind {
                        item_variant => {
                            return true;
                        },
                        _ => {
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn visible_variant_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    if is_builtin_variant(name) {
        return "__builtin__";
    }
    if module_exports_variant(ref items, module, name) {
        return module;
    }
    let mut use_index = 0;
    while use_index < list_len(ref uses) {
        let entry = list_get(ref uses, use_index);
        match entry {
            Some(value) => {
                if value.module == module and module_exports_variant(ref items, value.name, name) {
                    return value.name;
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }
    return "";
}

fn variant_enum_name(variants: ref list<variant_fact>, module: str, name: str) -> str {
    let mut index = 0;
    while index < list_len(ref variants) {
        let entry = list_get(ref variants, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    return value.enum_name;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return "";
}

fn skip_until_semi(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let mut paren_depth = 0;
    let mut brace_depth = 0;
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lparen => {
                paren_depth = paren_depth + 1;
                advance(mutref cursor);
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
                advance(mutref cursor);
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
                advance(mutref cursor);
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
                advance(mutref cursor);
            },
            tk_semi => {
                if paren_depth == 0 and brace_depth == 0 {
                    advance(mutref cursor);
                    return;
                }
                advance(mutref cursor);
            },
            _ => {
                advance(mutref cursor);
            },
        }
    }
}

fn skip_type(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let current = token_at(ref tokens, cursor);
    match current.kind {
        tk_kw_ref => {
            advance(mutref cursor);
            skip_type(ref tokens, mutref cursor);
        },
        tk_kw_mutref => {
            advance(mutref cursor);
            skip_type(ref tokens, mutref cursor);
        },
        tk_ident => {
            advance(mutref cursor);
            let maybe_lt = token_at(ref tokens, cursor);
            match maybe_lt.kind {
                tk_lt => {
                    advance(mutref cursor);
                    skip_type(ref tokens, mutref cursor);
                    let maybe_comma = token_at(ref tokens, cursor);
                    match maybe_comma.kind {
                        tk_comma => {
                            advance(mutref cursor);
                            skip_type(ref tokens, mutref cursor);
                        },
                        _ => {
                        },
                    }
                    let maybe_gt = token_at(ref tokens, cursor);
                    match maybe_gt.kind {
                        tk_gt => {
                            advance(mutref cursor);
                        },
                        _ => {
                        },
                    }
                },
                _ => {
                },
            }
        },
        _ => {
            advance(mutref cursor);
        },
    }
    return;
}

fn skip_param_list(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let open = token_at(ref tokens, cursor);
    match open.kind {
        tk_lparen => {
            advance(mutref cursor);
        },
        _ => {
            return;
        },
    }
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_rparen => {
                advance(mutref cursor);
                return;
            },
            tk_eof => {
                return;
            },
            tk_ident => {
                advance(mutref cursor);
                let maybe_colon = token_at(ref tokens, cursor);
                match maybe_colon.kind {
                    tk_colon => {
                        advance(mutref cursor);
                        skip_type(ref tokens, mutref cursor);
                    },
                    _ => {
                    },
                }
                let maybe_comma = token_at(ref tokens, cursor);
                match maybe_comma.kind {
                    tk_comma => {
                        advance(mutref cursor);
                    },
                    _ => {
                    },
                }
            },
            _ => {
                advance(mutref cursor);
            },
        }
    }
}

fn skip_brace_block(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let open = token_at(ref tokens, cursor);
    match open.kind {
        tk_lbrace => {
            advance(mutref cursor);
        },
        _ => {
            return;
        },
    }
    let mut depth = 1;
    while depth > 0 {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lbrace => {
                depth = depth + 1;
                advance(mutref cursor);
            },
            tk_rbrace => {
                depth = depth - 1;
                advance(mutref cursor);
            },
            _ => {
                advance(mutref cursor);
            },
        }
    }
    return;
}

fn skip_until_block(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let mut paren_depth = 0;
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lparen => {
                paren_depth = paren_depth + 1;
                advance(mutref cursor);
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
                advance(mutref cursor);
            },
            tk_lbrace => {
                if paren_depth == 0 {
                    return;
                }
                advance(mutref cursor);
            },
            _ => {
                advance(mutref cursor);
            },
        }
    }
}

fn skip_type_or_enum_decl(tokens: ref list<token>, cursor: mutref i32) -> unit {
    advance(mutref cursor);
    let maybe_name = token_at(ref tokens, cursor);
    match maybe_name.kind {
        tk_ident => {
            advance(mutref cursor);
        },
        _ => {
        },
    }
    skip_until_block(ref tokens, mutref cursor);
    skip_brace_block(ref tokens, mutref cursor);
    return;
}

fn push_contract_syntax(diags: mutref list<diag>, module: str, at: token, expected: str) -> unit {
    list_push(mutref diags, make_diagnostic("NQ-CONTRACT-002", diag_contract, diag_error, module, at.start, at.end, str_concat("expected ", expected), "", "Use audit { intent(\"...\"); mutates(...); effects(...); propagates(...); } in that order; propagates is optional."));
    return;
}

fn audit_token_matches(current: token, expected: str) -> bool {
    match current.kind {
        tk_ident => { return current.text == expected; },
        tk_lparen => { return expected == "("; },
        tk_rparen => { return expected == ")"; },
        tk_lbrace => { return expected == "{"; },
        tk_rbrace => { return expected == "}"; },
        tk_semi => { return expected == ";"; },
        tk_comma => { return expected == ","; },
        _ => { return false; },
    }
}

fn require_audit_text(tokens: ref list<token>, cursor: mutref i32, module: str, expected: str, diags: mutref list<diag>) -> bool {
    let current = token_at(ref tokens, cursor);
    if audit_token_matches(current, expected) {
        advance(mutref cursor);
        return true;
    }
    push_contract_syntax(mutref diags, module, current, str_concat("audit token ", expected));
    return false;
}

fn finish_audit_recovery(tokens: ref list<token>, cursor: mutref i32) -> unit {
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => { return; },
            tk_rbrace => { advance(mutref cursor); return; },
            _ => { advance(mutref cursor); },
        }
    }
}

fn parse_ident_list(tokens: ref list<token>, cursor: mutref i32, module: str, function_name: str, clause: str, kind: review_decl_kind, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> bool {
    if not require_audit_text(ref tokens, mutref cursor, module, clause, mutref diags) {
        return false;
    }
    if not require_audit_text(ref tokens, mutref cursor, module, "(", mutref diags) {
        return false;
    }
    let first = token_at(ref tokens, cursor);
    if not audit_token_matches(first, ")") {
        let mut scanning = true;
        while scanning {
            let current = token_at(ref tokens, cursor);
            match current.kind {
                tk_ident => {
                    list_push(mutref decls_out, make_review_decl_entry(module, function_name, current.text, current.start, kind));
                    advance(mutref cursor);
                },
                _ => {
                    push_contract_syntax(mutref diags, module, current, "an audit entry name");
                    return false;
                },
            }
            let separator = token_at(ref tokens, cursor);
            if audit_token_matches(separator, ",") {
                advance(mutref cursor);
                let next = token_at(ref tokens, cursor);
                if audit_token_matches(next, ")") {
                    scanning = false;
                }
            } else {
                scanning = false;
            }
        }
    }
    if not require_audit_text(ref tokens, mutref cursor, module, ")", mutref diags) {
        return false;
    }
    return require_audit_text(ref tokens, mutref cursor, module, ";", mutref diags);
}

fn parse_audit_block(tokens: ref list<token>, cursor: mutref i32, module: str, function_name: str, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> option<str> {
    let audit_tok = token_at(ref tokens, cursor);
    match audit_tok.kind {
        tk_kw_audit => { advance(mutref cursor); },
        _ => { return None; },
    }
    if not require_audit_text(ref tokens, mutref cursor, module, "{", mutref diags) {
        finish_audit_recovery(ref tokens, mutref cursor);
        return Some("");
    }
    if not require_audit_text(ref tokens, mutref cursor, module, "intent", mutref diags)
        or not require_audit_text(ref tokens, mutref cursor, module, "(", mutref diags) {
        finish_audit_recovery(ref tokens, mutref cursor);
        return Some("");
    }
    let intent_token = token_at(ref tokens, cursor);
    match intent_token.kind {
        tk_string_lit => { advance(mutref cursor); },
        _ => {
            push_contract_syntax(mutref diags, module, intent_token, "an intent string");
            finish_audit_recovery(ref tokens, mutref cursor);
            return Some("");
        },
    }
    let intent = intent_token.text;
    if not require_audit_text(ref tokens, mutref cursor, module, ")", mutref diags)
        or not require_audit_text(ref tokens, mutref cursor, module, ";", mutref diags) {
        finish_audit_recovery(ref tokens, mutref cursor);
        return Some(intent);
    }
    if not parse_ident_list(ref tokens, mutref cursor, module, function_name, "mutates", review_decl_mutates, mutref decls_out, mutref diags)
        or not parse_ident_list(ref tokens, mutref cursor, module, function_name, "effects", review_decl_effects, mutref decls_out, mutref diags) {
        finish_audit_recovery(ref tokens, mutref cursor);
        return Some(intent);
    }
    let next = token_at(ref tokens, cursor);
    if next.text == "propagates" {
        if not parse_ident_list(ref tokens, mutref cursor, module, function_name, "propagates", review_decl_propagates, mutref decls_out, mutref diags) {
            finish_audit_recovery(ref tokens, mutref cursor);
            return Some(intent);
        }
    }
    if not require_audit_text(ref tokens, mutref cursor, module, "}", mutref diags) {
        finish_audit_recovery(ref tokens, mutref cursor);
    }
    return Some(intent);
}

fn collect_review_function(tokens: ref list<token>, cursor: mutref i32, module: str, is_public: bool, functions_out: mutref list<review_function_fact>, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> unit {
    advance(mutref cursor);
    let name_tok = token_at(ref tokens, cursor);
    let mut function_name = "";
    let mut function_at = name_tok.start;
    match name_tok.kind {
        tk_ident => {
            function_name = name_tok.text;
            function_at = name_tok.start;
            advance(mutref cursor);
        },
        _ => {
            advance(mutref cursor);
        },
    }
    skip_param_list(ref tokens, mutref cursor);
    let maybe_arrow = token_at(ref tokens, cursor);
    match maybe_arrow.kind {
        tk_arrow => {
            advance(mutref cursor);
            skip_type(ref tokens, mutref cursor);
        },
        _ => {
        },
    }
    let audit_result = parse_audit_block(ref tokens, mutref cursor, module, function_name, mutref decls_out, mutref diags);
    let mut has_audit = false;
    let mut intent = "";
    match audit_result {
        Some(value) => {
            has_audit = true;
            intent = value;
        },
        None => {
        },
    }
    list_push(mutref functions_out, make_review_function_fact(module, function_name, function_at, is_public, has_audit, intent));
    skip_until_block(ref tokens, mutref cursor);
    skip_brace_block(ref tokens, mutref cursor);
    return;
}

fn collect_review_facts(file: str, tokens: ref list<token>, functions_out: mutref list<review_function_fact>, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> unit {
    let mut cursor = 0;
    let mut scanning_uses = true;
    while scanning_uses {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_kw_use => {
                skip_until_semi(ref tokens, mutref cursor);
            },
            _ => {
                scanning_uses = false;
            },
        }
    }

    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_kw_pub => {
                advance(mutref cursor);
                let next = token_at(ref tokens, cursor);
                match next.kind {
                    tk_kw_fn => {
                        collect_review_function(ref tokens, mutref cursor, file, true, mutref functions_out, mutref decls_out, mutref diags);
                    },
                    tk_kw_type => {
                        skip_type_or_enum_decl(ref tokens, mutref cursor);
                    },
                    tk_kw_enum => {
                        skip_type_or_enum_decl(ref tokens, mutref cursor);
                    },
                    _ => {
                        advance(mutref cursor);
                    },
                }
            },
            tk_kw_fn => {
                collect_review_function(ref tokens, mutref cursor, file, false, mutref functions_out, mutref decls_out, mutref diags);
            },
            tk_kw_type => {
                skip_type_or_enum_decl(ref tokens, mutref cursor);
            },
            tk_kw_enum => {
                skip_type_or_enum_decl(ref tokens, mutref cursor);
            },
            _ => {
                advance(mutref cursor);
            },
        }
    }
}

fn decl_entries_for_function(decls: ref list<review_decl_entry>, module: str, function_name: str, kind: review_decl_kind) -> list<str> {
    let mut names: list<str> = list();
    let mut index = 0;
    while index < list_len(ref decls) {
        let entry = list_get(ref decls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    match value.kind {
                        review_decl_mutates => {
                            match kind {
                                review_decl_mutates => {
                                    list_push(mutref names, value.name);
                                },
                                _ => {
                                },
                            }
                        },
                        review_decl_effects => {
                            match kind {
                                review_decl_effects => {
                                    list_push(mutref names, value.name);
                                },
                                _ => {
                                },
                            }
                        },
                        review_decl_propagates => {
                            match kind {
                                review_decl_propagates => {
                                    list_push(mutref names, value.name);
                                },
                                _ => {
                                },
                            }
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return names;
}

fn param_is_mutref(function_params: ref list<function_param_fact>, module: str, function_name: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref function_params) {
        let entry = list_get(ref function_params, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.name == name and value.is_borrow and value.borrow_mutable {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn assignment_targets_name(assignments: ref list<assignment_fact>, module: str, function_name: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref assignments) {
        let entry = list_get(ref assignments, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.target_name == name {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn inferred_mutates(function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, module: str, function_name: str) -> list<str> {
    let mut names: list<str> = list();
    let mut index = 0;
    while index < list_len(ref function_params) {
        let entry = list_get(ref function_params, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.is_borrow and value.borrow_mutable and assignment_targets_name(ref assignments, module, function_name, value.name) {
                    list_push(mutref names, value.name);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return names;
}

fn builtin_propagation_error(name: str) -> str {
    if name == "read_file" or name == "write_file" or name == "create_dir_all" or name == "run_process" {
        return "io_err";
    }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "stdout_flush" or name == "stderr_flush" {
        return "io_err";
    }
    if name == "env_get" or name == "current_dir" or name == "read_file_bytes" or name == "write_file_bytes" or name == "path_metadata" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" or name == "rename_path" or name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" {
        return "io_err";
    }
    return "";
}

fn lookup_function_result_error(function_facts: ref list<function_fact>, module: str, name: str) -> str {
    let mut index = 0;
    while index < list_len(ref function_facts) {
        let entry = list_get(ref function_facts, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name and value.return_name == "result" {
                    return value.return_arg2_name;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return "";
}

fn propagation_error_name(function_facts: ref list<function_fact>, functions: ref list<review_function_fact>, uses: ref list<module_use>, local: local_init_fact) -> str {
    let builtin = builtin_propagation_error(local.expr_name);
    if builtin != "" {
        return builtin;
    }
    let origin = visible_function_origin(ref functions, ref uses, local.module, local.expr_name);
    if origin != "" and origin != "__builtin__" {
        return lookup_function_result_error(ref function_facts, origin, local.expr_name);
    }
    return "";
}

fn propagation_site_count(locals: ref list<local_init_fact>) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref locals) {
        let entry = list_get(ref locals, index);
        match entry {
            Some(value) => {
                if value.expr_member_name == "propagate" or value.expr_member_name == "try_propagate" {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn propagation_type_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    if name == "bool" or name == "i32" or name == "i64" or name == "str" or name == "unit" or name == "io_err"
        or name == "bytes" or name == "process_result" or name == "path_metadata" {
        return "__builtin__";
    }
    return visible_type_origin_module(ref uses, ref items, module, name);
}

fn propagation_type_is_enum(items: ref list<top_item>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    match value.kind {
                        item_enum => {
                            return true;
                        },
                        _ => {
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn propagation_target_kind(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let origin = propagation_type_origin(ref items, ref uses, module, name);
    if origin == "__builtin__" {
        return "builtin_type";
    }
    if origin == "" {
        return "unknown";
    }
    if propagation_type_is_enum(ref items, origin, name) {
        return "enum";
    }
    return "type";
}

fn propagation_target_id(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let origin = propagation_type_origin(ref items, ref uses, module, name);
    if origin == "__builtin__" {
        return str_concat("builtin-type:", name);
    }
    if origin == "" {
        return "";
    }
    if propagation_type_is_enum(ref items, origin, name) {
        return concat4("enum:", origin, "::", name);
    }
    return concat4("type:", origin, "::", name);
}

fn propagation_target_evidence(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let origin = propagation_type_origin(ref items, ref uses, module, name);
    if origin == "__builtin__" {
        return "builtin";
    }
    if origin == "" {
        return "unresolved";
    }
    return "checked";
}

fn inferred_propagates(function_facts: ref list<function_fact>, functions: ref list<review_function_fact>, locals: ref list<local_init_fact>, uses: ref list<module_use>, module: str, function_name: str) -> list<str> {
    let mut inferred: list<str> = list();
    let mut index = 0;
    while index < list_len(ref locals) {
        let entry = list_get(ref locals, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.expr_member_name == "propagate" {
                    let error_name = propagation_error_name(ref function_facts, ref functions, ref uses, value);
                    if error_name != "" {
                        push_if_missing(mutref inferred, error_name);
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return inferred;
}

fn propagation_contexts(locals: ref list<local_init_fact>, module: str, function_name: str) -> list<str> {
    let mut contexts: list<str> = list();
    let mut index = 0;
    while index < list_len(ref locals) {
        let entry = list_get(ref locals, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and (value.expr_member_name == "propagate" or value.expr_member_name == "try_propagate") and value.propagation_label != "" {
                    list_push(mutref contexts, concat3(propagation_identity(value.module, value.function_name, value.at), "=", value.propagation_label));
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return contexts;
}

fn io_kind_for_builtin(name: str) -> str {
    if name == "read_file" {
        return "read";
    }
    if name == "write_file" {
        return "write";
    }
    if name == "create_dir_all" {
        return "create_dir";
    }
    if name == "run_process" {
        return "process";
    }
    if name == "arg_count" or name == "arg_get" { return "arguments"; }
    if name == "env_get" { return "environment"; }
    if name == "current_dir" { return "cwd"; }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" { return "stdin"; }
    if name == "stdout_write" or name == "stdout_write_bytes" or name == "stdout_flush" { return "stdout"; }
    if name == "stderr_write" or name == "stderr_write_bytes" or name == "stderr_flush" { return "stderr"; }
    if name == "read_file_bytes" { return "read"; }
    if name == "write_file_bytes" { return "write"; }
    if name == "path_metadata" { return "metadata"; }
    if name == "read_dir" { return "traversal"; }
    if name == "create_dir" { return "create_dir"; }
    if name == "create_file_new" { return "create_file"; }
    if name == "create_temp_file" or name == "create_temp_dir" { return "temporary"; }
    if name == "remove_file" or name == "remove_dir" { return "remove"; }
    if name == "rename_path" { return "rename"; }
    if name == "atomic_write_file" { return "atomic_replace"; }
    return "";
}

fn review_io_kind_exists(entries: ref list<review_io_kind_fact>, function_id: str, kind: str) -> bool {
    let mut index = 0;
    while index < list_len(ref entries) {
        let entry = list_get(ref entries, index);
        match entry {
            Some(value) => {
                if value.function_id == function_id and value.kind == kind {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn push_review_io_kind_if_missing(entries: mutref list<review_io_kind_fact>, function_id: str, kind: str) -> bool {
    if review_io_kind_exists(ref entries, function_id, kind) {
        return false;
    }
    list_push(mutref entries, make_review_io_kind_fact(function_id, kind));
    return true;
}

fn io_kinds_for_function(entries: ref list<review_io_kind_fact>, module: str, function_name: str) -> list<str> {
    let mut kinds: list<str> = list();
    let function_id = function_internal_name(module, function_name);
    if review_io_kind_exists(ref entries, function_id, "read") {
        list_push(mutref kinds, "read");
    }
    if review_io_kind_exists(ref entries, function_id, "write") {
        list_push(mutref kinds, "write");
    }
    if review_io_kind_exists(ref entries, function_id, "create_dir") {
        list_push(mutref kinds, "create_dir");
    }
    if review_io_kind_exists(ref entries, function_id, "process") {
        list_push(mutref kinds, "process");
    }
    if review_io_kind_exists(ref entries, function_id, "arguments") { list_push(mutref kinds, "arguments"); }
    if review_io_kind_exists(ref entries, function_id, "environment") { list_push(mutref kinds, "environment"); }
    if review_io_kind_exists(ref entries, function_id, "cwd") { list_push(mutref kinds, "cwd"); }
    if review_io_kind_exists(ref entries, function_id, "stdin") { list_push(mutref kinds, "stdin"); }
    if review_io_kind_exists(ref entries, function_id, "stdout") { list_push(mutref kinds, "stdout"); }
    if review_io_kind_exists(ref entries, function_id, "stderr") { list_push(mutref kinds, "stderr"); }
    if review_io_kind_exists(ref entries, function_id, "metadata") { list_push(mutref kinds, "metadata"); }
    if review_io_kind_exists(ref entries, function_id, "traversal") { list_push(mutref kinds, "traversal"); }
    if review_io_kind_exists(ref entries, function_id, "create_file") { list_push(mutref kinds, "create_file"); }
    if review_io_kind_exists(ref entries, function_id, "temporary") { list_push(mutref kinds, "temporary"); }
    if review_io_kind_exists(ref entries, function_id, "remove") { list_push(mutref kinds, "remove"); }
    if review_io_kind_exists(ref entries, function_id, "rename") { list_push(mutref kinds, "rename"); }
    if review_io_kind_exists(ref entries, function_id, "atomic_replace") { list_push(mutref kinds, "atomic_replace"); }
    return kinds;
}

fn function_has_direct_print(calls: ref list<call_fact>, module: str, function_name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and (value.name == "print_line" or value.name == "eprint_line") {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn function_has_direct_io(calls: ref list<call_fact>, module: str, function_name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and io_kind_for_builtin(value.name) != "" {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn build_print_effects(functions: ref list<review_function_fact>, calls: ref list<call_fact>, uses: ref list<module_use>) -> list<str> {
    let mut inferred: list<str> = list();
    let mut function_index = 0;
    while function_index < list_len(ref functions) {
        let entry = list_get(ref functions, function_index);
        match entry {
            Some(value) => {
                if function_has_direct_print(ref calls, value.module, value.name) {
                    push_if_missing(mutref inferred, function_internal_name(value.module, value.name));
                }
            },
            None => {
            },
        }
        function_index = function_index + 1;
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut index = 0;
        while index < list_len(ref functions) {
            let entry = list_get(ref functions, index);
            match entry {
                Some(value) => {
                    let internal_name = function_internal_name(value.module, value.name);
                    if not list_contains(ref inferred, internal_name) {
                        let mut call_index = 0;
                        let mut found_print = false;
                        while call_index < list_len(ref calls) {
                            let current = list_get(ref calls, call_index);
                            match current {
                                Some(call_entry) => {
                                    if call_entry.module == value.module and call_entry.function_name == value.name {
                                        if call_entry.name == "print_line" or call_entry.name == "eprint_line" {
                                            found_print = true;
                                        } else {
                                            let origin = visible_function_origin(ref functions, ref uses, value.module, call_entry.name);
                                            if origin != "" and origin != "__builtin__" and list_contains(ref inferred, function_internal_name(origin, call_entry.name)) {
                                                found_print = true;
                                            }
                                        }
                                    }
                                },
                                None => {
                                },
                            }
                            call_index = call_index + 1;
                        }
                        if found_print {
                            list_push(mutref inferred, internal_name);
                            changed = true;
                        }
                    }
                },
                None => {
                },
            }
            index = index + 1;
        }
    }
    return inferred;
}

fn build_io_effects(functions: ref list<review_function_fact>, calls: ref list<call_fact>, uses: ref list<module_use>) -> list<str> {
    let mut inferred: list<str> = list();
    let mut function_index = 0;
    while function_index < list_len(ref functions) {
        let entry = list_get(ref functions, function_index);
        match entry {
            Some(value) => {
                if function_has_direct_io(ref calls, value.module, value.name) {
                    push_if_missing(mutref inferred, function_internal_name(value.module, value.name));
                }
            },
            None => {
            },
        }
        function_index = function_index + 1;
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut index = 0;
        while index < list_len(ref functions) {
            let entry = list_get(ref functions, index);
            match entry {
                Some(value) => {
                    let internal_name = function_internal_name(value.module, value.name);
                    if not list_contains(ref inferred, internal_name) {
                        let mut call_index = 0;
                        let mut found_io = false;
                        while call_index < list_len(ref calls) {
                            let current = list_get(ref calls, call_index);
                            match current {
                                Some(call_entry) => {
                                    if call_entry.module == value.module and call_entry.function_name == value.name {
                                        if io_kind_for_builtin(call_entry.name) != "" {
                                            found_io = true;
                                        } else {
                                            let origin = visible_function_origin(ref functions, ref uses, value.module, call_entry.name);
                                            if origin != "" and origin != "__builtin__" and list_contains(ref inferred, function_internal_name(origin, call_entry.name)) {
                                                found_io = true;
                                            }
                                        }
                                    }
                                },
                                None => {
                                },
                            }
                            call_index = call_index + 1;
                        }
                        if found_io {
                            list_push(mutref inferred, internal_name);
                            changed = true;
                        }
                    }
                },
                None => {
                },
            }
            index = index + 1;
        }
    }
    return inferred;
}

fn build_io_kind_effects(functions: ref list<review_function_fact>, calls: ref list<call_fact>, uses: ref list<module_use>) -> list<review_io_kind_fact> {
    let mut inferred: list<review_io_kind_fact> = list();
    let mut changed = true;
    while changed {
        changed = false;
        let mut function_index = 0;
        while function_index < list_len(ref functions) {
            let function_entry = list_get(ref functions, function_index);
            match function_entry {
                Some(function_value) => {
                    let function_id = function_internal_name(function_value.module, function_value.name);
                    let mut call_index = 0;
                    while call_index < list_len(ref calls) {
                        let call_entry = list_get(ref calls, call_index);
                        match call_entry {
                            Some(call_value) => {
                                if call_value.module == function_value.module and call_value.function_name == function_value.name {
                                    let direct_kind = io_kind_for_builtin(call_value.name);
                                    if direct_kind != "" {
                                        if push_review_io_kind_if_missing(mutref inferred, function_id, direct_kind) {
                                            changed = true;
                                        }
                                    } else {
                                        let origin = visible_function_origin(ref functions, ref uses, function_value.module, call_value.name);
                                        if origin != "" and origin != "__builtin__" {
                                            let callee_id = function_internal_name(origin, call_value.name);
                                            let mut kind_index = 0;
                                            while kind_index < list_len(ref inferred) {
                                                let known_kind = list_get(ref inferred, kind_index);
                                                match known_kind {
                                                    Some(kind_value) => {
                                                        if kind_value.function_id == callee_id {
                                                            if push_review_io_kind_if_missing(mutref inferred, function_id, kind_value.kind) {
                                                                changed = true;
                                                            }
                                                        }
                                                    },
                                                    None => {
                                                    },
                                                }
                                                kind_index = kind_index + 1;
                                            }
                                        }
                                    }
                                }
                            },
                            None => {
                            },
                        }
                        call_index = call_index + 1;
                    }
                },
                None => {
                },
            }
            function_index = function_index + 1;
        }
    }
    return inferred;
}

fn push_contract_diag(diags: mutref list<diag>, module: str, at: i32, name: str, code: str, severity: diag_severity, message: str, help: str) -> unit {
    let mut category = diag_contract;
    if code == "NQ-PROPAGATE-004" or code == "NQ-PROPAGATE-005" or code == "NQ-PROPAGATE-006" {
        category = diag_propagate;
    }
    list_push(mutref diags, make_diagnostic(code, category, severity, module, at, at + str_len(name), message, "", help));
    return;
}

fn audit_effect_is_supported(name: str) -> bool {
    return name == "print" or name == "io";
}

fn validate_contracts(functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, uses: ref list<module_use>, diags: mutref list<diag>) -> review_summary {
    let mut warning_count = 0;
    let mut error_count = 0;
    let print_effects = build_print_effects(ref functions, ref calls, ref uses);
    let io_effects = build_io_effects(ref functions, ref calls, ref uses);
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                let inferred_propagate_names = inferred_propagates(ref function_facts, ref functions, ref locals, ref uses, value.module, value.name);
                let inferred_print = list_contains(ref print_effects, function_internal_name(value.module, value.name));
                let inferred_io = list_contains(ref io_effects, function_internal_name(value.module, value.name));
                if value.is_public and not value.has_audit {
                    push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-001", diag_warning, concat5("public function `", value.name, "` is missing an `audit` block", "", ""), "Add `audit { intent(...); mutates(...); effects(...); }` before the function body.");
                    warning_count = warning_count + 1;
                } else {
                    if value.has_audit {
                        if value.intent == "" {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-003", diag_error, "`intent(...)` text must be non-empty", "Describe the function intent with a non-empty string.");
                            error_count = error_count + 1;
                        }

                        let mut seen_mutates: list<str> = list();
                        let mut valid_mutates: list<str> = list();
                        let mut mutate_index = 0;
                        while mutate_index < list_len(ref decls) {
                            let decl_entry = list_get(ref decls, mutate_index);
                            match decl_entry {
                                Some(decl_value) => {
                                    if decl_value.module == value.module and decl_value.function_name == value.name {
                                        match decl_value.kind {
                                            review_decl_mutates => {
                                                if list_contains(ref seen_mutates, decl_value.name) {
                                                    push_contract_diag(mutref diags, value.module, decl_value.at, decl_value.name, "NQ-CONTRACT-010", diag_error, concat3("duplicate `mutates(...)` entry `", decl_value.name, "`"), "List each contract entry only once.");
                                                    error_count = error_count + 1;
                                                } else {
                                                    list_push(mutref seen_mutates, decl_value.name);
                                                    if param_is_mutref(ref function_params, value.module, value.name, decl_value.name) {
                                                        list_push(mutref valid_mutates, decl_value.name);
                                                    } else {
                                                        push_contract_diag(mutref diags, value.module, decl_value.at, decl_value.name, "NQ-CONTRACT-004", diag_error, concat3("`mutates(...)` entry `", decl_value.name, "` must name a `mutref` parameter"), "Name a mutref parameter; local assignment does not belong in mutates(...).");
                                                        error_count = error_count + 1;
                                                    }
                                                }
                                            },
                                            _ => {
                                            },
                                        }
                                    }
                                },
                                None => {
                                },
                            }
                            mutate_index = mutate_index + 1;
                        }

                        let mut seen_effects: list<str> = list();
                        let mut valid_effects: list<str> = list();
                        let mut effect_index = 0;
                        while effect_index < list_len(ref decls) {
                            let decl_entry = list_get(ref decls, effect_index);
                            match decl_entry {
                                Some(decl_value) => {
                                    if decl_value.module == value.module and decl_value.function_name == value.name {
                                        match decl_value.kind {
                                            review_decl_effects => {
                                                if list_contains(ref seen_effects, decl_value.name) {
                                                    push_contract_diag(mutref diags, value.module, decl_value.at, decl_value.name, "NQ-CONTRACT-010", diag_error, concat3("duplicate `effects(...)` entry `", decl_value.name, "`"), "List each contract entry only once.");
                                                    error_count = error_count + 1;
                                                } else {
                                                    list_push(mutref seen_effects, decl_value.name);
                                                    if audit_effect_is_supported(decl_value.name) {
                                                        list_push(mutref valid_effects, decl_value.name);
                                                    } else {
                                                        push_contract_diag(mutref diags, value.module, decl_value.at, decl_value.name, "NQ-CONTRACT-007", diag_error, concat3("unknown audit effect `", decl_value.name, "`"), "Use only the fixed print and io effect atoms.");
                                                        error_count = error_count + 1;
                                                    }
                                                }
                                            },
                                            _ => {
                                            },
                                        }
                                    }
                                },
                                None => {
                                },
                            }
                            effect_index = effect_index + 1;
                        }

                        let mut seen_propagates: list<str> = list();
                        let mut valid_propagates: list<str> = list();
                        let mut propagate_index = 0;
                        while propagate_index < list_len(ref decls) {
                            let decl_entry = list_get(ref decls, propagate_index);
                            match decl_entry {
                                Some(decl_value) => {
                                    if decl_value.module == value.module and decl_value.function_name == value.name {
                                        match decl_value.kind {
                                            review_decl_propagates => {
                                                if list_contains(ref seen_propagates, decl_value.name) {
                                                    push_contract_diag(mutref diags, value.module, decl_value.at, decl_value.name, "NQ-CONTRACT-010", diag_error, concat3("duplicate `propagates(...)` entry `", decl_value.name, "`"), "List each contract entry only once.");
                                                    error_count = error_count + 1;
                                                } else {
                                                    list_push(mutref seen_propagates, decl_value.name);
                                                    if decl_value.target_id != "" {
                                                        list_push(mutref valid_propagates, decl_value.name);
                                                    }
                                                }
                                            },
                                            _ => {
                                            },
                                        }
                                    }
                                },
                                None => {
                                },
                            }
                            propagate_index = propagate_index + 1;
                        }

                        if inferred_print and not list_contains(ref valid_effects, "print") {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-008", diag_error, "`audit` omits `print` from `effects(...)`", "Declare print in effects(...), or remove the effectful operation.");
                            error_count = error_count + 1;
                        }
                        if list_contains(ref valid_effects, "print") and not inferred_print {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-009", diag_warning, "`audit` declares `print` in `effects(...)` but no matching effect was inferred", "Remove the unused effect declaration, or implement the intended effect.");
                            warning_count = warning_count + 1;
                        }
                        if inferred_io and not list_contains(ref valid_effects, "io") {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-008", diag_error, "`audit` omits `io` from `effects(...)`", "Declare io in effects(...), or remove the effectful operation.");
                            error_count = error_count + 1;
                        }
                        if list_contains(ref valid_effects, "io") and not inferred_io {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-CONTRACT-009", diag_warning, "`audit` declares `io` in `effects(...)` but no matching effect was inferred", "Remove the unused effect declaration, or implement the intended effect.");
                            warning_count = warning_count + 1;
                        }

                        let mut inferred_propagate_index = 0;
                        while inferred_propagate_index < list_len(ref inferred_propagate_names) {
                            let inferred_entry = list_get(ref inferred_propagate_names, inferred_propagate_index);
                            match inferred_entry {
                                Some(inferred_name) => {
                                    if not list_contains(ref valid_propagates, inferred_name) {
                                        push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-PROPAGATE-004", diag_error, concat3("`audit` omits `", inferred_name, "` from `propagates(...)`"), "Declare the exact error type in propagates(...), or handle it explicitly with let-else.");
                                        error_count = error_count + 1;
                                    }
                                },
                                None => {
                                },
                            }
                            inferred_propagate_index = inferred_propagate_index + 1;
                        }

                        let mut declared_propagate_index = 0;
                        while declared_propagate_index < list_len(ref valid_propagates) {
                            let declared_entry = list_get(ref valid_propagates, declared_propagate_index);
                            match declared_entry {
                                Some(declared_name) => {
                                    if not list_contains(ref inferred_propagate_names, declared_name) {
                                        push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-PROPAGATE-005", diag_warning, concat3("`audit` declares `", declared_name, "` in `propagates(...)` but no matching propagation was inferred"), "Remove the unused propagation declaration.");
                                        warning_count = warning_count + 1;
                                    }
                                },
                                None => {
                                },
                            }
                            declared_propagate_index = declared_propagate_index + 1;
                        }
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return make_review_summary(list_len(ref functions), list_len(ref decls), warning_count, error_count);
}

fn module_function_count(functions: ref list<review_function_fact>, module: str) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if value.module == module {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn function_call_count(calls: ref list<call_fact>, module: str, function_name: str) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn call_target_kind(functions: ref list<review_function_fact>, items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let function_origin = visible_function_origin(ref functions, ref uses, module, name);
    if function_origin == "__builtin__" {
        return "builtin";
    }
    if function_origin != "" {
        return "function";
    }
    let variant_origin = visible_variant_origin(ref items, ref uses, module, name);
    if variant_origin == "__builtin__" {
        return "builtin_variant";
    }
    if variant_origin != "" {
        return "variant";
    }
    return "unknown";
}

fn call_target_id(functions: ref list<review_function_fact>, items: ref list<top_item>, uses: ref list<module_use>, variants: ref list<variant_fact>, module: str, name: str) -> str {
    let function_origin = visible_function_origin(ref functions, ref uses, module, name);
    if function_origin == "__builtin__" {
        return builtin_identity(name);
    }
    if function_origin != "" {
        return function_identity(function_origin, name);
    }
    let variant_origin = visible_variant_origin(ref items, ref uses, module, name);
    if variant_origin == "__builtin__" {
        return str_concat("builtin-variant:", name);
    }
    if variant_origin != "" {
        return concat6("variant:", variant_origin, "::", variant_enum_name(ref variants, variant_origin, name), "::", name);
    }
    return "";
}

fn call_target_module(functions: ref list<review_function_fact>, items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let function_origin = visible_function_origin(ref functions, ref uses, module, name);
    if function_origin != "" {
        return function_origin;
    }
    return visible_variant_origin(ref items, ref uses, module, name);
}

fn call_target_evidence(functions: ref list<review_function_fact>, items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    let origin = call_target_module(ref functions, ref items, ref uses, module, name);
    if origin == "__builtin__" {
        return "builtin";
    }
    if origin == "" {
        return "unresolved";
    }
    return "checked";
}

fn target_id_for_call(origin: str, name: str) -> str {
    if origin == "__builtin__" {
        return builtin_identity(name);
    }
    if origin == "" {
        return "";
    }
    return function_identity(origin, name);
}

fn append_review_json(lines: mutref list<str>, entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, uses: ref list<module_use>) -> unit {
    let print_effects = build_print_effects(ref functions, ref calls, ref uses);
    let io_effects = build_io_effects(ref functions, ref calls, ref uses);
    let total_functions = module_function_count(ref functions, entry_module);
    let mut emitted_functions = 0;

    list_push(mutref lines, "{");
    list_push(mutref lines, concat3("  \"module\": ", json_quote(entry_module), ","));
    list_push(mutref lines, "  \"functions\": [");

    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if value.module == entry_module {
                    let declared_mutates = decl_entries_for_function(ref decls, value.module, value.name, review_decl_mutates);
                    let declared_effects = decl_entries_for_function(ref decls, value.module, value.name, review_decl_effects);
                    let inferred_mutate_names = inferred_mutates(ref function_params, ref assignments, value.module, value.name);
                    let mut inferred_effect_names: list<str> = list();
                    if list_contains(ref print_effects, function_internal_name(value.module, value.name)) {
                        list_push(mutref inferred_effect_names, "print");
                    }
                    if list_contains(ref io_effects, function_internal_name(value.module, value.name)) {
                        list_push(mutref inferred_effect_names, "io");
                    }

                    list_push(mutref lines, "    {");
                    list_push(mutref lines, concat3("      \"name\": ", json_quote(value.name), ","));
                    list_push(mutref lines, concat3("      \"public\": ", bool_text(value.is_public), ","));
                    if value.has_audit {
                        list_push(mutref lines, "      \"audit\": {");
                        list_push(mutref lines, concat3("        \"intent\": ", json_quote(value.intent), ","));
                        append_named_string_array(mutref lines, "        ", "mutates", ref declared_mutates, true);
                        append_named_string_array(mutref lines, "        ", "effects", ref declared_effects, false);
                        list_push(mutref lines, "      },");
                    } else {
                        list_push(mutref lines, "      \"audit\": null,");
                    }
                    list_push(mutref lines, "      \"inferred\": {");
                    append_named_string_array(mutref lines, "        ", "mutates", ref inferred_mutate_names, true);
                    append_named_string_array(mutref lines, "        ", "effects", ref inferred_effect_names, false);
                    list_push(mutref lines, "      }");

                    emitted_functions = emitted_functions + 1;
                    if emitted_functions < total_functions {
                        list_push(mutref lines, "    },");
                    } else {
                        list_push(mutref lines, "    }");
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }

    list_push(mutref lines, "  ]");
    list_push(mutref lines, "}");
    return;
}

fn append_review_v2_calls(lines: mutref list<str>, indent: str, functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, module: str, function_name: str, trailing_comma: bool) -> unit {
    let total_calls = function_call_count(ref calls, module, function_name);
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    if total_calls == 0 {
        list_push(mutref lines, concat5(indent, "\"calls\": []", suffix, "", ""));
        return;
    }

    list_push(mutref lines, concat3(indent, "\"calls\": [", ""));
    let mut emitted_calls = 0;
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    let origin = call_target_module(ref functions, ref items, ref uses, value.module, value.name);
                    let target_kind = call_target_kind(ref functions, ref items, ref uses, value.module, value.name);
                    let target_id = call_target_id(ref functions, ref items, ref uses, ref variants, value.module, value.name);
                    let evidence = call_target_evidence(ref functions, ref items, ref uses, value.module, value.name);
                    let io_kind = io_kind_for_builtin(value.name);
                    list_push(mutref lines, concat3(indent, "  {", ""));
                    list_push(mutref lines, concat5(indent, "    \"id\": ", json_quote(call_identity(value.module, value.function_name, value.at)), ",", ""));
                    list_push(mutref lines, concat5(indent, "    \"name\": ", json_quote(value.name), ",", ""));
                    list_push(mutref lines, concat5(indent, "    \"target_kind\": ", json_quote(target_kind), ",", ""));
                    list_push(mutref lines, concat5(indent, "    \"target_id\": ", json_quote(target_id), ",", ""));
                    list_push(mutref lines, concat5(indent, "    \"target_module\": ", json_quote(origin), ",", ""));
                    if io_kind != "" {
                        list_push(mutref lines, concat5(indent, "    \"evidence\": ", json_quote(evidence), ",", ""));
                        list_push(mutref lines, concat5(indent, "    \"io_kind\": ", json_quote(io_kind), ",", ""));
                    } else {
                        list_push(mutref lines, concat5(indent, "    \"evidence\": ", json_quote(evidence), ",", ""));
                    }
                    append_span(mutref lines, concat3(indent, "    ", ""), value.at, false);
                    emitted_calls = emitted_calls + 1;
                    if emitted_calls < total_calls {
                        list_push(mutref lines, concat3(indent, "  },", ""));
                    } else {
                        list_push(mutref lines, concat3(indent, "  }", ""));
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, concat3(indent, "]", suffix));
    return;
}

fn append_review_v2_functions(lines: mutref list<str>, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, items: ref list<top_item>, variants: ref list<variant_fact>, locals: ref list<local_init_fact>, writes: ref list<review_direct_mutation>, coverage: ref list<review_mutation_coverage>, format_version: i32) -> unit {
    let use_v3 = format_version >= 3;
    let print_effects = build_print_effects(ref functions, ref calls, ref uses);
    let io_effects = build_io_effects(ref functions, ref calls, ref uses);
    let io_kind_effects = build_io_kind_effects(ref functions, ref calls, ref uses);
    let total_functions = list_len(ref functions);
    list_push(mutref lines, "  \"functions\": [");
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                let declared_mutates = decl_entries_for_function(ref decls, value.module, value.name, review_decl_mutates);
                let declared_effects = decl_entries_for_function(ref decls, value.module, value.name, review_decl_effects);
                let declared_propagates = decl_entries_for_function(ref decls, value.module, value.name, review_decl_propagates);
                let mut inferred_mutate_names: list<str> = list();
                if use_v3 {
                    inferred_mutate_names = inferred_checked_mutates(ref writes, value.module, value.name);
                } else {
                    inferred_mutate_names = inferred_mutates(ref function_params, ref assignments, value.module, value.name);
                }
                let inferred_propagate_names = inferred_propagates(ref function_facts, ref functions, ref locals, ref uses, value.module, value.name);
                let inferred_io_kinds = io_kinds_for_function(ref io_kind_effects, value.module, value.name);
                let mut inferred_effect_names: list<str> = list();
                if list_contains(ref print_effects, function_internal_name(value.module, value.name)) {
                    list_push(mutref inferred_effect_names, "print");
                }
                if list_contains(ref io_effects, function_internal_name(value.module, value.name)) {
                    list_push(mutref inferred_effect_names, "io");
                }

                list_push(mutref lines, "    {");
                list_push(mutref lines, concat5("      \"id\": ", json_quote(function_identity(value.module, value.name)), ",", "", ""));
                list_push(mutref lines, concat5("      \"kind\": ", json_quote("function"), ",", "", ""));
                list_push(mutref lines, concat5("      \"qualified_name\": ", json_quote(function_internal_name(value.module, value.name)), ",", "", ""));
                list_push(mutref lines, concat5("      \"module\": ", json_quote(value.module), ",", "", ""));
                list_push(mutref lines, concat5("      \"name\": ", json_quote(value.name), ",", "", ""));
                list_push(mutref lines, concat3("      \"public\": ", bool_text(value.is_public), ","));
                append_span(mutref lines, "      ", value.at, true);
                if value.has_audit {
                    list_push(mutref lines, "      \"audit\": {");
                    list_push(mutref lines, concat3("        \"intent\": ", json_quote(value.intent), ","));
                    append_named_string_array(mutref lines, "        ", "mutates", ref declared_mutates, true);
                    append_named_string_array(mutref lines, "        ", "effects", ref declared_effects, true);
                    append_named_string_array(mutref lines, "        ", "propagates", ref declared_propagates, false);
                    list_push(mutref lines, "      },");
                } else {
                    list_push(mutref lines, "      \"audit\": null,");
                }
                list_push(mutref lines, "      \"inferred\": {");
                append_named_string_array(mutref lines, "        ", "mutates", ref inferred_mutate_names, true);
                append_named_string_array(mutref lines, "        ", "effects", ref inferred_effect_names, true);
                if list_len(ref inferred_io_kinds) > 0 {
                    append_named_string_array(mutref lines, "        ", "propagates", ref inferred_propagate_names, true);
                    append_named_string_array(mutref lines, "        ", "io_kinds", ref inferred_io_kinds, false);
                } else {
                    append_named_string_array(mutref lines, "        ", "propagates", ref inferred_propagate_names, false);
                }
                list_push(mutref lines, "      },");
                list_push(mutref lines, "      \"evidence\": {");
                if use_v3 and not value.has_audit {
                    list_push(mutref lines, "        \"audit\": \"absent\",");
                } else {
                    list_push(mutref lines, "        \"audit\": \"declared\",");
                }
                if use_v3 {
                    list_push(mutref lines, "        \"inferred\": \"checked\",");
                    list_push(mutref lines, "        \"mutation_coverage\": {");
                    if format_version == 4 {
                        list_push(mutref lines, "          \"interpretation\": \"syntactic_may_write\",");
                        list_push(mutref lines, "          \"scope\": \"checked_mutref_parameters\",");
                        if review_mutation_partial(ref coverage, value.module, value.name) {
                            list_push(mutref lines, "          \"completeness\": \"partial\",");
                            list_push(mutref lines, "          \"uncovered\": [\"unmodeled_builtin_summary\"]");
                        } else {
                            list_push(mutref lines, "          \"completeness\": \"complete\",");
                            list_push(mutref lines, "          \"uncovered\": []");
                        }
                    } else {
                    list_push(mutref lines, "          \"interpretation\": \"lower_bound\",");
                    list_push(mutref lines, "          \"scope\": \"direct_mutref_parameter_assignments\",");
                    list_push(mutref lines, "          \"completeness\": \"partial\",");
                    list_push(mutref lines, "          \"uncovered\": [\"builtin_call_writes\", \"local_call_writes\", \"imported_call_writes\"]");
                    }
                    list_push(mutref lines, "        }");
                } else {
                    list_push(mutref lines, "        \"inferred\": \"checked\"");
                }
                list_push(mutref lines, "      },");
                append_review_v2_calls(mutref lines, "      ", ref functions, ref items, ref variants, ref calls, ref uses, value.module, value.name, false);
                if index + 1 < total_functions {
                    list_push(mutref lines, "    },");
                } else {
                    list_push(mutref lines, "    }");
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, "  ],");
    return;
}

fn append_review_v2_references(lines: mutref list<str>, functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, calls: ref list<call_fact>, uses: ref list<module_use>) -> unit {
    let total_calls = list_len(ref calls);
    if total_calls == 0 {
        list_push(mutref lines, "  \"references\": [],");
        return;
    }
    list_push(mutref lines, "  \"references\": [");
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                let target_kind = call_target_kind(ref functions, ref items, ref uses, value.module, value.name);
                let target_id = call_target_id(ref functions, ref items, ref uses, ref variants, value.module, value.name);
                let evidence = call_target_evidence(ref functions, ref items, ref uses, value.module, value.name);
                let io_kind = io_kind_for_builtin(value.name);
                list_push(mutref lines, "    {");
                list_push(mutref lines, concat5("      \"id\": ", json_quote(call_identity(value.module, value.function_name, value.at)), ",", "", ""));
                list_push(mutref lines, "      \"kind\": \"call\",");
                list_push(mutref lines, concat5("      \"from\": ", json_quote(function_identity(value.module, value.function_name)), ",", "", ""));
                list_push(mutref lines, concat5("      \"name\": ", json_quote(value.name), ",", "", ""));
                list_push(mutref lines, concat5("      \"target_kind\": ", json_quote(target_kind), ",", "", ""));
                list_push(mutref lines, concat5("      \"target_id\": ", json_quote(target_id), ",", "", ""));
                if io_kind != "" {
                    list_push(mutref lines, concat5("      \"evidence\": ", json_quote(evidence), ",", "", ""));
                    list_push(mutref lines, concat5("      \"io_kind\": ", json_quote(io_kind), ",", "", ""));
                } else {
                    list_push(mutref lines, concat5("      \"evidence\": ", json_quote(evidence), ",", "", ""));
                }
                append_span(mutref lines, "      ", value.at, false);
                if index + 1 < total_calls {
                    list_push(mutref lines, "    },");
                } else {
                    list_push(mutref lines, "    }");
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, "  ],");
    return;
}

fn append_review_v2_call_graph(lines: mutref list<str>, functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    let total_calls = list_len(ref calls);
    if total_calls == 0 {
        list_push(mutref lines, concat3("  \"call_graph\": []", suffix, ""));
        return;
    }
    list_push(mutref lines, "  \"call_graph\": [");
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                let target_id = call_target_id(ref functions, ref items, ref uses, ref variants, value.module, value.name);
                let evidence = call_target_evidence(ref functions, ref items, ref uses, value.module, value.name);
                let io_kind = io_kind_for_builtin(value.name);
                list_push(mutref lines, "    {");
                list_push(mutref lines, concat5("      \"caller\": ", json_quote(function_identity(value.module, value.function_name)), ",", "", ""));
                list_push(mutref lines, concat5("      \"callee\": ", json_quote(target_id), ",", "", ""));
                list_push(mutref lines, concat5("      \"call_site\": ", json_quote(call_identity(value.module, value.function_name, value.at)), ",", "", ""));
                if io_kind != "" {
                    list_push(mutref lines, concat5("      \"evidence\": ", json_quote(evidence), ",", "", ""));
                    list_push(mutref lines, concat5("      \"io_kind\": ", json_quote(io_kind), "", "", ""));
                } else {
                    list_push(mutref lines, concat5("      \"evidence\": ", json_quote(evidence), "", "", ""));
                }
                if index + 1 < total_calls {
                    list_push(mutref lines, "    },");
                } else {
                    list_push(mutref lines, "    }");
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, concat3("  ]", suffix, ""));
    return;
}

fn append_review_v2_propagation_sites(lines: mutref list<str>, function_facts: ref list<function_fact>, functions: ref list<review_function_fact>, items: ref list<top_item>, uses: ref list<module_use>, locals: ref list<local_init_fact>) -> unit {
    let total_sites = propagation_site_count(ref locals);
    if total_sites == 0 {
        list_push(mutref lines, "  \"propagation_sites\": []");
        return;
    }
    list_push(mutref lines, "  \"propagation_sites\": [");
    let mut emitted = 0;
    let mut index = 0;
    while index < list_len(ref locals) {
        let entry = list_get(ref locals, index);
        match entry {
            Some(value) => {
                if value.expr_member_name == "propagate" or value.expr_member_name == "try_propagate" {
                    let error_name = propagation_error_name(ref function_facts, ref functions, ref uses, value);
                    let target_kind = propagation_target_kind(ref items, ref uses, value.module, error_name);
                    let target_id = propagation_target_id(ref items, ref uses, value.module, error_name);
                    let evidence = propagation_target_evidence(ref items, ref uses, value.module, error_name);
                    list_push(mutref lines, "    {");
                    list_push(mutref lines, concat5("      \"id\": ", json_quote(propagation_identity(value.module, value.function_name, value.at)), ",", "", ""));
                    list_push(mutref lines, concat5("      \"function\": ", json_quote(function_identity(value.module, value.function_name)), ",", "", ""));
                    list_push(mutref lines, concat5("      \"error\": ", json_quote(error_name), ",", "", ""));
                    list_push(mutref lines, concat5("      \"target_kind\": ", json_quote(target_kind), ",", "", ""));
                    list_push(mutref lines, concat5("      \"target_id\": ", json_quote(target_id), ",", "", ""));
                    list_push(mutref lines, concat5("      \"evidence\": ", json_quote(evidence), ",", "", ""));
                    if value.propagation_label != "" {
                        list_push(mutref lines, concat5("      \"context\": ", json_quote(value.propagation_label), ",", "", ""));
                    }
                    append_span(mutref lines, "      ", value.at, false);
                    emitted = emitted + 1;
                    if emitted < total_sites {
                        list_push(mutref lines, "    },");
                    } else {
                        list_push(mutref lines, "    }");
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, "  ]");
    return;
}

fn append_review_v2_json(lines: mutref list<str>, entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, items: ref list<top_item>, variants: ref list<variant_fact>, locals: ref list<local_init_fact>, writes: ref list<review_direct_mutation>, coverage: ref list<review_mutation_coverage>, format_version: i32) -> unit {
    let use_v3 = format_version >= 3;
    list_push(mutref lines, "{");
    list_push(mutref lines, concat3("  \"version\": ", i32_to_str(format_version), ","));
    list_push(mutref lines, "  \"command\": \"review\",");
    list_push(mutref lines, concat3("  \"module\": ", json_quote(entry_module), ","));
    list_push(mutref lines, "  \"identity_scheme\": \"nauqtype.semantic.v1\",");
    append_review_v2_functions(mutref lines, ref functions, ref decls, ref function_facts, ref function_params, ref assignments, ref calls, ref uses, ref items, ref variants, ref locals, ref writes, ref coverage, format_version);
    append_review_v2_references(mutref lines, ref functions, ref items, ref variants, ref calls, ref uses);
    append_review_v2_call_graph(mutref lines, ref functions, ref items, ref variants, ref calls, ref uses, true);
    append_review_v2_propagation_sites(mutref lines, ref function_facts, ref functions, ref items, ref uses, ref locals);
    list_push(mutref lines, "}");
    return;
}

fn collect_review_fact_lists(sources: ref list<source_file>, functions_out: mutref list<review_function_fact>, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> unit {
    let mut source_index = 0;
    while source_index < list_len(ref sources) {
        let entry = list_get(ref sources, source_index);
        match entry {
            Some(file) => {
                let tokens = lex(file.text);
                collect_review_facts(file.name, ref tokens, mutref functions_out, mutref decls_out, mutref diags);
            },
            None => {
            },
        }
        source_index = source_index + 1;
    }
    return;
}

pub fn build_source_contracts(sources: ref list<source_file>, uses: ref list<module_use>, items: ref list<top_item>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, functions_out: mutref list<review_function_fact>, decls_out: mutref list<review_decl_entry>, diags: mutref list<diag>) -> review_summary
audit {
    intent("Extract, resolve, and validate source contracts once for compilation and evidence commands");
    mutates(functions_out, decls_out, diags);
    effects();
}
{
    if diagnostics_have_errors(ref diags) {
        return make_review_summary(0, 0, 0, 1);
    }
    let mut declarations: list<review_decl_entry> = list();
    collect_review_fact_lists(ref sources, mutref functions_out, mutref declarations, mutref diags);
    if diagnostics_have_errors(ref diags) {
        return make_review_summary(list_len(ref functions_out), list_len(ref declarations), 0, 1);
    }
    let mut invalid_types = 0;
    let mut index = 0;
    while index < list_len(ref declarations) {
        let entry = list_get(ref declarations, index);
        match entry {
            Some(value) => {
                let mut target = "";
                match value.kind {
                    review_decl_propagates => {
                        target = propagation_target_id(ref items, ref uses, value.module, value.name);
                        if target == "" {
                            push_contract_diag(mutref diags, value.module, value.at, value.name, "NQ-PROPAGATE-006", diag_error, concat3("propagation declaration `", value.name, "` must name a visible concrete error type"), "Use an existing builtin, local type, or directly imported public type; map different errors explicitly with let-else.");
                            invalid_types = invalid_types + 1;
                        }
                    },
                    _ => {
                    },
                }
                list_push(mutref decls_out, review_decl_entry {
                    module: value.module, function_name: value.function_name,
                    name: value.name, at: value.at, kind: value.kind, target_id: target,
                });
            },
            None => {
            },
        }
        index = index + 1;
    }
    let summary = validate_contracts(ref functions_out, ref decls_out, ref function_facts, ref function_params, ref assignments, ref calls, ref locals, ref uses, mutref diags);
    return make_review_summary(summary.function_count, summary.declaration_count, summary.warning_count, summary.error_count + invalid_types);
}

pub fn validate_checked_mutation_contracts(base: review_summary, contracts: ref list<review_function_fact>, decls: ref list<review_decl_entry>, functions: ref list<checked_function>, bindings: ref list<checked_binding>, params: ref list<checked_param>, statements: ref list<checked_stmt>, expressions: ref list<checked_expr>, children: ref list<checked_expr_child>, shapes: ref list<checked_type_shape>, types: ref list<checked_type_decl>, fields: ref list<checked_field_decl>, writes: mutref list<review_direct_mutation>, coverage: mutref list<review_mutation_coverage>, diags: mutref list<diag>) -> review_summary
audit {
    intent("Validate declared mutation against one shared checked call-aware parameter footprint");
    mutates(writes, coverage, diags);
    effects();
}
{
    if diagnostics_have_errors(ref diags) { return make_review_summary(base.function_count, base.declaration_count, base.warning_count, base.error_count + 1); }
    collect_review_mutations(ref functions, ref bindings, ref params, ref statements, ref expressions, ref children, ref shapes, ref types, ref fields, mutref writes, mutref coverage, mutref diags);
    if diagnostics_have_errors(ref diags) { return make_review_summary(base.function_count, base.declaration_count, base.warning_count, base.error_count + 1); }
    let mut errors = base.error_count;
    let mut warnings = base.warning_count;
    let mut index = 0;
    while index < list_len(ref contracts) {
        match list_get(ref contracts, index) {
            Some(contract) => {
                if contract.has_audit {
                    let declared = decl_entries_for_function(ref decls, contract.module, contract.name, review_decl_mutates);
                    let mut param_index = 0;
                    while param_index < list_len(ref params) {
                        match list_get(ref params, param_index) {
                            Some(param) => {
                                if param.module_name == contract.module and param.function_name == contract.name and param.is_borrow and param.borrow_mutable {
                                    let written = review_mutation_has(ref writes, param.binding_id);
                                    let named = list_contains(ref declared, param.name);
                                    if written and not named {
                                        push_contract_diag(mutref diags, contract.module, contract.at, contract.name, "NQ-CONTRACT-005", diag_error, concat3("`audit` omits mutated `mutref` parameter `", param.name, "`"), "Declare the checked direct or call-mediated parameter write in mutates(...).");
                                        errors = errors + 1;
                                    }
                                    if named and not written and not review_mutation_partial(ref coverage, contract.module, contract.name) {
                                        push_contract_diag(mutref diags, contract.module, contract.at, contract.name, "NQ-CONTRACT-006", diag_warning, concat3("`audit` declares mutation of `", param.name, "` but no write-through was inferred"), "Remove the unused mutation declaration; the complete syntactic parameter analysis found no direct or call-mediated write.");
                                        warnings = warnings + 1;
                                    }
                                }
                            },
                            None => {},
                        }
                        param_index = param_index + 1;
                    }
                }
            },
            None => {},
        }
        index = index + 1;
    }
    return make_review_summary(base.function_count, base.declaration_count, warnings, errors);
}

fn join_strings(values: ref list<str>) -> str {
    let mut text = "";
    let mut index = 0;
    while index < list_len(ref values) {
        let entry = list_get(ref values, index);
        match entry {
            Some(value) => {
                if index > 0 {
                    text = str_concat(text, "|");
                }
                text = str_concat(text, value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return text;
}

fn function_identity_exists(functions: ref list<review_function_fact>, id: str) -> bool {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if function_identity(value.module, value.name) == id {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn call_edge_key(functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, uses: ref list<module_use>, call: call_fact) -> str {
    let caller = function_identity(call.module, call.function_name);
    let mut target = call_target_id(ref functions, ref items, ref uses, ref variants, call.module, call.name);
    if target == "" {
        target = concat5("unknown:", call.module, "::", call.name, "");
    }
    return concat3(caller, " -> ", target);
}

fn collect_call_edges(functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, edges_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                push_if_missing(mutref edges_out, call_edge_key(ref functions, ref items, ref variants, ref uses, value));
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn collect_call_edges_for_function(functions: ref list<review_function_fact>, items: ref list<top_item>, variants: ref list<variant_fact>, calls: ref list<call_fact>, uses: ref list<module_use>, module: str, function_name: str, edges_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref calls) {
        let entry = list_get(ref calls, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    push_if_missing(mutref edges_out, call_edge_key(ref functions, ref items, ref variants, ref uses, value));
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn propagation_contract_key(entry: review_decl_entry) -> str {
    return concat5(function_identity(entry.module, entry.function_name), " -> ", entry.name, "", "");
}

fn collect_propagation_contracts(decls: ref list<review_decl_entry>, values_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref decls) {
        let entry = list_get(ref decls, index);
        match entry {
            Some(value) => {
                match value.kind {
                    review_decl_propagates => {
                        push_if_missing(mutref values_out, propagation_contract_key(value));
                    },
                    _ => {
                    },
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn review_function_signature(entry: review_function_fact, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, items: ref list<top_item>, function_facts: ref list<function_fact>, variants: ref list<variant_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, uses: ref list<module_use>, print_effects: ref list<str>, io_effects: ref list<str>, io_kind_effects: ref list<review_io_kind_fact>) -> str {
    let declared_mutates = decl_entries_for_function(ref decls, entry.module, entry.name, review_decl_mutates);
    let declared_effects = decl_entries_for_function(ref decls, entry.module, entry.name, review_decl_effects);
    let declared_propagates = decl_entries_for_function(ref decls, entry.module, entry.name, review_decl_propagates);
    let inferred_mutate_names = inferred_mutates(ref function_params, ref assignments, entry.module, entry.name);
    let inferred_propagate_names = inferred_propagates(ref function_facts, ref functions, ref locals, ref uses, entry.module, entry.name);
    let propagation_context_names = propagation_contexts(ref locals, entry.module, entry.name);
    let inferred_io_kinds = io_kinds_for_function(ref io_kind_effects, entry.module, entry.name);
    let mut inferred_effect_names: list<str> = list();
    if list_contains(ref print_effects, function_internal_name(entry.module, entry.name)) {
        list_push(mutref inferred_effect_names, "print");
    }
    if list_contains(ref io_effects, function_internal_name(entry.module, entry.name)) {
        list_push(mutref inferred_effect_names, "io");
    }
    let mut call_edges: list<str> = list();
    collect_call_edges_for_function(ref functions, ref items, ref variants, ref calls, ref uses, entry.module, entry.name, mutref call_edges);

    let mut signature = concat3("public=", bool_text(entry.is_public), "|");
    signature = concat3(signature, "audit=", bool_text(entry.has_audit));
    signature = concat3(signature, "|intent=", entry.intent);
    signature = concat3(signature, "|params=", param_signature(ref function_params, entry.module, entry.name));
    signature = concat3(signature, "|decl_mutates=", join_strings(ref declared_mutates));
    signature = concat3(signature, "|decl_effects=", join_strings(ref declared_effects));
    signature = concat3(signature, "|decl_propagates=", join_strings(ref declared_propagates));
    signature = concat3(signature, "|inferred_mutates=", join_strings(ref inferred_mutate_names));
    signature = concat3(signature, "|inferred_effects=", join_strings(ref inferred_effect_names));
    signature = concat3(signature, "|inferred_io_kinds=", join_strings(ref inferred_io_kinds));
    signature = concat3(signature, "|inferred_propagates=", join_strings(ref inferred_propagate_names));
    signature = concat3(signature, "|propagation_contexts=", join_strings(ref propagation_context_names));
    signature = concat3(signature, "|calls=", join_strings(ref call_edges));
    return signature;
}

fn review_function_signature_by_id(functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, items: ref list<top_item>, function_facts: ref list<function_fact>, variants: ref list<variant_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, uses: ref list<module_use>, print_effects: ref list<str>, io_effects: ref list<str>, io_kind_effects: ref list<review_io_kind_fact>, id: str) -> str {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if function_identity(value.module, value.name) == id {
                    return review_function_signature(value, ref functions, ref decls, ref items, ref function_facts, ref variants, ref function_params, ref assignments, ref calls, ref locals, ref uses, ref print_effects, ref io_effects, ref io_kind_effects);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return "";
}

fn param_signature_part(param: function_param_fact) -> str {
    let mut part = concat5(i32_to_str(param.index), ":", param.name, ":", param.type_name);
    if param.type_arg1_name != "" {
        part = concat3(part, "<", param.type_arg1_name);
        if param.type_arg2_name != "" {
            part = concat3(part, ",", param.type_arg2_name);
        }
        part = str_concat(part, ">");
    }
    part = concat3(part, ":borrow=", bool_text(param.is_borrow));
    part = concat3(part, ":mutable=", bool_text(param.borrow_mutable));
    return part;
}

fn param_signature(function_params: ref list<function_param_fact>, module: str, function_name: str) -> str {
    let mut parts: list<str> = list();
    let mut index = 0;
    while index < list_len(ref function_params) {
        let entry = list_get(ref function_params, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    list_push(mutref parts, param_signature_part(value));
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return join_strings(ref parts);
}

fn collect_added_functions(before_functions: ref list<review_function_fact>, after_functions: ref list<review_function_fact>, added_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref after_functions) {
        let entry = list_get(ref after_functions, index);
        match entry {
            Some(value) => {
                let id = function_identity(value.module, value.name);
                if not function_identity_exists(ref before_functions, id) {
                    list_push(mutref added_out, id);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn collect_removed_functions(before_functions: ref list<review_function_fact>, after_functions: ref list<review_function_fact>, removed_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref before_functions) {
        let entry = list_get(ref before_functions, index);
        match entry {
            Some(value) => {
                let id = function_identity(value.module, value.name);
                if not function_identity_exists(ref after_functions, id) {
                    list_push(mutref removed_out, id);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn collect_changed_functions(before_functions: ref list<review_function_fact>, before_decls: ref list<review_decl_entry>, before_items: ref list<top_item>, before_function_facts: ref list<function_fact>, before_variants: ref list<variant_fact>, before_params: ref list<function_param_fact>, before_assignments: ref list<assignment_fact>, before_calls: ref list<call_fact>, before_locals: ref list<local_init_fact>, before_uses: ref list<module_use>, after_functions: ref list<review_function_fact>, after_decls: ref list<review_decl_entry>, after_items: ref list<top_item>, after_function_facts: ref list<function_fact>, after_variants: ref list<variant_fact>, after_params: ref list<function_param_fact>, after_assignments: ref list<assignment_fact>, after_calls: ref list<call_fact>, after_locals: ref list<local_init_fact>, after_uses: ref list<module_use>, changed_out: mutref list<str>) -> unit {
    let before_print_effects = build_print_effects(ref before_functions, ref before_calls, ref before_uses);
    let before_io_effects = build_io_effects(ref before_functions, ref before_calls, ref before_uses);
    let before_io_kind_effects = build_io_kind_effects(ref before_functions, ref before_calls, ref before_uses);
    let after_print_effects = build_print_effects(ref after_functions, ref after_calls, ref after_uses);
    let after_io_effects = build_io_effects(ref after_functions, ref after_calls, ref after_uses);
    let after_io_kind_effects = build_io_kind_effects(ref after_functions, ref after_calls, ref after_uses);
    let mut index = 0;
    while index < list_len(ref after_functions) {
        let entry = list_get(ref after_functions, index);
        match entry {
            Some(value) => {
                let id = function_identity(value.module, value.name);
                if function_identity_exists(ref before_functions, id) {
                    let before_signature = review_function_signature_by_id(ref before_functions, ref before_decls, ref before_items, ref before_function_facts, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, ref before_uses, ref before_print_effects, ref before_io_effects, ref before_io_kind_effects, id);
                    let after_signature = review_function_signature(value, ref after_functions, ref after_decls, ref after_items, ref after_function_facts, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, ref after_uses, ref after_print_effects, ref after_io_effects, ref after_io_kind_effects);
                    if before_signature != after_signature {
                        list_push(mutref changed_out, id);
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn collect_added_strings(before_values: ref list<str>, after_values: ref list<str>, added_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref after_values) {
        let entry = list_get(ref after_values, index);
        match entry {
            Some(value) => {
                if not list_contains(ref before_values, value) {
                    list_push(mutref added_out, value);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn collect_removed_strings(before_values: ref list<str>, after_values: ref list<str>, removed_out: mutref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref before_values) {
        let entry = list_get(ref before_values, index);
        match entry {
            Some(value) => {
                if not list_contains(ref after_values, value) {
                    list_push(mutref removed_out, value);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn append_review_diff_json(lines: mutref list<str>, before_module: str, after_module: str, added_functions: ref list<str>, removed_functions: ref list<str>, changed_functions: ref list<str>, added_call_edges: ref list<str>, removed_call_edges: ref list<str>) -> unit {
    list_push(mutref lines, "{");
    list_push(mutref lines, "  \"version\": 1,");
    list_push(mutref lines, "  \"command\": \"review-diff\",");
    list_push(mutref lines, "  \"identity_scheme\": \"nauqtype.semantic.v1\",");
    list_push(mutref lines, concat3("  \"before\": { \"module\": ", json_quote(before_module), " },"));
    list_push(mutref lines, concat3("  \"after\": { \"module\": ", json_quote(after_module), " },"));
    list_push(mutref lines, "  \"summary\": {");
    list_push(mutref lines, concat3("    \"added_functions\": ", i32_to_str(list_len(ref added_functions)), ","));
    list_push(mutref lines, concat3("    \"removed_functions\": ", i32_to_str(list_len(ref removed_functions)), ","));
    list_push(mutref lines, concat3("    \"changed_functions\": ", i32_to_str(list_len(ref changed_functions)), ","));
    list_push(mutref lines, concat3("    \"added_call_edges\": ", i32_to_str(list_len(ref added_call_edges)), ","));
    list_push(mutref lines, concat3("    \"removed_call_edges\": ", i32_to_str(list_len(ref removed_call_edges)), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"changes\": {");
    append_named_string_array(mutref lines, "    ", "added_functions", ref added_functions, true);
    append_named_string_array(mutref lines, "    ", "removed_functions", ref removed_functions, true);
    append_named_string_array(mutref lines, "    ", "changed_functions", ref changed_functions, true);
    append_named_string_array(mutref lines, "    ", "added_call_edges", ref added_call_edges, true);
    append_named_string_array(mutref lines, "    ", "removed_call_edges", ref removed_call_edges, false);
    list_push(mutref lines, "  }");
    list_push(mutref lines, "}");
    return;
}

fn append_review_diff_v2_json(lines: mutref list<str>, before_module: str, after_module: str, added_functions: ref list<str>, removed_functions: ref list<str>, changed_functions: ref list<str>, added_call_edges: ref list<str>, removed_call_edges: ref list<str>) -> unit {
    list_push(mutref lines, "{");
    list_push(mutref lines, "  \"version\": 2,");
    list_push(mutref lines, "  \"command\": \"review-diff\",");
    list_push(mutref lines, "  \"identity_scheme\": \"nauqtype.semantic.v1\",");
    list_push(mutref lines, concat3("  \"before\": { \"module\": ", json_quote(before_module), ", \"evidence\": \"checked\" },"));
    list_push(mutref lines, concat3("  \"after\": { \"module\": ", json_quote(after_module), ", \"evidence\": \"checked\" },"));
    list_push(mutref lines, "  \"evidence\": {");
    list_push(mutref lines, "    \"before\": \"checked\",");
    list_push(mutref lines, "    \"after\": \"checked\",");
    list_push(mutref lines, "    \"comparison\": \"semantic-identities\"");
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"summary\": {");
    list_push(mutref lines, concat3("    \"added_functions\": ", i32_to_str(list_len(ref added_functions)), ","));
    list_push(mutref lines, concat3("    \"removed_functions\": ", i32_to_str(list_len(ref removed_functions)), ","));
    list_push(mutref lines, concat3("    \"changed_functions\": ", i32_to_str(list_len(ref changed_functions)), ","));
    list_push(mutref lines, concat3("    \"added_call_edges\": ", i32_to_str(list_len(ref added_call_edges)), ","));
    list_push(mutref lines, concat3("    \"removed_call_edges\": ", i32_to_str(list_len(ref removed_call_edges)), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"changes\": {");
    append_named_string_array(mutref lines, "    ", "added_functions", ref added_functions, true);
    append_named_string_array(mutref lines, "    ", "removed_functions", ref removed_functions, true);
    append_named_string_array(mutref lines, "    ", "changed_functions", ref changed_functions, true);
    append_named_string_array(mutref lines, "    ", "added_call_edges", ref added_call_edges, true);
    append_named_string_array(mutref lines, "    ", "removed_call_edges", ref removed_call_edges, false);
    list_push(mutref lines, "  }");
    list_push(mutref lines, "}");
    return;
}

fn append_change_report_diagnostic(lines: mutref list<str>, code: str, message: str, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, "    {");
    list_push(mutref lines, concat5("      \"code\": ", json_quote(code), ",", "", ""));
    list_push(mutref lines, concat5("      \"message\": ", json_quote(message), "", "", ""));
    list_push(mutref lines, concat3("    }", suffix, ""));
    return;
}

fn append_change_report_json(lines: mutref list<str>, before_module: str, after_module: str, added_functions: ref list<str>, removed_functions: ref list<str>, changed_functions: ref list<str>, added_call_edges: ref list<str>, removed_call_edges: ref list<str>, added_propagates: ref list<str>, removed_propagates: ref list<str>, policy_provided: bool, policy_path: str, policy_targets: i32, policy_errors: i32, policy_malformed: bool, review_errors: i32) -> unit {
    let ok = review_errors == 0 and policy_errors == 0;
    let mut policy_evidence = "not-provided";
    if policy_provided {
        policy_evidence = "checked";
        if policy_malformed {
            policy_evidence = "invalid";
        }
    }
    list_push(mutref lines, "{");
    list_push(mutref lines, "  \"version\": 1,");
    list_push(mutref lines, "  \"command\": \"change-report\",");
    list_push(mutref lines, concat3("  \"ok\": ", bool_text(ok), ","));
    list_push(mutref lines, "  \"identity_scheme\": \"nauqtype.semantic.v1\",");
    list_push(mutref lines, concat3("  \"before\": { \"module\": ", json_quote(before_module), ", \"evidence\": \"checked\" },"));
    list_push(mutref lines, concat3("  \"after\": { \"module\": ", json_quote(after_module), ", \"evidence\": \"checked\" },"));
    list_push(mutref lines, "  \"evidence\": {");
    list_push(mutref lines, "    \"review\": \"checked\",");
    list_push(mutref lines, "    \"comparison\": \"semantic-identities\",");
    list_push(mutref lines, concat5("    \"policy\": ", json_quote(policy_evidence), ",", "", ""));
    list_push(mutref lines, "    \"propagation\": \"checked\"");
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"summary\": {");
    list_push(mutref lines, concat3("    \"added_functions\": ", i32_to_str(list_len(ref added_functions)), ","));
    list_push(mutref lines, concat3("    \"removed_functions\": ", i32_to_str(list_len(ref removed_functions)), ","));
    list_push(mutref lines, concat3("    \"changed_functions\": ", i32_to_str(list_len(ref changed_functions)), ","));
    list_push(mutref lines, concat3("    \"added_call_edges\": ", i32_to_str(list_len(ref added_call_edges)), ","));
    list_push(mutref lines, concat3("    \"removed_call_edges\": ", i32_to_str(list_len(ref removed_call_edges)), ","));
    list_push(mutref lines, concat3("    \"added_propagates\": ", i32_to_str(list_len(ref added_propagates)), ","));
    list_push(mutref lines, concat3("    \"removed_propagates\": ", i32_to_str(list_len(ref removed_propagates)), ","));
    list_push(mutref lines, concat3("    \"policy_targets\": ", i32_to_str(policy_targets), ","));
    list_push(mutref lines, concat3("    \"policy_errors\": ", i32_to_str(policy_errors), ","));
    list_push(mutref lines, concat3("    \"diagnostics\": ", i32_to_str(review_errors + policy_errors), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"changes\": {");
    append_named_string_array(mutref lines, "    ", "added_functions", ref added_functions, true);
    append_named_string_array(mutref lines, "    ", "removed_functions", ref removed_functions, true);
    append_named_string_array(mutref lines, "    ", "changed_functions", ref changed_functions, true);
    append_named_string_array(mutref lines, "    ", "added_call_edges", ref added_call_edges, true);
    append_named_string_array(mutref lines, "    ", "removed_call_edges", ref removed_call_edges, true);
    append_named_string_array(mutref lines, "    ", "added_propagates", ref added_propagates, true);
    append_named_string_array(mutref lines, "    ", "removed_propagates", ref removed_propagates, false);
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"policy\": {");
    list_push(mutref lines, concat3("    \"provided\": ", bool_text(policy_provided), ","));
    list_push(mutref lines, concat5("    \"path\": ", json_quote(policy_path), ",", "", ""));
    list_push(mutref lines, concat3("    \"targets\": ", i32_to_str(policy_targets), ","));
    list_push(mutref lines, concat3("    \"errors\": ", i32_to_str(policy_errors), ","));
    list_push(mutref lines, concat3("    \"malformed\": ", bool_text(policy_malformed), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"diagnostics\": [");
    if review_errors > 0 {
        append_change_report_diagnostic(mutref lines, "NQ-CHANGE-001", "review contract errors prevented a clean report", policy_errors > 0);
    }
    if policy_errors > 0 {
        append_change_report_diagnostic(mutref lines, "NQ-CHANGE-002", "policy metadata has validation errors", false);
    }
    list_push(mutref lines, "  ]");
    list_push(mutref lines, "}");
    return;
}

pub fn emit_change_report_load_error(before_module: str, after_module: str, message: str) -> i32
audit {
    intent("Emit deterministic change-report JSON when checked inputs cannot be loaded");
    mutates();
    effects(print);
}
{
    let mut lines: list<str> = list();
    list_push(mutref lines, "{");
    list_push(mutref lines, "  \"version\": 1,");
    list_push(mutref lines, "  \"command\": \"change-report\",");
    list_push(mutref lines, "  \"ok\": false,");
    list_push(mutref lines, "  \"identity_scheme\": \"nauqtype.semantic.v1\",");
    list_push(mutref lines, concat3("  \"before\": { \"module\": ", json_quote(before_module), ", \"evidence\": \"unavailable\" },"));
    list_push(mutref lines, concat3("  \"after\": { \"module\": ", json_quote(after_module), ", \"evidence\": \"unavailable\" },"));
    list_push(mutref lines, "  \"evidence\": { \"review\": \"unavailable\", \"comparison\": \"unavailable\", \"policy\": \"not-provided\", \"propagation\": \"unavailable\" },");
    list_push(mutref lines, "  \"summary\": { \"added_functions\": 0, \"removed_functions\": 0, \"changed_functions\": 0, \"added_call_edges\": 0, \"removed_call_edges\": 0, \"added_propagates\": 0, \"removed_propagates\": 0, \"policy_targets\": 0, \"policy_errors\": 0, \"diagnostics\": 1 },");
    list_push(mutref lines, "  \"changes\": { \"added_functions\": [], \"removed_functions\": [], \"changed_functions\": [], \"added_call_edges\": [], \"removed_call_edges\": [], \"added_propagates\": [], \"removed_propagates\": [] },");
    list_push(mutref lines, "  \"policy\": { \"provided\": false, \"path\": \"\", \"targets\": 0, \"errors\": 0, \"malformed\": false },");
    list_push(mutref lines, "  \"diagnostics\": [");
    append_change_report_diagnostic(mutref lines, "NQ-CHANGE-001", message, false);
    list_push(mutref lines, "  ]");
    list_push(mutref lines, "}");
    emit_lines(ref lines);
    return 1;
}

pub fn emit_change_report(before_module: str, before_functions: ref list<review_function_fact>, before_decls: ref list<review_decl_entry>, before_summary: review_summary, before_uses: ref list<module_use>, before_items: ref list<top_item>, before_function_facts: ref list<function_fact>, before_variants: ref list<variant_fact>, before_params: ref list<function_param_fact>, before_assignments: ref list<assignment_fact>, before_calls: ref list<call_fact>, before_locals: ref list<local_init_fact>, after_module: str, after_functions: ref list<review_function_fact>, after_decls: ref list<review_decl_entry>, after_summary: review_summary, after_uses: ref list<module_use>, after_items: ref list<top_item>, after_function_facts: ref list<function_fact>, after_variants: ref list<variant_fact>, after_params: ref list<function_param_fact>, after_assignments: ref list<assignment_fact>, after_calls: ref list<call_fact>, after_locals: ref list<local_init_fact>, policy_provided: bool, policy_path: str, policy_targets: i32, policy_errors: i32, policy_malformed: bool) -> review_summary
audit {
    intent("Emit deterministic supervised change-report JSON from two checked review inputs");
    mutates();
    effects(print);
}
{

    let review_errors = before_summary.error_count + after_summary.error_count;

    let mut added_functions: list<str> = list();
    let mut removed_functions: list<str> = list();
    let mut changed_functions: list<str> = list();
    let mut before_call_edges: list<str> = list();
    let mut after_call_edges: list<str> = list();
    let mut added_call_edges: list<str> = list();
    let mut removed_call_edges: list<str> = list();
    let mut before_propagates: list<str> = list();
    let mut after_propagates: list<str> = list();
    let mut added_propagates: list<str> = list();
    let mut removed_propagates: list<str> = list();
    if review_errors == 0 {
        collect_added_functions(ref before_functions, ref after_functions, mutref added_functions);
        collect_removed_functions(ref before_functions, ref after_functions, mutref removed_functions);
        collect_changed_functions(ref before_functions, ref before_decls, ref before_items, ref before_function_facts, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, ref before_uses, ref after_functions, ref after_decls, ref after_items, ref after_function_facts, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, ref after_uses, mutref changed_functions);
        collect_call_edges(ref before_functions, ref before_items, ref before_variants, ref before_calls, ref before_uses, mutref before_call_edges);
        collect_call_edges(ref after_functions, ref after_items, ref after_variants, ref after_calls, ref after_uses, mutref after_call_edges);
        collect_added_strings(ref before_call_edges, ref after_call_edges, mutref added_call_edges);
        collect_removed_strings(ref before_call_edges, ref after_call_edges, mutref removed_call_edges);
        collect_propagation_contracts(ref before_decls, mutref before_propagates);
        collect_propagation_contracts(ref after_decls, mutref after_propagates);
        collect_added_strings(ref before_propagates, ref after_propagates, mutref added_propagates);
        collect_removed_strings(ref before_propagates, ref after_propagates, mutref removed_propagates);
    }

    let mut lines: list<str> = list();
    append_change_report_json(mutref lines, before_module, after_module, ref added_functions, ref removed_functions, ref changed_functions, ref added_call_edges, ref removed_call_edges, ref added_propagates, ref removed_propagates, policy_provided, policy_path, policy_targets, policy_errors, policy_malformed, review_errors);
    emit_lines(ref lines);
    return make_review_summary(list_len(ref after_functions), list_len(ref after_decls), before_summary.warning_count + after_summary.warning_count, review_errors + policy_errors);
}

pub fn emit_review(entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, summary: review_summary, uses: ref list<module_use>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>) -> review_summary
audit {
    intent("Emit deterministic stage1 review JSON from selfhost facts and audit blocks");
    mutates();
    effects(print);
}
{

    if summary.error_count > 0 {
        return summary;
    }

    let mut lines: list<str> = list();
    append_review_json(mutref lines, entry_module, ref functions, ref decls, ref function_params, ref assignments, ref calls, ref uses);
    emit_lines(ref lines);
    return summary;
}

pub fn emit_review_v2(entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, summary: review_summary, uses: ref list<module_use>, items: ref list<top_item>, variants: ref list<variant_fact>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>) -> review_summary
audit {
    intent("Emit deterministic stage1 review v2 JSON with semantic identities and evidence fields");
    mutates();
    effects(print);
}
{

    if summary.error_count > 0 {
        return summary;
    }

    let mut lines: list<str> = list();
    let writes: list<review_direct_mutation> = list();
    let coverage: list<review_mutation_coverage> = list();
    append_review_v2_json(mutref lines, entry_module, ref functions, ref decls, ref function_facts, ref function_params, ref assignments, ref calls, ref uses, ref items, ref variants, ref locals, ref writes, ref coverage, 2);
    emit_lines(ref lines);
    return summary;
}

pub fn emit_review_v3(entry_module: str, functions: ref list<review_function_fact>, decls: ref list<review_decl_entry>, summary: review_summary, uses: ref list<module_use>, items: ref list<top_item>, variants: ref list<variant_fact>, function_facts: ref list<function_fact>, function_params: ref list<function_param_fact>, assignments: ref list<assignment_fact>, calls: ref list<call_fact>, locals: ref list<local_init_fact>, writes: ref list<review_direct_mutation>) -> review_summary
audit {
    intent("Emit review v3 with truthful audit provenance and partial checked direct-write evidence");
    mutates();
    effects(print);
}
{
    if summary.error_count > 0 {
        return summary;
    }
    let mut lines: list<str> = list();
    let coverage: list<review_mutation_coverage> = list();
    append_review_v2_json(mutref lines, entry_module, ref functions, ref decls, ref function_facts, ref function_params, ref assignments, ref calls, ref uses, ref items, ref variants, ref locals, ref writes, ref coverage, 3);
    emit_lines(ref lines);
    return summary;
}

pub fn emit_review_diff(before_module: str, before_functions: ref list<review_function_fact>, before_decls: ref list<review_decl_entry>, before_summary: review_summary, before_uses: ref list<module_use>, before_items: ref list<top_item>, before_function_facts: ref list<function_fact>, before_variants: ref list<variant_fact>, before_params: ref list<function_param_fact>, before_assignments: ref list<assignment_fact>, before_calls: ref list<call_fact>, before_locals: ref list<local_init_fact>, after_module: str, after_functions: ref list<review_function_fact>, after_decls: ref list<review_decl_entry>, after_summary: review_summary, after_uses: ref list<module_use>, after_items: ref list<top_item>, after_function_facts: ref list<function_fact>, after_variants: ref list<variant_fact>, after_params: ref list<function_param_fact>, after_assignments: ref list<assignment_fact>, after_calls: ref list<call_fact>, after_locals: ref list<local_init_fact>) -> review_summary
audit {
    intent("Emit deterministic semantic review diffs from two checked stage1 review inputs");
    mutates();
    effects(print);
}
{
    return emit_review_diff_format(before_module, ref before_functions, ref before_decls, before_summary, ref before_uses, ref before_items, ref before_function_facts, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, after_module, ref after_functions, ref after_decls, after_summary, ref after_uses, ref after_items, ref after_function_facts, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, false);
}

pub fn emit_review_diff_format(before_module: str, before_functions: ref list<review_function_fact>, before_decls: ref list<review_decl_entry>, before_summary: review_summary, before_uses: ref list<module_use>, before_items: ref list<top_item>, before_function_facts: ref list<function_fact>, before_variants: ref list<variant_fact>, before_params: ref list<function_param_fact>, before_assignments: ref list<assignment_fact>, before_calls: ref list<call_fact>, before_locals: ref list<local_init_fact>, after_module: str, after_functions: ref list<review_function_fact>, after_decls: ref list<review_decl_entry>, after_summary: review_summary, after_uses: ref list<module_use>, after_items: ref list<top_item>, after_function_facts: ref list<function_fact>, after_variants: ref list<variant_fact>, after_params: ref list<function_param_fact>, after_assignments: ref list<assignment_fact>, after_calls: ref list<call_fact>, after_locals: ref list<local_init_fact>, use_v2: bool) -> review_summary
audit {
    intent("Emit deterministic semantic review diffs with optional v2 evidence metadata");
    mutates();
    effects(print);
}
{


    if before_summary.error_count > 0 or after_summary.error_count > 0 {
        return make_review_summary(list_len(ref after_functions), list_len(ref after_decls), before_summary.warning_count + after_summary.warning_count, before_summary.error_count + after_summary.error_count);
    }

    let mut added_functions: list<str> = list();
    let mut removed_functions: list<str> = list();
    let mut changed_functions: list<str> = list();
    collect_added_functions(ref before_functions, ref after_functions, mutref added_functions);
    collect_removed_functions(ref before_functions, ref after_functions, mutref removed_functions);
    collect_changed_functions(ref before_functions, ref before_decls, ref before_items, ref before_function_facts, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, ref before_uses, ref after_functions, ref after_decls, ref after_items, ref after_function_facts, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, ref after_uses, mutref changed_functions);

    let mut before_call_edges: list<str> = list();
    let mut after_call_edges: list<str> = list();
    let mut added_call_edges: list<str> = list();
    let mut removed_call_edges: list<str> = list();
    collect_call_edges(ref before_functions, ref before_items, ref before_variants, ref before_calls, ref before_uses, mutref before_call_edges);
    collect_call_edges(ref after_functions, ref after_items, ref after_variants, ref after_calls, ref after_uses, mutref after_call_edges);
    collect_added_strings(ref before_call_edges, ref after_call_edges, mutref added_call_edges);
    collect_removed_strings(ref before_call_edges, ref after_call_edges, mutref removed_call_edges);

    let mut lines: list<str> = list();
    if use_v2 {
        append_review_diff_v2_json(mutref lines, before_module, after_module, ref added_functions, ref removed_functions, ref changed_functions, ref added_call_edges, ref removed_call_edges);
    } else {
        append_review_diff_json(mutref lines, before_module, after_module, ref added_functions, ref removed_functions, ref changed_functions, ref added_call_edges, ref removed_call_edges);
    }
    emit_lines(ref lines);
    return make_review_summary(list_len(ref after_functions), list_len(ref after_decls), before_summary.warning_count + after_summary.warning_count, 0);
}
