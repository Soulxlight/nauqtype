fn builtin_function_arity(name: str) -> i32 {
    if name == "print_line" or name == "eprint_line" or name == "read_file" or name == "arg_get" or name == "create_dir_all" or name == "io_err_text" {
        return 1;
    }
    if name == "write_file" {
        return 2;
    }
    if name == "run_process" {
        return 3;
    }
    if name == "arg_count" or name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_flush" or name == "stderr_flush" or name == "current_dir" {
        return 0;
    }
    if name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "env_get" or name == "read_file_bytes" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" {
        return 1;
    }
    if name == "io_err_kind" or name == "io_err_operation" or name == "io_err_path" or name == "io_err_other_path" or name == "io_err_os_code" or name == "str_from_bytes" {
        return 1;
    }
    if name == "write_file_bytes" or name == "path_metadata" or name == "rename_path" or name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" {
        return 2;
    }
    if name == "str_len" {
        return 1;
    }
    if name == "str_concat" {
        return 2;
    }
    if name == "str_get" or name == "str_slice" {
        if name == "str_get" {
            return 2;
        }
        return 3;
    }
    if name == "bytes_from_str" or name == "bytes_len" {
        return 1;
    }
    if name == "bytes_get" {
        return 2;
    }
    if name == "list" {
        return 0;
    }
    if name == "list_push" or name == "list_get" {
        return 2;
    }
    if name == "list_len" {
        return 1;
    }
    return -1;
}

fn builtin_variant_arity(name: str) -> i32 {
    if name == "Some" or name == "Ok" or name == "Err" {
        return 1;
    }
    if name == "None" {
        return 0;
    }
    return -1;
}

fn lookup_function_fact_arity(functions: ref list<function_fact>, module: str, name: str) -> i32 {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    return value.param_count;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return -1;
}

fn lookup_variant_fact_arity(variants: ref list<variant_fact>, module: str, name: str) -> i32 {
    let mut index = 0;
    while index < list_len(ref variants) {
        let entry = list_get(ref variants, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    return value.payload_count;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return -1;
}

fn visible_function_arity(functions: ref list<function_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> i32 {
    let builtin = builtin_function_arity(name);
    if builtin >= 0 {
        return builtin;
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_function);
    if origin != "" {
        return lookup_function_fact_arity(ref functions, origin, name);
    }
    return -1;
}

fn visible_variant_arity(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> i32 {
    let builtin = builtin_variant_arity(name);
    if builtin >= 0 {
        return builtin;
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_variant);
    if origin != "" {
        return lookup_variant_fact_arity(ref variants, origin, name);
    }
    return -1;
}

fn find_entry_main(functions: ref list<function_fact>, entry_module: str) -> option<function_fact> {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if value.module == entry_module and value.name == "main" {
                    return Some(value);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return None;
}

pub fn typecheck_modules_for_entry(functions: ref list<function_fact>, variants: ref list<variant_fact>, calls: ref list<call_fact>, patterns: ref list<pattern_ctor_fact>, uses: ref list<module_use>, items: ref list<top_item>, entry_module: str, require_entry: bool, diags: mutref list<diag>) -> typecheck_summary
audit {
    intent("Run the first selfhost type-checker slice over function signatures, calls, and constructor arity");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);

    if require_entry {
        let entry = find_entry_main(ref functions, entry_module);
        match entry {
            Some(main_fn) => {
                if main_fn.param_count != 0 or main_fn.return_name != "i32" or main_fn.return_is_borrow {
                    push_diag(mutref diags, main_fn.module, main_fn.at, "`main` must take no parameters and return plain `i32`");
                }
            },
            None => {
                push_diag(mutref diags, entry_module, 0, "missing `main` entry point");
            },
        }
    }

    let mut call_index = 0;
    while call_index < list_len(ref calls) {
        let entry = list_get(ref calls, call_index);
        match entry {
            Some(current) => {
                let fn_arity = visible_function_arity(ref functions, ref uses, ref items, current.module, current.name);
                if fn_arity >= 0 {
                    if fn_arity != current.arg_count {
                        push_diag(mutref diags, current.module, current.at, "call argument count does not match target signature");
                    }
                } else {
                    let variant_arity = visible_variant_arity(ref variants, ref uses, ref items, current.module, current.name);
                    if variant_arity >= 0 and variant_arity != current.arg_count {
                        push_diag(mutref diags, current.module, current.at, "constructor call argument count does not match payload count");
                    }
                }
            },
            None => {
            },
        }
        call_index = call_index + 1;
    }

    let mut pattern_index = 0;
    while pattern_index < list_len(ref patterns) {
        let entry = list_get(ref patterns, pattern_index);
        match entry {
            Some(current) => {
                let variant_arity = visible_variant_arity(ref variants, ref uses, ref items, current.module, current.name);
                if variant_arity >= 0 and variant_arity != current.arg_count {
                    push_diag(mutref diags, current.module, current.at, "pattern constructor argument count does not match payload count");
                }
            },
            None => {
            },
        }
        pattern_index = pattern_index + 1;
    }

    return make_typecheck_summary(
        list_len(ref functions),
        list_len(ref calls),
        list_len(ref patterns),
        list_len(ref diags) - start_diag_count
    );
}

pub fn typecheck_modules(functions: ref list<function_fact>, variants: ref list<variant_fact>, calls: ref list<call_fact>, patterns: ref list<pattern_ctor_fact>, uses: ref list<module_use>, items: ref list<top_item>, diags: mutref list<diag>) -> typecheck_summary
audit {
    intent("Run the first selfhost type-checker slice over function signatures, calls, and constructor arity");
    mutates(diags);
    effects();
}
{
    return typecheck_modules_for_entry(ref functions, ref variants, ref calls, ref patterns, ref uses, ref items, "main", true, mutref diags);
}

fn builtin_function_return_name(name: str) -> str {
    if name == "print_line" {
        return "unit";
    }
    if name == "eprint_line" {
        return "unit";
    }
    if name == "read_file" {
        return "result";
    }
    if name == "write_file" {
        return "result";
    }
    if name == "arg_count" {
        return "i32";
    }
    if name == "arg_get" {
        return "option";
    }
    if name == "create_dir_all" {
        return "result";
    }
    if name == "run_process" {
        return "result";
    }
    if name == "io_err_text" {
        return "str";
    }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "stdout_flush" or name == "stderr_flush" {
        return "result";
    }
    if name == "env_get" or name == "current_dir" or name == "read_file_bytes" or name == "write_file_bytes" or name == "path_metadata" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" or name == "rename_path" or name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" {
        return "result";
    }
    if name == "io_err_kind" or name == "io_err_operation" or name == "str_from_bytes" {
        return "str";
    }
    if name == "io_err_path" or name == "io_err_other_path" {
        return "option";
    }
    if name == "io_err_os_code" {
        return "i32";
    }
    if name == "str_len" {
        return "i32";
    }
    if name == "str_concat" {
        return "str";
    }
    if name == "str_get" or name == "str_slice" {
        return "option";
    }
    if name == "bytes_from_str" {
        return "bytes";
    }
    if name == "bytes_len" {
        return "i64";
    }
    if name == "bytes_get" {
        return "option";
    }
    if name == "list" {
        return "list";
    }
    if name == "list_push" {
        return "unit";
    }
    if name == "list_len" {
        return "i32";
    }
    if name == "list_get" {
        return "option";
    }
    return "";
}

