            return "index";
        }
    }
    if function_name == "list_push" {
        if index == 0 {
            return "items";
        }
        if index == 1 {
            return "value";
        }
    }
    if function_name == "list_len" {
        if index == 0 {
            return "items";
        }
    }
    if function_name == "list_get" {
        if index == 0 {
            return "items";
        }
        if index == 1 {
            return "index";
        }
    }
    return "";
}

fn lookup_function_param_name(function_params: ref list<function_param_fact>, module: str, function_name: str, index: i32) -> str {
    let mut cursor = 0;
    while cursor < list_len(ref function_params) {
        let entry = list_get(ref function_params, cursor);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.index == index {
                    return value.name;
                }
            },
            None => {
            },
        }
        cursor = cursor + 1;
    }
    return "";
}

fn visible_function_param_name(function_params: ref list<function_param_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, index: i32) -> str {
