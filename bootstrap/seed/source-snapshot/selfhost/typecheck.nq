                if value.module == module and value.function_name == function_name and value.name == name and value.at < at {
                    match value.kind {
                        stmt_local => {
                            if value.is_mutable and scope_is_visible(ref scopes, module, function_name, scope_id, value.scope_id) {
                                return true;
                            }
