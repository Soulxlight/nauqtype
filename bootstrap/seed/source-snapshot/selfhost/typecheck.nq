fn diagnostic_identity_matches(left: diag, right: diag) -> bool {
    return left.code == right.code
        and diag_category_matches(left.category, right.category)
        and diag_severity_matches(left.severity, right.severity)
        and left.source_name == right.source_name
        and left.start == right.start
        and left.end == right.end
        and left.message == right.message
        and left.note == right.note
        and left.help == right.help;
}

fn push_diagnostic_once(diags: mutref list<diag>, entry: diag) -> unit {
    let mut index = 0;
    while index < list_len(ref diags) {
        let current = list_get(ref diags, index);
        match current {
            Some(value) => {
                if diagnostic_identity_matches(value, entry) {
                    return;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref diags, entry);
    return;
}

fn push_token_error_with_help(diags: mutref list<diag>, file: str, tok: token, code: str, message: str, help: str) -> unit {
    push_diagnostic_once(mutref diags, make_diagnostic(code, diag_type, diag_error, file, tok.start, tok.end, message, "", help));
    return;
}

fn push_list_get_noncopy_diag(diags: mutref list<diag>, file: str, tok: token) -> unit {
    push_token_error_with_help(mutref diags, file, tok, "NQ-TYPE-044", "list_get requires a copy element type", "Keep the element in the list or use a copy element type; borrowing or moving a non-copy list element is not supported yet.");
    return;
}

pub fn typecheck_diagnostic_identity_self_test() -> bool
audit {
    intent("Self-test typecheck diagnostic producer identity without using rendered output");
    mutates();
    effects();
}
{
    let mut diags: list<diag> = list();
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 18, "base", "", ""));
    if list_len(ref diags) != 1 {
        return false;
    }

    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-043", diag_type, diag_error, "probe", 10, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_try, diag_error, "probe", 10, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_warning, "probe", 10, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "other", 10, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 11, 18, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 19, "base", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 18, "message", "", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 18, "base", "note", ""));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-042", diag_type, diag_error, "probe", 10, 18, "base", "", "help"));
    if list_len(ref diags) != 10 {
        return false;
    }

    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-044", diag_type, diag_error, "probe", 10, 18, "list_get requires a copy element type", "", "Keep the element in the list or use a copy element type; borrowing or moving a non-copy list element is not supported yet."));
    push_diagnostic_once(mutref diags, make_diagnostic("NQ-TYPE-044", diag_type, diag_error, "probe", 10, 18, "list_get requires a copy element type", "", "Keep the element in the list or use a copy element type; borrowing or moving a non-copy list element is not supported yet."));
    if list_len(ref diags) != 11 {
        return false;
    }
    match list_get(ref diags, 10) {
        Some(value) => {
            return value.code == "NQ-TYPE-044"
                and value.start == 10
                and value.end == 18
                and value.help == "Keep the element in the list or use a copy element type; borrowing or moving a non-copy list element is not supported yet.";
        },
        None => {
            return false;
        },
    }
}

fn is_function_item(item: top_item) -> bool {
    match item.kind {
        item_fn => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn is_variant_item(item: top_item) -> bool {
    match item.kind {
        item_variant => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn is_const_item(item: top_item) -> bool {
    match item.kind {
        item_const => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn is_type_item(item: top_item) -> bool {
    match item.kind {
        item_type => {
            return true;
        },
        item_enum => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

enum visible_item_kind {
    visible_item_function,
    visible_item_variant,
    visible_item_const,
    visible_item_type,
}

fn item_matches_visible_kind(item: top_item, kind: visible_item_kind) -> bool {
    match kind {
        visible_item_function => {
            return is_function_item(item);
        },
        visible_item_variant => {
            return is_variant_item(item);
        },
        visible_item_const => {
            return is_const_item(item);
        },
        visible_item_type => {
            return is_type_item(item);
        },
    }
}

fn visible_item_origin(uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str, kind: visible_item_kind) -> str {
    let mut has_local = false;
    let mut exported_modules: list<str> = list();
    let mut item_index = 0;
    while item_index < list_len(ref items) {
        let entry = list_get(ref items, item_index);
        match entry {
            Some(value) => {
                if value.name == name and item_matches_visible_kind(value, kind) {
                    if value.module == module {
                        has_local = true;
                    }
                    if value.is_public {
                        list_push(mutref exported_modules, value.module);
                    }
                }
            },
            None => {
            },
        }
        item_index = item_index + 1;
    }
    if has_local {
        return module;
    }
    let mut use_index = 0;
    while use_index < list_len(ref uses) {
        let entry = list_get(ref uses, use_index);
        match entry {
            Some(value) => {
                if value.module == module and list_contains_str(ref exported_modules, value.name) {
                    return value.name;
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }
    return "";
}

fn module_has_local_function_name(items: ref list<top_item>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name and is_function_item(value) {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

