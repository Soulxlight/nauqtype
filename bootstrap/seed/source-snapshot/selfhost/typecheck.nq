fn parent_scope_id(scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32) -> i32 {
    let mut index = list_len(ref scopes) - 1;
    while index >= 0 {
        let entry = list_get(ref scopes, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.scope_id == scope_id {
                    return value.parent_scope_id;
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return -1;
}

fn typed_binding_type_in_scope(typed_bindings: ref list<typed_binding_fact>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> str {
    let mut index = list_len(ref typed_bindings) - 1;
    while index >= 0 {
        let entry = list_get(ref typed_bindings, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.scope_id == scope_id and value.name == name and value.at < at {
                    return value.type_name;
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return "";
}

fn typed_binding_ctx_in_scope(typed_bindings: ref list<typed_binding_fact>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> expected_type_ctx {
