fn visible_typed_binding_is_mutable_capable(typed_bindings: ref list<typed_binding_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> bool {
    let mut index = list_len(ref typed_bindings) - 1;
    while index >= 0 {
        let entry = list_get(ref typed_bindings, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.name == name and value.at < at {
                    if scope_is_visible(ref scopes, module, function_name, scope_id, value.scope_id) {
                        return value.is_mutable or (value.is_borrow and value.borrow_mutable);
                    }
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return false;
}

fn visible_mutable_local_stmt(statements: ref list<stmt_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> bool {
    let mut index = list_len(ref statements) - 1;
    while index >= 0 {
        let entry = list_get(ref statements, index);
        match entry {
