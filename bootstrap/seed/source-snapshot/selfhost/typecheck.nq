    return make_expected_type_ctx(builtin, "", "");
}

fn visible_function_param_type_name(function_params: ref list<function_param_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, index: i32) -> str {
    let builtin = builtin_function_param_type_name(function_name, index);
    if builtin != "" {
        return builtin;
    }
    let origin = visible_item_origin(ref uses, ref items, module, function_name, visible_item_function);
    if origin != "" {
        return lookup_function_param_type_name(ref function_params, origin, function_name, index);
    }
    return "";
}

pub fn visible_function_param_ctx(function_params: ref list<function_param_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, index: i32) -> expected_type_ctx
audit {
