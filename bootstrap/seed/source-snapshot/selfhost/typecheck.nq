        index = index - 1;
    }
    return empty_expected_type_ctx();
}

fn scope_is_visible(scopes: ref list<body_scope>, module: str, function_name: str, current_scope_id: i32, candidate_scope_id: i32) -> bool {
    let mut scope_cursor = current_scope_id;
    while scope_cursor >= 0 {
        if scope_cursor == candidate_scope_id {
            return true;
        }
        scope_cursor = parent_scope_id(ref scopes, module, function_name, scope_cursor);
    }
    return false;
}

fn visible_typed_binding_type(typed_bindings: ref list<typed_binding_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> str {
    let mut index = list_len(ref typed_bindings) - 1;
    while index >= 0 {
        let entry = list_get(ref typed_bindings, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.name == name and value.at < at {
                    if scope_is_visible(ref scopes, module, function_name, scope_id, value.scope_id) {
                        return value.type_name;
                    }
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return "";
}

fn visible_typed_binding_ctx(typed_bindings: ref list<typed_binding_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> expected_type_ctx {
