        let entry = list_get(ref uses, use_index);
        match entry {
            Some(value) => {
                if value.module == module {
                    if value.name == qualifier or value.alias == qualifier {
                        return value.name;
                    }
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }
    return "";
}

