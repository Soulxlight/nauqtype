fn clone_for_statements_for_function(source: ref list<stmt_fact>, module: str, function_name: str) -> list<stmt_fact> {
    let mut copied: list<stmt_fact> = list();
    let mut wanted_count = 0;
    let mut count_index = 0;
    while count_index < list_len(ref source) {
        let entry = list_get(ref source, count_index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    match value.kind {
                        stmt_for => {
                            wanted_count = wanted_count + 1;
                        },
                        _ => {
                        },
                    }
                }
            },
            None => {
            },
        }
        count_index = count_index + 1;
    }

    let mut last_at = -1;
    while list_len(ref copied) < wanted_count and last_at < 2147483647 {
        let mut best_index = -1;
        let mut best_at = 2147483647;
        let mut index = 0;
        while index < list_len(ref source) {
            let entry = list_get(ref source, index);
            match entry {
                Some(value) => {
                    if value.module == module and value.function_name == function_name and value.at > last_at and value.at < best_at {
                        match value.kind {
                            stmt_for => {
                                best_index = index;
                                best_at = value.at;
                            },
                            _ => {
                            },
                        }
                    }
                },
                None => {
                },
            }
            index = index + 1;
        }
        let best_entry = list_get(ref source, best_index);
        match best_entry {
            Some(value) => {
                list_push(mutref copied, value);
                last_at = value.at;
            },
            None => {
                last_at = 2147483647;
            },
        }
    }
    return copied;
}

fn type_names_match(expected: str, actual: str) -> bool {
    if expected == actual {
        return true;
    }
    if expected == "int" and actual == "i32" {
        return true;
    }
    if expected == "i32" and actual == "int" {
        return true;
    }
    return false;
}

fn type_ctx_arg_matches(expected: str, actual: str) -> bool {
    if expected == "" or actual == "" {
        return true;
    }
    return type_names_match(expected, actual);
}

fn type_ctx_matches(expected: expected_type_ctx, actual: expected_type_ctx) -> bool {
    if expected.head == "" or actual.head == "" {
        return false;
    }
    if not type_names_match(expected.head, actual.head) {
        return false;
    }
    if expected.head == "option" or expected.head == "list" {
        if not type_ctx_arg_matches(expected.arg1_name, actual.arg1_name) {
            return false;
        }
        return true;
    }
    if expected.head == "result" {
        if not type_ctx_arg_matches(expected.arg1_name, actual.arg1_name) {
            return false;
        }
        if not type_ctx_arg_matches(expected.arg2_name, actual.arg2_name) {
            return false;
        }
    }
    return true;
}

