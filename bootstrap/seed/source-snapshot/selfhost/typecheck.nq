fn span_call_open_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let head = token_at(ref tokens, start);
    match head.kind {
        tk_ident => {
        },
        _ => {
            return -1;
        },
    }
    if end - start >= 3 {
        let open = token_at(ref tokens, start + 1);
        match open.kind {
            tk_lparen => {
                return start + 1;
            },
            _ => {
            },
        }
    }
    let mut cursor = start + 1;
    let mut saw_qualifier = false;
    while cursor + 2 < end {
        let first_colon = token_at(ref tokens, cursor);
        let second_colon = token_at(ref tokens, cursor + 1);
        let segment = token_at(ref tokens, cursor + 2);
        if not is_colon_token(first_colon) or not is_colon_token(second_colon) or not is_ident_token(segment) {
            return -1;
        }
        saw_qualifier = true;
        cursor = cursor + 3;
        let open = token_at(ref tokens, cursor);
        match open.kind {
            tk_lparen => { return cursor; },
            _ => { },
        }
    }
    return -1;
}

fn span_call_name_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let open_index = span_call_open_index(ref tokens, start, end);
    if open_index > start + 1 {
        return open_index - 1;
    }
    if open_index == start + 1 {
        return start;
    }
    return -1;
}

fn span_call_qualifier(tokens: ref list<token>, start: i32, end: i32) -> str {
    let open_index = span_call_open_index(ref tokens, start, end);
    if open_index > start + 1 {
        let mut qualifier = token_at(ref tokens, start).text;
        let mut cursor = start + 3;
        while cursor < open_index - 1 {
            let segment = token_at(ref tokens, cursor);
            qualifier = str_concat(str_concat(qualifier, "::"), segment.text);
            cursor = cursor + 3;
        }
        return qualifier;
    }
    return "";
}

fn is_ident_token(value: token) -> bool {
    match value.kind {
        tk_ident => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn is_colon_token(value: token) -> bool {
    match value.kind {
        tk_colon => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn is_lbrace_token(value: token) -> bool {
    match value.kind {
        tk_lbrace => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn span_is_qualified_data_name(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if start + 4 != end {
        return false;
    }
    let module_token = token_at(ref tokens, start);
    let first_colon = token_at(ref tokens, start + 1);
    let second_colon = token_at(ref tokens, start + 2);
    let name = token_at(ref tokens, start + 3);
    if is_ident_token(module_token) and is_colon_token(first_colon) and is_colon_token(second_colon) and is_ident_token(name) {
        return true;
    }
    return false;
}

fn span_data_name_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let call_name = span_call_name_index(ref tokens, start, end);
    if call_name >= 0 {
        return call_name;
    }
    if span_is_qualified_data_name(ref tokens, start, end) {
        return start + 3;
    }
    return start;
}

fn span_data_qualifier(tokens: ref list<token>, start: i32, end: i32) -> str {
    let call_qualifier = span_call_qualifier(ref tokens, start, end);
    if call_qualifier != "" {
        return call_qualifier;
    }
    if span_is_qualified_data_name(ref tokens, start, end) {
        let module_token = token_at(ref tokens, start);
        return module_token.text;
    }
    return "";
}

fn span_is_call_expr(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if end - start < 3 {
        return false;
    }
    let open_index = span_call_open_index(ref tokens, start, end);
    if open_index < 0 {
        return false;
    }
    let open = token_at(ref tokens, open_index);
    match open.kind {
        tk_lparen => {
        },
        _ => {
            return false;
        },
    }
    let mut depth = 0;
    let mut index = open_index;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                depth = depth - 1;
                if depth == 0 {
                    return index + 1 == end;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn span_struct_open_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let head = token_at(ref tokens, start);
    match head.kind {
        tk_ident => {
        },
        _ => {
            return -1;
        },
    }
    if end - start >= 3 {
        let open = token_at(ref tokens, start + 1);
        match open.kind {
            tk_lbrace => {
                return start + 1;
            },
            _ => {
            },
        }
    }
    let mut cursor = start + 1;
    while cursor + 2 < end {
        let first_colon = token_at(ref tokens, cursor);
        let second_colon = token_at(ref tokens, cursor + 1);
        let segment = token_at(ref tokens, cursor + 2);
        if not is_colon_token(first_colon) or not is_colon_token(second_colon) or not is_ident_token(segment) { return -1; }
        cursor = cursor + 3;
        let open = token_at(ref tokens, cursor);
        if is_lbrace_token(open) { return cursor; }
    }
    return -1;
}

fn span_struct_name_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let open_index = span_struct_open_index(ref tokens, start, end);
    if open_index > start + 1 {
        return open_index - 1;
    }
    if open_index == start + 1 {
        return start;
    }
    return -1;
}

fn span_struct_qualifier(tokens: ref list<token>, start: i32, end: i32) -> str {
    let open_index = span_struct_open_index(ref tokens, start, end);
    if open_index > start + 1 {
        let mut qualifier = token_at(ref tokens, start).text;
        let mut cursor = start + 3;
        while cursor < open_index - 1 {
            let segment = token_at(ref tokens, cursor);
            qualifier = str_concat(str_concat(qualifier, "::"), segment.text);
            cursor = cursor + 3;
        }
        return qualifier;
    }
    return "";
}

fn span_is_struct_expr(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let open_index = span_struct_open_index(ref tokens, start, end);
    if open_index < 0 {
        return false;
    }
    let mut depth = 0;
    let mut index = open_index;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lbrace => {
                depth = depth + 1;
            },
            tk_rbrace => {
                depth = depth - 1;
                if depth == 0 {
                    return index + 1 == end;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn segment_label_colon(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    if start + 2 > end {
        return -1;
    }
    let label = token_at(ref tokens, start);
    let colon = token_at(ref tokens, start + 1);
    let maybe_second_colon = token_at(ref tokens, start + 2);
    match label.kind {
        tk_ident => {
            match colon.kind {
                tk_colon => {
                    match maybe_second_colon.kind {
                        tk_colon => {
                            return -1;
                        },
                        _ => {
                        },
                    }
                    return start + 1;
                },
                _ => {
                },
            }
        },
        _ => {
        },
    }
    return -1;
}

fn segment_label_name(tokens: ref list<token>, start: i32, end: i32) -> str {
    if segment_label_colon(ref tokens, start, end) >= 0 {
        let label = token_at(ref tokens, start);
        return label.text;
    }
    return "";
}

fn segment_value_start(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let colon = segment_label_colon(ref tokens, start, end);
    if colon >= 0 {
        return colon + 1;
    }
    return start;
}

fn segment_is_record_update_base(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if start + 1 >= end {
        return false;
    }
    if find_top_level_colon(ref tokens, start, end) >= 0 {
        return false;
    }
    let head = token_at(ref tokens, start);
    match head.kind {
        tk_ident => {
            return head.text == "from";
        },
        _ => {
        },
    }
    return false;
}

fn record_update_base_is_simple_name(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if start + 1 != end {
        return false;
    }
    let value = token_at(ref tokens, start);
    match value.kind {
        tk_ident => {
            return true;
        },
        _ => {
        },
    }
    return false;
}

fn call_args_are_named(tokens: ref list<token>, arg_start: i32, arg_end_limit: i32) -> bool {
    if arg_start >= arg_end_limit {
        return false;
    }
    let first_end = next_top_level_comma(ref tokens, arg_start, arg_end_limit);
    return segment_label_colon(ref tokens, arg_start, first_end) >= 0;
}

fn find_named_arg_segment_start(tokens: ref list<token>, arg_start: i32, arg_end_limit: i32, label: str) -> i32 {
    let mut current_start = arg_start;
    while current_start < arg_end_limit {
        let segment_end = next_top_level_comma(ref tokens, current_start, arg_end_limit);
        if segment_label_name(ref tokens, current_start, segment_end) == label {
            return current_start;
        }
        current_start = segment_end + 1;
    }
    return -1;
}

fn named_arg_label_seen_before(tokens: ref list<token>, arg_start: i32, segment_start: i32, label: str) -> bool {
    let mut current_start = arg_start;
    while current_start < segment_start {
        let segment_end = next_top_level_comma(ref tokens, current_start, segment_start);
        if segment_label_name(ref tokens, current_start, segment_end) == label {
            return true;
        }
        current_start = segment_end + 1;
    }
    return false;
}

fn span_is_list_expr(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if end - start < 2 {
        return false;
    }
    let first = token_at(ref tokens, start);
    match first.kind {
        tk_lbracket => {
        },
        _ => {
            return false;
        },
    }
    let mut paren_depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                paren_depth = paren_depth + 1;
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
                if paren_depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    return index + 1 == end;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn next_top_level_comma(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                if depth > 0 {
                    depth = depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_comma => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    return index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return end;
}

fn find_top_level_colon(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                if depth > 0 {
                    depth = depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_colon => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    return index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return -1;
}

fn count_expected_fields(field_facts: ref list<field_fact>, module: str, type_name: str) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref field_facts) {
        let entry = list_get(ref field_facts, index);
        match entry {
            Some(value) => {
                if value.module == module and value.type_name == type_name {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn struct_literal_has_field(tokens: ref list<token>, start: i32, end: i32, field_name: str) -> bool {
    let open_index = span_struct_open_index(ref tokens, start, end);
    if open_index < 0 {
        return false;
    }
    let mut field_start = open_index + 1;
    let field_end_limit = end - 1;
    while field_start < field_end_limit {
        let segment_end = next_top_level_comma(ref tokens, field_start, field_end_limit);
        let colon_index = find_top_level_colon(ref tokens, field_start, segment_end);
        if colon_index >= 0 {
            let field_token = token_at(ref tokens, field_start);
            match field_token.kind {
                tk_ident => {
                    if field_token.text == field_name {
                        return true;
                    }
                },
                _ => {
                },
            }
        }
        field_start = segment_end + 1;
    }
    return false;
}

fn push_stage1_limitation(diags: mutref list<diag>, file: str, at: i32) -> unit {
    push_diag(mutref diags, file, at, "stage1 limitation: unsupported expression shape in recursive type checker");
    return;
}

fn builtin_variant_return_ctx(call_name: str, expected_ctx: expected_type_ctx) -> expected_type_ctx {
    let enum_name = builtin_variant_enum_name(call_name);
    if enum_name == "" {
        return empty_expected_type_ctx();
    }
    if expected_ctx.head != "" and type_names_match(enum_name, expected_ctx.head) {
        return expected_ctx;
    }
    return make_expected_type_ctx(enum_name, "", "");
}

fn builtin_variant_payload_ctx(call_name: str, return_ctx: expected_type_ctx, index: i32) -> expected_type_ctx {
    if index != 0 {
        return empty_expected_type_ctx();
    }
    if call_name == "Some" {
        return expected_type_ctx_from_text(return_ctx.arg1_name);
    }
    if call_name == "Ok" {
        return expected_type_ctx_from_text(return_ctx.arg1_name);
    }
    if call_name == "Err" {
        return expected_type_ctx_from_text(return_ctx.arg2_name);
    }
    return empty_expected_type_ctx();
}

fn call_param_is_borrow(function_params: ref list<function_param_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, qualifier: str, function_name: str, index: i32) -> bool {
    if qualifier != "" {
        return qualified_function_param_is_borrow(ref function_params, ref uses, ref items, module, qualifier, function_name, index);
    }
    return visible_function_param_is_borrow(ref function_params, ref uses, ref items, module, function_name, index);
}

fn call_param_borrow_mutable(function_params: ref list<function_param_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, qualifier: str, function_name: str, index: i32) -> bool {
    if qualifier != "" {
        return qualified_function_param_borrow_mutable(ref function_params, ref uses, ref items, module, qualifier, function_name, index);
    }
    return visible_function_param_borrow_mutable(ref function_params, ref uses, ref items, module, function_name, index);
}

fn borrow_argument_has_place_shape(tokens: ref list<token>, start: i32, end: i32, fields: bool) -> bool {
    let mut target_start = start;
    let mut target_end = end;
    while span_is_wrapped_in_parens(ref tokens, target_start, target_end) {
        target_start = target_start + 1;
        target_end = target_end - 1;
    }
    if target_start >= target_end { return false; }
    match token_at(ref tokens, target_start).kind { tk_ident => {}, _ => { return false; }, }
    let mut index = target_start + 1;
    while index < target_end {
        if not fields or index + 1 >= target_end { return false; }
        match token_at(ref tokens, index).kind { tk_dot => {}, _ => { return false; }, }
        match token_at(ref tokens, index + 1).kind { tk_ident => {}, _ => { return false; }, }
        index = index + 2;
    }
    return true;
}

fn call_argument_supplies_borrow(scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return false;
    }
    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_ref => {
            return borrow_argument_has_place_shape(ref tokens, expr_start + 1, expr_end, true);
        },
        tk_kw_mutref => {
            if expr_start + 2 != expr_end { return false; }
            match token_at(ref tokens, expr_start + 1).kind { tk_ident => { return true; }, _ => { return false; }, }
        },
        tk_ident => {
            if expr_start + 1 == expr_end {
                return visible_typed_binding_is_borrow(ref typed_bindings, ref scopes, module, function_name, scope_id, current.text, current.start);
            }
        },
        _ => {
        },
    }
    return false;
}

fn call_argument_is_explicit_borrow(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return false;
    }
    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_ref => { return true; },
        tk_kw_mutref => { return true; },
        _ => {
        },
    }
    return false;
}

fn call_argument_is_explicit_mutref(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return false;
    }
    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_mutref => { return true; },
        _ => {
        },
    }
    return false;
}

fn call_argument_mutref_target_name(tokens: ref list<token>, start: i32, end: i32) -> str {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start + 2 != expr_end {
        return "";
    }
    let prefix = token_at(ref tokens, expr_start);
    match prefix.kind {
        tk_kw_mutref => {
        },
        _ => { return ""; },
    }
    let target = token_at(ref tokens, expr_start + 1);
    match target.kind {
        tk_ident => { return target.text; },
        _ => {
        },
    }
    return "";
}

fn call_argument_mutref_target_is_mutable_capable(scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32) -> bool {
    let name = call_argument_mutref_target_name(ref tokens, start, end);
    if name == "" {
        return false;
    }
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    let target = token_at(ref tokens, expr_start + 1);
    return visible_typed_binding_is_mutable_capable(ref typed_bindings, ref scopes, module, function_name, scope_id, name, target.start);
}

fn call_argument_supplies_mutable_borrow(scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return false;
    }
    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_mutref => {
            return call_argument_mutref_target_is_mutable_capable(ref scopes, ref typed_bindings, module, function_name, scope_id, ref tokens, start, end);
        },
        tk_ident => {
            if expr_start + 1 == expr_end {
                return visible_typed_binding_borrow_mutable(ref typed_bindings, ref scopes, module, function_name, scope_id, current.text, current.start);
            }
        },
        _ => {
        },
    }
    return false;
}

fn validate_call_argument_borrow(function_params: ref list<function_param_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, qualifier: str, call_name: str, arg_index: i32, tokens: ref list<token>, start: i32, end: i32, diags: mutref list<diag>) -> unit {
    let expects_borrow = call_param_is_borrow(ref function_params, ref uses, ref items, module, qualifier, call_name, arg_index);
    if call_argument_is_explicit_borrow(ref tokens, start, end) and not call_argument_supplies_borrow(ref scopes, ref typed_bindings, module, function_name, scope_id, ref tokens, start, end) {
        push_diag(mutref diags, module, token_at(ref tokens, start).start, "borrow expression must name a binding or field path");
        return;
    }
    if call_argument_is_explicit_mutref(ref tokens, start, end) and not call_argument_mutref_target_is_mutable_capable(ref scopes, ref typed_bindings, module, function_name, scope_id, ref tokens, start, end) {
        let at = token_at(ref tokens, start).start;
        let name = call_argument_mutref_target_name(ref tokens, start, end);
        push_error(mutref diags, module, at, "NQ-TYPE-012", diag_type, str_concat("cannot take `mutref` of immutable binding `", str_concat(name, "`")));
        return;
    }
    if not expects_borrow and call_argument_is_explicit_borrow(ref tokens, start, end) {
        let at = token_at(ref tokens, start).start;
        push_diag(mutref diags, module, at, "borrow expression does not match owned call argument type");
        return;
    }
    if expects_borrow and not call_argument_supplies_borrow(ref scopes, ref typed_bindings, module, function_name, scope_id, ref tokens, start, end) {
        let at = token_at(ref tokens, start).start;
        push_diag(mutref diags, module, at, "borrow parameter requires explicit `ref` or an existing borrowed binding");
        return;
    }
    if expects_borrow and call_param_borrow_mutable(ref function_params, ref uses, ref items, module, qualifier, call_name, arg_index) and not call_argument_supplies_mutable_borrow(ref scopes, ref typed_bindings, module, function_name, scope_id, ref tokens, start, end) {
        let at = token_at(ref tokens, start).start;
        push_diag(mutref diags, module, at, "mutable borrow parameter requires explicit `mutref` or an existing mutable borrowed binding");
    }
}

fn infer_call_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> expected_type_ctx {
    let name_index = span_call_name_index(ref tokens, start, end);
    let open_index = span_call_open_index(ref tokens, start, end);
    let head = token_at(ref tokens, name_index);
    let call_name = head.text;
    let qualifier = span_call_qualifier(ref tokens, start, end);
    let mut function_return_ctx = visible_function_return_ctx(ref functions, ref uses, ref items, module, call_name);
    if qualifier != "" {
        function_return_ctx = qualified_function_return_ctx(ref functions, ref uses, ref items, module, qualifier, call_name);
    }
    let mut variant_enum_name = visible_variant_enum_name(ref variants, ref uses, ref items, module, call_name);
    if qualifier != "" {
        variant_enum_name = qualified_variant_enum_name(ref variants, ref uses, ref items, module, qualifier, call_name);
        if function_return_ctx.head == "" and variant_enum_name == "" {
            push_diag(mutref diags, module, head.start, "unknown qualified function or data constructor target");
        }
    }
    let mut call_return_ctx = function_return_ctx;
    if function_return_ctx.head != "" {
        if call_name == "list" and expected_ctx.head != "" and type_names_match(expected_ctx.head, "list") {
            call_return_ctx = expected_ctx;
        }
    } else {
        if variant_enum_name != "" {
            if builtin_variant_enum_name(call_name) != "" {
                call_return_ctx = builtin_variant_return_ctx(call_name, expected_ctx);
            } else {
                call_return_ctx = make_expected_type_ctx(variant_enum_name, "", "");
            }
        }
    }
    let mut arg_start = open_index + 1;
    let arg_end_limit = end - 1;
    let mut arg_index = 0;
    let mut first_arg_ctx = empty_expected_type_ctx();
    let named_args = call_args_are_named(ref tokens, arg_start, arg_end_limit);

    if named_args and variant_enum_name != "" {
        push_diag(mutref diags, module, head.start, "named arguments are only supported for function calls");
    }

    if named_args and function_return_ctx.head != "" {
        let mut fn_arity = visible_function_arity(ref functions, ref uses, ref items, module, call_name);
        if qualifier != "" {
            fn_arity = qualified_function_arity(ref functions, ref uses, ref items, module, qualifier, call_name);
        }
        let mut scan_start = arg_start;
        while scan_start < arg_end_limit {
            let scan_end = next_top_level_comma(ref tokens, scan_start, arg_end_limit);
            let label = segment_label_name(ref tokens, scan_start, scan_end);
            if label == "" {
                push_diag(mutref diags, module, head.start, "cannot mix positional and named arguments");
            } else {
                if named_arg_label_seen_before(ref tokens, arg_start, scan_start, label) {
                    push_diag(mutref diags, module, head.start, "duplicate named argument");
                }
                let mut label_known = false;
                let mut param_scan = 0;
                while param_scan < fn_arity {
                    let mut candidate_name = "";
                    if qualifier != "" {
                        candidate_name = qualified_function_param_name(ref function_params, ref uses, ref items, module, qualifier, call_name, param_scan);
                    } else {
                        candidate_name = visible_function_param_name(ref function_params, ref uses, ref items, module, call_name, param_scan);
                    }
                    if candidate_name == label {
                        label_known = true;
                    }
                    param_scan = param_scan + 1;
                }
                if not label_known {
                    push_diag(mutref diags, module, head.start, "unknown named argument");
                }
            }
            scan_start = scan_end + 1;
        }
        while arg_index < fn_arity {
            let mut expected_arg_ctx = empty_expected_type_ctx();
            if call_name == "list_push" {
                if arg_index == 0 {
                    expected_arg_ctx = make_expected_type_ctx("list", "", "");
                } else {
                    if arg_index == 1 and first_arg_ctx.head == "list" and first_arg_ctx.arg1_name != "" {
                expected_arg_ctx = expected_type_ctx_from_text(first_arg_ctx.arg1_name);
                    } else {
                        expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                    }
                }
            } else {
                if call_name == "list_get" {
                    if arg_index == 0 {
                        expected_arg_ctx = make_expected_type_ctx("list", "", "");
                    } else {
                        expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                    }
                } else {
                    if qualifier != "" {
                        expected_arg_ctx = qualified_function_param_ctx(ref function_params, ref uses, ref items, module, qualifier, call_name, arg_index);
                    } else {
                        expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                    }
                }
            }
            let mut param_name = "";
            if qualifier != "" {
                param_name = qualified_function_param_name(ref function_params, ref uses, ref items, module, qualifier, call_name, arg_index);
            } else {
                param_name = visible_function_param_name(ref function_params, ref uses, ref items, module, call_name, arg_index);
            }
            let segment_start = find_named_arg_segment_start(ref tokens, arg_start, arg_end_limit, param_name);
            if segment_start < 0 {
                push_diag(mutref diags, module, head.start, "missing named argument for parameter");
            } else {
                let segment_end = next_top_level_comma(ref tokens, segment_start, arg_end_limit);
                let value_start = segment_value_start(ref tokens, segment_start, segment_end);
                let actual_arg_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, value_start, segment_end, head.start, expected_arg_ctx, mutref diags);
                validate_call_argument_borrow(ref function_params, ref scopes, ref typed_bindings, ref uses, ref items, module, function_name, scope_id, qualifier, call_name, arg_index, ref tokens, value_start, segment_end, mutref diags);
                if arg_index == 0 {
                    first_arg_ctx = actual_arg_ctx;
                }
                if expected_arg_ctx.head != "" and has_known_type_ctx(actual_arg_ctx) and not type_ctx_matches(expected_arg_ctx, actual_arg_ctx) {
                    push_diag(mutref diags, module, head.start, "call argument type does not match parameter type");
                }
            }
            arg_index = arg_index + 1;
        }
    } else {
        while arg_start < arg_end_limit {
            let segment_end = next_top_level_comma(ref tokens, arg_start, arg_end_limit);
            if segment_label_colon(ref tokens, arg_start, segment_end) >= 0 {
                push_diag(mutref diags, module, head.start, "cannot mix positional and named arguments");
            }
            let mut expected_arg_ctx = empty_expected_type_ctx();
            if function_return_ctx.head != "" {
                if call_name == "list_push" {
                    if arg_index == 0 {
                        expected_arg_ctx = make_expected_type_ctx("list", "", "");
                    } else {
                        if arg_index == 1 and first_arg_ctx.head == "list" and first_arg_ctx.arg1_name != "" {
                            expected_arg_ctx = expected_type_ctx_from_text(first_arg_ctx.arg1_name);
                        } else {
                            expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                        }
                    }
                } else {
                    if call_name == "list_get" {
                        if arg_index == 0 {
                            expected_arg_ctx = make_expected_type_ctx("list", "", "");
                        } else {
                            expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                        }
                    } else {
                        if qualifier != "" {
                            expected_arg_ctx = qualified_function_param_ctx(ref function_params, ref uses, ref items, module, qualifier, call_name, arg_index);
                        } else {
                            expected_arg_ctx = visible_function_param_ctx(ref function_params, ref uses, ref items, module, call_name, arg_index);
                        }
                    }
                }
            } else {
                if variant_enum_name != "" {
                    if builtin_variant_enum_name(call_name) != "" {
                        expected_arg_ctx = builtin_variant_payload_ctx(call_name, call_return_ctx, arg_index);
                    } else {
                        if qualifier != "" {
                            expected_arg_ctx = qualified_variant_payload_ctx(ref variant_payloads, ref variants, ref uses, ref items, module, qualifier, call_name, arg_index);
                        } else {
                            expected_arg_ctx = visible_variant_payload_ctx(ref variant_payloads, ref uses, ref items, module, call_name, arg_index);
                        }
                    }
                }
            }
            let value_start = segment_value_start(ref tokens, arg_start, segment_end);
            let actual_arg_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, value_start, segment_end, head.start, expected_arg_ctx, mutref diags);
            if function_return_ctx.head != "" or variant_enum_name != "" {
                validate_call_argument_borrow(ref function_params, ref scopes, ref typed_bindings, ref uses, ref items, module, function_name, scope_id, qualifier, call_name, arg_index, ref tokens, value_start, segment_end, mutref diags);
            }
            if arg_index == 0 {
                first_arg_ctx = actual_arg_ctx;
            }
            if function_return_ctx.head != "" {
                if expected_arg_ctx.head != "" and has_known_type_ctx(actual_arg_ctx) and not type_ctx_matches(expected_arg_ctx, actual_arg_ctx) {
                    push_diag(mutref diags, module, head.start, "call argument type does not match parameter type");
                }
            } else {
                if variant_enum_name != "" {
                    if expected_arg_ctx.head != "" and has_known_type_ctx(actual_arg_ctx) and not type_ctx_matches(expected_arg_ctx, actual_arg_ctx) {
                        push_diag(mutref diags, module, head.start, "constructor payload type does not match variant payload type");
                    }
                }
            }
            arg_index = arg_index + 1;
            arg_start = segment_end + 1;
        }
    }

    if call_return_ctx.head != "" {
        if call_name == "list_get" and first_arg_ctx.head == "list" {
            let element_ctx = expected_type_ctx_from_text(first_arg_ctx.arg1_name);
            let visiting: list<str> = list();
            if not type_ctx_is_copy(element_ctx, module, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref visiting) {
                push_list_get_noncopy_diag(mutref diags, module, head);
            }
            return make_expected_type_ctx("option", first_arg_ctx.arg1_name, "");
        }
        return call_return_ctx;
    }
    return make_expected_type_ctx(variant_enum_name, "", "");
}

fn infer_struct_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, diags: mutref list<diag>) -> expected_type_ctx {
    let name_index = span_struct_name_index(ref tokens, start, end);
    let open_index = span_struct_open_index(ref tokens, start, end);
    let type_token = token_at(ref tokens, name_index);
    let type_name = type_token.text;
    let qualifier = span_struct_qualifier(ref tokens, start, end);
    let mut origin_module = visible_type_origin_module(ref uses, ref items, module, type_name);
    if qualifier != "" {
        origin_module = qualified_type_origin_module(ref uses, ref items, module, qualifier, type_name);
    }
    if origin_module == "" {
        if qualifier != "" {
            push_diag(mutref diags, module, type_token.start, "unknown qualified struct literal type");
        }
        return empty_expected_type_ctx();
    }

    let struct_ctx = make_expected_type_ctx(type_name, "", "");
    let mut has_update_base = false;
    let mut field_start = open_index + 1;
    let field_end_limit = end - 1;
    while field_start < field_end_limit {
        let segment_end = next_top_level_comma(ref tokens, field_start, field_end_limit);
        if segment_is_record_update_base(ref tokens, field_start, segment_end) {
            if field_start != open_index + 1 {
                push_diag(mutref diags, module, type_token.start, "record update base must be the first struct literal entry");
            }
            if has_update_base {
                push_diag(mutref diags, module, type_token.start, "record update base appears more than once");
            }
            has_update_base = true;
            let base_start = field_start + 1;
            if not record_update_base_is_simple_name(ref tokens, base_start, segment_end) {
                push_diag(mutref diags, module, type_token.start, "record update base must be a simple local, parameter, pattern binding, or visible const name");
            } else {
                let base_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, base_start, segment_end, type_token.start, struct_ctx, mutref diags);
                if has_known_type_ctx(base_ctx) and not type_ctx_matches(struct_ctx, base_ctx) {
                    push_diag(mutref diags, module, type_token.start, "record update base type does not match struct literal type");
                }
            }
            field_start = segment_end + 1;
        } else {
        let colon_index = find_top_level_colon(ref tokens, field_start, segment_end);
        if colon_index < 0 {
            push_stage1_limitation(mutref diags, module, type_token.start);
            return unsupported_type_ctx();
        }
        let field_token = token_at(ref tokens, field_start);
        let mut field_name = "";
        match field_token.kind {
            tk_ident => {
                field_name = field_token.text;
            },
            _ => {
                push_stage1_limitation(mutref diags, module, type_token.start);
                return unsupported_type_ctx();
            },
        }
        let expected_field_ctx = lookup_field_ctx(ref field_facts, origin_module, type_name, field_name);
        if expected_field_ctx.head == "" {
            push_diag(mutref diags, module, field_token.start, "struct literal field does not exist on type");
        }
        let actual_field_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, colon_index + 1, segment_end, field_token.start, expected_field_ctx, mutref diags);
        if expected_field_ctx.head != "" and has_known_type_ctx(actual_field_ctx) and not type_ctx_matches(expected_field_ctx, actual_field_ctx) {
            push_diag(mutref diags, module, field_token.start, "struct literal field does not match declared field type");
        }
        field_start = segment_end + 1;
        }
    }

    let mut field_index = 0;
    while field_index < list_len(ref field_facts) {
        let entry = list_get(ref field_facts, field_index);
        match entry {
            Some(value) => {
                if value.module == origin_module and value.type_name == type_name {
                    if not has_update_base and not struct_literal_has_field(ref tokens, start, end, value.name) {
                        push_diag(mutref diags, module, type_token.start, "struct literal is missing required field");
                    }
                }
            },
            None => {
            },
        }
        field_index = field_index + 1;
    }
    return struct_ctx;
}

fn infer_list_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> expected_type_ctx {
    let open = token_at(ref tokens, start);
    let item_start_limit = start + 1;
    let item_end_limit = end - 1;
    if item_start_limit >= item_end_limit {
        if expected_ctx.head == "list" and expected_ctx.arg1_name != "" {
            return expected_ctx;
        }
        push_diag(mutref diags, module, open.start, "`[]` requires an expected `list<T>` context");
        return make_expected_type_ctx("list", "", "");
    }

    let mut declared_element_ctx = empty_expected_type_ctx();
    if expected_ctx.head == "list" and expected_ctx.arg1_name != "" {
        declared_element_ctx = expected_type_ctx_from_text(expected_ctx.arg1_name);
    }

    let mut first_element_ctx = empty_expected_type_ctx();
    let mut item_start = item_start_limit;
    let mut item_index = 0;
    while item_start < item_end_limit {
        let segment_end = next_top_level_comma(ref tokens, item_start, item_end_limit);
        if item_start == segment_end {
            push_diag(mutref diags, module, open.start, "list literal element cannot be empty");
            return unsupported_type_ctx();
        }
        let mut expected_element_ctx = declared_element_ctx;
        if expected_element_ctx.head == "" and first_element_ctx.head != "" {
            expected_element_ctx = first_element_ctx;
        }
        let actual_element_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, item_start, segment_end, open.start, expected_element_ctx, mutref diags);
        if is_unsupported_type_ctx(actual_element_ctx) {
            return actual_element_ctx;
        }
        if item_index == 0 and declared_element_ctx.head == "" {
            first_element_ctx = actual_element_ctx;
        } else {
            if expected_element_ctx.head != "" and has_known_type_ctx(actual_element_ctx) and not type_ctx_matches(expected_element_ctx, actual_element_ctx) {
                if declared_element_ctx.head == "" {
                    push_diag(mutref diags, module, open.start, "list literal elements must have matching types");
                }
            }
        }
        if declared_element_ctx.head != "" and has_known_type_ctx(actual_element_ctx) and not type_ctx_matches(declared_element_ctx, actual_element_ctx) {
            push_diag(mutref diags, module, open.start, "list literal element does not match expected element type");
        }
        item_index = item_index + 1;
        item_start = segment_end + 1;
    }

    if declared_element_ctx.head != "" {
        return expected_ctx;
    }
    if has_known_type_ctx(first_element_ctx) {
        return make_expected_type_ctx("list", first_element_ctx.head, "");
    }
    return make_expected_type_ctx("list", "", "");
}

fn match_pattern_is_default(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut pattern_start = start;
    let mut pattern_end = end;
    while span_is_wrapped_in_parens(ref tokens, pattern_start, pattern_end) {
        pattern_start = pattern_start + 1;
        pattern_end = pattern_end - 1;
    }
    if pattern_start + 1 != pattern_end {
        return false;
    }
    let current = token_at(ref tokens, pattern_start);
    match current.kind {
        tk_ident => {
            if current.text == "_" {
                return true;
            }
            if builtin_variant_enum_name(current.text) != "" {
                return false;
            }
            if visible_variant_enum_name(ref variants, ref uses, ref items, module, current.text) != "" {
                return false;
            }
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn pattern_span_is_refined(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut pattern_start = start;
    let mut pattern_end = end;
    while span_is_wrapped_in_parens(ref tokens, pattern_start, pattern_end) {
        pattern_start = pattern_start + 1;
        pattern_end = pattern_end - 1;
    }
    let mut paren_count = 0;
    let mut index = pattern_start;
    while index < pattern_end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_int_lit => {
                return true;
            },
            tk_minus => {
                return true;
            },
            tk_lparen => {
                paren_count = paren_count + 1;
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return paren_count > 1;
}

fn match_pattern_variant_name(tokens: ref list<token>, start: i32, end: i32) -> str {
    let mut pattern_start = start;
    let mut pattern_end = end;
    while span_is_wrapped_in_parens(ref tokens, pattern_start, pattern_end) {
        pattern_start = pattern_start + 1;
        pattern_end = pattern_end - 1;
    }
    if pattern_start >= pattern_end {
        return "";
    }
    if pattern_start + 3 < pattern_end {
        let first_colon = token_at(ref tokens, pattern_start + 1);
        let second_colon = token_at(ref tokens, pattern_start + 2);
        let name = token_at(ref tokens, pattern_start + 3);
        if is_colon_token(first_colon) and is_colon_token(second_colon) and is_ident_token(name) {
            return name.text;
        }
    }
    let current = token_at(ref tokens, pattern_start);
    match current.kind {
        tk_ident => {
            return current.text;
        },
        _ => {
            return "";
        },
    }
}

fn match_expr_patterns_have_default(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut cursor = start;
    let match_token = token_at(ref tokens, cursor);
    match match_token.kind {
        tk_kw_match => {
            cursor = cursor + 1;
        },
        _ => {
            return false;
        },
    }
    skip_until_match_block(ref tokens, mutref cursor);
    let open = token_at(ref tokens, cursor);
    match open.kind {
        tk_lbrace => {
            cursor = cursor + 1;
        },
        _ => {
            return false;
        },
    }
    while cursor < end {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_rbrace => {
                return false;
            },
            tk_eof => {
                return false;
            },
            _ => {
                let pattern_start = cursor;
                skip_pattern_until_arrow(ref tokens, mutref cursor);
                if match_pattern_is_default(ref variants, ref uses, ref items, module, ref tokens, pattern_start, cursor) {
                    return true;
                }
                let arrow = token_at(ref tokens, cursor);
                match arrow.kind {
                    tk_fat_arrow => {
                        cursor = cursor + 1;
                    },
                    _ => {
                        return false;
                    },
                }
                skip_match_arm_value_expr(ref tokens, mutref cursor);
                let maybe_comma = token_at(ref tokens, cursor);
                match maybe_comma.kind {
                    tk_comma => {
                        cursor = cursor + 1;
                    },
                    _ => {
                    },
                }
            },
        }
    }
    return false;
}

fn match_expr_patterns_have_refined(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut cursor = start;
    let match_token = token_at(ref tokens, cursor);
    match match_token.kind {
        tk_kw_match => {
            cursor = cursor + 1;
        },
