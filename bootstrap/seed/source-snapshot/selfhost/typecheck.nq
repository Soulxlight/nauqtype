pub fn visible_const_origin_module(uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str
audit {
    intent("Resolve the origin module for a visible top-level constant");
    mutates();
    effects();
}
{
    return visible_item_origin(ref uses, ref items, module, name, visible_item_const);
}

pub fn visible_const_ctx(consts: ref list<const_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> expected_type_ctx
audit {
    intent("Resolve the checked type context for a visible top-level constant");
    mutates();
    effects();
}
{
    let origin = visible_const_origin_module(ref uses, ref items, module, name);
    if origin == "" {
        return empty_expected_type_ctx();
    }
    return lookup_const_ctx(ref consts, origin, name);
}

fn visible_function_return_name(functions: ref list<function_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str {
    let builtin = builtin_function_return_name(name);
    if builtin != "" {
        return builtin;
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_function);
    if origin != "" {
        return lookup_function_fact_return_name(ref functions, origin, name);
    }
    return "";
}

fn visible_function_return_ctx(functions: ref list<function_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> expected_type_ctx {
    let builtin = builtin_function_return_name(name);
    if builtin != "" {
        return make_expected_type_ctx(builtin, builtin_function_return_arg1_name(name), builtin_function_return_arg2_name(name));
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_function);
    if origin != "" {
        return make_expected_type_ctx(
            lookup_function_fact_return_name(ref functions, origin, name),
            lookup_function_fact_return_arg1_name(ref functions, origin, name),
            lookup_function_fact_return_arg2_name(ref functions, origin, name)
        );
    }
    return empty_expected_type_ctx();
}

fn visible_function_return_is_borrow(functions: ref list<function_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> bool {
    let builtin = builtin_function_return_name(name);
    if builtin != "" {
        return false;
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_function);
    if origin != "" {
        return lookup_function_fact_return_is_borrow(ref functions, origin, name);
    }
    return false;
}

pub fn visible_variant_enum_name(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str
audit {
    intent("Resolve the enum name for a visible variant constructor");
    mutates();
    effects();
}
{
    let builtin = builtin_variant_enum_name(name);
    if builtin != "" {
        return builtin;
    }
    let origin = visible_item_origin(ref uses, ref items, module, name, visible_item_variant);
    if origin != "" {
        return lookup_variant_fact_enum_name(ref variants, origin, name);
    }
    return "";
}

pub fn visible_function_origin_module(uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str
audit {
    intent("Resolve the origin module for a visible function call target");
    mutates();
    effects();
}
{
    if builtin_function_arity(name) >= 0 {
        return "__builtin__";
    }
    return visible_item_origin(ref uses, ref items, module, name, visible_item_function);
}

pub fn visible_variant_origin_module(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str
audit {
    intent("Resolve the origin module for a visible constructor target");
    mutates();
    effects();
}
{
    if builtin_variant_enum_name(name) != "" {
        return "__builtin__";
    }
    return visible_item_origin(ref uses, ref items, module, name, visible_item_variant);
}

fn visible_zero_arg_variant_enum_name(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str) -> str {
    let builtin = builtin_variant_enum_name(name);
    if builtin != "" and builtin_variant_arity(name) == 0 {
        return builtin;
    }
    let variant_arity = visible_variant_arity(ref variants, ref uses, ref items, module, name);
    if variant_arity == 0 {
        return visible_variant_enum_name(ref variants, ref uses, ref items, module, name);
    }
    return "";
}

fn visible_zero_arg_variant_ctx(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, name: str, expected_ctx: expected_type_ctx) -> expected_type_ctx {
    let enum_name = visible_zero_arg_variant_enum_name(ref variants, ref uses, ref items, module, name);
    if enum_name == "" {
        return empty_expected_type_ctx();
    }
    if builtin_variant_enum_name(name) != "" and expected_ctx.head != "" and type_names_match(enum_name, expected_ctx.head) {
        return expected_ctx;
    }
    return make_expected_type_ctx(enum_name, "", "");
}

