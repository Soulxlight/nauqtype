                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_plus => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 and is_binary_operator_position(ref tokens, start, index) {
                    found = index;
                }
            },
            tk_minus => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 and is_binary_operator_position(ref tokens, start, index) {
                    found = index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return found;
}

