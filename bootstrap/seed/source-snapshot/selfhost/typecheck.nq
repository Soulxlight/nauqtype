pub type expected_type_ctx {
    head: str,
    arg1_name: str,
    arg2_name: str,
}

pub fn make_expected_type_ctx(head: str, arg1_name: str, arg2_name: str) -> expected_type_ctx
audit {
    intent("Construct an expected type context for selfhost semantic checks");
    mutates();
    effects();
}
{
    return expected_type_ctx {
        head: head,
        arg1_name: arg1_name,
        arg2_name: arg2_name,
    };
}

pub fn empty_expected_type_ctx() -> expected_type_ctx
audit {
    intent("Construct an empty expected type context for selfhost semantic checks");
    mutates();
    effects();
}
{
    return make_expected_type_ctx("", "", "");
}

fn expected_type_ctx_from_text(value: str) -> expected_type_ctx {
    if value == "" {
        return empty_expected_type_ctx();
    }
    return make_expected_type_ctx(type_text_head(value), type_text_arg1(value), type_text_arg2(value));
}

fn clone_type_keys(values: ref list<str>) -> list<str> {
    let mut result: list<str> = list();
    let mut index = 0;
    while index < list_len(ref values) {
        let entry = list_get(ref values, index);
        match entry {
            Some(value) => { list_push(mutref result, value); },
            None => {
            },
        }
        index = index + 1;
    }
    return result;
}

fn type_ctx_is_copy(ctx: expected_type_ctx, module: str, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, visiting: ref list<str>) -> bool {
    if ctx.head == "bool" or ctx.head == "i32" or ctx.head == "i64" or ctx.head == "str" or ctx.head == "unit" or ctx.head == "io_err" or ctx.head == "process_result" or ctx.head == "path_metadata" {
        return true;
    }
    if ctx.head == "list" or ctx.head == "bytes" {
        return false;
    }
    if ctx.head == "option" {
        return type_ctx_is_copy(expected_type_ctx_from_text(ctx.arg1_name), module, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref visiting);
    }
    if ctx.head == "result" {
        return type_ctx_is_copy(expected_type_ctx_from_text(ctx.arg1_name), module, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref visiting)
            and type_ctx_is_copy(expected_type_ctx_from_text(ctx.arg2_name), module, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref visiting);
    }
    if ctx.head == "" {
        return false;
    }

    let origin = visible_type_origin_module(ref uses, ref items, module, ctx.head);
    if origin == "" {
        return false;
    }
    let key = str_concat(str_concat(origin, "::"), ctx.head);
    if list_contains_str(ref visiting, key) {
        return false;
    }
    let mut next_visiting = clone_type_keys(ref visiting);
    list_push(mutref next_visiting, key);

    let mut field_index = 0;
    while field_index < list_len(ref field_facts) {
        let entry = list_get(ref field_facts, field_index);
        match entry {
            Some(field) => {
                if field.module == origin and field.type_name == ctx.head {
                    let field_ctx = make_expected_type_ctx(field.field_type_name, field.field_type_arg1_name, field.field_type_arg2_name);
                    if field.field_is_borrow or not type_ctx_is_copy(field_ctx, origin, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref next_visiting) {
                        return field.field_is_borrow;
                    }
                }
            },
            None => {
            },
        }
        field_index = field_index + 1;
    }

    let mut variant_index = 0;
    while variant_index < list_len(ref variants) {
        let variant_entry = list_get(ref variants, variant_index);
        match variant_entry {
            Some(variant) => {
                if variant.module == origin and variant.enum_name == ctx.head {
                    let mut payload_index = 0;
                    while payload_index < list_len(ref variant_payloads) {
                        let payload_entry = list_get(ref variant_payloads, payload_index);
                        match payload_entry {
                            Some(payload) => {
                                if payload.module == origin and payload.variant_name == variant.name {
                                    let payload_ctx = make_expected_type_ctx(payload.type_name, payload.type_arg1_name, payload.type_arg2_name);
                                    if payload.is_borrow or not type_ctx_is_copy(payload_ctx, origin, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref next_visiting) {
                                        return payload.is_borrow;
                                    }
                                }
                            },
                            None => {
                            },
                        }
                        payload_index = payload_index + 1;
                    }
                }
            },
            None => {
            },
        }
        variant_index = variant_index + 1;
    }
    return true;
}

fn push_error(diags: mutref list<diag>, file: str, at: i32, code: str, category: diag_category, message: str) -> unit {
    let mut end = at;
    if at >= 0 {
        end = at + 1;
    }
    push_diagnostic_once(mutref diags, make_error(code, category, file, at, end, message));
    return;
}

fn push_diag(diags: mutref list<diag>, file: str, at: i32, message: str) -> unit {
    push_error(mutref diags, file, at, "NQ-TYPE-042", diag_type, message);
    return;
}

fn token_at(tokens: ref list<token>, index: i32) -> token {
    let found = list_get(ref tokens, index);
    match found {
        Some(value) => {
            return value;
        },
        None => {
            return eof_token(index);
        },
    }
}

fn push_token_range_error(diags: mutref list<diag>, file: str, tokens: ref list<token>, start: i32, end: i32, code: str, message: str) -> unit {
    if start >= 0 and start < end {
        let first = token_at(ref tokens, start);
        let last = token_at(ref tokens, end - 1);
        push_diagnostic_once(mutref diags, make_error(code, diag_type, file, first.start, last.end, message));
        return;
    }
    push_error(mutref diags, file, -1, code, diag_type, message);
    return;
}

fn push_token_range_diag(diags: mutref list<diag>, file: str, tokens: ref list<token>, start: i32, end: i32, message: str) -> unit {
    push_token_range_error(mutref diags, file, ref tokens, start, end, "NQ-TYPE-042", message);
    return;
}

fn diag_severity_matches(left: diag_severity, right: diag_severity) -> bool {
    match left {
        diag_error => {
            match right {
                diag_error => { return true; },
                _ => { return false; },
            }
        },
        diag_warning => {
            match right {
                diag_warning => { return true; },
                _ => { return false; },
            }
        },
    }
}

