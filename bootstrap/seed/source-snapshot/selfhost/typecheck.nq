fn visible_typed_binding_is_borrow(typed_bindings: ref list<typed_binding_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> bool {
    let mut index = list_len(ref typed_bindings) - 1;
