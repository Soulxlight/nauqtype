    }
    return false;
}

fn visible_assignment_target_is_for_binding(statements: ref list<stmt_fact>, scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32, name: str, at: i32) -> bool {
    let mut best_at = -1;
    let mut best_is_for = false;
    let mut index = 0;
    while index < list_len(ref statements) {
        let entry = list_get(ref statements, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.name == name and value.at < at {
                    let mut declaration_scope_id = -1;
                    let mut declaration_is_for = false;
                    match value.kind {
                        stmt_local => {
                            declaration_scope_id = value.scope_id;
                        },
                        stmt_let_else => {
                            declaration_scope_id = value.scope_id;
                        },
                        stmt_propagate => {
                            declaration_scope_id = value.scope_id;
                        },
                        stmt_for => {
                            declaration_scope_id = value.child_scope_id;
                            declaration_is_for = true;
                        },
                        _ => {
                        },
                    }
                    if declaration_scope_id >= 0 and value.at > best_at and scope_is_visible(ref scopes, module, function_name, scope_id, declaration_scope_id) {
                        best_at = value.at;
                        best_is_for = declaration_is_for;
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return best_is_for;
}

