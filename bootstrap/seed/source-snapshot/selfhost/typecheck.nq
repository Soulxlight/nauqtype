fn unsupported_type_name() -> str {
    return "__stage1_unsupported__";
}

fn unsupported_type_ctx() -> expected_type_ctx {
    return make_expected_type_ctx(unsupported_type_name(), "", "");
}

fn is_unsupported_type_name(type_name: str) -> bool {
    return type_name == unsupported_type_name();
}

pub fn is_unsupported_type_ctx(type_ctx: expected_type_ctx) -> bool
audit {
    intent("Check whether a type context marks a retained stage1 limitation");
    mutates();
    effects();
}
{
    return is_unsupported_type_name(type_ctx.head);
}

fn has_known_type_name(type_name: str) -> bool {
    if type_name == "" {
        return false;
    }
    return not is_unsupported_type_name(type_name);
}

pub fn has_known_type_ctx(type_ctx: expected_type_ctx) -> bool
audit {
    intent("Check whether a type context carries a known non-limitation type");
    mutates();
    effects();
}
{
    return has_known_type_name(type_ctx.head);
}

fn is_int_like(type_name: str) -> bool {
    if type_name == "int" {
        return true;
    }
    return type_name == "i32" or type_name == "i64";
}

fn integer_expected_ctx(expected_ctx: expected_type_ctx) -> expected_type_ctx {
    if expected_ctx.head == "i64" {
        return make_expected_type_ctx("i64", "", "");
    }
    if expected_ctx.head == "i32" or expected_ctx.head == "int" {
        return make_expected_type_ctx("i32", "", "");
    }
    return empty_expected_type_ctx();
}

fn decimal_char_at(text_value: str, index: i32) -> i32 {
    let entry = str_get(text_value, index);
    match entry {
        Some(value) => {
            return value;
        },
        None => {
            return -1;
        },
    }
}

fn decimal_magnitude_fits(text_value: str, limit: str) -> bool {
    let mut first = 0;
    let mut scanning = true;
    while scanning and first + 1 < str_len(text_value) {
        if decimal_char_at(text_value, first) == 48 {
            first = first + 1;
        } else {
            scanning = false;
        }
    }
    let magnitude_len = str_len(text_value) - first;
    let limit_len = str_len(limit);
    if magnitude_len < limit_len {
        return true;
    }
    if magnitude_len > limit_len {
        return false;
    }
    let mut index = 0;
    while index < limit_len {
        let actual = decimal_char_at(text_value, first + index);
        let allowed = decimal_char_at(limit, index);
        if actual < allowed {
            return true;
        }
        if actual > allowed {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn push_integer_range_diag(diags: mutref list<diag>, module: str, tokens: ref list<token>, start: i32, end: i32, type_name: str) -> unit {
    push_token_range_error(mutref diags, module, ref tokens, start, end, "NQ-TYPE-043", str_concat("integer literal is out of range for `", str_concat(type_name, "`")));
    return;
}

fn integer_literal_ctx(text_value: str, negative: bool, expected_ctx: expected_type_ctx, module: str, tokens: ref list<token>, start: i32, end: i32, diags: mutref list<diag>) -> expected_type_ctx {
    let selected = integer_expected_ctx(expected_ctx);
    let mut type_name = "i32";
    if selected.head == "i64" {
        type_name = "i64";
    }
    let mut limit = "2147483647";
    if negative {
        limit = "2147483648";
    }
    if type_name == "i64" {
        limit = "9223372036854775807";
        if negative {
            limit = "9223372036854775808";
        }
    }
    if not decimal_magnitude_fits(text_value, limit) {
        push_integer_range_diag(mutref diags, module, ref tokens, start, end, type_name);
    }
    return make_expected_type_ctx(type_name, "", "");
}

fn span_is_contextual_integer_expr(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut expr_start = start;
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return false;
    }
    if expr_start + 1 == expr_end {
        let current = token_at(ref tokens, expr_start);
        match current.kind {
            tk_int_lit => {
                return true;
            },
            _ => {
                return false;
            },
        }
    }
    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_minus => {
            return span_is_contextual_integer_expr(ref tokens, expr_start + 1, expr_end);
        },
        _ => {
        },
    }
    let additive_index = find_root_additive_operator(ref tokens, expr_start, expr_end);
    if additive_index >= 0 {
        return span_is_contextual_integer_expr(ref tokens, expr_start, additive_index) and span_is_contextual_integer_expr(ref tokens, additive_index + 1, expr_end);
    }
    let multiplicative_index = find_root_multiplicative_operator(ref tokens, expr_start, expr_end);
    if multiplicative_index >= 0 {
        return span_is_contextual_integer_expr(ref tokens, expr_start, multiplicative_index) and span_is_contextual_integer_expr(ref tokens, multiplicative_index + 1, expr_end);
    }
    return false;
}

fn arithmetic_result_ctx(expected_ctx: expected_type_ctx, left_ctx: expected_type_ctx, right_ctx: expected_type_ctx) -> expected_type_ctx {
    let selected = integer_expected_ctx(expected_ctx);
    if selected.head != "" {
        return selected;
    }
    if left_ctx.head == "i64" or right_ctx.head == "i64" {
        return make_expected_type_ctx("i64", "", "");
    }
    return make_expected_type_ctx("i32", "", "");
}

fn expr_content_start(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut cursor = start;
    while cursor < end {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eq => {
                cursor = cursor + 1;
            },
            _ => {
                return cursor;
            },
        }
    }
    return cursor;
}

fn skip_until_match_block(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let mut paren_depth = 0;
    let mut bracket_depth = 0;
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lparen => {
                paren_depth = paren_depth + 1;
                cursor = cursor + 1;
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
                cursor = cursor + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_lbrace => {
                if paren_depth == 0 and bracket_depth == 0 {
                    return;
                }
                cursor = cursor + 1;
            },
            _ => {
                cursor = cursor + 1;
            },
        }
    }
}

fn skip_pattern_until_arrow(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let mut paren_depth = 0;
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lparen => {
                paren_depth = paren_depth + 1;
                cursor = cursor + 1;
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_fat_arrow => {
                if paren_depth == 0 {
                    return;
                }
                cursor = cursor + 1;
            },
            _ => {
                cursor = cursor + 1;
            },
        }
    }
}

fn skip_match_arm_value_expr(tokens: ref list<token>, cursor: mutref i32) -> unit {
    let mut paren_depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    while true {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_eof => {
                return;
            },
            tk_lparen => {
                paren_depth = paren_depth + 1;
                cursor = cursor + 1;
            },
            tk_rparen => {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
                cursor = cursor + 1;
            },
            tk_rbrace => {
                if paren_depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    return;
                }
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
                cursor = cursor + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
                cursor = cursor + 1;
            },
            tk_comma => {
                if paren_depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    return;
                }
                cursor = cursor + 1;
            },
            _ => {
                cursor = cursor + 1;
            },
        }
    }
}

fn token_can_end_expr(tok: token) -> bool {
    match tok.kind {
        tk_ident => {
            return true;
        },
        tk_int_lit => {
            return true;
        },
        tk_string_lit => {
            return true;
        },
        tk_kw_true => {
            return true;
        },
        tk_kw_false => {
            return true;
        },
        tk_rparen => {
            return true;
        },
        tk_rbrace => {
            return true;
        },
        tk_rbracket => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn span_is_wrapped_in_parens(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if end - start < 2 {
        return false;
    }
    let first = token_at(ref tokens, start);
    let last = token_at(ref tokens, end - 1);
    match first.kind {
        tk_lparen => {
        },
        _ => {
            return false;
        },
    }
    match last.kind {
        tk_rparen => {
        },
        _ => {
            return false;
        },
    }
    let mut depth = 0;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                depth = depth - 1;
                if depth == 0 and index + 1 < end {
                    return false;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return depth == 0;
}

// The rightmost root preserves left associativity; keep these scans aligned with the handoff/typechecker.
fn find_root_or_operator(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut found = -1;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                if depth > 0 {
                    depth = depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_kw_or => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    found = index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return found;
}

fn find_root_and_operator(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut found = -1;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                if depth > 0 {
                    depth = depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_kw_and => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    found = index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return found;
}

fn is_binary_operator_position(tokens: ref list<token>, start: i32, index: i32) -> bool {
    if index <= start {
        return false;
    }
    let previous = token_at(ref tokens, index - 1);
    return token_can_end_expr(previous);
}

fn find_root_compare_operator(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
    let mut equality = -1;
    let mut relational = -1;
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_lparen => {
                depth = depth + 1;
            },
            tk_rparen => {
                if depth > 0 {
                    depth = depth - 1;
                }
            },
            tk_lbrace => {
                brace_depth = brace_depth + 1;
            },
            tk_rbrace => {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                }
            },
            tk_lbracket => {
                bracket_depth = bracket_depth + 1;
            },
            tk_rbracket => {
                if bracket_depth > 0 {
                    bracket_depth = bracket_depth - 1;
                }
            },
            tk_eqeq => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    equality = index;
                }
            },
            tk_noteq => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    equality = index;
                }
            },
            tk_lt => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    relational = index;
                }
            },
            tk_gt => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    relational = index;
                }
            },
            tk_lte => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    relational = index;
                }
            },
            tk_gte => {
                if depth == 0 and brace_depth == 0 and bracket_depth == 0 {
                    relational = index;
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    if equality >= 0 {
        return equality;
    }
    return relational;
}

fn find_root_additive_operator(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    let mut depth = 0;
    let mut brace_depth = 0;
    let mut bracket_depth = 0;
