        tk_lbrace => {
            cursor = cursor + 1;
        },
        _ => {
            return false;
        },
    }
    while cursor < end {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_rbrace => {
                return false;
            },
            tk_eof => {
                return false;
            },
            _ => {
                let pattern_start = cursor;
                skip_pattern_until_arrow(ref tokens, mutref cursor);
                if pattern_span_is_refined(ref tokens, pattern_start, cursor) {
                    return true;
                }
                let arrow = token_at(ref tokens, cursor);
                match arrow.kind {
                    tk_fat_arrow => {
                        cursor = cursor + 1;
                    },
                    _ => {
                        return false;
                    },
                }
                skip_match_arm_value_expr(ref tokens, mutref cursor);
                let maybe_comma = token_at(ref tokens, cursor);
                match maybe_comma.kind {
                    tk_comma => {
                        cursor = cursor + 1;
                    },
                    _ => {
                    },
                }
            },
        }
    }
    return false;
}

fn match_expr_patterns_include_variant(tokens: ref list<token>, start: i32, end: i32, variant_name: str) -> bool {
    let mut cursor = start;
    let match_token = token_at(ref tokens, cursor);
    match match_token.kind {
        tk_kw_match => {
            cursor = cursor + 1;
        },
        _ => {
            return false;
        },
    }
    skip_until_match_block(ref tokens, mutref cursor);
    let open = token_at(ref tokens, cursor);
    match open.kind {
        tk_lbrace => {
            cursor = cursor + 1;
        },
        _ => {
            return false;
        },
    }
    while cursor < end {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_rbrace => {
                return false;
            },
            tk_eof => {
                return false;
            },
            _ => {
                let pattern_start = cursor;
                skip_pattern_until_arrow(ref tokens, mutref cursor);
                if match_pattern_variant_name(ref tokens, pattern_start, cursor) == variant_name {
                    return true;
                }
                let arrow = token_at(ref tokens, cursor);
                match arrow.kind {
                    tk_fat_arrow => {
                        cursor = cursor + 1;
                    },
                    _ => {
                        return false;
                    },
                }
                skip_match_arm_value_expr(ref tokens, mutref cursor);
                let maybe_comma = token_at(ref tokens, cursor);
                match maybe_comma.kind {
                    tk_comma => {
                        cursor = cursor + 1;
                    },
                    _ => {
                    },
                }
            },
        }
    }
    return false;
}

fn match_expr_is_exhaustive(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, tokens: ref list<token>, start: i32, end: i32, scrutinee_ctx: expected_type_ctx) -> bool {
    if scrutinee_ctx.head == "i32" or scrutinee_ctx.head == "i64" {
        return match_expr_patterns_have_default(ref variants, ref uses, ref items, module, ref tokens, start, end);
    }
    if match_expr_patterns_have_refined(ref tokens, start, end) {
        return match_expr_patterns_have_default(ref variants, ref uses, ref items, module, ref tokens, start, end);
    }
    if scrutinee_ctx.head == "option" {
        if match_expr_patterns_have_default(ref variants, ref uses, ref items, module, ref tokens, start, end) {
            return true;
        }
        return match_expr_patterns_include_variant(ref tokens, start, end, "Some") and match_expr_patterns_include_variant(ref tokens, start, end, "None");
    }
    if scrutinee_ctx.head == "result" {
        if match_expr_patterns_have_default(ref variants, ref uses, ref items, module, ref tokens, start, end) {
            return true;
        }
        return match_expr_patterns_include_variant(ref tokens, start, end, "Ok") and match_expr_patterns_include_variant(ref tokens, start, end, "Err");
    }
    let mut required = 0;
    let mut covered = 0;
    let mut index = 0;
    while index < list_len(ref variants) {
        let entry = list_get(ref variants, index);
        match entry {
            Some(value) => {
                if visible_variant_enum_name(ref variants, ref uses, ref items, module, value.name) == scrutinee_ctx.head {
                    required = required + 1;
                    if match_expr_patterns_include_variant(ref tokens, start, end, value.name) {
                        covered = covered + 1;
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    if required > 0 and match_expr_patterns_have_default(ref variants, ref uses, ref items, module, ref tokens, start, end) {
        return true;
    }
    return required > 0 and required == covered;
}

fn match_expr_scrutinee_is_supported(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, scrutinee_ctx: expected_type_ctx) -> bool {
    if scrutinee_ctx.head == "i32" or scrutinee_ctx.head == "i64" {
        return true;
    }
    if scrutinee_ctx.head == "option" or scrutinee_ctx.head == "result" {
        return true;
    }
    let mut index = 0;
    while index < list_len(ref variants) {
        let entry = list_get(ref variants, index);
        match entry {
            Some(value) => {
                if visible_variant_enum_name(ref variants, ref uses, ref items, module, value.name) == scrutinee_ctx.head {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn infer_match_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, at: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> expected_type_ctx {
    let mut cursor = start;
    let match_token = token_at(ref tokens, cursor);
    match match_token.kind {
        tk_kw_match => {
            cursor = cursor + 1;
        },
        _ => {
            push_stage1_limitation(mutref diags, module, at);
            return unsupported_type_ctx();
        },
    }
    let scrutinee_start = cursor;
    skip_until_match_block(ref tokens, mutref cursor);
    let scrutinee_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, scrutinee_start, cursor, at, empty_expected_type_ctx(), mutref diags);
    if is_unsupported_type_ctx(scrutinee_ctx) {
        return scrutinee_ctx;
    }
    if has_known_type_ctx(scrutinee_ctx) and not match_expr_scrutinee_is_supported(ref variants, ref uses, ref items, module, scrutinee_ctx) {
        push_diag(mutref diags, module, match_token.start, "match expression scrutinee must be i32, option, result, or enum");
        return unsupported_type_ctx();
    }
    let open = token_at(ref tokens, cursor);
    match open.kind {
        tk_lbrace => {
            cursor = cursor + 1;
        },
        _ => {
            push_diag(mutref diags, module, open.start, "expected `{` after match expression");
            return unsupported_type_ctx();
        },
    }
    let mut arm_index = 0;
    let mut result_ctx = empty_expected_type_ctx();
    while cursor < end {
        let current = token_at(ref tokens, cursor);
        match current.kind {
            tk_rbrace => {
                if arm_index == 0 {
                    push_diag(mutref diags, module, current.start, "match expression must have at least one arm");
                    return unsupported_type_ctx();
                }
                if not match_expr_is_exhaustive(ref variants, ref uses, ref items, module, ref tokens, start, end, scrutinee_ctx) {
                    push_diag(mutref diags, module, match_token.start, "match expression must be exhaustive");
                    return unsupported_type_ctx();
                }
                if expected_ctx.head != "" {
                    return expected_ctx;
                }
                return result_ctx;
            },
            tk_eof => {
                push_diag(mutref diags, module, current.start, "unterminated match expression");
                return unsupported_type_ctx();
            },
            _ => {
                let pattern_start = cursor;
                skip_pattern_until_arrow(ref tokens, mutref cursor);
                let pattern_end = cursor;
                let arrow = token_at(ref tokens, cursor);
                match arrow.kind {
                    tk_fat_arrow => {
                        cursor = cursor + 1;
                    },
                    _ => {
                        push_diag(mutref diags, module, arrow.start, "expected `=>` in match arm");
                        return unsupported_type_ctx();
                    },
                }
                let body_start = cursor;
                skip_match_arm_value_expr(ref tokens, mutref cursor);
                let body_end = cursor;

                let mut arm_bindings = clone_typed_bindings_for_function(ref typed_bindings, module, function_name);
                let mut ignored_pattern_bindings: list<pattern_binding_fact> = list();
                typecheck_pattern_span(ref variants, ref variant_payloads, ref uses, ref items, module, function_name, scope_id, ref tokens, pattern_start, pattern_end, scrutinee_ctx, mutref arm_bindings, mutref ignored_pattern_bindings, mutref diags);

                let mut arm_expected_ctx = expected_ctx;
                if arm_expected_ctx.head == "" and result_ctx.head != "" {
                    arm_expected_ctx = result_ctx;
                }
                let arm_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref arm_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, body_start, body_end, current.start, arm_expected_ctx, mutref diags);
                if not is_unsupported_type_ctx(arm_ctx) and has_known_type_ctx(arm_ctx) {
                    if arm_index == 0 and expected_ctx.head == "" {
                        result_ctx = arm_ctx;
                    } else {
                        if expected_ctx.head != "" {
                            if not type_ctx_matches(expected_ctx, arm_ctx) {
                                push_diag(mutref diags, module, current.start, "match expression arm result does not match expected type");
                            }
                        } else {
                            if result_ctx.head != "" and not type_ctx_matches(result_ctx, arm_ctx) {
                                push_diag(mutref diags, module, current.start, "match expression arm result types must match exactly");
                            }
                        }
                    }
                }
                arm_index = arm_index + 1;
                let maybe_comma = token_at(ref tokens, cursor);
                match maybe_comma.kind {
                    tk_comma => {
                        cursor = cursor + 1;
                    },
                    _ => {
                    },
                }
            },
        }
    }
    if arm_index == 0 {
        push_diag(mutref diags, module, at, "match expression must have at least one arm");
        return unsupported_type_ctx();
    }
    if not match_expr_is_exhaustive(ref variants, ref uses, ref items, module, ref tokens, start, end, scrutinee_ctx) {
        push_diag(mutref diags, module, match_token.start, "match expression must be exhaustive");
        return unsupported_type_ctx();
    }
    if expected_ctx.head != "" {
        return expected_ctx;
    }
    return result_ctx;
}

fn trailing_expression_question_index(tokens: ref list<token>, start: i32, end: i32) -> i32 {
    if end - start >= 4 {
        let close = token_at(ref tokens, end - 1);
        let label = token_at(ref tokens, end - 2);
        let open = token_at(ref tokens, end - 3);
        let question = token_at(ref tokens, end - 4);
        match close.kind {
            tk_rbracket => {
                match label.kind {
                    tk_ident => {
                        match open.kind {
                            tk_lbracket => {
                                match question.kind {
                                    tk_question => {
                                        return end - 4;
                                    },
                                    _ => {
                                    },
                                }
                            },
                            _ => {
                            },
                        }
                    },
                    _ => {
                    },
                }
            },
            _ => {
            },
        }
    }
    if end > start {
        let last = token_at(ref tokens, end - 1);
        match last.kind {
            tk_question => {
                return end - 1;
            },
            _ => {
            },
        }
    }
    return -1;
}

fn span_is_try_expr(tokens: ref list<token>, start: i32, end: i32) -> bool {
    if end - start < 4 {
        return false;
    }
    let first = token_at(ref tokens, start);
    let open = token_at(ref tokens, start + 1);
    let close = token_at(ref tokens, end - 1);
    match first.kind {
        tk_kw_try => {
        },
        _ => {
            return false;
        },
    }
    match open.kind {
        tk_lbrace => {
        },
        _ => {
            return false;
        },
    }
    match close.kind {
        tk_rbrace => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn try_question_operand_start(tokens: ref list<token>, inner_start: i32, question_index: i32) -> i32 {
    if question_index <= inner_start {
        return -1;
    }
    let last = token_at(ref tokens, question_index - 1);
    match last.kind {
        tk_rparen => {
        },
        _ => {
            return -1;
        },
    }
    let mut depth = 0;
    let mut index = question_index - 1;
    let mut open_index = -1;
    while index >= inner_start and open_index < 0 {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_rparen => {
                depth = depth + 1;
            },
            tk_lparen => {
                depth = depth - 1;
                if depth == 0 {
                    open_index = index;
                }
            },
            _ => {
            },
        }
        index = index - 1;
    }
    if open_index <= inner_start {
        return -1;
    }
    let name = token_at(ref tokens, open_index - 1);
    match name.kind {
        tk_ident => {
        },
        _ => {
            return -1;
        },
    }
    let mut operand_start = open_index - 1;
    let mut scanning = true;
    while scanning and operand_start - 3 >= inner_start {
        let second_colon = token_at(ref tokens, operand_start - 1);
        let first_colon = token_at(ref tokens, operand_start - 2);
        let qualifier = token_at(ref tokens, operand_start - 3);
        if is_colon_token(second_colon) and is_colon_token(first_colon) and is_ident_token(qualifier) {
            operand_start = operand_start - 3;
        } else {
            scanning = false;
        }
    }
    return operand_start;
}

fn validate_try_question_sites(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, inner_start: i32, inner_end: i32, boundary_error: str, diags: mutref list<diag>) -> unit {
    let mut index = inner_start;
    while index < inner_end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_question => {
                let operand_start = try_question_operand_start(ref tokens, inner_start, index);
                if operand_start >= 0 {
                    let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, operand_start, index, current.start, empty_expected_type_ctx(), mutref diags);
                    if actual_ctx.head != "result" {
                        push_error(mutref diags, module, current.start, "NQ-PROPAGATE-001", diag_propagate, "`?` requires `result<T, E>`");
                    } else {
                        if not type_names_match(actual_ctx.arg2_name, boundary_error) {
                            push_error(mutref diags, module, current.start, "NQ-PROPAGATE-003", diag_propagate, "propagated error type must match the enclosing `try` boundary exactly; use let-else for explicit mapping");
                        }
                    }
                }
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return;
}

fn span_contains_question_token(tokens: ref list<token>, start: i32, end: i32) -> bool {
    let mut index = start;
    while index < end {
        let current = token_at(ref tokens, index);
        match current.kind {
            tk_question => {
                return true;
            },
            _ => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn infer_try_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, at: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> expected_type_ctx {
    if expected_ctx.head != "result" or expected_ctx.arg1_name == "" or expected_ctx.arg2_name == "" {
        push_error(mutref diags, module, at, "NQ-TRY-001", diag_try, "`try` requires an explicit `result<T, E>` expected type");
        return unsupported_type_ctx();
    }
    let inner_start = start + 2;
    let inner_end = end - 1;
    if inner_start >= inner_end {
        push_error(mutref diags, module, at, "NQ-TRY-002", diag_try, "`try` requires one value expression");
        return unsupported_type_ctx();
    }
    if span_contains_question_token(ref tokens, inner_start, inner_end) and (find_root_or_operator(ref tokens, inner_start, inner_end) >= 0 or find_root_and_operator(ref tokens, inner_start, inner_end) >= 0) {
        push_error(mutref diags, module, at, "NQ-TRY-004", diag_try, "expression propagation inside short-circuit logic is not supported in `try` V1");
        return unsupported_type_ctx();
    }
    let mut value_start = inner_start;
    let mut value_end = inner_end;
    while span_is_wrapped_in_parens(ref tokens, value_start, value_end) {
        value_start = value_start + 1;
        value_end = value_end - 1;
    }
    let value_head = token_at(ref tokens, value_start);
    match value_head.kind {
        tk_kw_match => {
            push_error(mutref diags, module, at, "NQ-TRY-005", diag_try, "match expressions are not supported as `try` V1 success expressions");
            return unsupported_type_ctx();
        },
        _ => {
        },
    }
    validate_try_question_sites(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, inner_start, inner_end, expected_ctx.arg2_name, mutref diags);
    let success_ctx = expected_type_ctx_from_text(expected_ctx.arg1_name);
    let actual_success = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, inner_start, inner_end, at, success_ctx, mutref diags);
    if has_known_type_ctx(actual_success) and not type_ctx_matches(success_ctx, actual_success) {
        push_error(mutref diags, module, at, "NQ-TRY-003", diag_try, "`try` success expression does not match the annotated result payload type");
    }
    return expected_ctx;
}

pub fn infer_expr_type_ctx(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, at: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> expected_type_ctx
audit {
    intent("Infer the type context of a trusted-subset expression for selfhost semantic checks");
    mutates(diags);
    effects();
}
{
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        return make_expected_type_ctx("unit", "", "");
    }

    if span_is_try_expr(ref tokens, expr_start, expr_end) {
        return infer_try_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, expr_end, at, expected_ctx, mutref diags);
    }

    let question_index = trailing_expression_question_index(ref tokens, expr_start, expr_end);
    if question_index >= 0 {
        let result_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, question_index, at, empty_expected_type_ctx(), mutref diags);
        if result_ctx.head == "result" and result_ctx.arg1_name != "" {
            return expected_type_ctx_from_text(result_ctx.arg1_name);
        }
        return unsupported_type_ctx();
    }

    let or_index = find_root_or_operator(ref tokens, expr_start, expr_end);
    if or_index >= 0 {
        let left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, or_index, at, empty_expected_type_ctx(), mutref diags);
        let right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, or_index + 1, expr_end, at, empty_expected_type_ctx(), mutref diags);
        if has_known_type_ctx(left_type_ctx) and left_type_ctx.head != "bool" {
            push_diag(mutref diags, module, at, "logical operand must have type `bool`");
        }
        if has_known_type_ctx(right_type_ctx) and right_type_ctx.head != "bool" {
            push_diag(mutref diags, module, at, "logical operand must have type `bool`");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let and_index = find_root_and_operator(ref tokens, expr_start, expr_end);
    if and_index >= 0 {
        let left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, and_index, at, empty_expected_type_ctx(), mutref diags);
        let right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, and_index + 1, expr_end, at, empty_expected_type_ctx(), mutref diags);
        if has_known_type_ctx(left_type_ctx) and left_type_ctx.head != "bool" {
            push_diag(mutref diags, module, at, "logical operand must have type `bool`");
        }
        if has_known_type_ctx(right_type_ctx) and right_type_ctx.head != "bool" {
            push_diag(mutref diags, module, at, "logical operand must have type `bool`");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let compare_index = find_root_compare_operator(ref tokens, expr_start, expr_end);
    if compare_index >= 0 {
        let mut left_type_ctx = empty_expected_type_ctx();
        let mut right_type_ctx = empty_expected_type_ctx();
        if span_is_contextual_integer_expr(ref tokens, expr_start, compare_index) {
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, compare_index + 1, expr_end, at, empty_expected_type_ctx(), mutref diags);
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, compare_index, at, integer_expected_ctx(right_type_ctx), mutref diags);
        } else {
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, compare_index, at, empty_expected_type_ctx(), mutref diags);
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, compare_index + 1, expr_end, at, integer_expected_ctx(left_type_ctx), mutref diags);
        }
        if has_known_type_ctx(left_type_ctx) and has_known_type_ctx(right_type_ctx) and not type_ctx_matches(left_type_ctx, right_type_ctx) {
            push_diag(mutref diags, module, at, "comparison operands must have matching types");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let additive_index = find_root_additive_operator(ref tokens, expr_start, expr_end);
    if additive_index >= 0 {
        let operand_expected = integer_expected_ctx(expected_ctx);
        let mut left_type_ctx = empty_expected_type_ctx();
        let mut right_type_ctx = empty_expected_type_ctx();
        if operand_expected.head == "" and span_is_contextual_integer_expr(ref tokens, expr_start, additive_index) {
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, additive_index + 1, expr_end, at, empty_expected_type_ctx(), mutref diags);
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, additive_index, at, integer_expected_ctx(right_type_ctx), mutref diags);
        } else {
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, additive_index, at, operand_expected, mutref diags);
            let mut right_expected = operand_expected;
            if right_expected.head == "" {
                right_expected = integer_expected_ctx(left_type_ctx);
            }
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, additive_index + 1, expr_end, at, right_expected, mutref diags);
        }
        if has_known_type_ctx(left_type_ctx) and not is_int_like(left_type_ctx.head) {
            push_diag(mutref diags, module, at, "arithmetic operand must have integer type");
        }
        if has_known_type_ctx(right_type_ctx) and not is_int_like(right_type_ctx.head) {
            push_diag(mutref diags, module, at, "arithmetic operand must have integer type");
        }
        if has_known_type_ctx(left_type_ctx) and has_known_type_ctx(right_type_ctx) and is_int_like(left_type_ctx.head) and is_int_like(right_type_ctx.head) and not type_ctx_matches(left_type_ctx, right_type_ctx) {
            push_diag(mutref diags, module, at, "arithmetic operands must have matching types");
        }
        return arithmetic_result_ctx(expected_ctx, left_type_ctx, right_type_ctx);
    }

    let multiplicative_index = find_root_multiplicative_operator(ref tokens, expr_start, expr_end);
    if multiplicative_index >= 0 {
        let operand_expected = integer_expected_ctx(expected_ctx);
        let mut left_type_ctx = empty_expected_type_ctx();
        let mut right_type_ctx = empty_expected_type_ctx();
        if operand_expected.head == "" and span_is_contextual_integer_expr(ref tokens, expr_start, multiplicative_index) {
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, multiplicative_index + 1, expr_end, at, empty_expected_type_ctx(), mutref diags);
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, multiplicative_index, at, integer_expected_ctx(right_type_ctx), mutref diags);
        } else {
            left_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, multiplicative_index, at, operand_expected, mutref diags);
            let mut right_expected = operand_expected;
            if right_expected.head == "" {
                right_expected = integer_expected_ctx(left_type_ctx);
            }
            right_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, multiplicative_index + 1, expr_end, at, right_expected, mutref diags);
        }
        if has_known_type_ctx(left_type_ctx) and not is_int_like(left_type_ctx.head) {
            push_diag(mutref diags, module, at, "arithmetic operand must have integer type");
        }
        if has_known_type_ctx(right_type_ctx) and not is_int_like(right_type_ctx.head) {
            push_diag(mutref diags, module, at, "arithmetic operand must have integer type");
        }
        if has_known_type_ctx(left_type_ctx) and has_known_type_ctx(right_type_ctx) and is_int_like(left_type_ctx.head) and is_int_like(right_type_ctx.head) and not type_ctx_matches(left_type_ctx, right_type_ctx) {
            push_diag(mutref diags, module, at, "arithmetic operands must have matching types");
        }
        return arithmetic_result_ctx(expected_ctx, left_type_ctx, right_type_ctx);
    }

    if span_is_list_expr(ref tokens, expr_start, expr_end) {
        return infer_list_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, expr_end, expected_ctx, mutref diags);
    }

    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_match => {
            return infer_match_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, expr_end, at, expected_ctx, mutref diags);
        },
        tk_kw_ref => {
            return infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start + 1, expr_end, current.start, empty_expected_type_ctx(), mutref diags);
        },
        tk_kw_mutref => {
            return infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start + 1, expr_end, current.start, empty_expected_type_ctx(), mutref diags);
        },
        tk_kw_not => {
            let inner_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start + 1, expr_end, current.start, empty_expected_type_ctx(), mutref diags);
            if has_known_type_ctx(inner_type_ctx) and inner_type_ctx.head != "bool" {
                push_diag(mutref diags, module, current.start, "logical operand must have type `bool`");
            }
            return make_expected_type_ctx("bool", "", "");
        },
        tk_minus => {
            let mut literal_start = expr_start + 1;
            let mut literal_end = expr_end;
            while span_is_wrapped_in_parens(ref tokens, literal_start, literal_end) {
                literal_start = literal_start + 1;
                literal_end = literal_end - 1;
            }
            if literal_start + 1 == literal_end {
                let literal = token_at(ref tokens, literal_start);
                match literal.kind {
                    tk_int_lit => {
                        return integer_literal_ctx(literal.text, true, expected_ctx, module, ref tokens, expr_start, expr_end, mutref diags);
                    },
                    _ => {
                    },
                }
            }
            let numeric_expected = integer_expected_ctx(expected_ctx);
            let inner_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start + 1, expr_end, current.start, numeric_expected, mutref diags);
            if has_known_type_ctx(inner_type_ctx) and not is_int_like(inner_type_ctx.head) {
                push_diag(mutref diags, module, current.start, "arithmetic operand must have integer type");
            }
            if is_int_like(inner_type_ctx.head) {
                return make_expected_type_ctx(inner_type_ctx.head, "", "");
            }
            return arithmetic_result_ctx(expected_ctx, inner_type_ctx, empty_expected_type_ctx());
        },
        tk_kw_true => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("bool", "", "");
            }
        },
        tk_kw_false => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("bool", "", "");
            }
        },
        tk_int_lit => {
            if expr_start + 1 == expr_end {
                return integer_literal_ctx(current.text, false, expected_ctx, module, ref tokens, expr_start, expr_end, mutref diags);
            }
        },
        tk_string_lit => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("str", "", "");
            }
        },
        tk_ident => {
            if span_is_call_expr(ref tokens, expr_start, expr_end) {
                return infer_call_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, expr_end, expected_ctx, mutref diags);
            }
            if span_is_struct_expr(ref tokens, expr_start, expr_end) {
                return infer_struct_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, expr_end, mutref diags);
            }
            if expr_start + 1 == expr_end or span_is_qualified_data_name(ref tokens, expr_start, expr_end) {
                let name_index = span_data_name_index(ref tokens, expr_start, expr_end);
                let name_token = token_at(ref tokens, name_index);
                let qualifier = span_data_qualifier(ref tokens, expr_start, expr_end);
                if qualifier == "" {
                    let binding_ctx = visible_typed_binding_ctx(ref typed_bindings, ref scopes, module, function_name, scope_id, name_token.text, name_token.start);
                    if binding_ctx.head != "" {
                        return binding_ctx;
                    }
                    let const_ctx = visible_const_ctx(ref consts, ref uses, ref items, module, name_token.text);
                    if const_ctx.head != "" {
                        return const_ctx;
                    }
                    return visible_zero_arg_variant_ctx(ref variants, ref uses, ref items, module, name_token.text, expected_ctx);
                }
                return qualified_zero_arg_variant_ctx(ref variants, ref uses, ref items, module, qualifier, name_token.text, expected_ctx);
            }
        },
        _ => {
        },
    }

    let dot_index = find_root_field_dot(ref tokens, expr_start, expr_end);
    if dot_index >= 0 {
        let field_token = token_at(ref tokens, dot_index + 1);
        match field_token.kind {
            tk_ident => {
                if dot_index + 2 == expr_end {
                    let base_type_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, expr_start, dot_index, field_token.start, empty_expected_type_ctx(), mutref diags);
                    if is_unsupported_type_ctx(base_type_ctx) {
                        return base_type_ctx;
                    }
                    if base_type_ctx.head == "" {
                        return empty_expected_type_ctx();
                    }
                    let origin_module = visible_type_origin_module(ref uses, ref items, module, base_type_ctx.head);
                    if origin_module == "" {
                        if base_type_ctx.head == "bool" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `bool`");
                            return empty_expected_type_ctx();
                        }
                        if is_int_like(base_type_ctx.head) {
                            push_diag(mutref diags, module, field_token.start, "field access base has integer type");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "str" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `str`");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "option" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `option`");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "result" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `result`");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "list" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `list`");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "token_kind" {
                            push_diag(mutref diags, module, field_token.start, "field access base has type `token_kind`");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "process_result" {
                            if field_token.text == "exit_code" {
                                return make_expected_type_ctx("i32", "", "");
                            }
                            if field_token.text == "stdout" or field_token.text == "stderr" {
                                return make_expected_type_ctx("str", "", "");
                            }
                            push_diag(mutref diags, module, field_token.start, "field does not exist on base type");
                            return empty_expected_type_ctx();
                        }
                        if base_type_ctx.head == "path_metadata" {
                            if field_token.text == "is_file" or field_token.text == "is_directory" or field_token.text == "is_symlink" {
                                return make_expected_type_ctx("bool", "", "");
                            }
                            if field_token.text == "size" or field_token.text == "modified_ns" {
                                return make_expected_type_ctx("i64", "", "");
                            }
                            if field_token.text == "mode" {
                                return make_expected_type_ctx("i32", "", "");
                            }
                            push_diag(mutref diags, module, field_token.start, "field does not exist on base type");
                            return empty_expected_type_ctx();
                        }
                        push_diag(mutref diags, module, field_token.start, "field access base does not name a readable product type");
                        return empty_expected_type_ctx();
                    }
                    let field_ctx = lookup_field_ctx(ref field_facts, origin_module, base_type_ctx.head, field_token.text);
                    if field_ctx.head == "" {
                        push_diag(mutref diags, module, field_token.start, "field does not exist on base type");
                        return empty_expected_type_ctx();
                    }
                    return field_ctx;
                }
            },
            _ => {
            },
        }
        push_stage1_limitation(mutref diags, module, at);
        return unsupported_type_ctx();
    }

    push_stage1_limitation(mutref diags, module, at);
    return unsupported_type_ctx();
}

fn infer_expr_type_name(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, at: i32, expected_ctx: expected_type_ctx, diags: mutref list<diag>) -> str {
    let ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref uses, ref items, module, function_name, scope_id, ref tokens, start, end, at, expected_ctx, mutref diags);
    return ctx.head;
}

fn is_const_safe_type(type_name: str, arg1_name: str, arg2_name: str, is_borrow: bool) -> bool {
    if is_borrow {
        return false;
    }
    if arg1_name != "" or arg2_name != "" {
        return false;
    }
    return type_name == "i32" or type_name == "i64" or type_name == "bool" or type_name == "str";
}

fn infer_const_expr_type_ctx(tokens: ref list<token>, start: i32, end: i32, expected_ctx: expected_type_ctx, module: str, at: i32, diags: mutref list<diag>) -> expected_type_ctx {
    let mut expr_start = expr_content_start(ref tokens, start, end);
    let mut expr_end = end;
    while span_is_wrapped_in_parens(ref tokens, expr_start, expr_end) {
        expr_start = expr_start + 1;
        expr_end = expr_end - 1;
    }
    if expr_start >= expr_end {
        push_diag(mutref diags, module, at, "const initializer cannot be empty");
        return empty_expected_type_ctx();
    }

    let or_index = find_root_or_operator(ref tokens, expr_start, expr_end);
    if or_index >= 0 {
        let bool_ctx = make_expected_type_ctx("bool", "", "");
        let left_type = infer_const_expr_type_ctx(ref tokens, expr_start, or_index, bool_ctx, module, at, mutref diags);
        let right_type = infer_const_expr_type_ctx(ref tokens, or_index + 1, expr_end, bool_ctx, module, at, mutref diags);
        if has_known_type_ctx(left_type) and left_type.head != "bool" {
            push_diag(mutref diags, module, at, "const logical operand must have type `bool`");
        }
        if has_known_type_ctx(right_type) and right_type.head != "bool" {
            push_diag(mutref diags, module, at, "const logical operand must have type `bool`");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let and_index = find_root_and_operator(ref tokens, expr_start, expr_end);
    if and_index >= 0 {
        let bool_ctx = make_expected_type_ctx("bool", "", "");
        let left_type = infer_const_expr_type_ctx(ref tokens, expr_start, and_index, bool_ctx, module, at, mutref diags);
        let right_type = infer_const_expr_type_ctx(ref tokens, and_index + 1, expr_end, bool_ctx, module, at, mutref diags);
        if has_known_type_ctx(left_type) and left_type.head != "bool" {
            push_diag(mutref diags, module, at, "const logical operand must have type `bool`");
        }
        if has_known_type_ctx(right_type) and right_type.head != "bool" {
            push_diag(mutref diags, module, at, "const logical operand must have type `bool`");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let compare_index = find_root_compare_operator(ref tokens, expr_start, expr_end);
    if compare_index >= 0 {
        let mut left_type = empty_expected_type_ctx();
        let mut right_type = empty_expected_type_ctx();
        if span_is_contextual_integer_expr(ref tokens, expr_start, compare_index) {
            right_type = infer_const_expr_type_ctx(ref tokens, compare_index + 1, expr_end, empty_expected_type_ctx(), module, at, mutref diags);
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, compare_index, integer_expected_ctx(right_type), module, at, mutref diags);
        } else {
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, compare_index, empty_expected_type_ctx(), module, at, mutref diags);
            right_type = infer_const_expr_type_ctx(ref tokens, compare_index + 1, expr_end, integer_expected_ctx(left_type), module, at, mutref diags);
        }
        if has_known_type_ctx(left_type) and has_known_type_ctx(right_type) and not type_ctx_matches(left_type, right_type) {
            push_diag(mutref diags, module, at, "const comparison operands must have matching types");
        }
        if has_known_type_ctx(left_type) and not is_int_like(left_type.head) {
            push_diag(mutref diags, module, at, "const comparison operand must have integer type");
        }
        if has_known_type_ctx(right_type) and not is_int_like(right_type.head) {
            push_diag(mutref diags, module, at, "const comparison operand must have integer type");
        }
        return make_expected_type_ctx("bool", "", "");
    }

    let additive_index = find_root_additive_operator(ref tokens, expr_start, expr_end);
    if additive_index >= 0 {
        let operand_expected = integer_expected_ctx(expected_ctx);
        let mut left_type = empty_expected_type_ctx();
        let mut right_type = empty_expected_type_ctx();
        if operand_expected.head == "" and span_is_contextual_integer_expr(ref tokens, expr_start, additive_index) {
            right_type = infer_const_expr_type_ctx(ref tokens, additive_index + 1, expr_end, empty_expected_type_ctx(), module, at, mutref diags);
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, additive_index, integer_expected_ctx(right_type), module, at, mutref diags);
        } else {
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, additive_index, operand_expected, module, at, mutref diags);
            let mut right_expected = operand_expected;
            if right_expected.head == "" {
                right_expected = integer_expected_ctx(left_type);
            }
            right_type = infer_const_expr_type_ctx(ref tokens, additive_index + 1, expr_end, right_expected, module, at, mutref diags);
        }
        if has_known_type_ctx(left_type) and not is_int_like(left_type.head) {
            push_diag(mutref diags, module, at, "const arithmetic operand must have integer type");
        }
        if has_known_type_ctx(right_type) and not is_int_like(right_type.head) {
            push_diag(mutref diags, module, at, "const arithmetic operand must have integer type");
        }
        if has_known_type_ctx(left_type) and has_known_type_ctx(right_type) and is_int_like(left_type.head) and is_int_like(right_type.head) and not type_ctx_matches(left_type, right_type) {
            push_diag(mutref diags, module, at, "const arithmetic operands must have matching types");
        }
        return arithmetic_result_ctx(expected_ctx, left_type, right_type);
    }

    let multiplicative_index = find_root_multiplicative_operator(ref tokens, expr_start, expr_end);
    if multiplicative_index >= 0 {
        let operand_expected = integer_expected_ctx(expected_ctx);
        let mut left_type = empty_expected_type_ctx();
        let mut right_type = empty_expected_type_ctx();
        if operand_expected.head == "" and span_is_contextual_integer_expr(ref tokens, expr_start, multiplicative_index) {
            right_type = infer_const_expr_type_ctx(ref tokens, multiplicative_index + 1, expr_end, empty_expected_type_ctx(), module, at, mutref diags);
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, multiplicative_index, integer_expected_ctx(right_type), module, at, mutref diags);
        } else {
            left_type = infer_const_expr_type_ctx(ref tokens, expr_start, multiplicative_index, operand_expected, module, at, mutref diags);
            let mut right_expected = operand_expected;
            if right_expected.head == "" {
                right_expected = integer_expected_ctx(left_type);
            }
            right_type = infer_const_expr_type_ctx(ref tokens, multiplicative_index + 1, expr_end, right_expected, module, at, mutref diags);
        }
        if has_known_type_ctx(left_type) and not is_int_like(left_type.head) {
            push_diag(mutref diags, module, at, "const arithmetic operand must have integer type");
        }
        if has_known_type_ctx(right_type) and not is_int_like(right_type.head) {
            push_diag(mutref diags, module, at, "const arithmetic operand must have integer type");
        }
        if has_known_type_ctx(left_type) and has_known_type_ctx(right_type) and is_int_like(left_type.head) and is_int_like(right_type.head) and not type_ctx_matches(left_type, right_type) {
            push_diag(mutref diags, module, at, "const arithmetic operands must have matching types");
        }
        return arithmetic_result_ctx(expected_ctx, left_type, right_type);
    }

    let current = token_at(ref tokens, expr_start);
    match current.kind {
        tk_kw_not => {
            let inner = infer_const_expr_type_ctx(ref tokens, expr_start + 1, expr_end, make_expected_type_ctx("bool", "", ""), module, current.start, mutref diags);
            if has_known_type_ctx(inner) and inner.head != "bool" {
                push_diag(mutref diags, module, current.start, "const logical operand must have type `bool`");
            }
            return make_expected_type_ctx("bool", "", "");
        },
        tk_minus => {
            let mut literal_start = expr_start + 1;
            let mut literal_end = expr_end;
            while span_is_wrapped_in_parens(ref tokens, literal_start, literal_end) {
                literal_start = literal_start + 1;
                literal_end = literal_end - 1;
            }
            if literal_start + 1 == literal_end {
                let literal = token_at(ref tokens, literal_start);
                match literal.kind {
                    tk_int_lit => {
                        return integer_literal_ctx(literal.text, true, expected_ctx, module, ref tokens, expr_start, expr_end, mutref diags);
                    },
                    _ => {
                    },
                }
            }
            let inner = infer_const_expr_type_ctx(ref tokens, expr_start + 1, expr_end, integer_expected_ctx(expected_ctx), module, current.start, mutref diags);
            if has_known_type_ctx(inner) and not is_int_like(inner.head) {
                push_diag(mutref diags, module, current.start, "const arithmetic operand must have integer type");
            }
            if is_int_like(inner.head) {
                return make_expected_type_ctx(inner.head, "", "");
            }
            return arithmetic_result_ctx(expected_ctx, inner, empty_expected_type_ctx());
        },
        tk_kw_true => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("bool", "", "");
            }
        },
        tk_kw_false => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("bool", "", "");
            }
        },
        tk_int_lit => {
            if expr_start + 1 == expr_end {
                return integer_literal_ctx(current.text, false, expected_ctx, module, ref tokens, expr_start, expr_end, mutref diags);
            }
        },
        tk_string_lit => {
            if expr_start + 1 == expr_end {
                return make_expected_type_ctx("str", "", "");
            }
        },
        _ => {
        },
    }

    push_diag(mutref diags, module, at, "stage1 limitation: unsupported const initializer expression");
    return unsupported_type_ctx();
}

type const_eval_value {
    bits: const_word,
    boolean: bool,
    failed: bool,
}

fn const_eval_empty() -> const_eval_value {
    return const_eval_value { bits: const_word_decimal("0", 4), boolean: false, failed: false };
}

fn evaluate_typed_const(tokens: ref list<token>, start: i32, end: i32, width: i32, module: str, diags: mutref list<diag>) -> const_eval_value {
    let mut lo = expr_content_start(ref tokens, start, end);
    let mut hi = end;
    while span_is_wrapped_in_parens(ref tokens, lo, hi) { lo = lo + 1; hi = hi - 1; }
    let mut out = const_eval_empty();
    let mut root = find_root_or_operator(ref tokens, lo, hi);
    if root < 0 { root = find_root_and_operator(ref tokens, lo, hi); }
    if root >= 0 {
        let left = evaluate_typed_const(ref tokens, lo, root, 4, module, mutref diags);
        if left.failed { return left; }
        match token_at(ref tokens, root).kind {
            tk_kw_or => { if left.boolean { return left; } },
            tk_kw_and => { if not left.boolean { return left; } },
            _ => {},
        }
        return evaluate_typed_const(ref tokens, root + 1, hi, 4, module, mutref diags);
    }
    root = find_root_compare_operator(ref tokens, lo, hi);
    if root >= 0 {
        // Const comparisons have no named operands; their unsuffixed integers are i32.
        let left = evaluate_typed_const(ref tokens, lo, root, 4, module, mutref diags);
        if left.failed { return left; }
        let right = evaluate_typed_const(ref tokens, root + 1, hi, 4, module, mutref diags);
        if right.failed { return right; }
        let order = const_word_compare(left.bits, right.bits, 4);
        match token_at(ref tokens, root).kind {
            tk_eqeq => { out.boolean = order == 0; },
            tk_noteq => { out.boolean = order != 0; },
            tk_lt => { out.boolean = order < 0; },
            tk_lte => { out.boolean = order <= 0; },
            tk_gt => { out.boolean = order > 0; },
            tk_gte => { out.boolean = order >= 0; },
            _ => {},
        }
        return out;
    }
    root = find_root_additive_operator(ref tokens, lo, hi);
    if root < 0 { root = find_root_multiplicative_operator(ref tokens, lo, hi); }
    if root >= 0 {
        let left = evaluate_typed_const(ref tokens, lo, root, width, module, mutref diags);
        if left.failed { return left; }
        let right = evaluate_typed_const(ref tokens, root + 1, hi, width, module, mutref diags);
        if right.failed { return right; }
        let op = token_at(ref tokens, root);
        match op.kind {
            tk_plus => { out.bits = const_word_add(left.bits, right.bits, width); },
            tk_minus => { out.bits = const_word_add(left.bits, const_word_neg(right.bits, width), width); },
            tk_star => { out.bits = const_word_mul(left.bits, right.bits, width); },
            tk_slash => {
                match const_word_div(left.bits, right.bits, width) {
                    Ok(value) => { out.bits = value; },
                    Err(reason) => {
                        let mut message = "constant integer division by zero";
                        if reason == 2 { message = "constant integer division overflow"; }
                        push_token_error_with_help(mutref diags, module, op, "NQ-TYPE-045", message, "Change the evaluated constant division; a zero divisor and minimum integer divided by -1 are not defined results.");
                        out.failed = true;
                    },
                }
            },
            _ => {},
        }
        return out;
    }
    let current = token_at(ref tokens, lo);
    match current.kind {
        tk_kw_not => {
            let inner = evaluate_typed_const(ref tokens, lo + 1, hi, 4, module, mutref diags);
            out.boolean = not inner.boolean;
            out.failed = inner.failed;
        },
        tk_minus => {
            let inner = evaluate_typed_const(ref tokens, lo + 1, hi, width, module, mutref diags);
            out.bits = const_word_neg(inner.bits, width);
            out.failed = inner.failed;
        },
        tk_kw_true => { out.boolean = true; },
        tk_kw_false => {},
        tk_int_lit => { out.bits = const_word_decimal(current.text, width); },
        tk_string_lit => {},
        _ => {
            push_diag(mutref diags, module, current.start, "stage1 limitation: missing typed constant evaluation");
            out.failed = true;
        },
    }
    return out;
}

pub fn typecheck_const_facts(consts: ref list<const_fact>, sources: ref list<source_file>, diags: mutref list<diag>) -> typecheck_summary
audit {
    intent("Validate top-level constants against the narrow stage1 const-expression subset");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);
    let mut index = 0;
    while index < list_len(ref consts) {
        let entry = list_get(ref consts, index);
        match entry {
            Some(value) => {
                let before_const = list_len(ref diags);
                if not is_const_safe_type(value.type_name, value.type_arg1_name, value.type_arg2_name, value.is_borrow) {
                    push_diag(mutref diags, value.module, value.at, "top-level const supports only non-borrow i32, i64, bool, or str in v1");
                }
                let text = module_source_text(ref sources, value.module);
                let tokens = lex(text);
                let expected = make_expected_type_ctx(value.type_name, value.type_arg1_name, value.type_arg2_name);
                let actual = infer_const_expr_type_ctx(ref tokens, value.expr_start, value.expr_end, expected, value.module, value.at, mutref diags);
                if has_known_type_ctx(actual) and not type_ctx_matches(expected, actual) {
                    push_diag(mutref diags, value.module, value.at, "const initializer does not match declared type");
                }
                if list_len(ref diags) == before_const {
                    let mut width = 4;
                    if value.type_name == "i64" { width = 8; }
                    let evaluated = evaluate_typed_const(ref tokens, value.expr_start, value.expr_end, width, value.module, mutref diags);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return make_typecheck_summary(0, 0, 0, list_len(ref diags) - start_diag_count);
}

fn pattern_payload_ctx(variant_payloads: ref list<variant_payload_fact>, variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, variant_name: str, scrutinee_ctx: expected_type_ctx, index: i32) -> expected_type_ctx {
    if builtin_variant_enum_name(variant_name) != "" {
        return builtin_variant_payload_ctx(variant_name, scrutinee_ctx, index);
    }
    return visible_variant_payload_ctx(ref variant_payloads, ref uses, ref items, module, variant_name, index);
}

fn typecheck_pattern_span(variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, scope_id: i32, tokens: ref list<token>, start: i32, end: i32, scrutinee_ctx: expected_type_ctx, resolved_bindings: mutref list<typed_binding_fact>, pattern_bindings: mutref list<pattern_binding_fact>, diags: mutref list<diag>) -> unit {
    let mut pattern_start = start;
    let mut pattern_end = end;
    while span_is_wrapped_in_parens(ref tokens, pattern_start, pattern_end) {
        pattern_start = pattern_start + 1;
        pattern_end = pattern_end - 1;
    }
    if pattern_start >= pattern_end {
        return;
    }
    let current = token_at(ref tokens, pattern_start);
    match current.kind {
        tk_int_lit => {
            if pattern_start + 1 == pattern_end {
                let i32_ctx = make_expected_type_ctx("i32", "", "");
                integer_literal_ctx(current.text, false, i32_ctx, module, ref tokens, pattern_start, pattern_end, mutref diags);
                if has_known_type_ctx(scrutinee_ctx) and scrutinee_ctx.head != "i32" {
                    push_diag(mutref diags, module, current.start, "integer literal patterns require an `i32` scrutinee");
                }
                return;
            }
        },
        tk_minus => {
            let value = token_at(ref tokens, pattern_start + 1);
            match value.kind {
                tk_int_lit => {
                    if pattern_start + 2 == pattern_end {
                        let i32_ctx = make_expected_type_ctx("i32", "", "");
                        integer_literal_ctx(value.text, true, i32_ctx, module, ref tokens, pattern_start, pattern_end, mutref diags);
                        if has_known_type_ctx(scrutinee_ctx) and scrutinee_ctx.head != "i32" {
                            push_diag(mutref diags, module, current.start, "integer literal patterns require an `i32` scrutinee");
                        }
                        return;
                    }
                },
                _ => {
                },
            }
        },
        tk_ident => {
            if current.text == "_" and pattern_start + 1 == pattern_end {
                return;
            }
            if span_is_call_expr(ref tokens, pattern_start, pattern_end) {
                let ctor_index = span_call_name_index(ref tokens, pattern_start, pattern_end);
                let ctor = token_at(ref tokens, ctor_index);
                let qualifier = span_call_qualifier(ref tokens, pattern_start, pattern_end);
                let mut ctor_enum_name = visible_variant_enum_name(ref variants, ref uses, ref items, module, ctor.text);
                if qualifier != "" {
                    ctor_enum_name = qualified_variant_enum_name(ref variants, ref uses, ref items, module, qualifier, ctor.text);
                }
                if ctor_enum_name == "" {
                    push_stage1_limitation(mutref diags, module, ctor.start);
                    return;
                }
                if has_known_type_ctx(scrutinee_ctx) and not type_names_match(scrutinee_ctx.head, ctor_enum_name) {
                    push_diag(mutref diags, module, ctor.start, "pattern does not match scrutinee type");
                }
                let open_index = span_call_open_index(ref tokens, pattern_start, pattern_end);
                let mut arg_start = open_index + 1;
                let arg_end_limit = pattern_end - 1;
                let mut arg_index = 0;
                while arg_start < arg_end_limit {
                    let segment_end = next_top_level_comma(ref tokens, arg_start, arg_end_limit);
                    let mut payload_ctx = pattern_payload_ctx(ref variant_payloads, ref variants, ref uses, ref items, module, ctor.text, scrutinee_ctx, arg_index);
                    if qualifier != "" {
                        payload_ctx = qualified_variant_payload_ctx(ref variant_payloads, ref variants, ref uses, ref items, module, qualifier, ctor.text, arg_index);
                    }
                    typecheck_pattern_span(ref variants, ref variant_payloads, ref uses, ref items, module, function_name, scope_id, ref tokens, arg_start, segment_end, payload_ctx, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
                    arg_index = arg_index + 1;
                    arg_start = segment_end + 1;
                }
                return;
            }
            if pattern_start + 1 == pattern_end or span_is_qualified_data_name(ref tokens, pattern_start, pattern_end) {
                let name_index = span_data_name_index(ref tokens, pattern_start, pattern_end);
                let name_token = token_at(ref tokens, name_index);
                let qualifier = span_data_qualifier(ref tokens, pattern_start, pattern_end);
                let mut zero_arg_ctx = visible_zero_arg_variant_ctx(ref variants, ref uses, ref items, module, name_token.text, scrutinee_ctx);
                if qualifier != "" {
                    zero_arg_ctx = qualified_zero_arg_variant_ctx(ref variants, ref uses, ref items, module, qualifier, name_token.text, scrutinee_ctx);
                    if zero_arg_ctx.head == "" {
                        push_stage1_limitation(mutref diags, module, name_token.start);
                        return;
                    }
                }
                if zero_arg_ctx.head != "" {
                    if has_known_type_ctx(scrutinee_ctx) and not type_ctx_matches(zero_arg_ctx, scrutinee_ctx) {
                        push_diag(mutref diags, module, name_token.start, "pattern does not match scrutinee type");
                    }
                    return;
                }
                if has_known_type_ctx(scrutinee_ctx) {
                    list_push(mutref resolved_bindings, make_typed_binding_fact(module, function_name, scope_id, current.text, current.start, scrutinee_ctx.head, scrutinee_ctx.arg1_name, scrutinee_ctx.arg2_name, false, false, false));
                    list_push(mutref pattern_bindings, make_pattern_binding_fact(module, function_name, scope_id, current.text, current.start, scrutinee_ctx.head, scrutinee_ctx.arg1_name, scrutinee_ctx.arg2_name, false, false));
                }
                return;
            }
        },
        _ => {
        },
    }
    push_stage1_limitation(mutref diags, module, current.start);
    return;
}

fn typecheck_match_arm(variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, functions: ref list<function_fact>, function_params: ref list<function_param_fact>, scopes: ref list<body_scope>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, module: str, function_name: str, tokens: ref list<token>, arm: match_arm_fact, resolved_bindings: mutref list<typed_binding_fact>, pattern_bindings: mutref list<pattern_binding_fact>, diags: mutref list<diag>) -> unit {
    let scrutinee_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, module, function_name, arm.scope_id, ref tokens, arm.scrutinee_start, arm.scrutinee_end, arm.at, empty_expected_type_ctx(), mutref diags);
    if is_unsupported_type_ctx(scrutinee_ctx) {
        return;
    }
    typecheck_pattern_span(ref variants, ref variant_payloads, ref uses, ref items, module, function_name, arm.scope_id, ref tokens, arm.pattern_start, arm.pattern_end, scrutinee_ctx, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
    return;
}

fn match_stmt_group_is_first(match_arms: ref list<match_arm_fact>, arm: match_arm_fact) -> bool {
    let mut index = 0;
    while index < list_len(ref match_arms) {
        let entry = list_get(ref match_arms, index);
        match entry {
            Some(value) => {
                if value.module == arm.module and value.function_name == arm.function_name and value.match_at == arm.match_at and not value.is_expression and value.at < arm.at {
                    return false;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return true;
}

fn match_stmt_group_has_default(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, match_arms: ref list<match_arm_fact>, module: str, function_name: str, match_at: i32, tokens: ref list<token>) -> bool {
    let mut index = 0;
    while index < list_len(ref match_arms) {
        let entry = list_get(ref match_arms, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.match_at == match_at and not value.is_expression {
                    if match_pattern_is_default(ref variants, ref uses, ref items, module, ref tokens, value.pattern_start, value.pattern_end) {
                        return true;
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn match_stmt_group_has_refined(match_arms: ref list<match_arm_fact>, module: str, function_name: str, match_at: i32, tokens: ref list<token>) -> bool {
    let mut index = 0;
    while index < list_len(ref match_arms) {
        let entry = list_get(ref match_arms, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.match_at == match_at and not value.is_expression {
                    if pattern_span_is_refined(ref tokens, value.pattern_start, value.pattern_end) {
                        return true;
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn validate_refined_match_stmt_groups(variants: ref list<variant_fact>, uses: ref list<module_use>, items: ref list<top_item>, match_arms: ref list<match_arm_fact>, module: str, function_name: str, tokens: ref list<token>, diags: mutref list<diag>) -> unit {
    let mut index = 0;
    while index < list_len(ref match_arms) {
        let entry = list_get(ref match_arms, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and not value.is_expression and match_stmt_group_is_first(ref match_arms, value) {
                    if match_stmt_group_has_refined(ref match_arms, module, function_name, value.match_at, ref tokens) and not match_stmt_group_has_default(ref variants, ref uses, ref items, ref match_arms, module, function_name, value.match_at, ref tokens) {
                        push_diag(mutref diags, module, value.match_at, "literal or nested constructor patterns require a wildcard or binding fallback arm");
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn let_else_payload_ctx(variant_name: str, scrutinee_ctx: expected_type_ctx, module: str, at: i32, diags: mutref list<diag>) -> expected_type_ctx {
    if variant_name == "Some" {
        if has_known_type_ctx(scrutinee_ctx) and scrutinee_ctx.head != "option" {
            push_diag(mutref diags, module, at, "let-else `Some` pattern requires an option scrutinee");
            return empty_expected_type_ctx();
        }
        if scrutinee_ctx.head == "option" {
            return expected_type_ctx_from_text(scrutinee_ctx.arg1_name);
        }
        return empty_expected_type_ctx();
    }
    if variant_name == "Ok" {
        if has_known_type_ctx(scrutinee_ctx) and scrutinee_ctx.head != "result" {
            push_diag(mutref diags, module, at, "let-else `Ok` pattern requires a result scrutinee");
            return empty_expected_type_ctx();
        }
        if scrutinee_ctx.head == "result" {
            return expected_type_ctx_from_text(scrutinee_ctx.arg1_name);
        }
        return empty_expected_type_ctx();
    }
    push_diag(mutref diags, module, at, "let-else V1 only supports `Some(name)` and `Ok(name)` patterns");
    return empty_expected_type_ctx();
}

fn local_init_is_let_else(local: local_init_fact) -> bool {
    return local.expr_member_name == "let_else";
}

fn local_init_is_propagate(local: local_init_fact) -> bool {
    return local.expr_member_name == "propagate";
}

fn result_ok_payload_ctx(result_ctx: expected_type_ctx) -> expected_type_ctx {
    if result_ctx.head == "result" {
        return expected_type_ctx_from_text(result_ctx.arg1_name);
    }
    return empty_expected_type_ctx();
}

fn propagation_typecheck_payload_ctx(actual_ctx: expected_type_ctx, return_ctx: expected_type_ctx, module: str, at: i32, diags: mutref list<diag>) -> expected_type_ctx {
    if actual_ctx.head != "result" {
        push_error(mutref diags, module, at, "NQ-PROPAGATE-001", diag_propagate, "`?` requires `result<T, E>`");
        return empty_expected_type_ctx();
    }
    if return_ctx.head != "result" {
        push_error(mutref diags, module, at, "NQ-PROPAGATE-002", diag_propagate, "`?` requires an enclosing function that returns `result<_, E>`");
        return empty_expected_type_ctx();
    }
    if not type_names_match(actual_ctx.arg2_name, return_ctx.arg2_name) {
        push_error(mutref diags, module, at, "NQ-PROPAGATE-003", diag_propagate, "propagated error type must match exactly; use let-else and return an explicitly mapped error");
        return empty_expected_type_ctx();
    }
    return result_ok_payload_ctx(actual_ctx);
}

fn list_iteration_element_ctx(list_ctx: expected_type_ctx, module: str, at: i32, diags: mutref list<diag>) -> expected_type_ctx {
    if list_ctx.head != "list" {
        push_diag(mutref diags, module, at, "`for` iterable must have type `list<T>`");
        return empty_expected_type_ctx();
    }
    if list_ctx.arg1_name == "" {
        push_diag(mutref diags, module, at, "cannot determine `for` loop element type from list iterable");
        return empty_expected_type_ctx();
    }
    return expected_type_ctx_from_text(list_ctx.arg1_name);
}

fn typecheck_for_binding(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, field_facts: ref list<field_fact>, uses: ref list<module_use>, items: ref list<top_item>, tokens: ref list<token>, current: stmt_fact, resolved_bindings: mutref list<typed_binding_fact>, diags: mutref list<diag>) -> unit {
    let iterable_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, current.expr_start, current.expr_end, current.at, empty_expected_type_ctx(), mutref diags);
    let element_ctx = list_iteration_element_ctx(iterable_ctx, current.module, current.at, mutref diags);
    let visiting: list<str> = list();
    if has_known_type_ctx(element_ctx) and not type_ctx_is_copy(element_ctx, current.module, ref variants, ref variant_payloads, ref field_facts, ref uses, ref items, ref visiting) {
        push_diag(mutref diags, current.module, current.at, "for over list<T> requires a copy element type in V1");
    }
    if current.name != "" and has_known_type_ctx(element_ctx) {
        list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.child_scope_id, current.name, current.at, element_ctx.head, element_ctx.arg1_name, element_ctx.arg2_name, false, false, false));
    }
    return;
}

fn type_text_contains_borrow(value: str) -> bool {
    if value == "" {
        return false;
    }
    if type_text_is_borrow(value) {
        return true;
    }
    return type_text_contains_borrow(type_text_arg1(value)) or type_text_contains_borrow(type_text_arg2(value));
}

fn type_shape_contains_borrow(arg1_name: str, arg2_name: str, is_borrow: bool) -> bool {
    return is_borrow or type_text_contains_borrow(arg1_name) or type_text_contains_borrow(arg2_name);
}

fn push_borrow_type_location_diag(diags: mutref list<diag>, module: str, at: i32) -> unit {
    push_error(mutref diags, module, at, "NQ-TYPE-003", diag_type, "borrow types are only allowed in function parameters in v0.1");
}

fn validate_borrow_type_locations(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, field_facts: ref list<field_fact>, diags: mutref list<diag>) -> unit {
    let mut function_index = 0;
    while function_index < list_len(ref functions) {
        let entry = list_get(ref functions, function_index);
        match entry {
            Some(value) => {
                if type_shape_contains_borrow(value.return_arg1_name, value.return_arg2_name, value.return_is_borrow) {
                    push_borrow_type_location_diag(mutref diags, value.module, value.at);
                }
            },
            None => {
            },
        }
        function_index = function_index + 1;
    }

    let mut param_index = 0;
    while param_index < list_len(ref function_params) {
        let entry = list_get(ref function_params, param_index);
        match entry {
            Some(value) => {
                if type_text_contains_borrow(value.type_arg1_name) or type_text_contains_borrow(value.type_arg2_name) {
                    push_borrow_type_location_diag(mutref diags, value.module, value.at);
                }
            },
            None => {
            },
        }
        param_index = param_index + 1;
    }

    let mut field_index = 0;
    while field_index < list_len(ref field_facts) {
        let entry = list_get(ref field_facts, field_index);
        match entry {
            Some(value) => {
                if type_shape_contains_borrow(value.field_type_arg1_name, value.field_type_arg2_name, value.field_is_borrow) {
                    push_borrow_type_location_diag(mutref diags, value.module, value.at);
                }
            },
            None => {
            },
        }
        field_index = field_index + 1;
    }

    let mut payload_index = 0;
    while payload_index < list_len(ref variant_payloads) {
        let entry = list_get(ref variant_payloads, payload_index);
        match entry {
            Some(value) => {
                if type_shape_contains_borrow(value.type_arg1_name, value.type_arg2_name, value.is_borrow) {
                    push_borrow_type_location_diag(mutref diags, value.module, value.at);
                }
            },
            None => {
            },
        }
        payload_index = payload_index + 1;
    }

    let mut const_index = 0;
    while const_index < list_len(ref consts) {
        let entry = list_get(ref consts, const_index);
        match entry {
            Some(value) => {
                if type_shape_contains_borrow(value.type_arg1_name, value.type_arg2_name, value.is_borrow) {
                    push_borrow_type_location_diag(mutref diags, value.module, value.at);
                }
            },
            None => {
            },
        }
        const_index = const_index + 1;
    }
}

pub fn typecheck_value_facts_with_stmt_facts(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, match_arms: ref list<match_arm_fact>, locals: ref list<local_init_fact>, returns: ref list<return_expr_fact>, conditions: ref list<condition_fact>, assignments: ref list<assignment_fact>, statements: ref list<stmt_fact>, uses: ref list<module_use>, items: ref list<top_item>, sources: ref list<source_file>, diags: mutref list<diag>) -> value_typecheck_summary
audit {
    intent("Run the selfhost type-checker slice over value flow, list iteration, and direct owned-local field assignments");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);
    validate_borrow_type_locations(ref functions, ref function_params, ref variant_payloads, ref consts, ref field_facts, mutref diags);
    let mut total_resolved_binding_count = 0;
    let mut ignored_pattern_bindings: list<pattern_binding_fact> = list();
    let mut source_index = 0;
    while source_index < list_len(ref sources) {
        let source_entry = list_get(ref sources, source_index);
        match source_entry {
            Some(current_source) => {
                let tokens = lex(current_source.text);
                let mut function_index = 0;
                while function_index < list_len(ref functions) {
                    let function_entry = list_get(ref functions, function_index);
                    match function_entry {
                        Some(current_function) => {
                            if current_function.module == current_source.name {
                                let function_scopes = clone_scopes_for_function(ref scopes, current_function.module, current_function.name);
                                let function_statements = clone_statements_for_function(ref statements, current_function.module, current_function.name);
                                let mut resolved_bindings = clone_typed_bindings_for_function(ref typed_bindings, current_function.module, current_function.name);
                                let function_match_arms = clone_match_arms_for_function(ref match_arms, current_function.module, current_function.name);
                                let function_locals = clone_local_inits_for_function(ref locals, current_function.module, current_function.name);
                                let function_assignments = clone_assignments_for_function(ref assignments, current_function.module, current_function.name);
                                let function_returns = clone_returns_for_function(ref returns, current_function.module, current_function.name);
                                let function_conditions = clone_conditions_for_function(ref conditions, current_function.module, current_function.name);
                                let function_for_statements = clone_for_statements_for_function(ref function_statements, current_function.module, current_function.name);

                                let mut local_index = 0;
                                let mut arm_index = 0;
                                let mut for_index = 0;
                                while local_index < list_len(ref function_locals) or arm_index < list_len(ref function_match_arms) or for_index < list_len(ref function_for_statements) {
                                    let mut next_local_at = 2147483647;
                                    let mut next_arm_at = 2147483647;
                                    let mut next_for_at = 2147483647;
                                    let local_entry = list_get(ref function_locals, local_index);
                                    match local_entry {
                                        Some(value) => {
                                            next_local_at = value.at;
                                        },
                                        None => {
                                        },
                                    }
                                    let arm_entry = list_get(ref function_match_arms, arm_index);
                                    match arm_entry {
                                        Some(value) => {
                                            next_arm_at = value.at;
                                        },
                                        None => {
                                        },
                                    }
                                    let for_entry = list_get(ref function_for_statements, for_index);
                                    match for_entry {
                                        Some(value) => {
                                            next_for_at = value.at;
                                        },
                                        None => {
                                        },
                                    }

                                    if next_for_at <= next_local_at and next_for_at <= next_arm_at {
                                        match for_entry {
                                            Some(current) => {
                                                typecheck_for_binding(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref field_facts, ref uses, ref items, ref tokens, current, mutref resolved_bindings, mutref diags);
                                            },
                                            None => {
                                            },
                                        }
                                        for_index = for_index + 1;
                                    } else {
                                    if next_arm_at <= next_local_at {
                                        match arm_entry {
                                            Some(current) => {
                                                typecheck_match_arm(ref variants, ref variant_payloads, ref consts, ref functions, ref function_params, ref function_scopes, ref field_facts, ref uses, ref items, current.module, current.function_name, ref tokens, current, mutref resolved_bindings, mutref ignored_pattern_bindings, mutref diags);
                                            },
                                            None => {
                                            },
                                        }
                                        arm_index = arm_index + 1;
                                    } else {
                                        match local_entry {
                                            Some(current) => {
                                                let mut expected_ctx = empty_expected_type_ctx();
                                                let mut expr_start = current.expr_start;
                                                let eq_token = token_at(ref tokens, expr_start);
                                                match eq_token.kind {
                                                    tk_eq => {
                                                        expr_start = expr_start + 1;
                                                    },
                                                    _ => {
                                                    },
                                                }
                                                if current.expected_type_name != "" {
                                                    expected_ctx = exact_typed_binding_ctx(ref resolved_bindings, current.module, current.function_name, current.scope_id, current.name, current.at);
                                                    if type_shape_contains_borrow(expected_ctx.arg1_name, expected_ctx.arg2_name, current.expected_is_borrow) {
                                                        push_borrow_type_location_diag(mutref diags, current.module, current.at);
                                                    }
                                                }
                                                let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, expr_start, current.expr_end, current.at, expected_ctx, mutref diags);
                                                if local_init_is_let_else(current) {
                                                    let payload_ctx = let_else_payload_ctx(current.expr_name, actual_ctx, current.module, current.at, mutref diags);
                                                    if current.name != "" and has_known_type_ctx(payload_ctx) {
                                                        list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, payload_ctx.head, payload_ctx.arg1_name, payload_ctx.arg2_name, current.is_mutable, false, false));
                                                    }
                                                } else {
                                                    if local_init_is_propagate(current) {
                                                        let return_ctx = visible_function_return_ctx(ref functions, ref uses, ref items, current.module, current.function_name);
                                                        let payload_ctx = propagation_typecheck_payload_ctx(actual_ctx, return_ctx, current.module, current.at, mutref diags);
                                                        if current.expected_type_name != "" {
                                                            if expected_ctx.head != "" and has_known_type_ctx(payload_ctx) and not type_ctx_matches(expected_ctx, payload_ctx) {
                                                                push_token_range_diag(mutref diags, current.module, ref tokens, expr_start, current.expr_end, "annotated local initializer does not match declared type");
                                                            }
                                                        }
                                                        if current.name != "" and has_known_type_ctx(payload_ctx) {
                                                            list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, payload_ctx.head, payload_ctx.arg1_name, payload_ctx.arg2_name, current.is_mutable, false, false));
                                                        }
                                                    } else {
                                                        if current.expected_type_name != "" {
                                                            if not current.expected_is_borrow {
                                                                if expected_ctx.head != "" and has_known_type_ctx(actual_ctx) and not type_ctx_matches(expected_ctx, actual_ctx) {
                                                                    push_token_range_diag(mutref diags, current.module, ref tokens, expr_start, current.expr_end, "annotated local initializer does not match declared type");
                                                                }
                                                            }
                                                        } else {
                                                            if current.name != "" and has_known_type_ctx(actual_ctx) {
                                                                list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, actual_ctx.head, actual_ctx.arg1_name, actual_ctx.arg2_name, current.is_mutable, false, false));
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            None => {
                                            },
                                        }
                                        local_index = local_index + 1;
                                    }
                                    }
                                }

                                let mut assignment_index = 0;
                                while assignment_index < list_len(ref function_assignments) {
                                    let assignment_entry = list_get(ref function_assignments, assignment_index);
                                    match assignment_entry {
                                        Some(current) => {
                                            let expected_ctx = visible_typed_binding_ctx(ref resolved_bindings, ref function_scopes, current.module, current.function_name, current.scope_id, current.target_name, current.at);
                                            if visible_assignment_target_is_for_binding(ref function_statements, ref function_scopes, current.module, current.function_name, current.scope_id, current.target_name, current.at) {
                                                push_diag(mutref diags, current.module, current.at, "`for` loop bindings are immutable");
                                            }
                                            if expected_ctx.head != "" {
                                                let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, current.expr_start, current.expr_end, current.at, expected_ctx, mutref diags);
                                                if has_known_type_ctx(actual_ctx) and not type_ctx_matches(expected_ctx, actual_ctx) {
                                                    push_diag(mutref diags, current.module, current.at, "assignment value does not match target type");
                                                }
                                            }
                                        },
                                        None => {
                                        },
                                    }
                                    assignment_index = assignment_index + 1;
                                }

                                let mut statement_index = 0;
                                while statement_index < list_len(ref function_statements) {
                                    let statement_entry = list_get(ref function_statements, statement_index);
                                    match statement_entry {
                                        Some(current) => {
                                            if current.module == current_function.module and current.function_name == current_function.name {
                                                match current.kind {
                                                    stmt_field_assign => {
                                                        let base_ctx = visible_typed_binding_ctx(ref resolved_bindings, ref function_scopes, current.module, current.function_name, current.scope_id, current.name, current.at);
                                                        if base_ctx.head != "" {
                                                            let is_owned_mutable_local = visible_mutable_local_stmt(ref function_statements, ref function_scopes, current.module, current.function_name, current.scope_id, current.name, current.at);
                                                            let is_borrow = visible_typed_binding_is_borrow(ref resolved_bindings, ref function_scopes, current.module, current.function_name, current.scope_id, current.name, current.at);
                                                            if not is_owned_mutable_local or is_borrow {
                                                                push_diag(mutref diags, current.module, current.at, "field assignment requires an owned mutable local product binding");
                                                            } else {
                                                                let origin_module = visible_type_origin_module(ref uses, ref items, current.module, base_ctx.head);
                                                                if origin_module == "" {
                                                                    push_diag(mutref diags, current.module, current.at, "field assignment target must be a user-defined product type");
                                                                } else {
                                                                    let expected_ctx = lookup_field_ctx(ref field_facts, origin_module, base_ctx.head, current.field_name);
                                                                    if expected_ctx.head == "" {
                                                                        push_diag(mutref diags, current.module, current.at, "field assignment target field does not exist on product type");
                                                                    } else {
                                                                        let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, current.expr_start, current.expr_end, current.at, expected_ctx, mutref diags);
                                                                        if has_known_type_ctx(actual_ctx) and not type_ctx_matches(expected_ctx, actual_ctx) {
                                                                            push_diag(mutref diags, current.module, current.at, "field assignment value does not match target field type");
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    },
                                                    _ => {
                                                    },
                                                }
                                            }
                                        },
                                        None => {
                                        },
                                    }
                                    statement_index = statement_index + 1;
                                }

                                let mut return_index = 0;
                                while return_index < list_len(ref function_returns) {
                                    let return_entry = list_get(ref function_returns, return_index);
                                    match return_entry {
                                        Some(current) => {
                                            let expected_return_ctx = visible_function_return_ctx(ref functions, ref uses, ref items, current.module, current.function_name);
                                            let expected_is_borrow = visible_function_return_is_borrow(ref functions, ref uses, ref items, current.module, current.function_name);
                                            if expected_return_ctx.head != "" and not expected_is_borrow {
                                                let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, current.expr_start, current.expr_end, current.at, expected_return_ctx, mutref diags);
                                                if has_known_type_ctx(actual_ctx) and not type_ctx_matches(expected_return_ctx, actual_ctx) {
                                                    push_diag(mutref diags, current.module, current.at, "return expression does not match function return type");
                                                }
                                            }
                                        },
                                        None => {
                                        },
                                    }
                                    return_index = return_index + 1;
                                }

                                let mut condition_index = 0;
                                while condition_index < list_len(ref function_conditions) {
                                    let condition_entry = list_get(ref function_conditions, condition_index);
                                    match condition_entry {
                                        Some(current) => {
                                            let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, current.expr_start, current.expr_end, current.at, make_expected_type_ctx("bool", "", ""), mutref diags);
                                            if has_known_type_ctx(actual_ctx) and actual_ctx.head != "bool" {
                                                match current.kind {
                                                    condition_if => {
                                                        push_diag(mutref diags, current.module, current.at, "`if` condition must have type `bool`");
                                                    },
                                                    condition_while => {
                                                        push_diag(mutref diags, current.module, current.at, "`while` condition must have type `bool`");
                                                    },
                                                }
                                            }
                                        },
                                        None => {
                                        },
                                    }
                                    condition_index = condition_index + 1;
                                }

                                validate_refined_match_stmt_groups(ref variants, ref uses, ref items, ref function_match_arms, current_function.module, current_function.name, ref tokens, mutref diags);
                                total_resolved_binding_count = total_resolved_binding_count + list_len(ref resolved_bindings);
                            }
                        },
                        None => {
                        },
                    }
                    function_index = function_index + 1;
                }
            },
            None => {
            },
        }
        source_index = source_index + 1;
    }

    return make_value_typecheck_summary(
        total_resolved_binding_count,
        list_len(ref locals),
        list_len(ref returns),
        list_len(ref conditions),
        list_len(ref assignments),
        list_len(ref diags) - start_diag_count
    );
}

pub fn typecheck_value_facts(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, match_arms: ref list<match_arm_fact>, locals: ref list<local_init_fact>, returns: ref list<return_expr_fact>, conditions: ref list<condition_fact>, assignments: ref list<assignment_fact>, uses: ref list<module_use>, items: ref list<top_item>, sources: ref list<source_file>, diags: mutref list<diag>) -> value_typecheck_summary
audit {
    intent("Run the established selfhost value type-checker API without statement-specific extensions");
    mutates(diags);
    effects();
}
{
    let empty_statements: list<stmt_fact> = list();
    return typecheck_value_facts_with_stmt_facts(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref locals, ref returns, ref conditions, ref assignments, ref empty_statements, ref uses, ref items, ref sources, mutref diags);
}

pub fn collect_resolved_binding_facts(functions: ref list<function_fact>, function_params: ref list<function_param_fact>, variants: ref list<variant_fact>, variant_payloads: ref list<variant_payload_fact>, consts: ref list<const_fact>, scopes: ref list<body_scope>, typed_bindings: ref list<typed_binding_fact>, field_facts: ref list<field_fact>, match_arms: ref list<match_arm_fact>, locals: ref list<local_init_fact>, statements: ref list<stmt_fact>, uses: ref list<module_use>, items: ref list<top_item>, sources: ref list<source_file>, resolved_bindings_out: mutref list<typed_binding_fact>, pattern_bindings_out: mutref list<pattern_binding_fact>, diags: mutref list<diag>) -> resolved_binding_summary
audit {
    intent("Materialize resolved binding and typed pattern facts for the structured checked handoff");
    mutates(resolved_bindings_out, pattern_bindings_out, diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);
    let start_binding_count = list_len(ref resolved_bindings_out);
    let start_pattern_binding_count = list_len(ref pattern_bindings_out);
    let mut source_index = 0;
    while source_index < list_len(ref sources) {
        let source_entry = list_get(ref sources, source_index);
        match source_entry {
            Some(current_source) => {
                let tokens = lex(current_source.text);
                let mut function_index = 0;
                while function_index < list_len(ref functions) {
                    let function_entry = list_get(ref functions, function_index);
                    match function_entry {
                        Some(current_function) => {
                            if current_function.module == current_source.name {
                                let function_scopes = clone_scopes_for_function(ref scopes, current_function.module, current_function.name);
                                let mut resolved_bindings = clone_typed_bindings_for_function(ref typed_bindings, current_function.module, current_function.name);
                                let function_match_arms = clone_match_arms_for_function(ref match_arms, current_function.module, current_function.name);
                                let function_locals = clone_local_inits_for_function(ref locals, current_function.module, current_function.name);
                                let function_for_statements = clone_for_statements_for_function(ref statements, current_function.module, current_function.name);

                                let mut local_index = 0;
                                let mut arm_index = 0;
                                let mut for_index = 0;
                                while local_index < list_len(ref function_locals) or arm_index < list_len(ref function_match_arms) or for_index < list_len(ref function_for_statements) {
                                    let mut next_local_at = 2147483647;
                                    let mut next_arm_at = 2147483647;
                                    let mut next_for_at = 2147483647;
                                    let local_entry = list_get(ref function_locals, local_index);
                                    match local_entry {
                                        Some(value) => {
                                            next_local_at = value.at;
                                        },
                                        None => {
                                        },
                                    }
                                    let arm_entry = list_get(ref function_match_arms, arm_index);
                                    match arm_entry {
                                        Some(value) => {
                                            next_arm_at = value.at;
                                        },
                                        None => {
                                        },
                                    }
                                    let for_entry = list_get(ref function_for_statements, for_index);
                                    match for_entry {
                                        Some(value) => {
                                            next_for_at = value.at;
                                        },
                                        None => {
                                        },
                                    }

                                    if next_for_at <= next_local_at and next_for_at <= next_arm_at {
                                        match for_entry {
                                            Some(current) => {
                                                typecheck_for_binding(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref field_facts, ref uses, ref items, ref tokens, current, mutref resolved_bindings, mutref diags);
                                            },
                                            None => {
                                            },
                                        }
                                        for_index = for_index + 1;
                                    } else {
                                    if next_arm_at <= next_local_at {
                                        match arm_entry {
                                            Some(current) => {
                                                typecheck_match_arm(ref variants, ref variant_payloads, ref consts, ref functions, ref function_params, ref function_scopes, ref field_facts, ref uses, ref items, current.module, current.function_name, ref tokens, current, mutref resolved_bindings, mutref pattern_bindings_out, mutref diags);
                                            },
                                            None => {
                                            },
                                        }
                                        arm_index = arm_index + 1;
                                    } else {
                                        match local_entry {
                                            Some(current) => {
                                                let mut expected_ctx = empty_expected_type_ctx();
                                                let mut expr_start = current.expr_start;
                                                let eq_token = token_at(ref tokens, expr_start);
                                                match eq_token.kind {
                                                    tk_eq => {
                                                        expr_start = expr_start + 1;
                                                    },
                                                    _ => {
                                                    },
                                                }
                                                if current.expected_type_name != "" {
                                                    expected_ctx = exact_typed_binding_ctx(ref resolved_bindings, current.module, current.function_name, current.scope_id, current.name, current.at);
                                                }
                                                let actual_ctx = infer_expr_type_ctx(ref functions, ref function_params, ref variants, ref variant_payloads, ref consts, ref function_scopes, ref resolved_bindings, ref field_facts, ref uses, ref items, current.module, current.function_name, current.scope_id, ref tokens, expr_start, current.expr_end, current.at, expected_ctx, mutref diags);
                                                if local_init_is_let_else(current) {
                                                    let payload_ctx = let_else_payload_ctx(current.expr_name, actual_ctx, current.module, current.at, mutref diags);
                                                    if current.name != "" and has_known_type_ctx(payload_ctx) {
                                                        list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, payload_ctx.head, payload_ctx.arg1_name, payload_ctx.arg2_name, current.is_mutable, false, false));
                                                    }
                                                } else {
                                                    if local_init_is_propagate(current) {
                                                        let return_ctx = visible_function_return_ctx(ref functions, ref uses, ref items, current.module, current.function_name);
                                                        let payload_ctx = propagation_typecheck_payload_ctx(actual_ctx, return_ctx, current.module, current.at, mutref diags);
                                                        if current.name != "" and has_known_type_ctx(payload_ctx) {
                                                            list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, payload_ctx.head, payload_ctx.arg1_name, payload_ctx.arg2_name, current.is_mutable, false, false));
                                                        }
                                                    } else {
                                                        if current.expected_type_name == "" {
                                                            if current.name != "" and has_known_type_ctx(actual_ctx) {
                                                                list_push(mutref resolved_bindings, make_typed_binding_fact(current.module, current.function_name, current.scope_id, current.name, current.at, actual_ctx.head, actual_ctx.arg1_name, actual_ctx.arg2_name, current.is_mutable, false, false));
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            None => {
                                            },
                                        }
                                        local_index = local_index + 1;
                                    }
                                    }
                                }

                                let mut resolved_index = 0;
                                while resolved_index < list_len(ref resolved_bindings) {
                                    let resolved_entry = list_get(ref resolved_bindings, resolved_index);
                                    match resolved_entry {
                                        Some(value) => {
                                            list_push(mutref resolved_bindings_out, value);
                                        },
                                        None => {
                                        },
                                    }
                                    resolved_index = resolved_index + 1;
                                }
                            }
                        },
                        None => {
                        },
                    }
                    function_index = function_index + 1;
                }
            },
            None => {
            },
        }
        source_index = source_index + 1;
    }

    return make_resolved_binding_summary(
        list_len(ref resolved_bindings_out) - start_binding_count,
        list_len(ref pattern_bindings_out) - start_pattern_binding_count,
        list_len(ref diags) - start_diag_count
    );
}
