type Pair {
    left: i64,
    right: i64,
}

fn main() -> i32 {
    if arg_count() != 2 { return 90; }
    let Some(mode) = arg_get(1) else { return 91; };
    if mode == "array" {
        print_line("generated list from_array");
        let values: list<Pair> = [Pair { left: 1, right: 2 }, Pair { left: 3, right: 4 }, Pair { left: 5, right: 6 }, Pair { left: 7, right: 8 }, Pair { left: 9, right: 10 }, Pair { left: 11, right: 12 }, Pair { left: 13, right: 14 }, Pair { left: 15, right: 16 }, Pair { left: 17, right: 18 }];
        if list_len(ref values) == 9 { return 92; }
        return 93;
    }
    if mode != "ok" and mode != "grow" { return 94; }
    let mut values: list<Pair> = [Pair { left: 1, right: 2 }, Pair { left: 3, right: 4 }];
    let Some(saved) = list_get(ref values, 0) else { return 95; };
    while list_len(ref values) < 8 {
        list_push(mutref values, Pair { left: 7, right: 11 });
    }
    let Some(first) = list_get(ref values, 0) else { return 96; };
    let Some(last) = list_get(ref values, 7) else { return 97; };
    if first.left != 1 or first.right != 2 or saved.left != 1 or saved.right != 2 { return 98; }
    if last.left != 7 or last.right != 11 or list_len(ref values) != 8 { return 99; }
    if mode == "grow" {
        print_line("generated list growth");
        list_push(mutref values, Pair { left: 19, right: 20 });
        return 100;
    }
    print_line("generated list allocation ok");
    return 0;
}
