fn wrong_args() -> result<process, io_err> {
    let args = [1];
    let env: list<str> = [];
    return process_start("/bin/true", ref args, ".", ref env, None, false, 0);
}
fn wrong_env() -> result<process, io_err> {
    let args: list<str> = [];
    let env = [1];
    return process_start(program: "/bin/true", args: ref args, cwd: ".", env: ref env, input: None, capture: false, max_output_bytes: 0);
}
fn main() -> i32 { return 0; }
