fn duration_eq(left: duration, right: duration) -> bool { return left == right; }
fn duration_ne(left: duration, right: duration) -> bool { return left != right; }
fn duration_lt(left: duration, right: duration) -> bool { return left < right; }
fn duration_lte(left: duration, right: duration) -> bool { return left <= right; }
fn duration_gt(left: duration, right: duration) -> bool { return left > right; }
fn duration_gte(left: duration, right: duration) -> bool { return left >= right; }
fn instant_eq(left: instant, right: instant) -> bool { return left == right; }
fn process_eq(left: ref process, right: ref process) -> bool { return left == right; }
fn main() -> i32 { return 0; }
