fn wrong_input(input: option<i64>) -> result<process, io_err> {
    let empty: list<str> = [];
    return process_start("/bin/cat", ref empty, ".", ref empty, input, true, 64);
}
fn wrong_deadline(child: process, deadline: option<duration>) -> result<process_outcome, io_err> {
    return process_wait(deadline: deadline, child: child);
}
fn main() -> i32 { return 0; }
