fn take_ref32(value: ref i32) -> i32 {
    return value;
}

fn forward_ref32(value: ref i32) -> i32 {
    return take_ref32(value);
}

fn take_mutref32(value: mutref i32) -> i32 {
    value = value + 1;
    return value;
}

fn forward_mutref32(value: mutref i32) -> i32 {
    return take_mutref32(value);
}

fn borrowed_names32(seed: str) -> bool {
    let named = edge32(seed, "seven");
    if take_ref32(ref named) != 7 or forward_ref32(ref named) != 7 { return false; }
    let mut mutable = edge32(seed, "max");
    if take_mutref32(mutref mutable) != -2147483648 or mutable != -2147483648 { return false; }
    mutable = edge32(seed, "seven");
    if forward_mutref32(mutref mutable) != 8 or mutable != 8 { return false; }
    return take_ref32(ref mutable) == 8;
}

fn take_ref64(value: ref i64) -> i64 {
    return value;
}

fn forward_ref64(value: ref i64) -> i64 {
    return take_ref64(value);
}

