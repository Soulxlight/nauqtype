}

fn main() -> i32 {
    if arg_count() != 3 { return 90; }
    let Some(mode) = arg_get(1) else { return 91; };
    let Some(seed) = arg_get(2) else { return 92; };
    let mut ok = false;
    if mode == "boundaries32" { ok = boundaries32(seed); }
    if mode == "boundaries64" { ok = boundaries64(seed); }
    if mode == "order32" { ok = order32(seed); }
    if mode == "order64" { ok = order64(seed); }
    if mode == "short" { ok = short_circuit(seed); }
    if mode == "borrow32" { ok = borrowed_names32(seed); }
    if mode == "borrow64" { ok = borrowed_names64(seed); }
    if mode == "local32" { ok = local_snapshot32(seed); }
    if mode == "local64" { ok = local_snapshot64(seed); }
    if mode == "field32" { ok = field_snapshot32(seed); }
    if mode == "field64" { ok = field_snapshot64(seed); }
    if mode == "context32" { ok = context_snapshot32(seed); }
    if mode == "context64" { ok = context_snapshot64(seed); }
    if mode == "zero32" {
        let value = trap32(edge32(seed, "seven"), "left") / trap32(edge32(seed, "zero"), "right");
        if value == 0 { return 93; }
    }
    if mode == "zero64" {
        let value = trap64(edge64(seed, "seven"), "left") / trap64(edge64(seed, "zero"), "right");
        if value == 0 { return 93; }
    }
    if mode == "overflow32" {
        let value = trap32(edge32(seed, "min"), "left") / trap32(-edge32(seed, "one"), "right");
        if value == 0 { return 93; }
    }
    if mode == "overflow64" {
        let value = trap64(edge64(seed, "min"), "left") / trap64(-edge64(seed, "one"), "right");
        if value == 0 { return 93; }
    }
    if not ok { return 94; }
    print_line("integer policy ok");
    return 0;
}
