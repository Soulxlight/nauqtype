    if take_ref64(ref named) != 7 or forward_ref64(ref named) != 7 { return false; }
    let mut mutable = edge64(seed, "max");
    if take_mutref64(mutref mutable) != -9223372036854775808 or mutable != -9223372036854775808 { return false; }
    mutable = edge64(seed, "seven");
