fn edge32(seed: str, name: str) -> i32 {
    if seed != "edge" { return 3; }
    if name == "max" { return 2147483647; }
    if name == "min" { return -2147483648; }
    if name == "one" { return 1; }
    if name == "two" { return 2; }
    if name == "seven" { return 7; }
    return 0;
}

fn edge64(seed: str, name: str) -> i64 {
    if seed != "edge" { return 3; }
    if name == "max" { return 9223372036854775807; }
    if name == "min" { return -9223372036854775808; }
    if name == "one" { return 1; }
    if name == "two" { return 2; }
    if name == "seven" { return 7; }
    return 0;
}

fn boundaries32(seed: str) -> bool {
    let hi = edge32(seed, "max");
    let lo = edge32(seed, "min");
    let one = edge32(seed, "one");
    let two = edge32(seed, "two");
    let seven = edge32(seed, "seven");
    if hi + one != lo or lo + (-one) != hi { return false; }
    if lo - one != hi or hi - (-one) != lo { return false; }
    if hi * two != -2 or lo * two != 0 { return false; }
    if hi * hi != 1 or lo * (-one) != lo { return false; }
    if -lo != lo or -hi != -2147483647 or -one != -1 { return false; }
    if seven / two != 3 or (-seven) / two != -3 { return false; }
    if seven / (-two) != -3 or (-seven) / (-two) != 3 { return false; }
    if one / two != 0 or (-one) / two != 0 { return false; }
    if lo / one != lo or lo / two != -1073741824 { return false; }
    if hi / (-one) != -2147483647 or lo / lo != 1 { return false; }
    if (hi + one) / two != -1073741824 { return false; }
    return true;
}

fn boundaries64(seed: str) -> bool {
    let hi = edge64(seed, "max");
    let lo = edge64(seed, "min");
    let one = edge64(seed, "one");
    let two = edge64(seed, "two");
    let seven = edge64(seed, "seven");
    if hi + one != lo or lo + (-one) != hi { return false; }
    if lo - one != hi or hi - (-one) != lo { return false; }
    if hi * two != -2 or lo * two != 0 { return false; }
    if hi * hi != 1 or lo * (-one) != lo { return false; }
    if -lo != lo or -hi != -9223372036854775807 or -one != -1 { return false; }
    if seven / two != 3 or (-seven) / two != -3 { return false; }
    if seven / (-two) != -3 or (-seven) / (-two) != 3 { return false; }
    if one / two != 0 or (-one) / two != 0 { return false; }
    if lo / one != lo or lo / two != -4611686018427387904 { return false; }
    if hi / (-one) != -9223372036854775807 or lo / lo != 1 { return false; }
    if (hi + one) / two != -4611686018427387904 { return false; }
    return true;
}

type Trace {
    order: i32,
    calls: i32,
}

fn mark32(trace: mutref Trace, value: i32, digit: i32) -> i32 {
    trace = Trace { order: trace.order * 10 + digit, calls: trace.calls + 1 };
    return value;
}

fn mark64(trace: mutref Trace, value: i64, digit: i32) -> i64 {
    trace = Trace { order: trace.order * 10 + digit, calls: trace.calls + 1 };
    return value;
}

fn order32(seed: str) -> bool {
    let hi = edge32(seed, "max");
    let lo = edge32(seed, "min");
    let one = edge32(seed, "one");
    let two = edge32(seed, "two");
    let mut trace = Trace { order: 0, calls: 0 };
    let sum = mark32(mutref trace, hi, 1) + mark32(mutref trace, one, 2);
    if sum != lo or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let difference = mark32(mutref trace, lo, 1) - mark32(mutref trace, one, 2);
    if difference != hi or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let product = mark32(mutref trace, hi, 1) * mark32(mutref trace, two, 2);
    if product != -2 or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let quotient = mark32(mutref trace, lo, 1) / mark32(mutref trace, two, 2);
    if quotient != -1073741824 or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let negative = -mark32(mutref trace, lo, 1);
    if negative != lo or trace.order != 1 or trace.calls != 1 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let nested = (mark32(mutref trace, hi, 1) + mark32(mutref trace, one, 2)) / mark32(mutref trace, two, 3);
    if nested != -1073741824 or trace.order != 123 or trace.calls != 3 { return false; }
    return true;
}

fn order64(seed: str) -> bool {
    let hi = edge64(seed, "max");
    let lo = edge64(seed, "min");
    let one = edge64(seed, "one");
    let two = edge64(seed, "two");
    let mut trace = Trace { order: 0, calls: 0 };
    let sum = mark64(mutref trace, hi, 1) + mark64(mutref trace, one, 2);
    if sum != lo or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let difference = mark64(mutref trace, lo, 1) - mark64(mutref trace, one, 2);
    if difference != hi or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let product = mark64(mutref trace, hi, 1) * mark64(mutref trace, two, 2);
    if product != -2 or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let quotient = mark64(mutref trace, lo, 1) / mark64(mutref trace, two, 2);
    if quotient != -4611686018427387904 or trace.order != 12 or trace.calls != 2 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let negative = -mark64(mutref trace, lo, 1);
    if negative != lo or trace.order != 1 or trace.calls != 1 { return false; }
    trace = Trace { order: 0, calls: 0 };
    let nested = (mark64(mutref trace, hi, 1) + mark64(mutref trace, one, 2)) / mark64(mutref trace, two, 3);
    if nested != -4611686018427387904 or trace.order != 123 or trace.calls != 3 { return false; }
    return true;
}

fn trap32(value: i32, label: str) -> i32 {
    print_line(label);
    return value;
}

fn trap64(value: i64, label: str) -> i64 {
    print_line(label);
    return value;
}

fn short_circuit(seed: str) -> bool {
    let zero32 = edge32(seed, "zero");
    let zero64 = edge64(seed, "zero");
    let lo32 = edge32(seed, "min");
    let lo64 = edge64(seed, "min");
    let mut trace = Trace { order: 0, calls: 0 };
    if false and mark32(mutref trace, 1, 1) / zero32 == 0 { return false; }
    if not (true or mark64(mutref trace, 1, 2) / zero64 == 0) { return false; }
    if false and mark64(mutref trace, lo64, 3) / -1 == 0 { return false; }
    if not (true or mark32(mutref trace, lo32, 4) / -1 == 0) { return false; }
    return trace.order == 0 and trace.calls == 0;
}

type Cell32 {
    value: i32,
    calls: i32,
}

fn replace32(value: mutref i32, calls: mutref i32, replacement: i32, right: i32, label: str) -> i32 {
    value = replacement;
    calls = calls + 1;
    print_line(label);
    return right;
}

fn replace_cell32(cell: mutref Cell32, replacement: i32, right: i32, label: str) -> i32 {
    cell = Cell32 { value: replacement, calls: cell.calls + 1 };
    print_line(label);
    return right;
}

fn returned_snapshot32(seed: str, calls: mutref i32) -> i32 {
    let mut value = edge32(seed, "one");
    return value / replace32(mutref value, mutref calls, -2147483648, -1, "return32");
}

fn take_first32(first: i32, second: i32) -> i32 {
    if second != -1 { return 99; }
    return first;
}

fn local_snapshot32(seed: str) -> bool {
    let mut value = edge32(seed, "one");
    let mut calls = 0;
    let quotient = value / replace32(mutref value, mutref calls, -2147483648, -1, "local32:div");
    if quotient != -1 or value != -2147483648 or calls != 1 { return false; }
    value = edge32(seed, "seven");
    let mut result: i32 = 0;
    result = value + replace32(mutref value, mutref calls, 40, 2, "local32:add");
    if result != 9 or value != 40 or calls != 2 { return false; }
    value = edge32(seed, "seven");
    let difference = value - replace32(mutref value, mutref calls, 40, 2, "local32:sub");
    if difference != 5 or value != 40 or calls != 3 { return false; }
    value = edge32(seed, "seven");
    let product = value * replace32(mutref value, mutref calls, 40, 2, "local32:mul");
    return product == 14 and value == 40 and calls == 4;
}

fn field_snapshot32(seed: str) -> bool {
    let mut cell = Cell32 { value: edge32(seed, "one"), calls: 0 };
    let quotient = cell.value / replace_cell32(mutref cell, -2147483648, -1, "field32:div");
    if quotient != -1 or cell.value != -2147483648 or cell.calls != 1 { return false; }
    cell.value = edge32(seed, "seven");
    let sum = cell.value + replace_cell32(mutref cell, 40, 2, "field32:add");
    if sum != 9 or cell.value != 40 or cell.calls != 2 { return false; }
    cell.value = edge32(seed, "seven");
    let difference = cell.value - replace_cell32(mutref cell, 40, 2, "field32:sub");
    if difference != 5 or cell.value != 40 or cell.calls != 3 { return false; }
    cell.value = edge32(seed, "seven");
    let product = cell.value * replace_cell32(mutref cell, 40, 2, "field32:mul");
    return product == 14 and cell.value == 40 and cell.calls == 4;
}

fn context_snapshot32(seed: str) -> bool {
    let mut calls = 0;
    if returned_snapshot32(seed, mutref calls) != -1 or calls != 1 { return false; }
    let mut value = edge32(seed, "one");
    if value < replace32(mutref value, mutref calls, 40, 2, "condition32") {
        if value != 40 or calls != 2 { return false; }
    } else { return false; }
    value = edge32(seed, "one");
    value = value / replace32(mutref value, mutref calls, -2147483648, -1, "assignment32");
    if value != -1 or calls != 3 { return false; }
    value = edge32(seed, "one");
    let captured = take_first32(value, replace32(mutref value, mutref calls, -2147483648, -1, "argument32"));
    if captured != 1 or value != -2147483648 or calls != 4 { return false; }
    let mut cell = Cell32 { value: edge32(seed, "one"), calls: 0 };
    let values: list<i32> = [cell.value, replace_cell32(mutref cell, -2147483648, -1, "list32")];
    let Some(first) = list_get(ref values, 0) else { return false; };
    let Some(second) = list_get(ref values, 1) else { return false; };
    return first == 1 and second == -1 and cell.value == -2147483648 and cell.calls == 1;
}

