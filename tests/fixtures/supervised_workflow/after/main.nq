pub fn apply(value: i32, bonus: i32) -> i32
audit {
    intent("Add a supervised bonus");
    mutates();
    effects();
}
{
    return value + bonus;
}

pub fn main() -> i32
audit {
    intent("Return the reviewed value with a supervised bonus");
    mutates();
    effects();
}
{
    let value: i32 = apply(bonus: 2, value: 40);
    return value;
}
