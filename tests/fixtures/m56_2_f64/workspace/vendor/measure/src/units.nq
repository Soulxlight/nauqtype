pub type Measurement {
    value: f64,
}

pub fn ratio(part: f64, whole: f64) -> option<f64>
audit {
    intent("Divide two dependency-owned measurements, refusing a zero whole");
    mutates();
    effects();
}
{
    if whole == 0.0 {
        return None;
    }
    return Some(part / whole);
}

pub fn percent(value: f64) -> str
audit {
    intent("Render a ratio as a percentage string");
    mutates();
    effects();
}
{
    return str_concat(str_from_f64(value * 100.0), "%");
}
