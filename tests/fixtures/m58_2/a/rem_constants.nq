// M58.2 slice A: `%` folds in integer constant initializers (C99 truncated
// remainder), and a dead `%` operand of `and`/`or` is never evaluated.
const PP32: i32 = 7 % 2;
const NP32: i32 = -7 % 2;
const PN32: i32 = 7 % -2;
const NN32: i32 = -7 % -2;
const ZERO32: i32 = 0 % 5;
const ZERO_NEG32: i32 = 0 % -5;
const SMALL32: i32 = -1 % 2;
const MIN_ONE32: i32 = -2147483648 % 1;
const MIN_THREE32: i32 = -2147483648 % 3;
const MAX_MIN32: i32 = 2147483647 % -2147483648;
const MIN_MAX32: i32 = -2147483648 % 2147483647;
const MAX_NEG_ONE32: i32 = 2147483647 % -1;
const MIXED32: i32 = 7 / 2 % 2 + 7 % 4 / 2 * 10 + 1 + 7 % 4 * 100;
const WRAPPED32: i32 = (2147483647 + 1) % 3;
const PP64: i64 = 7 % 2;
const NP64: i64 = -7 % 2;
const PN64: i64 = 7 % -2;
const NN64: i64 = -7 % -2;
const ZERO64: i64 = 0 % 5;
const ZERO_NEG64: i64 = 0 % -5;
const SMALL64: i64 = -1 % 2;
const MIN_ONE64: i64 = -9223372036854775808 % 1;
const MIN_THREE64: i64 = -9223372036854775808 % 3;
const MAX_MIN64: i64 = 9223372036854775807 % -9223372036854775808;
const MIN_MAX64: i64 = -9223372036854775808 % 9223372036854775807;
const MAX_NEG_ONE64: i64 = 9223372036854775807 % -1;
const MAX_THOUSAND64: i64 = 9223372036854775807 % 1000;
const MIXED64: i64 = 7 / 2 % 2 + 7 % 4 / 2 * 10 + 1 + 7 % 4 * 100;
const WRAPPED64: i64 = (9223372036854775807 + 1) % 3;
const DEAD_AND_ZERO: bool = false and (1 % 0 == 0);
const DEAD_OR_ZERO: bool = true or (1 % 0 == 0);
const DEAD_AND_OVERFLOW: bool = false and (-2147483648 % -1 == 0);
const DEAD_OR_OVERFLOW: bool = true or (-2147483648 % -1 == 0);
const LIVE_COMPARE: bool = 7 % 3 == 1 and -7 % 3 == -1;

fn main() -> i32 {
    if PP32 != 1 or NP32 != -1 or PN32 != 1 or NN32 != -1 { return 1; }
    if ZERO32 != 0 or ZERO_NEG32 != 0 or SMALL32 != -1 or MIN_ONE32 != 0 { return 2; }
    if MIN_THREE32 != -2 or MAX_MIN32 != 2147483647 or MIN_MAX32 != -1 or MAX_NEG_ONE32 != 0 { return 3; }
    if MIXED32 != 312 or WRAPPED32 != -2 { return 4; }
    if PP64 != 1 or NP64 != -1 or PN64 != 1 or NN64 != -1 { return 5; }
    if ZERO64 != 0 or ZERO_NEG64 != 0 or SMALL64 != -1 or MIN_ONE64 != 0 { return 6; }
    if MIN_THREE64 != -2 or MAX_MIN64 != 9223372036854775807 or MIN_MAX64 != -1 or MAX_NEG_ONE64 != 0 { return 7; }
    if MAX_THOUSAND64 != 807 or MIXED64 != 312 or WRAPPED64 != -2 { return 8; }
    if DEAD_AND_ZERO or not DEAD_OR_ZERO or DEAD_AND_OVERFLOW or not DEAD_OR_OVERFLOW { return 9; }
    if not LIVE_COMPARE { return 10; }
    print_line("remainder constants ok");
    return 0;
}
