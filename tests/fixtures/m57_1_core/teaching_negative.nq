// M57.1 teaching negatives: each new front-end diagnostic once. Expected
// diagnostics are pinned exactly by the integer-policy suite.

enum Step {
    Start,
    list_pop,
}

enum Light {
    Red,
    Amber,
    Green,
}

fn name(light: Light) -> str {
    let mut text = "";
    match light {
        Red => {
            text = "stop";
        },
        Green => {
            text = "go";
        },
    }
    return text;
}

fn main() -> i32 {
    let total = 0;
    total = 1;
    if "apple" < "pear" {
        return 1;
    }
    return 0;
}
