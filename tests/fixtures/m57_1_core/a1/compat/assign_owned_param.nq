// M57.1 compatibility (slice A1): `nauqc check` at 675819b fails late with
// NQ-INTERNAL-012 (review mutation identity); M57.1 rejects it with
// NQ-TYPE-007 at `value`.
fn twice(value: i32) -> i32
audit {
    intent("Assign to an owned parameter");
    mutates();
    effects();
}
{
    value = value * 2;
    return value;
}

fn main() -> i32
audit {
    intent("Call the probe");
    mutates();
    effects();
}
{
    return twice(0);
}
