// M57.1 repair (F1 arity): a qualified constructor call with the wrong number
// of payloads is rejected by the qualified variant's payload count.
use qualified_ctor_helper;

fn main() -> i32 {
    let shape = qualified_ctor_helper::Dot(3);
    match shape {
        qualified_ctor_helper::Dot(width, height) => {
            return width;
        },
        qualified_ctor_helper::Empty => {
            return 0;
        },
    }
}
