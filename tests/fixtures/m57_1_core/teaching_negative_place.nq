// M57.1 teaching negative: `mutref` needs a mutable-capable root. A `ref`
// parameter's field is not one (NQ-TYPE-012 names the root). Take
// `shelf: mutref Shelf` to write through the borrow.

type Shelf {
    items: list<str>,
    count: i32,
}

fn peek(shelf: ref Shelf) -> unit {
    list_push(mutref shelf.items, "extra");
    return;
}

fn main() -> i32 {
    return 0;
}
