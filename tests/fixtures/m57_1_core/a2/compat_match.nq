// M57.1 compatibility (NQ-TYPE-051). At 675819b `check` and `run` accepted
// this file and `describe(Green)` fell off the end of the function. Now
// `check` rejects the statement match: missing `Green`.
enum Color {
    Red,
    Green,
}

fn describe(color: Color) -> i32 {
    match color {
        Red => {
            return 1;
        },
    }
}

fn main() -> i32 {
    return describe(Green);
}
