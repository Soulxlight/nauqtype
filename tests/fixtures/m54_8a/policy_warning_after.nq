pub fn audited_public() -> i32
audit {
    intent("Keep the existing public function audited.");
    mutates();
    effects();
}
{
    return 0;
}

pub fn missing_review() -> i32 {
    return 0;
}

fn main() -> i32
audit {
    intent("Call the public function that intentionally lacks audit metadata.");
    mutates();
    effects();
}
{
    return audited_public() + missing_review();
}
