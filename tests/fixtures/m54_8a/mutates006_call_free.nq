fn unchanged(counter: mutref i32) -> unit
audit {
    intent("Declare a direct mutation without writing to the mutref parameter.");
    mutates(counter);
    effects();
}
{
    return;
}

fn main() -> i32
audit {
    intent("Keep the call-free overdeclaration warning nonfatal.");
    mutates();
    effects();
}
{
    let mut value = 0;
    unchanged(mutref value);
    return value;
}
