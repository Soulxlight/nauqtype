fn bump(counter: mutref i32) -> unit
audit {
    intent("Allow a trailing comma in a fixed audit argument list.");
    mutates(counter,);
    effects();
}
{
    counter = counter + 1;
    return;
}

fn main() -> i32
audit {
    intent("Run the trailing-comma mutation helper.");
    mutates();
    effects();
}
{
    let mut value = 0;
    bump(mutref value);
    return value - 1;
}
