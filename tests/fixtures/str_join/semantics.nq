fn forward_positional(parts: ref list<str>) -> str {
    return str_join(parts);
}

fn forward_named(parts: ref list<str>) -> str {
    return str_join(parts: parts);
}

fn main() -> i32 {
    let parts: list<str> = ["alpha", "-", "beta"];
    let positional = forward_positional(ref parts);
    let named = forward_named(ref parts);
    if positional != "alpha-beta" or named != positional { return 93; }
    print_line(positional);
    return 0;
}
