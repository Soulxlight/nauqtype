// Rejected: a qualified `?` call in the right operand of a root `and` inside
// `try` (NQ-TRY-004). Before the repair the `::` colons ended the operand
// scan, the program was accepted and `helper::fails()` ran.
use helper;

fn main() -> i32 {
    let r: result<bool, str> = try {
        false and helper::fails()?
    };
    match r {
        Ok(value) => {
            return 0;
        },
        Err(e) => {
            return 1;
        },
    }
}
