// Qualified-call targets for the M58.1 NQ-TRY-004 regressions: `::` is lexed
// as two `:` tokens, which must never end a short-circuit operand.

pub fn fails() -> result<bool, str>
audit {
    intent("Fail with an error payload");
    mutates();
    effects();
}
{
    return Err("called");
}

pub fn plain() -> bool
audit {
    intent("Return true");
    mutates();
    effects();
}
{
    return true;
}

pub fn text() -> result<str, str>
audit {
    intent("Succeed with a short text");
    mutates();
    effects();
}
{
    return Ok("t");
}

pub fn wrap<T>(value: T) -> result<T, str>
audit {
    intent("Wrap a value as success");
    mutates();
    effects();
}
{
    return Ok(value);
}
