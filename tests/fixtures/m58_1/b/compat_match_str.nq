// M58.1 compatibility (NQ-TYPE-054). At 86368fc `check` accepted a statement
// `match` on a `str` scrutinee with a binding arm. Now `check` rejects the
// scrutinee type with "cannot `match` on type `str`".
fn main() -> i32 {
    let name = "pear";
    match name {
        other => {
            return 1;
        },
    }
    return 0;
}
