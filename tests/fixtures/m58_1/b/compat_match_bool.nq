// M58.1 compatibility (NQ-TYPE-054). At 86368fc `check` accepted a statement
// `match` on a `bool` scrutinee with a fallback arm. Now `check` rejects the
// scrutinee type with "cannot `match` on type `bool`".
fn main() -> i32 {
    let ready = true;
    match ready {
        _ => {
            return 1;
        },
    }
    return 0;
}
