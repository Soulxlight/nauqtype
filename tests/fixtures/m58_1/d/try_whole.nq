fn first() -> result<i32, str> {
    return Ok(2);
}

fn second() -> result<i32, str> {
    return Ok(3);
}

fn main() -> i32 {
    let sum: result<i32, str> = try { (first() + second())? };
    match sum {
        Ok(_) => {
            return 0;
        },
        Err(_) => {
            return 1;
        },
    }
}
