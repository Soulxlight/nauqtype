// M58.1 rule 2 (initializer scope): a `let`-family local is visible from the
// end of its statement, so an inner `let x = x ...` reads the outer binding.
// Before M58.1 each initializer below read the new, zero-initialized local.
// The owned test runs this program with exact output and the same C under
// ASan/UBSan.

type Box {
    value: i32,
}

fn show(label: str, passed: bool) -> unit
audit {
    intent("Print one labeled check");
    mutates();
    effects(print);
}
{
    if passed {
        print_line(str_concat(label, " ok"));
    } else {
        print_line(str_concat(label, " WRONG"));
    }
    return;
}

fn double_ok(value: i32) -> result<i32, str> {
    return Ok(value * 2);
}

// Plain inferred `let mut` shadowing in an inner scope.
fn plain() -> bool {
    let x = 1;
    if true {
        let mut x = x + 1;
        x = x + 10;
        if x != 12 {
            return false;
        }
    }
    return x == 1;
}

// Typed shadowing, including a wider inner type.
fn typed() -> bool {
    let y: i32 = 5;
    if true {
        let y: i32 = y * 2;
        if y != 10 {
            return false;
        }
        if true {
            let y: i64 = i64_from_i32(y) + i64_from_i32(2147483647);
            if y != 2147483657 {
                return false;
            }
        }
    }
    return y == 5;
}

// A statement-boundary propagation local reads the outer binding.
fn propagated() -> result<i32, str> {
    let v = 3;
    if true {
        let v = double_ok(v)?;
        return Ok(v + 1);
    }
    return Ok(0);
}

// A `try` local reads the outer binding of the same name.
fn tried() -> bool {
    let w = 4;
    if true {
        let w: result<i32, str> = try {
            double_ok(w)?
        };
        match w {
            Ok(n) => {
                return n == 8;
            },
            Err(e) => {
                return false;
            },
        }
    }
    return false;
}

// Product and string initializers read the outer binding.
fn values() -> bool {
    let p = Box { value: 7 };
    let s = "a";
    if true {
        let p = Box { value: p.value + 1 };
        let s = str_concat(s, "b");
        if p.value != 8 or s != "ab" {
            return false;
        }
    }
    return p.value == 7 and s == "a";
}

// A `for` iterable names the variable the loop binding shadows.
fn iterable() -> bool {
    let items = [1, 2, 3];
    let mut sum = 0;
    for items in items {
        sum = sum + items;
    }
    return sum == 6 and list_len(ref items) == 3;
}

// Match-expression arms inside an initializer see the outer binding.
fn matched() -> bool {
    let n: option<i32> = Some(4);
    if true {
        let n = match n {
            Some(v) => v + 1,
            None => 0,
        };
        return n == 5;
    }
    return false;
}

fn main() -> i32 {
    show("plain", plain());
    show("typed", typed());
    let mut propagated_ok = false;
    match propagated() {
        Ok(n) => {
            propagated_ok = n == 7;
        },
        Err(e) => {
        },
    }
    show("propagated", propagated_ok);
    show("tried", tried());
    show("values", values());
    show("iterable", iterable());
    show("matched", matched());
    if plain() and typed() and propagated_ok and tried() and values() and iterable() and matched() {
        return 0;
    }
    return 1;
}
