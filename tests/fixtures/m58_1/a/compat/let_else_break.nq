// M58.1 compatibility: a let-else `else` block ending in `break` was rejected
// at 86368fc ("must exit explicitly with `return`"); it is accepted after
// M58.1 and exits the loop.

fn pick(n: i32) -> option<i32> {
    if n == 3 {
        return None;
    }
    return Some(n);
}

fn main() -> i32 {
    let mut total = 0;
    for n in [1, 2, 3, 4] {
        let Some(value) = pick(n) else {
            break;
        };
        total = total + value;
    }
    if total == 3 {
        return 0;
    }
    return 1;
}
