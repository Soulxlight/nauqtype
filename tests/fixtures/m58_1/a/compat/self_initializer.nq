// M58.1 compatibility: `let x = x;` with no outer `x`. At 86368fc the
// initializer resolved to the binding it declares and the program failed only
// in the checked handoff (four NQ-HANDOFF-001 "stage1 limitation" cascades);
// after M58.1 the initializer cannot see its own binding, so the resolver
// reports the unknown name and nothing follows.

fn main() -> i32 {
    let x = x;
    return x;
}
