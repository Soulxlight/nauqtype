// M58.1 rules 1 and 5: every accepted terminating form, and let-else `else`
// blocks that leave through `break` or `continue`. The owned test runs this
// program with exact output and the same C under ASan/UBSan.

enum Shape {
    Dot,
    Line,
    Square,
}

fn show(label: str, passed: bool) -> unit
audit {
    intent("Print one labeled check");
    mutates();
    effects(print);
}
{
    if passed {
        print_line(str_concat(label, " ok"));
    } else {
        print_line(str_concat(label, " WRONG"));
    }
    return;
}

fn even(n: i32) -> option<i32> {
    if n / 2 * 2 == n {
        return Some(n);
    }
    return None;
}

fn below(n: i32, limit: i32) -> option<i32> {
    if n < limit {
        return Some(n);
    }
    return None;
}

// `if`/`else` with a nested `if`/`else` inside the `else` block.
fn sign(n: i32) -> i32 {
    if n > 0 {
        return 1;
    } else {
        if n < 0 {
            return -1;
        } else {
            return 0;
        }
    }
}

// A statement `match` whose arms all return.
fn corners(shape: Shape) -> i32 {
    match shape {
        Dot => {
            return 0;
        },
        Line => {
            return 2;
        },
        Square => {
            return 4;
        },
    }
}

// `while true` with no `break`; the loop exits by `return`.
fn first_square_above(limit: i32) -> i32 {
    let mut i = 0;
    while true {
        i = i + 1;
        if i * i > limit {
            return i;
        }
    }
}

// A `break` inside a nested `while` targets the nested loop.
fn nested_while_break() -> i32 {
    let mut n = 0;
    while true {
        while n < 5 {
            n = n + 1;
            if n == 3 {
                break;
            }
        }
        return n;
    }
}

// A `break` inside a nested `for` targets the nested loop.
fn nested_for_break() -> i32 {
    let items = [1, 2, 3];
    let mut seen = 0;
    while true {
        for item in items {
            if item == 2 {
                break;
            }
            seen = seen + item;
        }
        return seen;
    }
}

// Statements after `return` are not diagnosed.
fn early() -> i32 {
    return 7;
    print_line("unreachable");
}

// A `unit` function ends with `return;`.
fn noop() -> unit {
    return;
}

// let-else `else` blocks may leave with `continue` and `break`.
fn let_else_while() -> i32 {
    let mut index = 0;
    let mut total = 0;
    while index < 20 {
        index = index + 1;
        let Some(value) = even(index) else {
            continue;
        };
        let Some(small) = below(value, 9) else {
            break;
        };
        total = total + small;
    }
    return total;
}

fn let_else_for() -> i32 {
    let mut total = 0;
    for n in [1, 2, 3, 4, 5, 6, 7, 8] {
        let Some(value) = even(n) else {
            continue;
        };
        let Some(small) = below(value, 6) else {
            break;
        };
        total = total + small;
    }
    return total;
}

// A let-else `else` block that ends in `if`/`else` with mixed exits.
fn let_else_mixed(limit: i32) -> i32 {
    let mut index = 0;
    let mut total = 0;
    while index < 10 {
        index = index + 1;
        let Some(value) = even(index) else {
            if index > limit {
                break;
            } else {
                continue;
            }
        };
        total = total + value;
    }
    return total;
}

fn let_else_return(n: i32) -> i32 {
    let Some(value) = even(n) else {
        return -1;
    };
    return value;
}

fn main() -> i32 {
    noop();
    show("if else", sign(5) == 1 and sign(-5) == -1 and sign(0) == 0);
    show("match arms", corners(Dot) + corners(Line) + corners(Square) == 6);
    show("while true", first_square_above(10) == 4);
    show("nested while break", nested_while_break() == 3);
    show("nested for break", nested_for_break() == 1);
    show("early return", early() == 7);
    show("let-else while", let_else_while() == 20);
    show("let-else for", let_else_for() == 6);
    show("let-else mixed", let_else_mixed(5) == 12);
    show("let-else return", let_else_return(4) == 4 and let_else_return(3) == -1);
    return 0;
}
