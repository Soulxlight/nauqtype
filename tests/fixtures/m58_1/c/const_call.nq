// M58.1 rule 4 fixture: NQ-TYPE-057 for a constant that calls a function

fn identity(value: i32) -> i32
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return value;
}

const PROBE: i32 = identity(1);

fn main() -> i32
audit {
    intent("probe");
    mutates();
    effects();
}
{

    return 0;
}