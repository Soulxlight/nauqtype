// M58.1 rule 4 fixture: NQ-PROPAGATE-007 for `?` in a field assignment

type Pair {
    left: i32,
    right: i32,
}

fn read_value() -> result<i32, str>
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return Ok(1);
}
fn read_flag() -> result<bool, str>
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return Ok(true);
}
fn read_values() -> result<list<i32>, str>
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return Ok([1, 2]);
}
fn twice(value: i32) -> i32
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return value * 2;
}
fn probe() -> result<i32, str>
audit {
    intent("probe");
    mutates();
    effects();
}
{
    let mut pair = Pair { left: 1, right: 2 };
    pair.left = read_value()?;
    return Ok(pair.left);
}fn main() -> i32
