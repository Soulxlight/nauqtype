// M58.1 rule 4 fixture: accepted neighbours of the rule-4 shapes (checks quietly)

const LIMIT: i32 = (1 + 2) * 3;
const WIDE: i64 = 4;
const READY: bool = not false and 1 < 2;

type Pair {
    left: i32,
    right: i32,
}

fn identity(value: i32) -> i32
audit {
    intent("probe");
    mutates();
    effects();
}
{
    return value;
}
fn main() -> i32
audit {
    intent("probe");
    mutates();
    effects();
}
{
    let pair = Pair { left: LIMIT, right: 2 };
    let half = 0.5;
    let large = 1.0e5;
    let scaled = half * large;
    let picked = match pair.left {
        9 => identity(pair.right),
        _ => 0,
    };
    identity(picked);
    if scaled < 0.0 or not READY or WIDE != 4 {
        return 1;
    }
    return 0;
}