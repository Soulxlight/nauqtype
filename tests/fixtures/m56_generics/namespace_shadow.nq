type Box {
    value: i32,
}

enum Choice {
    Packed(i32),
}

fn unused<T>() -> i32 {
    let Box = 9;
    let item = Box { value: Box };
    return item.value;
}

fn plain() -> i32 {
    let Box = 7;
    let item = Box { value: Box };
    return item.value;
}

fn patterns(Packed: i32, choice: Choice) -> i32 {
    match choice {
        Packed(item) => {
            if item != 7 or Packed != 11 {
                return 1;
            }
        },
    }
    return 0;
}

fn main() -> i32 {
    if plain() != 7 {
        return 1;
    }
    return patterns(11, Packed(7));
}
