fn main() -> i32 {
    let mut source = str_concat("A", "BC");
    let data = bytes_from_str(source);
    source = "replaced";
    if bytes_len(ref data) != 3 {
        return 1;
    }

    let first = bytes_get(ref data, 0);
    match first {
        Some(value) => {
            if value != 65 {
                return 2;
            }
        },
        None => {
            return 3;
        },
    }

    let missing = bytes_get(ref data, 3);
    match missing {
        Some(_) => {
            return 4;
        },
        None => {
            return 0;
        },
    }
}
