pub const base_score: i32 = 3;

pub type Box {
    value: i32,
    label: str,
}

pub enum Choice {
    Use(i32),
    Skip,
}

pub fn boost(input: i32, scale: i32) -> i32
audit {
    intent("Scale a score for evidence parity fixtures.");
    mutates();
    effects();
}
{
    return input * scale;
}

pub fn load_text(path: str) -> result<str, io_err>
audit {
    intent("Load fixture text for evidence parity propagation.");
    mutates();
    effects(io);
    propagates(io_err);
}
{
    let text = read_file(path)?;
    return Ok(text);
}
