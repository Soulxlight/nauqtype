fn score(flag: bool, path: str) -> result<i32, io_err>
audit {
    intent("Return a simple baseline score before the evidence parity change.");
    mutates();
    effects();
    propagates();
}
{
    if flag {
        return Ok(1);
    }
    return Ok(0);
}

fn main() -> i32
audit {
    intent("Run the baseline evidence parity program.");
    mutates();
    effects();
}
{
    let scored = score(true, "tests/fixtures/evidence_parity/input.txt");
    match scored {
        Ok(value) => {
            return value;
        },
        Err(_) => {
            return 1;
        },
    }
}
