type Label {
    text: str,
}

fn main() -> i32 {
    let labels: list<Label> = [Label { text: str_concat("na", "uq") }];
    match list_get(ref labels, 0) {
        Some(first) => {
            if first.text != "nauq" {
                return 1;
            }
        },
        None => {
            return 2;
        },
    }
    match list_get(ref labels, 0) {
        Some(second) => {
            if second.text != "nauq" {
                return 3;
            }
        },
        None => {
            return 4;
        },
    }
    return 0;
}
