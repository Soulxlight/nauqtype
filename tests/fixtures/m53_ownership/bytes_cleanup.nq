fn consume(payload: bytes) -> i64 {
    return bytes_len(ref payload);
}

fn main() -> i32 {
    let source = str_concat("ab", "c");
    let source_bytes = bytes_from_str(source);
    if source != "abc" {
        return 1;
    }
    let measured = consume(source_bytes);
    if measured != 3 {
        return 2;
    }

    let temporary_bytes = bytes_from_str("Z");
    let first = bytes_get(ref temporary_bytes, 0);
    match first {
        Some(value) => {
            if value != 90 {
                return 3;
            }
        },
        None => {
            return 4;
        },
    }
    return 0;
}
