type Cargo {
    values: list<i32>,
}

fn main() -> i32 {
    let cargoes: list<Cargo> = [Cargo { values: [1, 2] }];
    let first = list_get(ref cargoes, 0);
    match first {
        Some(value) => {
            return list_len(ref value.values);
        },
        None => {
            return 0;
        },
    }
}
