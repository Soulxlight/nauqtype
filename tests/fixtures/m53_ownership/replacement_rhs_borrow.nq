type NumberBox {
    values: list<i32>,
}

fn copy_numbers(values: ref list<i32>) -> list<i32> {
    let mut copied: list<i32> = list();
    let mut index = 0;
    while index < list_len(ref values) {
        match list_get(ref values, index) {
            Some(value) => {
                list_push(mutref copied, value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return copied;
}

fn main() -> i32 {
    let mut values: list<i32> = [1, 2, 3];
    values = copy_numbers(ref values);
    if list_len(ref values) != 3 {
        return 1;
    }

    let mut box = NumberBox { values: [4, 5] };
    box.values = copy_numbers(ref box.values);
    if list_len(ref box.values) != 2 {
        return 2;
    }
    return 0;
}
