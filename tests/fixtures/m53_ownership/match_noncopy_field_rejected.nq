type Cargo {
    values: list<i32>,
}

type Envelope {
    payload: option<Cargo>,
}

fn main() -> i32 {
    let envelope = Envelope {
        payload: Some(Cargo { values: [1, 2] }),
    };
    match envelope.payload {
        Some(_) => {
            return 1;
        },
        None => {
            return 0;
        },
    }
}
