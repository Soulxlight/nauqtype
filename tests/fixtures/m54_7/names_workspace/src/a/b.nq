pub const VALUE: i32 = 3;

pub type Box {
    int: str,
}

pub fn f() -> i32
audit {
    intent("Keep the nested module spelling distinct from a double-underscore symbol.");
    mutates();
    effects();
}
{
    return VALUE;
}

pub fn nested_boxed() -> option<Box>
audit {
    intent("Exercise a generic carrier over a nested-module product type.");
    mutates();
    effects();
}
{
    return Some(Box { int: str_concat("a", "bc") });
}
