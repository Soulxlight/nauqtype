enum Message {
    Text(str),
    Empty,
}

fn enum_len(value: Message) -> i32 {
    match value {
        Text(text) => { return str_len(text); },
        Empty => { return 0; },
    }
}

fn option_len(value: option<str>) -> i32 {
    match value {
        Some(text) => { return str_len(text); },
        None => { return 0; },
    }
}

fn result_len(value: result<str, str>) -> i32 {
    match value {
        Ok(text) => { return str_len(text); },
        Err(text) => { return str_len(text); },
    }
}

fn enum_statement(value: Message) -> i32 {
    match value {
        bound => { return enum_len(bound); },
        Text(_) => { return 90; },
        Empty => { return 91; },
    }
}

fn option_statement(value: option<str>) -> i32 {
    let mut count = 0;
    match value {
        _ => { count = 3; },
        Some(_) => { count = 92; },
        None => { count = 93; },
    }
    return count;
}

fn result_statement(value: result<str, str>) -> i32 {
    match value {
        bound => { return result_len(bound); },
        Ok(_) => { return 94; },
        Err(_) => { return 95; },
    }
}

fn enum_expression(value: Message) -> i32 {
    let count = match value {
        _ => 3,
        Text(_) => 96,
        Empty => 97,
    };
    return count;
}

fn option_expression(value: option<str>) -> i32 {
    let count = match value {
        bound => option_len(bound),
        Some(_) => 98,
        None => 99,
    };
    return count;
}

fn result_expression(value: result<str, str>) -> i32 {
    let count = match value {
        _ => 3,
        Ok(_) => 100,
        Err(_) => 101,
    };
    return count;
}

fn duplicate_statement(value: Message) -> i32 {
    match value {
        Text(text) => { return str_len(text); },
        Text(_) => { return 102; },
        _ => { return 0; },
    }
}

fn duplicate_expression(value: option<str>) -> str {
    let selected = match value {
        Some(text) => text,
        Some(_) => str_concat("wrong", "-duplicate"),
        _ => str_concat("fall", "back"),
    };
    return selected;
}

fn middle_fallback(value: result<str, str>) -> i32 {
    let count = match value {
        Err(text) => str_len(text),
        _ => 3,
        Ok(_) => 103,
    };
    return count;
}

fn loop_cleanup() -> i32 {
    let mut index = 0;
    let mut seen = 0;
    while index < 4 {
        index = index + 1;
        let value: option<str> = Some(str_concat("pay", "load"));
        match value {
            _ => {
                seen = seen + 1;
                if index == 4 {
                    break;
                }
                continue;
            },
            Some(_) => { return 104; },
            None => { return 105; },
        }
        return 106;
    }
    return seen;
}

fn counted(counter: mutref i32) -> Message {
    counter = counter + 1;
    return Text(str_concat("a", "bc"));
}

fn moved_payload(value: option<list<i32>>) -> list<i32> {
    let selected: list<i32> = match value {
        Some(items) => items,
        Some(_) => [99],
        _ => [8],
    };
    return selected;
}

fn once_and_binding_cleanup() -> i32 {
    let mut counter = 0;
    let chosen = match counted(mutref counter) {
        bound => enum_len(bound),
        _ => 107,
    };
    match counted(mutref counter) {
        _ => {},
        Text(_) => { return 108; },
        Empty => { return 109; },
    }
    if counter != 2 or chosen != 3 {
        return 110;
    }
    let mut index = 0;
    while index < 4 {
        index = index + 1;
        let value: option<str> = Some(str_concat("pay", "load"));
        match value {
            bound => {
                if option_len(bound) != 7 {
                    return 111;
                }
                if index < 4 {
                    continue;
                }
            },
            _ => { return 112; },
        }
    }
    return 0;
}

fn main() -> i32 {
    let mut index = 0;
    while index < 32 {
        let text = str_concat("a", "bc");
        if enum_statement(Text(text)) != 3 or option_statement(Some(text)) != 3 or result_statement(Ok(text)) != 3 {
            return 1;
        }
        if enum_expression(Text(text)) != 3 or option_expression(Some(text)) != 3 or result_expression(Err(text)) != 3 {
            return 2;
        }
        if duplicate_statement(Text(text)) != 3 or duplicate_statement(Empty) != 0 {
            return 3;
        }
        if duplicate_expression(Some(text)) != text or duplicate_expression(None) != "fallback" {
            return 4;
        }
        if middle_fallback(Ok(text)) != 3 or middle_fallback(Err(text)) != 3 {
            return 5;
        }
        if loop_cleanup() != 4 {
            return 6;
        }
        if once_and_binding_cleanup() != 0 {
            return 7;
        }
        let kept = moved_payload(Some([7]));
        let fallback = moved_payload(None);
        let Some(first) = list_get(ref kept, 0) else {
            return 8;
        };
        let Some(second) = list_get(ref fallback, 0) else {
            return 9;
        };
        if first != 7 or second != 8 {
            return 10;
        }
        index = index + 1;
    }
    return 0;
}
