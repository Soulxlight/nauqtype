{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauqtype.dev/schemas/evidence-error-v1.schema.json",
  "title": "Nauqtype Evidence Error Envelope v1",
  "type": "object",
  "required": [
    "version",
    "command",
    "requested_format",
    "ok",
    "stage",
    "code",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "command": {
      "enum": [
        "review-diff",
        "change-report"
      ]
    },
    "requested_format": {
      "type": "integer"
    },
    "ok": {
      "const": false
    },
    "stage": {
      "enum": [
        "before_load",
        "after_load",
        "before_check",
        "after_check"
      ]
    },
    "code": {
      "enum": [
        "NQ-EVIDENCE-001",
        "NQ-EVIDENCE-002",
        "NQ-EVIDENCE-003"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "command": {
          "const": "review-diff"
        },
        "requested_format": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    {
      "properties": {
        "command": {
          "const": "change-report"
        },
        "requested_format": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    }
  ]
}
