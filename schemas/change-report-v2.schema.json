{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauqtype.dev/schemas/change-report-v2.schema.json",
  "title": "Nauqtype Workspace Change Report v2",
  "type": "object",
  "required": ["version", "command", "ok", "identity_scheme", "before", "after", "evidence", "summary", "changes", "policy"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "command": { "const": "change-report" },
    "ok": { "type": "boolean" },
    "identity_scheme": { "const": "nauqtype.workspace.v1" },
    "before": { "$ref": "#/$defs/side" },
    "after": { "$ref": "#/$defs/side" },
    "evidence": { "type": "object" },
    "summary": { "type": "object" },
    "changes": { "type": "object" },
    "policy": { "type": "object" }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["workspace", "entry_module"],
      "additionalProperties": false,
      "properties": { "workspace": { "type": "string" }, "entry_module": { "type": "string" } }
    }
  }
}
