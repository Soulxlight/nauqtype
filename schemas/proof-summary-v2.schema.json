{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauqtype.dev/schemas/proof-summary-v2.schema.json",
  "title": "Nauqtype Proof Summary v2",
  "type": "object",
  "required": ["version", "command", "ok", "failed_phase", "failure", "phases", "selfhost", "corpus", "tooling"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "command": { "enum": ["prove", "prove-selfhost", "prove-corpus"] },
    "ok": { "type": "boolean" },
    "failed_phase": { "type": "string" },
    "failure": { "$ref": "#/$defs/failure" },
    "phases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phase" }
    },
    "selfhost": { "$ref": "#/$defs/selfhost" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "tooling": { "$ref": "#/$defs/tooling" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "hash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["phase", "corpus_id", "artifact_path"],
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "string" },
        "corpus_id": { "type": "string" },
        "artifact_path": { "type": "string" }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "group", "ordinal", "status", "artifact"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "selfhost.copy",
            "selfhost.stage1_emit_c",
            "selfhost.stage2_run",
            "selfhost.structural_c_compare",
            "corpus.emit_c",
            "corpus.build",
            "corpus.run",
            "corpus.structural_c_compare",
            "tooling.schema_golden",
            "tooling.policy_check",
            "tooling.refactor_plan",
            "tooling.formatter_check"
          ]
        },
        "group": { "enum": ["selfhost", "corpus", "tooling"] },
        "ordinal": { "type": "integer" },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "selfhost_artifacts": {
      "type": "object",
      "required": ["workspace_main", "stage1_c", "stage2_c"],
      "additionalProperties": false,
      "properties": {
        "workspace_main": { "$ref": "#/$defs/artifact" },
        "stage1_c": { "$ref": "#/$defs/artifact" },
        "stage2_c": { "$ref": "#/$defs/artifact" }
      }
    },
    "selfhost": {
      "type": "object",
      "required": ["status", "structural_c_equal", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped"] },
        "structural_c_equal": { "type": "boolean" },
        "artifacts": { "$ref": "#/$defs/selfhost_artifacts" }
      }
    },
    "corpus_artifact": {
      "type": "object",
      "required": ["id", "source", "emit_c", "build_c", "run_c"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "emit_c": { "$ref": "#/$defs/artifact" },
        "build_c": { "$ref": "#/$defs/artifact" },
        "run_c": { "$ref": "#/$defs/artifact" }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["status", "cases", "ids", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped"] },
        "cases": { "type": "integer" },
        "ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/corpus_artifact" }
        }
      }
    },
    "tooling": {
      "type": "object",
      "required": ["status", "groups"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped"] },
        "groups": {
          "type": "array",
          "items": { "enum": ["schema_golden", "policy_check", "refactor_plan", "formatter_check"] }
        }
      }
    }
  }
}
