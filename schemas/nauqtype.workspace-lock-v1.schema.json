{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauqtype.dev/schemas/nauqtype.workspace-lock-v1.schema.json",
  "title": "Nauqtype Workspace Lock v1",
  "type": "object",
  "required": ["version", "workspace", "dependencies"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "workspace-lock/v1" },
    "workspace": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "workspace", "path", "manifest_sha256", "source_sha256"],
        "additionalProperties": false,
        "properties": {
          "alias": { "type": "string" },
          "workspace": { "type": "string" },
          "path": { "type": "string" },
          "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
