{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauqtype.dev/schemas/nauqtype.workspace-lock-v2.schema.json",
  "title": "Nauqtype Captured Workspace Lock v2",
  "type": "object",
  "required": [
    "version",
    "workspace",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "workspace-lock/v2"
    },
    "workspace": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alias",
          "workspace",
          "path",
          "manifest_sha256",
          "legacy_source_sha256",
          "source_tree_format",
          "source_tree_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "legacy_source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_tree_format": {
            "const": "nauqtype-source-tree/v2"
          },
          "source_tree_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
