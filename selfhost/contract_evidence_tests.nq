use typecheck;

fn synthetic_mutation_expr(id: i32, kind: checked_expr_kind, binding_id: i32, name: str, target: checked_target_kind) -> checked_expr {
    let mut type_id = 1;
    if binding_id > 0 { type_id = 2; }
    match kind { checked_expr_name => { type_id = 1; }, _ => {}, }
    return checked_expr { id: id, function_id: 1, module_name: "probe", function_name: "owner", scope_id: 1, at: 0, start: 0, end: 1, kind: kind, type_name: "i32", type_arg1_name: "", type_arg2_name: "", is_borrow: binding_id > 0, borrow_mutable: binding_id > 0, type_id: type_id, binding_id: binding_id, name: name, target_kind: target, target_origin_module: "probe", target_at: -1, field_owner_module: "", field_owner_type: "", field_name: "" };
}

fn synthetic_mutation_link(parent: i32, index: i32, child: i32) -> checked_expr_child {
    return checked_expr_child { parent_expr_id: parent, index: index, child_expr_id: child, label_name: "", label_at: -1 };
}

fn mutation_identity_cases() -> bool {
    let mut case_id = 0;
    while case_id < 27 {
        let mut shapes: list<checked_type_shape> = list();
        list_push(mutref shapes, checked_type_shape { id: 1, kind: checked_type_i32, name: "i32", origin_module: "", arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 2, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 1, arg2_id: -1, mutable: true });
        list_push(mutref shapes, checked_type_shape { id: 3, kind: checked_type_list, name: "list", origin_module: "", arg1_id: 1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 4, kind: checked_type_named, name: "Box", origin_module: "probe", arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 5, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 4, arg2_id: -1, mutable: true });
        list_push(mutref shapes, checked_type_shape { id: 6, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 3, arg2_id: -1, mutable: false });
        let mut builtin_origin = "";
        if case_id == 26 { builtin_origin = "forged"; }
        list_push(mutref shapes, checked_type_shape { id: 7, kind: checked_type_process_result, name: "", origin_module: builtin_origin, arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 8, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 7, arg2_id: -1, mutable: true });
        list_push(mutref shapes, checked_type_shape { id: 9, kind: checked_type_str, name: "str", origin_module: "", arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 10, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 9, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 11, kind: checked_type_path_metadata, name: "", origin_module: "", arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 12, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 11, arg2_id: -1, mutable: true });
        list_push(mutref shapes, checked_type_shape { id: 13, kind: checked_type_i64, name: "i64", origin_module: "", arg1_id: -1, arg2_id: -1, mutable: false });
        list_push(mutref shapes, checked_type_shape { id: 14, kind: checked_type_ref, name: "ref", origin_module: "", arg1_id: 13, arg2_id: -1, mutable: false });
        let mut types: list<checked_type_decl> = list();
        if case_id != 19 { list_push(mutref types, checked_type_decl { id: 1, module_id: 1, module_name: "probe", name: "Box", at: 0 }); }
        let mut fields: list<checked_field_decl> = list();
        let mut field = checked_field_decl { type_id: 1, index: 0, module_name: "probe", type_name: "Box", name: "values", at: 0, field_type_name: "list", field_type_arg1_name: "i32", field_type_arg2_name: "", field_is_borrow: false, field_borrow_mutable: false, field_type_id: 3 };
        if case_id == 11 { field.module_name = "other"; }
        if case_id == 12 { field.type_id = 2; }
        if case_id == 13 { field.field_type_id = 1; }
        if case_id == 14 { field.field_is_borrow = true; }
        if case_id != 10 { list_push(mutref fields, field); }
        if case_id == 16 { list_push(mutref fields, field); }
        let mut functions: list<checked_function> = list();
        list_push(mutref functions, checked_function { id: 1, module_id: 1, module_name: "probe", name: "owner", at: 0, root_scope_id: 1, return_name: "unit", return_arg1_name: "", return_arg2_name: "", return_is_borrow: false, return_borrow_mutable: false, return_type_id: 1 });
        let mut bindings: list<checked_binding> = list();
        let mut owner = 1;
        let mut binding_type = 2;
        let mut binding_name = "i32";
        if case_id >= 8 { binding_type = 5; binding_name = "Box"; }
        if case_id == 15 { binding_type = 2; binding_name = "i32"; }
        if case_id >= 20 { binding_type = 8; binding_name = "process_result"; }
        if case_id == 21 { binding_type = 12; binding_name = "path_metadata"; }
        if case_id == 4 { owner = 2; }
        list_push(mutref bindings, checked_binding { id: 1, function_id: owner, module_name: "probe", function_name: "owner", scope_id: 1, name: "value", at: 0, kind: checked_binding_param, type_name: binding_name, type_arg1_name: "", type_arg2_name: "", is_borrow: true, borrow_mutable: true, type_id: binding_type, origin_stmt_id: -1, origin_arm_id: -1, param_index: 0 });
        let mut params: list<checked_param> = list();
        list_push(mutref params, checked_param { function_id: 1, binding_id: 1, module_name: "probe", function_name: "owner", index: 0, name: "value", at: 0, type_name: binding_name, type_arg1_name: "", type_arg2_name: "", is_borrow: true, borrow_mutable: true, type_id: binding_type });
        if case_id == 6 { match list_get(ref params, 0) { Some(param) => { list_push(mutref params, param); }, None => {}, } }
        let statements: list<checked_stmt> = list();
        let mut expressions: list<checked_expr> = list();
        let mut children: list<checked_expr_child> = list();
        let mut name = "list_push";
        let mut target = checked_target_builtin_function;
        if case_id == 1 { name = "future_builtin"; }
        if case_id == 5 { name = "missing"; target = checked_target_function; }
        if case_id >= 8 { name = "list_len"; }
        list_push(mutref expressions, synthetic_mutation_expr(1, checked_expr_call, -1, name, target));
        if case_id >= 8 {
            let mut borrow_expr = synthetic_mutation_expr(2, checked_expr_ref, 1, "value", checked_target_none);
            borrow_expr.type_id = 6;
            borrow_expr.borrow_mutable = false;
            if case_id == 17 { borrow_expr.type_id = 2; }
            if case_id >= 20 { borrow_expr.type_id = 10; }
            if case_id == 21 { borrow_expr.type_id = 14; }
            if case_id == 23 { borrow_expr.type_id = 6; }
            list_push(mutref expressions, borrow_expr);
            let mut field_expr = checked_expr { id: 3, function_id: 1, module_name: "probe", function_name: "owner", scope_id: 1, at: 0, start: 0, end: 1, kind: checked_expr_field, type_name: "list", type_arg1_name: "i32", type_arg2_name: "", is_borrow: false, borrow_mutable: false, type_id: 3, binding_id: -1, name: "", target_kind: checked_target_none, target_origin_module: "", target_at: -1, field_owner_module: "probe", field_owner_type: "Box", field_name: "values" };
            if case_id >= 20 { field_expr.type_id = 9; field_expr.field_owner_module = ""; field_expr.field_owner_type = "process_result"; field_expr.field_name = "stdout"; }
            if case_id == 21 { field_expr.type_id = 13; field_expr.field_owner_type = "path_metadata"; field_expr.field_name = "size"; }
            if case_id == 22 { field_expr.field_name = "missing"; }
            if case_id == 23 { field_expr.type_id = 3; }
            if case_id == 24 { field_expr.field_owner_type = "Box"; }
            if case_id == 25 { field_expr.field_owner_module = "other"; }
            list_push(mutref expressions, field_expr);
            let mut base_expr = synthetic_mutation_expr(4, checked_expr_name, 1, "value", checked_target_none);
            base_expr.type_id = 4;
            if case_id == 15 { base_expr.type_id = 1; }
            if case_id >= 20 { base_expr.type_id = 7; }
            if case_id == 21 { base_expr.type_id = 11; }
            base_expr.type_name = binding_name;
            if case_id == 18 { base_expr.borrow_mutable = false; }
            list_push(mutref expressions, base_expr);
            list_push(mutref children, synthetic_mutation_link(1, 0, 2));
            list_push(mutref children, synthetic_mutation_link(2, 0, 3));
            if case_id != 9 { list_push(mutref children, synthetic_mutation_link(3, 0, 4)); }
        }
        if case_id < 8 and case_id != 1 and case_id != 5 {
            list_push(mutref expressions, synthetic_mutation_expr(2, checked_expr_mutref, 1, "value", checked_target_none));
            list_push(mutref expressions, synthetic_mutation_expr(3, checked_expr_name, 1, "value", checked_target_none));
            list_push(mutref expressions, synthetic_mutation_expr(4, checked_expr_i32, -1, "1", checked_target_none));
            if case_id != 2 { list_push(mutref children, synthetic_mutation_link(1, 0, 2)); }
            if case_id == 3 { list_push(mutref children, synthetic_mutation_link(1, 0, 2)); }
            list_push(mutref children, synthetic_mutation_link(1, 1, 4));
            if case_id != 7 { list_push(mutref children, synthetic_mutation_link(2, 0, 3)); }
        }
        let mut writes: list<review_direct_mutation> = list();
        let mut coverage: list<review_mutation_coverage> = list();
        let mut diags: list<diag> = list();
        collect_review_mutations(ref functions, ref bindings, ref params, ref statements, ref expressions, ref children, ref shapes, ref types, ref fields, mutref writes, mutref coverage, mutref diags);
        if case_id < 2 or case_id == 8 or case_id == 20 or case_id == 21 {
            if list_len(ref diags) != 0 or list_len(ref coverage) != 1 { return false; }
            if case_id == 0 and list_len(ref writes) != 1 { return false; }
            if case_id == 1 and list_len(ref writes) != 0 { return false; }
            if case_id >= 8 and list_len(ref writes) != 0 { return false; }
            match list_get(ref coverage, 0) { Some(value) => { if value.partial != (case_id == 1) { return false; } }, None => { return false; }, }
        } else {
            if list_len(ref diags) != 1 { return false; }
            match list_get(ref diags, 0) { Some(value) => { if value.code != "NQ-INTERNAL-012" { return false; } }, None => { return false; }, }
        }
        case_id = case_id + 1;
    }
    return true;
}

fn evidence_command(driver: str, command: str, before: str, after: str, format: str, policy: str) -> result<process_result, io_err> {
    let mut args: list<str> = list();
    list_push(mutref args, command);
    list_push(mutref args, before);
    if after != "" { list_push(mutref args, after); }
    if policy != "" { list_push(mutref args, "--policy"); list_push(mutref args, policy); }
    if format != "" { list_push(mutref args, "--format"); list_push(mutref args, format); }
    return run_process(driver, ref args, ".");
}

fn evidence_contains(text: str, needle: str) -> bool {
    let mut index = 0;
    while index + str_len(needle) <= str_len(text) {
        if starts_with_at(text, index, needle) { return true; }
        index = index + 1;
    }
    return false;
}

fn evidence_count(text: str, needle: str) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index + str_len(needle) <= str_len(text) {
        if starts_with_at(text, index, needle) { count = count + 1; }
        index = index + 1;
    }
    return count;
}

fn evidence_expect(label: str, result: result<process_result, io_err>, exit_code: i32, first: str, second: str) -> bool {
    match result {
        Ok(status) => {
            let output = str_concat(status.stdout, status.stderr);
            if status.exit_code == exit_code and evidence_contains(output, first) and evidence_contains(output, second) and not evidence_contains(output, "stage1 limitation") and not evidence_contains(output, "stage1 internal error") and evidence_valid_new_json(status.stdout) { return true; }
            eprint_line(str_concat(label, " failed"));
            eprint_line(output);
            return false;
        },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
}

fn evidence_valid_new_json(output: str) -> bool {
    let mut path = "";
    if evidence_contains(output, "\"requested_format\":") { path = "schemas/evidence-error-v1.schema.json"; }
    if evidence_contains(output, "\"version\": 4,") { path = "schemas/review-v4.schema.json"; }
    if evidence_contains(output, "\"version\": 3,") and evidence_contains(output, "\"command\": \"change-report\"") { path = "schemas/change-report-v3.schema.json"; }
    if path == "" { return true; }
    match read_file(path) {
        Ok(schema) => { return schema_profile_accepts(schema, output); },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
}

fn evidence_golden(label: str, result: result<process_result, io_err>, path: str) -> bool {
    match result {
        Ok(status) => {
            match read_file(path) {
                Ok(golden) => { if status.exit_code == 0 and status.stderr == "" and status.stdout == golden and evidence_valid_new_json(status.stdout) { return true; } },
                Err(err) => { eprint_line(io_err_text(err)); return false; },
            }
            eprint_line(str_concat(label, " did not match golden"));
            eprint_line(status.stdout);
            eprint_line(status.stderr);
            return false;
        },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
}

fn checked_call_identity_cases() -> bool {
    let calls = [make_call_fact("probe", "owner", "process_wait", 20, 2)];
    let mut expr = synthetic_mutation_expr(1, checked_expr_call, -1, "process_wait", checked_target_function);
    expr.target_at = 20;
    expr.target_origin_module = "provider";
    let mut expressions = [expr];
    let mut diags: list<diag> = list();
    let resolved = checked_evidence_calls(ref calls, ref expressions, mutref diags);
    if list_len(ref diags) != 0 or list_len(ref resolved) != 1 { return false; }
    match list_get(ref resolved, 0) {
        Some(value) => { if value.checked_origin != "provider" or value.checked_kind != "function" or value.at != 20 { return false; } },
        None => { return false; },
    }
    let mut later = expr;
    later.target_at = 40;
    let mut other = expr;
    other.function_name = "other";
    expressions = [expr, other, later];
    let more_calls = [make_call_fact("probe", "owner", "process_wait", 20, 2), make_call_fact("probe", "owner", "process_wait", 40, 2)];
    let split_runs = checked_evidence_calls(ref more_calls, ref expressions, mutref diags);
    if list_len(ref diags) != 0 or list_len(ref split_runs) != 2 { return false; }
    list_push(mutref expressions, expr);
    let duplicate = checked_evidence_calls(ref calls, ref expressions, mutref diags);
    if list_len(ref diags) != 1 { return false; }
    diags = list();
    expressions = list();
    let missing = checked_evidence_calls(ref calls, ref expressions, mutref diags);
    return list_len(ref diags) == 1;
}

pub fn run_contract_evidence_gate(driver: str) -> bool
audit {
    intent("Lock checked mutation, versioned failure, and policy evidence through the active driver");
    mutates();
    effects(print, io);
}
{
    let fixture = "tests/fixtures/m54_8_final/mutations.nq";
    if not checked_call_identity_cases() { eprint_line("checked call identity fail-closed cases failed"); return false; }
    if not mutation_identity_cases() { eprint_line("checked mutation identity/coverage cases failed"); return false; }
    if not typecheck_diagnostic_identity_self_test() { eprint_line("producer diagnostic identities were not preserved"); return false; }
    let mut diagnostic_args: list<str> = list();
    list_push(mutref diagnostic_args, "check");
    list_push(mutref diagnostic_args, "tests/fixtures/m53_ownership/list_get_noncopy_rejected.nq");
    list_push(mutref diagnostic_args, "--diagnostics");
    list_push(mutref diagnostic_args, "json");
    match run_process(driver, ref diagnostic_args, ".") {
        Ok(status) => {
            if status.exit_code != 1 or status.stderr != "" or evidence_count(status.stdout, "\"code\": \"NQ-TYPE-044\"") != 1 or evidence_count(status.stdout, "\"code\":") != 1 or not evidence_contains(status.stdout, "Keep the element in the list") or not evidence_contains(status.stdout, "\"start\": { \"offset\": 133") or not evidence_contains(status.stdout, "\"end\": { \"offset\": 141") { eprint_line("non-copy list_get diagnostic identity/span/help regressed"); eprint_line(status.stdout); return false; }
        },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
    diagnostic_args = list();
    list_push(mutref diagnostic_args, "check");
    list_push(mutref diagnostic_args, "tests/fixtures/m54_8_final/diagnostics_distinct_same_span.nq");
    list_push(mutref diagnostic_args, "--diagnostics");
    list_push(mutref diagnostic_args, "json");
    match run_process(driver, ref diagnostic_args, ".") {
        Ok(status) => {
            if status.exit_code != 1 or status.stderr != "" or evidence_count(status.stdout, "\"code\":") != 3 or not evidence_contains(status.stdout, "unknown named argument") or not evidence_contains(status.stdout, "missing named argument for parameter") or not evidence_contains(status.stdout, "call argument type does not match parameter type") { eprint_line("distinct same-span source diagnostics were lost"); return false; }
        },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
    if not evidence_golden("review v4", evidence_command(driver, "review", fixture, "", "v4", ""), "tests/golden/review/review_v4.json") { return false; }
    if not evidence_golden("review v4 repeat", evidence_command(driver, "review", fixture, "", "v4", ""), "tests/golden/review/review_v4.json") { return false; }
    if not evidence_expect("review v4 absent audit", evidence_command(driver, "review", "tests/fixtures/m54_8b/review_v3.nq", "", "v4", ""), 0, "\"audit\": \"absent\"", "\"audit\": null") { return false; }
    if not evidence_expect("existing checked field borrow", evidence_command(driver, "check", "examples/composite_field_backend.nq", "", "", ""), 0, "", "") { return false; }
    if not evidence_expect("existing runtime field borrow", evidence_command(driver, "check", "tests/fixtures/m54_8_final/runtime_field_borrows.nq", "", "", ""), 0, "", "") { return false; }
    if not evidence_expect("mutation runtime", evidence_command(driver, "run", fixture, "", "", ""), 0, "", "") { return false; }
    let missing = "tests/fixtures/m54_8_final/missing_builtin.nq";
    if not evidence_expect("builtin omission", evidence_command(driver, "check", missing, "", "", ""), 1, "NQ-CONTRACT-005", "items") { return false; }
    if not evidence_expect("imported omission", evidence_command(driver, "check", "tests/fixtures/m54_8_final/missing_imported.nq", "", "", ""), 1, "NQ-CONTRACT-005", "target") { return false; }
    if not evidence_expect("recursive omission", evidence_command(driver, "check", "tests/fixtures/m54_8_final/missing_recursive.nq", "", "", ""), 1, "NQ-CONTRACT-005", "target") { return false; }
    if not evidence_expect("readonly warning", evidence_command(driver, "review", "tests/fixtures/m54_8_final/readonly_warning.nq", "", "v4", ""), 0, "NQ-CONTRACT-006", "\"completeness\": \"complete\"") { return false; }
    if not evidence_expect("borrow alias rejection", evidence_command(driver, "check", "tests/fixtures/m54_8_final/alias_rejected.nq", "", "", ""), 1, "NQ-BORROW-006", "conflicting") { return false; }
    if not m57_mutation_surfaces(driver) { eprint_line("M57.1 mutation-surface table regressed"); return false; }
    if not m57_field_write_contracts(driver) { eprint_line("M57.1 field-write contract validation regressed"); return false; }

    let mut versions: list<str> = list();
    list_push(mutref versions, "v1");
    list_push(mutref versions, "v2");
    list_push(mutref versions, "v3");
    list_push(mutref versions, "v4");
    let mut index = 0;
    while index < list_len(ref versions) {
        match list_get(ref versions, index) {
            Some(version) => {
                if not evidence_expect("review checked omission", evidence_command(driver, "review", missing, "", version, ""), 1, "NQ-CONTRACT-005", "items") { return false; }
                if index < 3 {
                    if not evidence_expect("facts checked omission", evidence_command(driver, "facts", missing, "", version, ""), 1, "NQ-CONTRACT-005", "items") { return false; }
                    let result = evidence_command(driver, "change-report", fixture, missing, version, "");
                    match result {
                        Ok(status) => {
                            if status.exit_code != 1 or not evidence_contains(status.stdout, concat3("\"requested_format\": ", i32_to_str(index + 1), ",")) or not evidence_contains(status.stdout, "\"stage\": \"after_check\"") or evidence_count(status.stderr, "NQ-CONTRACT-005") != 1 or evidence_contains(status.stdout, "\"ok\": true") or not evidence_valid_new_json(status.stdout) { eprint_line("change-report source failure lost requested format or diagnostics"); return false; }
                        },
                        Err(err) => { eprint_line(io_err_text(err)); return false; },
                    }
                    if not evidence_expect("change missing before source", evidence_command(driver, "change-report", "tests/fixtures/m54_8_final/not-present.nq", fixture, version, ""), 1, "\"stage\": \"before_load\"", "\"ok\": false") { return false; }
                    if not evidence_expect("change missing after source", evidence_command(driver, "change-report", fixture, "tests/fixtures/m54_8_final/not-present.nq", version, ""), 1, "\"stage\": \"after_load\"", "\"ok\": false") { return false; }
                    if not evidence_expect("change missing lock", evidence_command(driver, "change-report", fixture, "tests/fixtures/workspace_missing_lock/src/app/main.nq", version, ""), 1, "\"stage\": \"after_load\"", "\"ok\": false") { return false; }
                }
                if index < 2 {
                    if not evidence_expect("diff checked omission", evidence_command(driver, "review-diff", missing, fixture, version, ""), 1, "\"stage\": \"before_check\"", "NQ-CONTRACT-005") { return false; }
                    if not evidence_expect("diff missing source", evidence_command(driver, "review-diff", "tests/fixtures/m54_8_final/not-present.nq", fixture, version, ""), 1, "\"stage\": \"before_load\"", "\"ok\": false") { return false; }
                }
            },
            None => {},
        }
        index = index + 1;
    }
    let before = "tests/fixtures/workspace_impact/before/src/app/main.nq";
    let after = "tests/fixtures/workspace_impact/after/src/app/main.nq";
    if not evidence_golden("change v3 absent policy", evidence_command(driver, "change-report", before, after, "v3", ""), "tests/golden/workspace_governance/change_report_v3.json") { return false; }
    let policy_source = "tests/fixtures/review_diff/after/main.nq";
    if not evidence_expect("change v3 checked policy", evidence_command(driver, "change-report", policy_source, policy_source, "v3", "tests/fixtures/policy/change_report_policy.json"), 0, "\"policy\": \"checked\"", "\"malformed\": false") { return false; }
    if not evidence_expect("change v3 invalid policy", evidence_command(driver, "change-report", fixture, fixture, "v3", "tests/fixtures/m54_8a/invalid_policy.json"), 1, "\"policy\": \"failed\"", "\"ok\": false") { return false; }
    if not evidence_expect("change v3 unreadable policy", evidence_command(driver, "change-report", fixture, fixture, "v3", "tests/fixtures/m54_8_final/missing-policy.json"), 1, "\"policy\": \"failed\"", "\"malformed\": true") { return false; }
    return true;
}

// M57.1: the inferred `mutates` list of `function` in a review output, with
// whitespace and quotes removed (`[]` or `[bag]`). The first `"name"` match is
// the function entry; its `inferred` object follows its `audit` object.
fn m57_inferred_mutates(output: str, function: str) -> str {
    let marker = concat3("\"name\": \"", function, "\",");
    let mut index = 0;
    let mut found = -1;
    while found < 0 and index + str_len(marker) <= str_len(output) {
        if starts_with_at(output, index, marker) { found = index; }
        index = index + 1;
    }
    if found < 0 { return "?"; }
    let inferred_marker = "\"inferred\": {";
    index = found;
    let mut inferred = -1;
    while inferred < 0 and index + str_len(inferred_marker) <= str_len(output) {
        if starts_with_at(output, index, inferred_marker) { inferred = index; }
        index = index + 1;
    }
    if inferred < 0 { return "?"; }
    let mutates_marker = "\"mutates\": [";
    index = inferred;
    let mut start = -1;
    while start < 0 and index + str_len(mutates_marker) <= str_len(output) {
        if starts_with_at(output, index, mutates_marker) { start = index + str_len(mutates_marker) - 1; }
        index = index + 1;
    }
    if start < 0 { return "?"; }
    let mut pieces: list<str> = list();
    index = start;
    let mut done = false;
    while not done and index < str_len(output) {
        let value = char_at(output, index);
        if value != 32 and value != 10 and value != 34 { list_push(mutref pieces, slice_text(output, index, index + 1)); }
        if value == 93 { done = true; }
        index = index + 1;
    }
    return str_join(ref pieces);
}

// M57.1 mutation-surface table: a direct field assignment through a `mutref`
// parameter is a write in every review version and in `check`; call-mediated
// field-place writes (`list_push`/`list_replace`/`list_pop` on
// `mutref bag.items`) appear only in review v4/v5 and `check`; a shadowing
// owned local named like the parameter is never projected.
fn m57_mutation_surfaces(driver: str) -> bool {
    let fixture = "tests/fixtures/m57_1_core/c/mutation_surfaces.nq";
    if not evidence_expect("M57.1 mutation surfaces check", evidence_command(driver, "check", fixture, "", "", ""), 0, "", "") { return false; }
    match evidence_command(driver, "check", fixture, "", "", "") {
        Ok(status) => { if status.stdout != "" or status.stderr != "" { eprint_line("M57.1 mutation surfaces check is not quiet"); eprint_line(status.stderr); return false; } },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
    let versions = ["v1", "v2", "v3", "v4", "v5"];
    let functions = ["set_count", "push_item", "swap_first", "drop_last", "shadowed"];
    let mut version_index = 0;
    while version_index < list_len(ref versions) {
        let Some(version) = list_get(ref versions, version_index) else { return false; };
        match evidence_command(driver, "review", fixture, "", version, "") {
            Ok(status) => {
                if status.exit_code != 0 or status.stderr != "" { eprint_line(str_concat("M57.1 review failed: ", version)); eprint_line(status.stderr); return false; }
                let mut function_index = 0;
                while function_index < list_len(ref functions) {
                    let Some(function) = list_get(ref functions, function_index) else { return false; };
                    let mut expected = "[]";
                    if function_index == 0 { expected = "[bag]"; }
                    if function_index > 0 and function_index < 4 and version_index >= 3 { expected = "[bag]"; }
                    let actual = m57_inferred_mutates(status.stdout, function);
                    if actual != expected {
                        eprint_line(concat6("M57.1 review ", version, " inferred mutates for ", function, " is ", concat4(actual, ", expected ", expected, "")));
                        return false;
                    }
                    function_index = function_index + 1;
                }
            },
            Err(err) => { eprint_line(io_err_text(err)); return false; },
        }
        version_index = version_index + 1;
    }
    let mut legacy_index = 0;
    while legacy_index < 2 {
        let Some(version) = list_get(ref versions, legacy_index) else { return false; };
        // review-diff shares the legacy projection: a self-diff stays clean.
        if not evidence_expect(str_concat("M57.1 review-diff ", version), evidence_command(driver, "review-diff", fixture, fixture, version, ""), 0, "\"changed_functions\": 0", "") { return false; }
        legacy_index = legacy_index + 1;
    }
    return true;
}

// A function whose only write is a field assignment through its `mutref`
// parameter satisfies `mutates(p)` (no NQ-CONTRACT-006) and, without it,
// reports NQ-CONTRACT-005 in `check` and in every review version.
fn m57_field_write_contracts(driver: str) -> bool {
    let Ok(directory) = create_temp_dir("build", "m57-1-c-contracts-") else { eprint_line("M57.1 contracts: temporary directory refused"); return false; };
    let declarations = "type Bag {\n    items: list<i32>,\n    count: i32,\n}\n\n";
    let main = "fn main() -> i32 {\n    let mut bag = Bag { items: list(), count: 0 };\n    reset(mutref bag);\n    return bag.count;\n}\n";
    let body = "{\n    bag.items = [1];\n    bag.count = 1;\n    return;\n}\n\n";
    let declared = concat4(declarations, "fn reset(bag: mutref Bag) -> unit\naudit {\n    intent(\"Reset the bag\");\n    mutates(bag);\n    effects();\n}\n", body, main);
    let omitted = concat4(declarations, "fn reset(bag: mutref Bag) -> unit\naudit {\n    intent(\"Reset the bag\");\n    mutates();\n    effects();\n}\n", body, main);
    let declared_path = str_concat(directory, "/declared.nq");
    let omitted_path = str_concat(directory, "/omitted.nq");
    match write_file(declared_path, declared) { Ok(_) => {}, Err(err) => { eprint_line(io_err_text(err)); return false; }, }
    match write_file(omitted_path, omitted) { Ok(_) => {}, Err(err) => { eprint_line(io_err_text(err)); return false; }, }
    match evidence_command(driver, "check", declared_path, "", "", "") {
        Ok(status) => { if status.exit_code != 0 or status.stdout != "" or status.stderr != "" { eprint_line("M57.1 field-write mutates(bag) was not accepted quietly"); eprint_line(status.stderr); return false; } },
        Err(err) => { eprint_line(io_err_text(err)); return false; },
    }
    if not evidence_expect("M57.1 field-write omission", evidence_command(driver, "check", omitted_path, "", "", ""), 1, "NQ-CONTRACT-005", "`audit` omits mutated `mutref` parameter `bag`") { return false; }
    for version in ["v1", "v2", "v3", "v4", "v5"] {
        match evidence_command(driver, "review", declared_path, "", version, "") {
            Ok(status) => { if status.exit_code != 0 or evidence_contains(status.stderr, "NQ-CONTRACT-006") { eprint_line(str_concat("M57.1 field-write review warned: ", version)); eprint_line(status.stderr); return false; } },
            Err(err) => { eprint_line(io_err_text(err)); return false; },
        }
        match evidence_command(driver, "review", omitted_path, "", version, "") {
            Ok(status) => { if status.exit_code != 1 or evidence_count(status.stderr, "NQ-CONTRACT-005") != 1 { eprint_line(str_concat("M57.1 field-write omission not reported: ", version)); eprint_line(status.stderr); return false; } },
            Err(err) => { eprint_line(io_err_text(err)); return false; },
        }
    }
    return true;
}
