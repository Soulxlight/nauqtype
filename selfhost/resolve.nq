use ast;
use diag;
use text;

type resolver_scope {
    id: i32,
    parent_id: i32,
}

type resolver_binding {
    scope_id: i32,
    name: str,
    at: i32,
    creates_local: bool,
}

type resolver_binding_key {
    binding_index: i32,
    scope_id: i32,
    at: i32,
    name_bucket: i32,
    creates_local: bool,
}

type resolver_ref {
    scope_id: i32,
    name: str,
    at: i32,
    kind: name_ref_kind,
}

enum resolver_top_status {
    resolver_top_absent,
    resolver_top_visible,
    resolver_top_hidden,
    resolver_top_function_value,
}

type resolver_top_cache_entry {
    name: str,
    ref_kind: i32,
    status: resolver_top_status,
}

fn push_diag(diags: mutref list<diag>, file: str, at: i32, message: str) -> unit {
    let mut end = at;
    if at >= 0 {
        end = at + 1;
    }
    list_push(mutref diags, make_error("NQ-RESOLVE-010", diag_resolve, file, at, end, message));
    return;
}

fn module_has_local_name(items: ref list<top_item>, module: str, name: str) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    return true;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn is_function_item(item: top_item) -> bool {
    match item.kind {
        item_fn => {
            return true;
        },
        _ => {
