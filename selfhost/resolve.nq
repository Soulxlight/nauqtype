fn is_pattern_binding(binding: body_binding) -> bool {
    match binding.kind {
        bind_pattern => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

fn binding_creates_local(binding: body_binding, items: ref list<top_item>, uses: ref list<module_use>) -> bool {
    if is_pattern_binding(binding) and module_has_visible_variant_name(ref items, ref uses, binding.module, binding.name) {
        return false;
    }
    return true;
}

fn resolver_name_bucket(name: str) -> i32 {
    let mut first = 0;
    let first_entry = str_get(name, 0);
    match first_entry {
        Some(value) => {
            first = value;
        },
        None => {
        },
    }
    return (str_len(name) * 31) + first;
}

fn parent_scope_id(scopes: ref list<resolver_scope>, scope_id: i32) -> i32 {
    let mut index = list_len(ref scopes) - 1;
    while index >= 0 {
        let entry = list_get(ref scopes, index);
        match entry {
            Some(value) => {
                if value.id == scope_id {
                    return value.parent_id;
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return -1;
}

fn scope_is_visible(scopes: ref list<resolver_scope>, current_scope_id: i32, candidate_scope_id: i32) -> bool {
    let mut scope_cursor = current_scope_id;
    while scope_cursor >= 0 {
        if scope_cursor == candidate_scope_id {
            return true;
        }
        scope_cursor = parent_scope_id(ref scopes, scope_cursor);
    }
    return false;
}

fn build_binding_keys(bindings: ref list<resolver_binding>) -> list<resolver_binding_key> {
    let mut keys: list<resolver_binding_key> = list();
    let mut index = 0;
    while index < list_len(ref bindings) {
        let entry = list_get(ref bindings, index);
        match entry {
            Some(value) => {
                list_push(mutref keys, resolver_binding_key {
                    binding_index: index,
                    scope_id: value.scope_id,
                    at: value.at,
                    name_bucket: resolver_name_bucket(value.name),
                    creates_local: value.creates_local,
                });
            },
            None => {
            },
        }
        index = index + 1;
    }
    return keys;
}

fn has_visible_binding(bindings: ref list<resolver_binding>, binding_keys: ref list<resolver_binding_key>, scopes: ref list<resolver_scope>, scope_id: i32, name: str, at: i32) -> bool {
    let target_bucket = resolver_name_bucket(name);
    let mut index = list_len(ref binding_keys) - 1;
    while index >= 0 {
        let entry = list_get(ref binding_keys, index);
        match entry {
            Some(key) => {
                if key.name_bucket == target_bucket and key.at < at and key.creates_local {
                    let binding_entry = list_get(ref bindings, key.binding_index);
                    match binding_entry {
                        Some(value) => {
                            if value.name == name and scope_is_visible(ref scopes, scope_id, key.scope_id) {
                                return true;
                            }
                        },
                        None => {
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return false;
}

fn take_scopes_for_function(source: ref list<body_scope>, module: str, function_name: str, cursor: mutref i32) -> list<resolver_scope> {
    let mut copied: list<resolver_scope> = list();
    let mut collecting = true;
    while cursor < list_len(ref source) and collecting {
        let entry = list_get(ref source, cursor);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    list_push(mutref copied, resolver_scope {
                        id: value.scope_id,
                        parent_id: value.parent_scope_id,
                    });
                    cursor = cursor + 1;
                } else {
                    collecting = false;
                }
            },
            None => {
                collecting = false;
            },
        }
    }
    return copied;
}

fn take_bindings_for_function(source: ref list<body_binding>, items: ref list<top_item>, uses: ref list<module_use>, module: str, function_name: str, cursor: mutref i32) -> list<resolver_binding> {
    let mut copied: list<resolver_binding> = list();
    let mut collecting = true;
    while cursor < list_len(ref source) and collecting {
        let entry = list_get(ref source, cursor);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    list_push(mutref copied, resolver_binding {
                        scope_id: value.scope_id,
                        name: value.name,
                        at: value.at,
                        creates_local: binding_creates_local(value, ref items, ref uses),
                    });
                    cursor = cursor + 1;
                } else {
                    collecting = false;
                }
            },
            None => {
                collecting = false;
            },
        }
    }
    return copied;
}

fn take_refs_for_function(source: ref list<name_ref>, module: str, function_name: str, cursor: mutref i32) -> list<resolver_ref> {
    let mut copied: list<resolver_ref> = list();
    let mut collecting = true;
    while cursor < list_len(ref source) and collecting {
        let entry = list_get(ref source, cursor);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    list_push(mutref copied, resolver_ref {
                        scope_id: value.scope_id,
                        name: value.name,
                        at: value.at,
                        kind: value.kind,
                    });
                    cursor = cursor + 1;
                } else {
                    collecting = false;
                }
            },
            None => {
                collecting = false;
            },
        }
    }
    return copied;
}

fn count_root_function_scopes(scopes: ref list<body_scope>) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref scopes) {
        let entry = list_get(ref scopes, index);
        match entry {
            Some(value) => {
                if value.parent_scope_id < 0 {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn resolve_duplicate_bindings(bindings: ref list<resolver_binding>, binding_keys: ref list<resolver_binding_key>, module: str, diags: mutref list<diag>) -> unit {
    let mut binding_index = 0;
    while binding_index < list_len(ref bindings) {
        let entry = list_get(ref bindings, binding_index);
        match entry {
            Some(current) => {
                if current.creates_local {
                    let current_bucket = resolver_name_bucket(current.name);
                    let mut prev_index = binding_index - 1;
                    while prev_index >= 0 {
                        let previous = list_get(ref binding_keys, prev_index);
                        match previous {
                            Some(key) => {
                                if key.scope_id == current.scope_id and key.name_bucket == current_bucket and key.creates_local {
                                    let value_entry = list_get(ref bindings, key.binding_index);
                                    match value_entry {
                                        Some(value) => {
                                            if value.name == current.name {
                                                push_diag(mutref diags, module, current.at, "duplicate local binding in one scope");
                                                prev_index = -1;
                                            } else {
                                                prev_index = prev_index - 1;
                                            }
                                        },
                                        None => {
                                            prev_index = prev_index - 1;
                                        },
                                    }
                                } else {
                                    prev_index = prev_index - 1;
                                }
                            },
                            None => {
                                prev_index = prev_index - 1;
                            },
                        }
                    }
                }
            },
            None => {
            },
        }
        binding_index = binding_index + 1;
    }
    return;
}

fn resolver_ref_kind_key(kind: name_ref_kind) -> i32 {
    match kind {
        ref_value => { return 1; },
        ref_call => { return 2; },
        ref_assign_target => { return 3; },
        ref_borrow_target => { return 4; },
        ref_struct_type => { return 5; },
        ref_pattern_ctor => { return 6; },
    }
}

fn compute_top_status(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str, kind: name_ref_kind) -> resolver_top_status {
    match kind {
        ref_call => {
            if module_has_visible_expression_name(ref items, ref uses, module, name) {
                return resolver_top_visible;
            }
            if module_has_hidden_imported_expression_name(ref items, ref uses, module, name) {
                return resolver_top_hidden;
            }
        },
        ref_value => {
            if module_has_visible_variant_name(ref items, ref uses, module, name) {
                return resolver_top_visible;
            }
            if module_has_visible_const_name(ref items, ref uses, module, name) {
                return resolver_top_visible;
            }
            if module_has_visible_function_name(ref items, ref uses, module, name) {
                return resolver_top_function_value;
            }
            if module_has_hidden_imported_expression_name(ref items, ref uses, module, name) or module_has_hidden_imported_const_name(ref items, ref uses, module, name) {
                return resolver_top_hidden;
            }
        },
        ref_struct_type => {
            if module_has_visible_type_name(ref items, ref uses, module, name) {
                return resolver_top_visible;
            }
            if module_has_hidden_imported_type_name(ref items, ref uses, module, name) {
                return resolver_top_hidden;
            }
        },
        ref_pattern_ctor => {
            if module_has_visible_variant_name(ref items, ref uses, module, name) {
                return resolver_top_visible;
            }
            if module_has_hidden_imported_variant_name(ref items, ref uses, module, name) {
                return resolver_top_hidden;
            }
        },
        _ => {
        },
    }
    return resolver_top_absent;
}

fn cached_top_status(cache: mutref list<resolver_top_cache_entry>, items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str, kind: name_ref_kind) -> resolver_top_status {
    let kind_key = resolver_ref_kind_key(kind);
    let mut index = 0;
    while index < list_len(ref cache) {
        let entry = list_get(ref cache, index);
        match entry {
            Some(value) => {
                if value.ref_kind == kind_key and value.name == name {
                    return value.status;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }

    let status = compute_top_status(ref items, ref uses, module, name, kind);
    list_push(mutref cache, resolver_top_cache_entry {
        name: name,
        ref_kind: kind_key,
        status: status,
    });
    return status;
}

fn resolve_function_refs(scopes: ref list<resolver_scope>, bindings: ref list<resolver_binding>, binding_keys: ref list<resolver_binding_key>, refs: ref list<resolver_ref>, uses: ref list<module_use>, items: ref list<top_item>, module: str, top_cache: mutref list<resolver_top_cache_entry>, diags: mutref list<diag>) -> unit {
    let mut ref_index = 0;
    while ref_index < list_len(ref refs) {
        let entry = list_get(ref refs, ref_index);
        match entry {
            Some(current) => {
                let has_local = has_visible_binding(ref bindings, ref binding_keys, ref scopes, current.scope_id, current.name, current.at);
                match current.kind {
                    ref_assign_target => {
                        if not has_local {
                            push_diag(mutref diags, module, current.at, "unknown assignment target in function body");
                        }
                    },
                    ref_borrow_target => {
                        if not has_local {
                            push_diag(mutref diags, module, current.at, "cannot borrow unknown local name");
                        }
                    },
                    ref_call => {
                        if has_local {
                            push_diag(mutref diags, module, current.at, "local name cannot be called in function body");
                        } else {
                            let status = cached_top_status(mutref top_cache, ref items, ref uses, module, current.name, current.kind);
                            match status {
                                resolver_top_visible => {
                                },
                                resolver_top_hidden => {
                                    push_diag(mutref diags, module, current.at, "name exists in an imported module but is not `pub`");
                                },
                                _ => {
                                    push_diag(mutref diags, module, current.at, "unknown call target in function body");
                                },
                            }
                        }
                    },
                    ref_value => {
                        if not has_local {
                            let status = cached_top_status(mutref top_cache, ref items, ref uses, module, current.name, current.kind);
                            match status {
                                resolver_top_visible => {
                                },
                                resolver_top_function_value => {
                                    push_diag(mutref diags, module, current.at, "function name cannot be used as a plain value in function body");
                                },
                                resolver_top_hidden => {
                                    push_diag(mutref diags, module, current.at, "name exists in an imported module but is not `pub`");
                                },
                                _ => {
                                    push_diag(mutref diags, module, current.at, "unknown name in function body");
                                },
                            }
                        }
                    },
                    ref_struct_type => {
                        let status = cached_top_status(mutref top_cache, ref items, ref uses, module, current.name, current.kind);
                        match status {
                            resolver_top_visible => {
                            },
                            resolver_top_hidden => {
                                push_diag(mutref diags, module, current.at, "type exists in an imported module but is not `pub`");
                            },
                            _ => {
                                push_diag(mutref diags, module, current.at, "unknown struct literal type in function body");
                            },
                        }
                    },
                    ref_pattern_ctor => {
                        let status = cached_top_status(mutref top_cache, ref items, ref uses, module, current.name, current.kind);
                        match status {
                            resolver_top_visible => {
                            },
                            resolver_top_hidden => {
                                push_diag(mutref diags, module, current.at, "pattern constructor exists in an imported module but is not `pub`");
                            },
                            _ => {
                                push_diag(mutref diags, module, current.at, "unknown pattern constructor in function body");
                            },
                        }
                    },
                }
            },
            None => {
            },
        }
        ref_index = ref_index + 1;
    }
    return;
}

fn import_qualifier(entry: module_use) -> str {
    if entry.alias != "" {
        return entry.alias;
    }
    return entry.name;
}

fn resolve_duplicate_import_qualifiers(uses: ref list<module_use>, diags: mutref list<diag>) -> unit {
    let mut index = 0;
    while index < list_len(ref uses) {
        let entry = list_get(ref uses, index);
        match entry {
            Some(current) => {
                let qualifier = import_qualifier(current);
                let mut previous_index = 0;
                while previous_index < index {
                    let previous = list_get(ref uses, previous_index);
                    match previous {
                        Some(value) => {
                            if value.module == current.module and import_qualifier(value) == qualifier {
                                push_diag(mutref diags, current.module, current.at, "duplicate import qualifier");
                            }
                        },
                        None => {
                        },
                    }
                    previous_index = previous_index + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

pub fn resolve_modules(modules: ref list<str>, uses: ref list<module_use>, items: ref list<top_item>, diags: mutref list<diag>) -> resolve_summary
audit {
    intent("Resolve flat top-level item and import visibility facts for the current selfhost module graph");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);

    resolve_duplicate_import_qualifiers(ref uses, mutref diags);

    let mut item_index = 0;
    while item_index < list_len(ref items) {
        let entry = list_get(ref items, item_index);
        match entry {
            Some(current) => {
                let mut prev_index = 0;
                while prev_index < item_index {
                    let previous = list_get(ref items, prev_index);
                    match previous {
                        Some(value) => {
                            if value.module == current.module and value.name == current.name {
                                push_diag(mutref diags, current.module, current.at, "duplicate top-level item name in one module");
                            }
                        },
                        None => {
                        },
                    }
                    prev_index = prev_index + 1;
                }
            },
            None => {
            },
        }
        item_index = item_index + 1;
    }

    let mut use_index = 0;
    while use_index < list_len(ref uses) {
        let entry = list_get(ref uses, use_index);
        match entry {
            Some(current_use) => {
                if not list_contains(ref modules, current_use.name) {
                    push_diag(mutref diags, current_use.module, current_use.at, "imported module could not be loaded");
                } else {
                    let mut item_cursor = 0;
                    while item_cursor < list_len(ref items) {
                        let imported = list_get(ref items, item_cursor);
                        match imported {
                            Some(value) => {
                                if value.module == current_use.name and value.is_public {
                                    if module_has_local_name(ref items, current_use.module, value.name) {
                                        push_diag(mutref diags, current_use.module, current_use.at, "import collides with an existing local top-level name");
                                    } else {
                                        if imported_name_visible_before(ref uses, ref items, current_use.module, use_index, current_use.name, value.name) {
                                            push_diag(mutref diags, current_use.module, current_use.at, "duplicate imported public name");
                                        }
                                    }
                                }
                            },
                            None => {
                            },
                        }
                        item_cursor = item_cursor + 1;
                    }
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }

    return make_resolve_summary(list_len(ref modules), list_len(ref items), list_len(ref diags) - start_diag_count);
}

pub fn resolve_types(type_refs: ref list<type_ref>, uses: ref list<module_use>, items: ref list<top_item>, diags: mutref list<diag>) -> type_resolve_summary
audit {
    intent("Resolve flat type references for the current selfhost module graph");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);

    let mut ref_index = 0;
    while ref_index < list_len(ref type_refs) {
        let entry = list_get(ref type_refs, ref_index);
        match entry {
            Some(current) => {
                if module_has_visible_type_name(ref items, ref uses, current.module, current.name) {
                } else {
                    if module_has_hidden_imported_type_name(ref items, ref uses, current.module, current.name) {
                        push_diag(mutref diags, current.module, current.at, "type exists in an imported module but is not `pub`");
                    } else {
                        push_diag(mutref diags, current.module, current.at, "unknown type in declaration");
                    }
                }
            },
            None => {
            },
        }
        ref_index = ref_index + 1;
    }

    return make_type_resolve_summary(list_len(ref type_refs), list_len(ref diags) - start_diag_count);
}

pub fn resolve_bodies(scopes: ref list<body_scope>, bindings: ref list<body_binding>, refs: ref list<name_ref>, uses: ref list<module_use>, items: ref list<top_item>, diags: mutref list<diag>) -> body_resolve_summary
audit {
    intent("Resolve flat function-body bindings and name references for the current selfhost graph");
    mutates(diags);
    effects();
}
{
    let start_diag_count = list_len(ref diags);
    let mut scope_index = 0;
    let mut function_scope_cursor = 0;
    let mut function_binding_cursor = 0;
    let mut function_ref_cursor = 0;
    let mut top_cache: list<resolver_top_cache_entry> = list();
    let mut top_cache_module = "";
    while scope_index < list_len(ref scopes) {
        let entry = list_get(ref scopes, scope_index);
        match entry {
            Some(current) => {
                if current.parent_scope_id < 0 {
                    if current.module != top_cache_module {
                        top_cache = list();
                        top_cache_module = current.module;
                    }
                    let function_scopes = take_scopes_for_function(ref scopes, current.module, current.function_name, mutref function_scope_cursor);
                    let function_bindings = take_bindings_for_function(ref bindings, ref items, ref uses, current.module, current.function_name, mutref function_binding_cursor);
                    let function_binding_keys = build_binding_keys(ref function_bindings);
                    let function_refs = take_refs_for_function(ref refs, current.module, current.function_name, mutref function_ref_cursor);
                    resolve_duplicate_bindings(ref function_bindings, ref function_binding_keys, current.module, mutref diags);
                    resolve_function_refs(ref function_scopes, ref function_bindings, ref function_binding_keys, ref function_refs, ref uses, ref items, current.module, mutref top_cache, mutref diags);
                }
            },
            None => {
            },
        }
        scope_index = scope_index + 1;
    }

    return make_body_resolve_summary(count_root_function_scopes(ref scopes), list_len(ref refs), list_len(ref diags) - start_diag_count);
}
