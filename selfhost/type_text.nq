use text;

fn type_text_inner_start(value: str) -> i32 {
    if str_starts_with(value, "mutref ") {
        return 7;
    }
    if str_starts_with(value, "ref ") {
        return 4;
    }
    return 0;
}

fn type_text_open_index(value: str) -> i32 {
    let mut index = type_text_inner_start(value);
    while index < str_len(value) {
        if char_at(value, index) == 60 {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn type_text_close_index(value: str) -> i32 {
    let mut index = str_len(value) - 1;
    while index >= 0 {
        if char_at(value, index) == 62 {
            return index;
        }
        index = index - 1;
    }
    return -1;
}

fn type_text_comma_index(value: str, open_index: i32, close_index: i32) -> i32 {
    let mut depth = 0;
    let mut index = open_index + 1;
    while index < close_index {
        let current = char_at(value, index);
        if current == 60 {
            depth = depth + 1;
        } else {
            if current == 62 {
                depth = depth - 1;
            } else {
                if current == 44 and depth == 0 {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

pub fn render_type_text(head: str, arg1_name: str, arg2_name: str, is_borrow: bool, borrow_mutable: bool) -> str
audit {
    intent("Render one recursively lossless checked type argument without changing simple type names");
    mutates();
    effects();
}
{
    let mut rendered = head;
    if arg1_name != "" {
        rendered = str_concat(rendered, "<");
        rendered = str_concat(rendered, arg1_name);
        if arg2_name != "" {
            rendered = str_concat(rendered, ",");
            rendered = str_concat(rendered, arg2_name);
        }
        rendered = str_concat(rendered, ">");
    }
    if is_borrow {
        if borrow_mutable {
            return str_concat("mutref ", rendered);
        }
        return str_concat("ref ", rendered);
    }
    return rendered;
}

pub fn type_text_is_borrow(value: str) -> bool
audit {
    intent("Report whether a recursive type argument is explicitly borrowed");
    mutates();
    effects();
}
{
    return str_starts_with(value, "ref ") or str_starts_with(value, "mutref ");
}

pub fn type_text_borrow_mutable(value: str) -> bool
audit {
    intent("Report whether a recursive type argument is explicitly mutably borrowed");
    mutates();
    effects();
}
{
    return str_starts_with(value, "mutref ");
}

pub fn type_text_head(value: str) -> str
audit {
    intent("Read the head name from one recursively encoded type argument");
    mutates();
    effects();
}
{
    let start = type_text_inner_start(value);
    let open_index = type_text_open_index(value);
    if open_index < 0 {
        return slice_text(value, start, str_len(value));
    }
    return slice_text(value, start, open_index);
}

pub fn type_text_arg1(value: str) -> str
audit {
    intent("Read the first recursively encoded child type argument");
    mutates();
    effects();
}
{
    let open_index = type_text_open_index(value);
    let close_index = type_text_close_index(value);
    if open_index < 0 or close_index <= open_index {
        return "";
    }
    let comma_index = type_text_comma_index(value, open_index, close_index);
    if comma_index < 0 {
        return slice_text(value, open_index + 1, close_index);
    }
    return slice_text(value, open_index + 1, comma_index);
}

pub fn type_text_arg2(value: str) -> str
audit {
    intent("Read the second recursively encoded child type argument");
    mutates();
    effects();
}
{
    let open_index = type_text_open_index(value);
    let close_index = type_text_close_index(value);
    if open_index < 0 or close_index <= open_index {
        return "";
    }
    let comma_index = type_text_comma_index(value, open_index, close_index);
    if comma_index < 0 {
        return "";
    }
    return slice_text(value, comma_index + 1, close_index);
}
