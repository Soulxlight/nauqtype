use ast;
use builtin_evidence;
use diag;
use files;
use generic_auth;
use generic_names;
use handoff;
use source;
use text;
use workspace;

pub type facts_summary {
    module_count: i32,
    definition_count: i32,
    reference_count: i32,
    call_edge_count: i32,
}

type fact_target {
    kind: str,
    id: str,
    evidence: str,
}

type fact_reference {
    id: str,
    kind: str,
    module: str,
    from: str,
    name: str,
    target_kind: str,
    target_id: str,
    at: i32,
    evidence: str,
    context: str,
}

type fact_call_edge {
    caller: str,
    callee: str,
    call_site: str,
    evidence: str,
    io_kind: str,
}

type fact_expr_range {
    module: str,
    function_name: str,
    start_index: i32,
    end_index: i32,
}

type refactor_target {
    ok: bool,
    id: str,
    kind: str,
    module: str,
    owner: str,
    name: str,
    at: i32,
    path: str,
}

type policy_entry {
    target_id: str,
    owner: str,
    review: str,
}

pub type policy_validation_summary {
    provided: bool,
    target_count: i32,
    error_count: i32,
    malformed: bool,
}

pub fn make_facts_summary(module_count: i32, definition_count: i32, reference_count: i32, call_edge_count: i32) -> facts_summary
audit {
    intent("Build a summary record for deterministic stage1 semantic facts output");
    mutates();
    effects();
}
{
    return facts_summary {
        module_count: module_count,
        definition_count: definition_count,
        reference_count: reference_count,
        call_edge_count: call_edge_count,
    };
}

fn make_fact_target(kind: str, id: str, evidence: str) -> fact_target {
    return fact_target {
        kind: kind,
        id: id,
        evidence: evidence,
    };
}

fn make_fact_reference(id: str, kind: str, module: str, from: str, name: str, target_kind: str, target_id: str, at: i32, evidence: str, context: str) -> fact_reference {
    return fact_reference {
        id: id,
        kind: kind,
        module: module,
        from: from,
        name: name,
        target_kind: target_kind,
        target_id: target_id,
        at: at,
        evidence: evidence,
        context: context,
    };
}

fn make_fact_call_edge(caller: str, callee: str, call_site: str, evidence: str, io_kind: str) -> fact_call_edge {
    return fact_call_edge {
        caller: caller,
        callee: callee,
        call_site: call_site,
        evidence: evidence,
        io_kind: io_kind,
    };
}

fn make_refactor_target(ok: bool, id: str, kind: str, module: str, owner: str, name: str, at: i32, path: str) -> refactor_target {
    return refactor_target {
        ok: ok,
        id: id,
        kind: kind,
        module: module,
        owner: owner,
        name: name,
        at: at,
        path: path,
    };
}

fn make_policy_entry(target_id: str, owner: str, review: str) -> policy_entry {
    return policy_entry {
        target_id: target_id,
        owner: owner,
        review: review,
    };
}

pub fn make_policy_validation_summary(provided: bool, target_count: i32, error_count: i32, malformed: bool) -> policy_validation_summary
audit {
    intent("Build a compact policy validation summary for report-style tooling");
    mutates();
    effects();
}
{
    return policy_validation_summary {
        provided: provided,
        target_count: target_count,
        error_count: error_count,
        malformed: malformed,
    };
}

fn emit_lines(lines: ref list<str>) -> unit {
    let mut index = 0;
    while index < list_len(ref lines) {
        let entry = list_get(ref lines, index);
        match entry {
            Some(value) => {
                print_line(value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn append_span(lines: mutref list<str>, indent: str, at: i32, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, concat5(indent, "\"span\": { \"start\": ", i32_to_str(at), " }", suffix));
    return;
}

fn module_identity(name: str) -> str {
    return str_concat("module:", name);
}

fn function_identity(module: str, name: str) -> str {
    return concat4("fn:", module, "::", name);
}

fn type_identity(module: str, name: str) -> str {
    return concat4("type:", module, "::", name);
}

fn enum_identity(module: str, name: str) -> str {
    return concat4("enum:", module, "::", name);
}

fn variant_identity(module: str, enum_name: str, name: str) -> str {
    return concat6("variant:", module, "::", enum_name, "::", name);
}

fn const_identity(module: str, name: str) -> str {
    return concat4("const:", module, "::", name);
}

fn field_identity(module: str, type_name: str, name: str) -> str {
    return concat6("field:", module, "::", type_name, "::", name);
}

fn binding_identity(binding: body_binding) -> str {
    let owner = function_identity(binding.module, binding.function_name);
    return concat6("binding:", owner, ":", i32_to_str(binding.scope_id), ":", concat3(binding.name, "@", i32_to_str(binding.at)));
}

fn call_identity(call: call_fact) -> str {
    return concat6("call:", call.module, "::", call.function_name, "@", i32_to_str(call.at));
}

fn use_identity(entry: module_use) -> str {
    if entry.alias != "" {
        return concat6("use:", entry.module, "->", concat3(entry.name, " as ", entry.alias), "@", i32_to_str(entry.at));
    }
    return concat6("use:", entry.module, "->", entry.name, "@", i32_to_str(entry.at));
}

fn source_use_name(entry: module_use) -> str {
    if entry.alias != "" {
        return entry.alias;
    }
    return entry.name;
}

fn type_ref_identity(entry: type_ref) -> str {
    return concat6("typeref:", entry.module, "::", entry.context_name, "@", i32_to_str(entry.at));
}

fn name_ref_identity(entry: name_ref) -> str {
    return concat6("nameref:", entry.module, "::", entry.function_name, "@", i32_to_str(entry.at));
}

fn field_ref_identity(kind: str, module: str, function_name: str, at: i32) -> str {
    return concat6("fieldref:", kind, ":", module, "::", concat3(function_name, "@", i32_to_str(at)));
}

fn arg_label_ref_identity(module: str, function_name: str, at: i32) -> str {
    return concat6("arglabel:", module, "::", function_name, "@", i32_to_str(at));
}

fn propagation_ref_identity(module: str, function_name: str, at: i32) -> str {
    return concat6("propagation:", module, "::", function_name, "@", i32_to_str(at));
}

fn builtin_param_identity(function_name: str, name: str) -> str {
    return concat4("builtin-param:", function_name, "::", name);
}

fn is_builtin_function(name: str) -> bool {
    if name == "duration_from_ns" or name == "duration_as_ns" or name == "duration_between" or name == "wall_time_ns" or name == "monotonic_now" or name == "deadline_after" or name == "sleep_for" or name == "process_start" or name == "process_wait" or name == "process_terminate" { return true; }
    if name == "print_line" or name == "eprint_line" or name == "read_file" or name == "write_file" or name == "arg_count" or name == "arg_get" or name == "create_dir_all" or name == "run_process" or name == "io_err_text" {
        return true;
    }
    if name == "str_len" or name == "str_get" or name == "str_slice" or name == "str_concat" or name == "str_join" or name == "bytes_from_str" or name == "bytes_len" or name == "bytes_get" {
        return true;
    }
    if name == "stdin_read" or name == "stdin_read_bytes" or name == "stdin_read_line" or name == "stdout_write" or name == "stdout_write_bytes" or name == "stderr_write" or name == "stderr_write_bytes" or name == "stdout_flush" or name == "stderr_flush" {
        return true;
    }
    if name == "env_get" or name == "current_dir" or name == "read_file_bytes" or name == "write_file_bytes" or name == "path_metadata" or name == "read_dir" or name == "create_dir" or name == "create_file_new" or name == "remove_file" or name == "remove_dir" or name == "rename_path" {
        return true;
    }
    if name == "create_temp_file" or name == "create_temp_dir" or name == "atomic_write_file" or name == "str_from_bytes" or name == "io_err_kind" or name == "io_err_operation" or name == "io_err_path" or name == "io_err_other_path" or name == "io_err_os_code" {
        return true;
    }
    if name == "list" or name == "list_push" or name == "list_len" or name == "list_get" {
        return true;
    }
    if name == "f64_from_i32" or name == "f64_from_i64" or name == "f64_trunc_i32" or name == "f64_trunc_i64" or name == "str_from_f64" or name == "f64_from_str" {
        return true;
    }
    if name == "list_replace" or name == "list_pop" or name == "i64_from_i32" or name == "i32_from_i64" {
        return true;
    }
    return false;
}

fn is_builtin_type(name: str) -> bool {
    if name == "duration" or name == "instant" or name == "process" or name == "process_outcome" { return true; }
    if name == "bool" or name == "i32" or name == "i64" or name == "f64" or name == "str" or name == "unit" or name == "io_err" or name == "process_result" or name == "path_metadata" or name == "bytes" {
        return true;
    }
    if name == "list" or name == "option" or name == "result" or name == "ref" {
        return true;
    }
    return false;
}

fn is_builtin_variant(name: str) -> bool {
    if name == "Some" or name == "None" or name == "Ok" or name == "Err" {
        return true;
    }
    return false;
}

fn builtin_propagation_error(name: str) -> str {
    return builtin_evidence_result_error(name);
}

fn io_kind_for_builtin(name: str) -> str {
    return builtin_evidence_io_kind(name);
}

fn item_kind_text(kind: top_item_kind) -> str {
    match kind {
        item_fn => {
            return "function";
        },
        item_type => {
            return "type";
        },
        item_enum => {
            return "enum";
        },
        item_variant => {
            return "variant";
        },
        item_const => {
            return "const";
        },
    }
}

fn binding_kind_text(kind: body_binding_kind) -> str {
    match kind {
        bind_param => {
            return "param";
        },
        bind_let => {
            return "local";
        },
        bind_pattern => {
            return "pattern";
        },
    }
}

fn name_ref_kind_text(kind: name_ref_kind) -> str {
    match kind {
        ref_value => {
            return "value";
        },
        ref_call => {
            return "call";
        },
        ref_assign_target => {
            return "assign_target";
        },
        ref_borrow_target => {
            return "borrow_target";
        },
        ref_struct_type => {
            return "struct_type";
        },
        ref_pattern_ctor => {
            return "pattern_ctor";
        },
    }
}

fn type_ref_kind_text(kind: type_ref_kind) -> str {
    match kind {
        type_return => {
            return "return_type";
        },
        type_param => {
            return "param_type";
        },
        type_local_annotation => {
            return "local_annotation";
        },
        type_field => {
            return "field_type";
        },
        type_enum_payload => {
            return "enum_payload_type";
        },
        type_const_annotation => {
            return "const_annotation";
        },
    }
}

fn variant_enum_name(variants: ref list<variant_fact>, module: str, name: str) -> str {
    let mut index = 0;
    while index < list_len(ref variants) {
        let entry = list_get(ref variants, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    return value.enum_name;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return "";
}

fn item_identity(item: top_item, variants: ref list<variant_fact>) -> str {
    match item.kind {
        item_fn => {
            return function_identity(item.module, item.name);
        },
        item_type => {
            return type_identity(item.module, item.name);
        },
        item_enum => {
            return enum_identity(item.module, item.name);
        },
        item_variant => {
            let enum_name = variant_enum_name(ref variants, item.module, item.name);
            return variant_identity(item.module, enum_name, item.name);
        },
        item_const => {
            return const_identity(item.module, item.name);
        },
    }
}

fn top_item_visible(items: ref list<top_item>, module: str, name: str, kind: top_item_kind) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name {
                    match value.kind {
                        item_fn => {
                            match kind {
                                item_fn => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_type => {
                            match kind {
                                item_type => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_enum => {
                            match kind {
                                item_enum => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_variant => {
                            match kind {
                                item_variant => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_const => {
                            match kind {
                                item_const => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn module_exports_item(items: ref list<top_item>, module: str, name: str, kind: top_item_kind) -> bool {
    let mut index = 0;
    while index < list_len(ref items) {
        let entry = list_get(ref items, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name and value.is_public {
                    match value.kind {
                        item_fn => {
                            match kind {
                                item_fn => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_type => {
                            match kind {
                                item_type => {
                                    return true;
                                },
                                item_enum => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_enum => {
                            match kind {
                                item_type => {
                                    return true;
                                },
                                item_enum => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_variant => {
                            match kind {
                                item_variant => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                        item_const => {
                            match kind {
                                item_const => {
                                    return true;
                                },
                                _ => {
                                },
                            }
                        },
                    }
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn visible_item_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str, kind: top_item_kind) -> str {
    if top_item_visible(ref items, module, name, kind) {
        return module;
    }
    let mut use_index = 0;
    while use_index < list_len(ref uses) {
        let entry = list_get(ref uses, use_index);
        match entry {
            Some(value) => {
                if value.module == module and module_exports_item(ref items, value.name, name, kind) {
                    return value.name;
                }
            },
            None => {
            },
        }
        use_index = use_index + 1;
    }
    return "";
}

fn visible_function_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    if is_builtin_function(name) {
        return "__builtin__";
    }
    return visible_item_origin(ref items, ref uses, module, name, item_fn);
}

fn visible_type_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    if is_builtin_type(name) {
        return "__builtin__";
    }
    let origin = visible_item_origin(ref items, ref uses, module, name, item_type);
    if origin != "" {
        return origin;
    }
    return visible_item_origin(ref items, ref uses, module, name, item_enum);
}

fn visible_variant_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    if is_builtin_variant(name) {
        return "__builtin__";
    }
    return visible_item_origin(ref items, ref uses, module, name, item_variant);
}

fn visible_const_origin(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> str {
    return visible_item_origin(ref items, ref uses, module, name, item_const);
}

fn parent_scope_id(scopes: ref list<body_scope>, module: str, function_name: str, scope_id: i32) -> i32 {
    let mut index = list_len(ref scopes) - 1;
    while index >= 0 {
        let entry = list_get(ref scopes, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name and value.scope_id == scope_id {
                    return value.parent_scope_id;
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return -1;
}

fn scope_is_visible(scopes: ref list<body_scope>, module: str, function_name: str, current_scope_id: i32, candidate_scope_id: i32) -> bool {
    let mut scope_cursor = current_scope_id;
    while scope_cursor >= 0 {
        if scope_cursor == candidate_scope_id {
            return true;
        }
        scope_cursor = parent_scope_id(ref scopes, module, function_name, scope_cursor);
    }
    return false;
}

fn binding_creates_local(binding: body_binding, items: ref list<top_item>, uses: ref list<module_use>) -> bool {
    match binding.kind {
        bind_pattern => {
            if visible_variant_origin(ref items, ref uses, binding.module, binding.name) != "" {
                return false;
            }
        },
        _ => {
        },
    }
    return true;
}

fn resolve_binding_identity(bindings: ref list<body_binding>, scopes: ref list<body_scope>, items: ref list<top_item>, uses: ref list<module_use>, reference: name_ref) -> str {
    return resolve_binding_identity_in_range(ref bindings, ref scopes, ref items, ref uses, reference, 0, list_len(ref bindings) - 1);
}

fn first_binding_index_for_function(bindings: ref list<body_binding>, module: str, function_name: str) -> i32 {
    let mut index = 0;
    while index < list_len(ref bindings) {
        let entry = list_get(ref bindings, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    return index;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return 0;
}

fn last_binding_index_for_function(bindings: ref list<body_binding>, module: str, function_name: str) -> i32 {
    let mut index = list_len(ref bindings) - 1;
    while index >= 0 {
        let entry = list_get(ref bindings, index);
        match entry {
            Some(value) => {
                if value.module == module and value.function_name == function_name {
                    return index;
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    return -1;
}

fn resolve_binding_identity_in_range(bindings: ref list<body_binding>, scopes: ref list<body_scope>, items: ref list<top_item>, uses: ref list<module_use>, reference: name_ref, start_index: i32, end_index: i32) -> str {
    if end_index < start_index {
        return "";
    }
    // M58.1 repair: the nearest visible declaration is the one with the
    // greatest declaration position (the rule typecheck and handoff use), not
    // the first visible entry in reverse storage order. Ties keep the later entry.
    let mut best = -1;
    let mut best_at = -1;
    let mut index = end_index;
    while index >= start_index {
        let entry = list_get(ref bindings, index);
        match entry {
            Some(value) => {
                if value.module == reference.module and value.function_name == reference.function_name and value.name == reference.name and value.visible_from <= reference.at and (best < 0 or value.at > best_at) {
                    if binding_creates_local(value, ref items, ref uses) and scope_is_visible(ref scopes, reference.module, reference.function_name, reference.scope_id, value.scope_id) {
                        best = index;
                        best_at = value.at;
                    }
                }
            },
            None => {
            },
        }
        index = index - 1;
    }
    match list_get(ref bindings, best) {
        Some(value) => { return binding_identity(value); },
        None => { return ""; },
    }
}

fn evidence_for_target(target_kind: str, target_id: str) -> str {
    if target_kind == "unknown" or target_id == "" {
        return "unresolved";
    }
    if target_kind == "builtin" or target_kind == "builtin_type" or target_kind == "builtin_variant" {
        return "builtin";
    }
    if target_kind == "module" {
        return "declared";
    }
    return "checked";
}

fn type_target_for_ref(items: ref list<top_item>, uses: ref list<module_use>, entry: type_ref) -> fact_target {
    let origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
    if origin == "__builtin__" {
        return make_fact_target("builtin_type", str_concat("builtin-type:", entry.name), "builtin");
    }
    if origin == "" {
        return make_fact_target("unknown", "", "unresolved");
    }
    if top_item_visible(ref items, origin, entry.name, item_enum) {
        return make_fact_target("enum", enum_identity(origin, entry.name), "checked");
    }
    return make_fact_target("type", type_identity(origin, entry.name), "checked");
}

fn type_target_for_name(items: ref list<top_item>, uses: ref list<module_use>, module: str, name: str) -> fact_target {
    let origin = visible_type_origin(ref items, ref uses, module, name);
    if origin == "__builtin__" {
        return make_fact_target("builtin_type", str_concat("builtin-type:", name), "builtin");
    }
    if origin == "" {
        return make_fact_target("unknown", "", "unresolved");
    }
    if top_item_visible(ref items, origin, name, item_enum) {
        return make_fact_target("enum", enum_identity(origin, name), "checked");
    }
    return make_fact_target("type", type_identity(origin, name), "checked");
}

fn lookup_function_result_error(functions: ref list<function_fact>, module: str, name: str) -> str {
    let mut index = 0;
    while index < list_len(ref functions) {
        let entry = list_get(ref functions, index);
        match entry {
            Some(value) => {
                if value.module == module and value.name == name and value.return_name == "result" {
                    return value.return_arg2_name;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return "";
}

fn propagation_error_name(expressions: ref list<checked_expr>, local: local_init_fact) -> str {
    if local.expr_member_name == "propagate" { return local.checked_error_name; }
    // Keep the preexisting expression-level try model separate from statements.
    let mut error_name = "";
    let mut outer_start = local.expr_end;
    let mut outer_end = local.expr_start;
    let mut matched_start = local.expr_end;
    let mut matched_end = local.expr_start;
    let mut widest = -1;
    let mut ambiguous = false;
    let mut index = 0;
    while index < list_len(ref expressions) {
        let entry = list_get(ref expressions, index);
        match entry {
            Some(value) => {
                if value.module_name == local.module and value.function_name == local.function_name and value.name == local.expr_name and value.start >= local.expr_start and value.end <= local.expr_end {
                    match value.kind {
                        checked_expr_call => {
                            if value.start < matched_start { matched_start = value.start; }
                            if value.end > matched_end { matched_end = value.end; }
                            let width = value.end - value.start;
                            if width > widest {
                                widest = width;
                                outer_start = value.start;
                                outer_end = value.end;
                                ambiguous = false;
                                error_name = "";
                                if value.type_name == "result" {
                                    error_name = value.type_arg2_name;
                                }
                            } else {
                                if width == widest { ambiguous = true; }
                            }
                        },
                        _ => {},
                    }
                }
            },
            None => {},
        }
        index = index + 1;
    }
    // Only one outer call may contain every matching nested call at this site.
    if ambiguous or outer_start != matched_start or outer_end != matched_end {
        return "";
    }
    return error_name;
}

fn checked_call_target(variants: ref list<variant_fact>, name: str, origin: str, kind: str) -> fact_target {
    if origin == "__builtin__" {
        if kind == "builtin" {
            return make_fact_target("builtin", str_concat("builtin:", name), "builtin");
        }
        if kind == "builtin_variant" {
            return make_fact_target("builtin_variant", str_concat("builtin-variant:", name), "builtin");
        }
    } else {
        if origin != "" {
            if kind == "function" {
                return make_fact_target("function", function_identity(origin, name), "checked");
            }
            if kind == "variant" {
                let enum_name = variant_enum_name(ref variants, origin, name);
                if enum_name != "" {
                    return make_fact_target("variant", variant_identity(origin, enum_name, name), "checked");
                }
            }
        }
    }
    return make_fact_target("unknown", "", "unresolved");
}

fn checked_expr_call_target(variants: ref list<variant_fact>, entry: checked_expr) -> fact_target {
    let mut kind = "";
    match entry.target_kind {
        checked_target_builtin_function => { kind = "builtin"; },
        checked_target_function => { kind = "function"; },
        checked_target_builtin_constructor => { kind = "builtin_variant"; },
        checked_target_constructor => { kind = "variant"; },
        _ => {},
    }
    return checked_call_target(ref variants, entry.name, entry.target_origin_module, kind);
}

fn checked_call_target_for_ref(variants: ref list<variant_fact>, expressions: ref list<checked_expr>, ranges: ref list<fact_expr_range>, entry: name_ref) -> fact_target {
    let mut target = make_fact_target("unknown", "", "unresolved");
    let mut found = false;
    let mut range_index = 0;
    while range_index < list_len(ref ranges) {
        let range_entry = list_get(ref ranges, range_index);
        match range_entry {
            Some(range) => {
                let mut index = range.start_index;
                while index < range.end_index {
                    let expression = list_get(ref expressions, index);
                    match expression {
                        Some(value) => {
                            if value.module_name == entry.module and value.function_name == entry.function_name and value.name == entry.name and value.target_at == entry.at {
                                match value.kind {
                                    checked_expr_call => {
                                        if found {
                                            return make_fact_target("unknown", "", "unresolved");
                                        }
                                        found = true;
                                        target = checked_expr_call_target(ref variants, value);
                                    },
                                    _ => {},
                                }
                            }
                        },
                        None => {},
                    }
                    index = index + 1;
                }
            },
            None => {},
        }
        range_index = range_index + 1;
    }
    return target;
}

fn full_checked_call_target_for_ref(variants: ref list<variant_fact>, expressions: ref list<checked_expr>, entry: name_ref) -> fact_target {
    let mut ranges: list<fact_expr_range> = list();
    list_push(mutref ranges, fact_expr_range { module: entry.module, function_name: entry.function_name, start_index: 0, end_index: list_len(ref expressions) });
    return checked_call_target_for_ref(ref variants, ref expressions, ref ranges, entry);
}

fn name_target_for_ref(items: ref list<top_item>, uses: ref list<module_use>, scopes: ref list<body_scope>, bindings: ref list<body_binding>, variants: ref list<variant_fact>, expressions: ref list<checked_expr>, expr_ranges: ref list<fact_expr_range>, entry: name_ref, start_index: i32, end_index: i32) -> fact_target {
    match entry.kind {
        ref_call => {
            return checked_call_target_for_ref(ref variants, ref expressions, ref expr_ranges, entry);
        },
        _ => {},
    }
    let binding_id = resolve_binding_identity_in_range(ref bindings, ref scopes, ref items, ref uses, entry, start_index, end_index);
    if binding_id != "" {
        return make_fact_target("binding", binding_id, "checked");
    }
    let const_origin = visible_const_origin(ref items, ref uses, entry.module, entry.name);
    if const_origin != "" {
        return make_fact_target("const", const_identity(const_origin, entry.name), "checked");
    }
    match entry.kind {
        ref_struct_type => {
            let type_origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
            if type_origin == "__builtin__" {
                return make_fact_target("builtin_type", str_concat("builtin-type:", entry.name), "builtin");
            }
            if type_origin != "" {
                return make_fact_target("type", type_identity(type_origin, entry.name), "checked");
            }
        },
        ref_pattern_ctor => {
            let origin = visible_variant_origin(ref items, ref uses, entry.module, entry.name);
            if origin == "__builtin__" {
                return make_fact_target("builtin_variant", str_concat("builtin-variant:", entry.name), "builtin");
            }
            if origin != "" {
                return make_fact_target("variant", variant_identity(origin, variant_enum_name(ref variants, origin, entry.name), entry.name), "checked");
            }
        },
        _ => {
        },
    }
    return make_fact_target("unknown", "", "unresolved");
}

fn call_target(items: ref list<top_item>, uses: ref list<module_use>, variants: ref list<variant_fact>, entry: call_fact) -> fact_target {
    return checked_call_target(ref variants, entry.name, entry.checked_origin, entry.checked_kind);
}

fn target_id_for_type_ref(items: ref list<top_item>, uses: ref list<module_use>, entry: type_ref) -> str {
    let origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
    if origin == "__builtin__" {
        return str_concat("builtin-type:", entry.name);
    }
    if origin == "" {
        return "";
    }
    if top_item_visible(ref items, origin, entry.name, item_enum) {
        return enum_identity(origin, entry.name);
    }
    return type_identity(origin, entry.name);
}

fn target_kind_for_type_ref(items: ref list<top_item>, uses: ref list<module_use>, entry: type_ref) -> str {
    let origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
    if origin == "__builtin__" {
        return "builtin_type";
    }
    if origin == "" {
        return "unknown";
    }
    if top_item_visible(ref items, origin, entry.name, item_enum) {
        return "enum";
    }
    return "type";
}

fn target_id_for_name_ref(items: ref list<top_item>, uses: ref list<module_use>, scopes: ref list<body_scope>, bindings: ref list<body_binding>, variants: ref list<variant_fact>, expressions: ref list<checked_expr>, entry: name_ref) -> str {
    match entry.kind {
        ref_call => {
            let target = full_checked_call_target_for_ref(ref variants, ref expressions, entry);
            return target.id;
        },
        _ => {},
    }
    let binding_id = resolve_binding_identity(ref bindings, ref scopes, ref items, ref uses, entry);
    if binding_id != "" {
        return binding_id;
    }
    let const_origin = visible_const_origin(ref items, ref uses, entry.module, entry.name);
    if const_origin != "" {
        return const_identity(const_origin, entry.name);
    }
    match entry.kind {
        ref_struct_type => {
            let type_origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
            if type_origin == "__builtin__" {
                return str_concat("builtin-type:", entry.name);
            }
            if type_origin != "" {
                return type_identity(type_origin, entry.name);
            }
        },
        ref_pattern_ctor => {
            let origin = visible_variant_origin(ref items, ref uses, entry.module, entry.name);
            if origin == "__builtin__" {
                return str_concat("builtin-variant:", entry.name);
            }
            if origin != "" {
                return variant_identity(origin, variant_enum_name(ref variants, origin, entry.name), entry.name);
            }
        },
        _ => {
        },
    }
    return "";
}

fn target_kind_for_name_ref(items: ref list<top_item>, uses: ref list<module_use>, scopes: ref list<body_scope>, bindings: ref list<body_binding>, variants: ref list<variant_fact>, expressions: ref list<checked_expr>, entry: name_ref) -> str {
    match entry.kind {
        ref_call => {
            let target = full_checked_call_target_for_ref(ref variants, ref expressions, entry);
            return target.kind;
        },
        _ => {},
    }
    let binding_id = resolve_binding_identity(ref bindings, ref scopes, ref items, ref uses, entry);
    if binding_id != "" {
        return "binding";
    }
    let const_origin = visible_const_origin(ref items, ref uses, entry.module, entry.name);
    if const_origin != "" {
        return "const";
    }
    match entry.kind {
        ref_struct_type => {
            let type_origin = visible_type_origin(ref items, ref uses, entry.module, entry.name);
            if type_origin == "__builtin__" {
                return "builtin_type";
            }
            if type_origin != "" {
                return "type";
            }
        },
        ref_pattern_ctor => {
            let origin = visible_variant_origin(ref items, ref uses, entry.module, entry.name);
            if origin == "__builtin__" {
                return "builtin_variant";
            }
            if origin != "" {
                return "variant";
            }
        },
        _ => {
        },
    }
    return "unknown";
}

fn call_target_id(items: ref list<top_item>, uses: ref list<module_use>, variants: ref list<variant_fact>, entry: call_fact) -> str {
    let target = call_target(ref items, ref uses, ref variants, entry);
    return target.id;
}

fn binding_definition_count(items: ref list<top_item>, uses: ref list<module_use>, bindings: ref list<body_binding>) -> i32 {
    let mut count = 0;
    let mut index = 0;
    while index < list_len(ref bindings) {
        let entry = list_get(ref bindings, index);
        match entry {
            Some(value) => {
                if binding_creates_local(value, ref items, ref uses) {
                    count = count + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return count;
}

fn definition_count(items: ref list<top_item>, uses: ref list<module_use>, fields: ref list<field_fact>, bindings: ref list<body_binding>) -> i32 {
    return list_len(ref items) + list_len(ref fields) + binding_definition_count(ref items, ref uses, ref bindings);
}

fn reference_count(uses: ref list<module_use>, type_refs: ref list<type_ref>, refs: ref list<name_ref>) -> i32 {
    return list_len(ref uses) + list_len(ref type_refs) + list_len(ref refs);
}

fn append_modules(lines: mutref list<str>, modules: ref list<str>) -> unit {
    list_push(mutref lines, "  \"modules\": [");
    let mut index = 0;
    while index < list_len(ref modules) {
        let entry = list_get(ref modules, index);
        match entry {
            Some(value) => {
                list_push(mutref lines, "    {");
                list_push(mutref lines, concat5("      \"id\": ", json_quote(module_identity(value)), ",", "", ""));
                list_push(mutref lines, concat5("      \"name\": ", json_quote(value), "", "", ""));
                if index + 1 < list_len(ref modules) {
                    list_push(mutref lines, "    },");
                } else {
                    list_push(mutref lines, "    }");
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    list_push(mutref lines, "  ],");
    return;
}

fn append_top_item_definition(lines: mutref list<str>, item: top_item, variants: ref list<variant_fact>, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, "    {");
    list_push(mutref lines, concat5("      \"id\": ", json_quote(item_identity(item, ref variants)), ",", "", ""));
    list_push(mutref lines, concat5("      \"kind\": ", json_quote(item_kind_text(item.kind)), ",", "", ""));
    list_push(mutref lines, concat5("      \"module\": ", json_quote(item.module), ",", "", ""));
    list_push(mutref lines, concat5("      \"name\": ", json_quote(item.name), ",", "", ""));
    list_push(mutref lines, concat3("      \"public\": ", bool_text(item.is_public), ","));
    append_span(mutref lines, "      ", item.at, false);
    list_push(mutref lines, concat3("    }", suffix, ""));
    return;
}

fn append_field_definition(lines: mutref list<str>, field: field_fact, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, "    {");
    list_push(mutref lines, concat5("      \"id\": ", json_quote(field_identity(field.module, field.type_name, field.name)), ",", "", ""));
    list_push(mutref lines, "      \"kind\": \"field\",");
    list_push(mutref lines, concat5("      \"module\": ", json_quote(field.module), ",", "", ""));
    list_push(mutref lines, concat5("      \"owner\": ", json_quote(type_identity(field.module, field.type_name)), ",", "", ""));
    list_push(mutref lines, concat5("      \"name\": ", json_quote(field.name), ",", "", ""));
    list_push(mutref lines, concat5("      \"type\": ", json_quote(field.field_type_name), ",", "", ""));
    append_span(mutref lines, "      ", field.at, false);
    list_push(mutref lines, concat3("    }", suffix, ""));
    return;
}

fn append_binding_definition(lines: mutref list<str>, binding: body_binding, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, "    {");
    list_push(mutref lines, concat5("      \"id\": ", json_quote(binding_identity(binding)), ",", "", ""));
    list_push(mutref lines, concat5("      \"kind\": ", json_quote(binding_kind_text(binding.kind)), ",", "", ""));
    list_push(mutref lines, concat5("      \"module\": ", json_quote(binding.module), ",", "", ""));
    list_push(mutref lines, concat5("      \"owner\": ", json_quote(function_identity(binding.module, binding.function_name)), ",", "", ""));
    list_push(mutref lines, concat5("      \"name\": ", json_quote(binding.name), ",", "", ""));
    list_push(mutref lines, concat5("      \"scope_id\": ", i32_to_str(binding.scope_id), ",", "", ""));
    append_span(mutref lines, "      ", binding.at, false);
    list_push(mutref lines, concat3("    }", suffix, ""));
    return;
}

fn append_definitions(lines: mutref list<str>, items: ref list<top_item>, uses: ref list<module_use>, variants: ref list<variant_fact>, fields: ref list<field_fact>, bindings: ref list<body_binding>) -> unit {
    let total = definition_count(ref items, ref uses, ref fields, ref bindings);
    let mut emitted = 0;
    list_push(mutref lines, "  \"definitions\": [");
    let mut item_index = 0;
    while item_index < list_len(ref items) {
        let entry = list_get(ref items, item_index);
        match entry {
            Some(value) => {
                emitted = emitted + 1;
                append_top_item_definition(mutref lines, value, ref variants, emitted < total);
            },
            None => {
            },
        }
        item_index = item_index + 1;
    }
    let mut field_index = 0;
    while field_index < list_len(ref fields) {
        let entry = list_get(ref fields, field_index);
        match entry {
            Some(value) => {
                emitted = emitted + 1;
                append_field_definition(mutref lines, value, emitted < total);
            },
            None => {
            },
        }
        field_index = field_index + 1;
    }
    let mut binding_index = 0;
    while binding_index < list_len(ref bindings) {
        let entry = list_get(ref bindings, binding_index);
        match entry {
            Some(value) => {
                if binding_creates_local(value, ref items, ref uses) {
                    emitted = emitted + 1;
                    append_binding_definition(mutref lines, value, emitted < total);
                }
            },
            None => {
            },
        }
        binding_index = binding_index + 1;
    }
    list_push(mutref lines, "  ],");
    return;
}

fn append_top_item_definition_v2(lines: mutref list<str>, item: top_item, variants: ref list<variant_fact>, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, "    {");
    list_push(mutref lines, concat5("      \"id\": ", json_quote(item_identity(item, ref variants)), ",", "", ""));
    list_push(mutref lines, concat5("      \"kind\": ", json_quote(item_kind_text(item.kind)), ",", "", ""));
    list_push(mutref lines, concat5("      \"module\": ", json_quote(item.module), ",", "", ""));
    list_push(mutref lines, concat5("      \"name\": ", json_quote(item.name), ",", "", ""));
    list_push(mutref lines, concat3("      \"public\": ", bool_text(item.is_public), ","));
    list_push(mutref lines, "      \"evidence\": \"declared\",");
    append_span(mutref lines, "      ", item.at, false);
    list_push(mutref lines, concat3("    }", suffix, ""));
    return;
}

