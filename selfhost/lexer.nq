use token;

type scanned_string {
    text: str,
    end: i32,
}

fn is_space(ch: i32) -> bool {
    return ch == 32 or ch == 9 or ch == 10 or ch == 13;
}

fn is_digit(ch: i32) -> bool {
    return ch >= 48 and ch <= 57;
}

fn is_alpha(ch: i32) -> bool {
    return (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95;
}

fn is_ident_continue(ch: i32) -> bool {
    return is_alpha(ch) or is_digit(ch);
}

fn slice_text(text: str, start: i32, end: i32) -> str {
    let part = str_slice(text, start, end);
    match part {
        Some(value) => {
            return value;
        },
        None => {
            return "";
        },
    }
}

fn keyword_kind(text: str) -> token_kind {
    if text == "and" {
        return tk_kw_and;
    }
    if text == "audit" {
        return tk_kw_audit;
    }
    if text == "break" {
        return tk_kw_break;
    }
    if text == "const" {
        return tk_kw_const;
    }
    if text == "continue" {
        return tk_kw_continue;
    }
    if text == "else" {
        return tk_kw_else;
    }
    if text == "enum" {
        return tk_kw_enum;
    }
    if text == "false" {
        return tk_kw_false;
    }
    if text == "fn" {
        return tk_kw_fn;
    }
    if text == "for" {
        return tk_kw_for;
    }
    if text == "if" {
        return tk_kw_if;
    }
    if text == "in" {
        return tk_kw_in;
    }
    if text == "let" {
        return tk_kw_let;
    }
    if text == "match" {
        return tk_kw_match;
    }
    if text == "mut" {
        return tk_kw_mut;
    }
    if text == "mutref" {
        return tk_kw_mutref;
    }
    if text == "not" {
        return tk_kw_not;
    }
    if text == "or" {
        return tk_kw_or;
    }
    if text == "pub" {
        return tk_kw_pub;
    }
    if text == "ref" {
        return tk_kw_ref;
    }
    if text == "return" {
        return tk_kw_return;
    }
    if text == "true" {
        return tk_kw_true;
    }
    if text == "try" {
        return tk_kw_try;
    }
    if text == "type" {
        return tk_kw_type;
    }
    if text == "use" {
        return tk_kw_use;
    }
    if text == "while" {
        return tk_kw_while;
    }
    return tk_ident;
}

fn scan_comment_end(text: str, start: i32, length: i32) -> i32 {
    let mut index = start;
    while index < length {
        let value = str_get(text, index);
        match value {
            Some(ch) => {
                if ch == 10 {
                    return index + 1;
                }
                index = index + 1;
            },
            None => {
                return length;
            },
        }
    }
    return length;
}

fn scan_string_end(text: str, start: i32, length: i32) -> i32 {
    let mut index = start + 1;
    while index < length {
        let value = str_get(text, index);
        match value {
            Some(ch) => {
                if ch == 34 {
                    return index + 1;
                }
                index = index + 1;
            },
            None => {
                return length;
            },
        }
    }
    return length;
}

fn scan_string_value(text: str, start: i32, length: i32) -> scanned_string {
    let mut index = start + 1;
    let mut value = "";
    while index < length {
        let entry = str_get(text, index);
        match entry {
            Some(ch) => {
                if ch == 34 {
                    return scanned_string {
                        text: value,
                        end: index + 1,
                    };
                }
                if ch == 92 {
                    let next_entry = str_get(text, index + 1);
                    match next_entry {
                        Some(escape) => {
                            if escape == 110 {
                                value = str_concat(value, "\n");
                            } else {
                                if escape == 116 {
                                    value = str_concat(value, "\t");
                                } else {
                                    let piece = slice_text(text, index + 1, index + 2);
                                    value = str_concat(value, piece);
                                }
                            }
                            index = index + 2;
                        },
                        None => {
                            return scanned_string {
                                text: value,
                                end: length,
                            };
                        },
                    }
                } else {
                    let piece = slice_text(text, index, index + 1);
                    value = str_concat(value, piece);
                    index = index + 1;
                }
            },
            None => {
                return scanned_string {
                    text: value,
                    end: length,
                };
            },
        }
    }
    return scanned_string {
        text: value,
        end: length,
    };
}

fn scan_digit_end(text: str, start: i32, length: i32) -> i32 {
    let mut index = start + 1;
    while index < length {
        let value = str_get(text, index);
        match value {
            Some(ch) => {
                if is_digit(ch) {
                    index = index + 1;
                } else {
                    return index;
                }
            },
            None => {
                return length;
            },
        }
    }
    return length;
}

fn lexer_byte_at(text: str, index: i32, length: i32) -> i32 {
    if index < 0 or index >= length {
        return -1;
    }
    let value = str_get(text, index);
    match value {
        Some(ch) => {
            return ch;
        },
        None => {
            return -1;
        },
    }
}

type scanned_number {
    kind: token_kind,
    end: i32,
}

// FLOAT_LIT = DIGITS "." DIGITS [ "e" [ "-" ] DIGITS ]. After the fraction,
// an `e`/`E`, at most one sign byte, and the maximal digit run are consumed;
// anything but `e`, an absent or `-` sign, and one or more digits makes the
// whole consumed span one malformed-float token (reported as NQ-PARSE-004).
//
// M58.1: the near-miss shapes `1.`, `1e5`, `1E5`, `1e-5` (and `.5`, see
// scan_leading_dot_number) are one malformed-float token too, so they reach
// NQ-PARSE-004 instead of later stage1 diagnostics. `1.name` and `1.e5` stay
// an integer followed by a field access (their existing diagnostic).
fn scan_number(text: str, start: i32, length: i32) -> scanned_number {
    let int_end = scan_digit_end(text, start, length);
    let after_int = lexer_byte_at(text, int_end, length);
    if after_int == 101 or after_int == 69 {
        let exponent_end = scan_bare_exponent_end(text, int_end, length);
        if exponent_end > int_end {
            return scanned_number { kind: tk_malformed_float_lit, end: exponent_end };
        }
    }
    if after_int != 46 {
        return scanned_number { kind: tk_int_lit, end: int_end };
    }
    if not is_digit(lexer_byte_at(text, int_end + 1, length)) {
        let after_dot = lexer_byte_at(text, int_end + 1, length);
        if is_alpha(after_dot) or after_dot == 46 {
            return scanned_number { kind: tk_int_lit, end: int_end };
        }
        return scanned_number { kind: tk_malformed_float_lit, end: int_end + 1 };
    }
    let fraction_end = scan_digit_end(text, int_end + 1, length);
    let marker = lexer_byte_at(text, fraction_end, length);
    if marker != 101 and marker != 69 {
        return scanned_number { kind: tk_float_lit, end: fraction_end };
    }
    let mut cursor = fraction_end + 1;
    let mut valid = marker == 101;
    let sign = lexer_byte_at(text, cursor, length);
    if sign == 43 or sign == 45 {
        if sign == 43 {
            valid = false;
        }
        cursor = cursor + 1;
    }
    if is_digit(lexer_byte_at(text, cursor, length)) {
        cursor = scan_digit_end(text, cursor, length);
    } else {
        valid = false;
    }
    if valid {
        return scanned_number { kind: tk_float_lit, end: cursor };
    }
    return scanned_number { kind: tk_malformed_float_lit, end: cursor };
}

// After DIGITS, an `e`/`E`, at most one `+`/`-`, and at least one digit: the
// end of that exponent, or -1 when the bytes are not an exponent (then `1e`
// stays an integer followed by a name).
fn scan_bare_exponent_end(text: str, marker: i32, length: i32) -> i32 {
    let mut cursor = marker + 1;
    let sign = lexer_byte_at(text, cursor, length);
    if sign == 43 or sign == 45 {
        cursor = cursor + 1;
    }
    if is_digit(lexer_byte_at(text, cursor, length)) {
        return scan_digit_end(text, cursor, length);
    }
    return -1;
}

// `.5` (a `.` directly followed by a digit, not after a name, number, `)` or
// `]`) is one malformed-float token covering `.DIGITS` and any exponent.
fn scan_leading_dot_number(text: str, start: i32, length: i32) -> i32 {
    if lexer_byte_at(text, start, length) != 46 or not is_digit(lexer_byte_at(text, start + 1, length)) {
        return -1;
    }
    let before = lexer_byte_at(text, start - 1, length);
    if is_ident_continue(before) or before == 41 or before == 93 {
        return -1;
    }
    let fraction_end = scan_digit_end(text, start + 1, length);
    let marker = lexer_byte_at(text, fraction_end, length);
    if marker == 101 or marker == 69 {
        let exponent_end = scan_bare_exponent_end(text, fraction_end, length);
        if exponent_end > fraction_end {
            return exponent_end;
        }
    }
    return fraction_end;
}

// Digit `ordinal` of DIGITS "." DIGITS (point skipped), or '0' past the mantissa.
fn float_mantissa_digit(text: str, point: i32, exponent_at: i32, ordinal: i32) -> i32 {
    let mut index = ordinal;
    if ordinal >= point {
        index = ordinal + 1;
    }
    if index >= exponent_at {
        return 48;
    }
    return lexer_byte_at(text, index, exponent_at);
}

pub fn float_literal_magnitude_order(text: str, bound_digits: str, bound_adjusted: i32) -> i32
audit {
    intent("Compare a FLOAT_LIT's exact decimal magnitude with 0.bound_digits x 10^bound_adjusted, textually and without floating-point arithmetic");
    mutates();
    effects();
}
{
    // Returns -1, 0, or 1. The literal's value is 0.D x 10^adjusted, where D
    // starts at its first nonzero digit. Exponent digit runs longer than nine
    // (after leading zeros) are unbounded in their sign's direction.
    let length = str_len(text);
    let mut point = -1;
    let mut exponent_at = length;
    let mut index = 0;
    while index < length {
        let ch = lexer_byte_at(text, index, length);
        if ch == 46 and point < 0 {
            point = index;
        }
        if (ch == 101 or ch == 69) and exponent_at == length {
            exponent_at = index;
        }
        index = index + 1;
    }
    if point < 0 or point > exponent_at {
        return -1;
    }
    let mantissa_count = exponent_at - 1;
    let mut first_nonzero = -1;
    let mut ordinal = 0;
    while ordinal < mantissa_count and first_nonzero < 0 {
        if float_mantissa_digit(text, point, exponent_at, ordinal) != 48 {
            first_nonzero = ordinal;
        }
        ordinal = ordinal + 1;
    }
    if first_nonzero < 0 {
        return -1;
    }
    let mut exponent_negative = false;
    let mut exponent_value = 0;
    if exponent_at < length {
        let mut cursor = exponent_at + 1;
        if lexer_byte_at(text, cursor, length) == 45 {
            exponent_negative = true;
            cursor = cursor + 1;
        }
        while cursor < length and lexer_byte_at(text, cursor, length) == 48 {
            cursor = cursor + 1;
        }
        if length - cursor > 9 {
            if exponent_negative {
                return -1;
            }
            return 1;
        }
        while cursor < length {
            exponent_value = exponent_value * 10 + (lexer_byte_at(text, cursor, length) - 48);
            cursor = cursor + 1;
        }
    }
    if exponent_negative {
        exponent_value = 0 - exponent_value;
    }
    let adjusted = point - first_nonzero + exponent_value;
    if adjusted > bound_adjusted {
        return 1;
    }
    if adjusted < bound_adjusted {
        return -1;
    }
    let bound_len = str_len(bound_digits);
    let mut offset = 0;
    while offset < bound_len {
        let actual = float_mantissa_digit(text, point, exponent_at, first_nonzero + offset);
        let allowed = lexer_byte_at(bound_digits, offset, bound_len);
        if actual > allowed {
            return 1;
        }
        if actual < allowed {
            return -1;
        }
        offset = offset + 1;
    }
    let mut rest = first_nonzero + bound_len;
    while rest < mantissa_count {
        if float_mantissa_digit(text, point, exponent_at, rest) != 48 {
            return 1;
        }
        rest = rest + 1;
    }
    return 0;
}

fn scan_ident_end(text: str, start: i32, length: i32) -> i32 {
    let mut index = start + 1;
    while index < length {
        let value = str_get(text, index);
        match value {
            Some(ch) => {
                if is_ident_continue(ch) {
                    index = index + 1;
                } else {
                    return index;
                }
            },
            None => {
                return length;
            },
        }
    }
    return length;
}

fn push_token(tokens: mutref list<token>, kind: token_kind, text: str, start: i32, end: i32) -> unit {
    list_push(mutref tokens, make_token(kind, text, start, end));
    return;
}

fn try_comment_or_slash(text: str, tokens: mutref list<token>, index: i32, length: i32, ch: i32) -> i32 {
    if ch != 47 {
        return -1;
    }
    let next = str_get(text, index + 1);
    match next {
        Some(other) => {
            if other == 47 {
                return scan_comment_end(text, index + 2, length);
            }
            push_token(mutref tokens, tk_slash, "/", index, index + 1);
            return index + 1;
        },
        None => {
            push_token(mutref tokens, tk_slash, "/", index, index + 1);
            return index + 1;
        },
    }
}

// M58.2: `..` at `index` pushes one `..` token; a single `.` directly after a
// `..` token (no space between) pushes a plain `.`. Returns the next index,
// or -1 when neither applies.
fn scan_range_dots(tokens: mutref list<token>, text: str, index: i32, length: i32) -> i32 {
    if lexer_byte_at(text, index, length) != 46 {
        return -1;
    }
    if lexer_byte_at(text, index + 1, length) == 46 {
        push_token(mutref tokens, tk_dotdot, "..", index, index + 2);
        return index + 2;
    }
    let count = list_len(ref tokens);
    if count > 0 {
        let previous = list_get(ref tokens, count - 1);
        match previous {
            Some(value) => {
                match value.kind {
                    tk_dotdot => {
                        if value.end == index {
                            push_token(mutref tokens, tk_dot, ".", index, index + 1);
                            return index + 1;
                        }
                    },
                    _ => {
                    },
                }
            },
            None => {
            },
        }
    }
    return -1;
}

fn try_single_char(tokens: mutref list<token>, index: i32, ch: i32) -> i32 {
    if ch == 40 {
        push_token(mutref tokens, tk_lparen, "(", index, index + 1);
        return index + 1;
    }
    if ch == 41 {
        push_token(mutref tokens, tk_rparen, ")", index, index + 1);
        return index + 1;
    }
    if ch == 123 {
        push_token(mutref tokens, tk_lbrace, "{", index, index + 1);
        return index + 1;
    }
    if ch == 125 {
        push_token(mutref tokens, tk_rbrace, "}", index, index + 1);
        return index + 1;
    }
    if ch == 91 {
        push_token(mutref tokens, tk_lbracket, "[", index, index + 1);
        return index + 1;
    }
    if ch == 93 {
        push_token(mutref tokens, tk_rbracket, "]", index, index + 1);
        return index + 1;
    }
    if ch == 44 {
        push_token(mutref tokens, tk_comma, ",", index, index + 1);
        return index + 1;
    }
    if ch == 59 {
        push_token(mutref tokens, tk_semi, ";", index, index + 1);
        return index + 1;
    }
    if ch == 58 {
        push_token(mutref tokens, tk_colon, ":", index, index + 1);
        return index + 1;
    }
    if ch == 46 {
        push_token(mutref tokens, tk_dot, ".", index, index + 1);
        return index + 1;
    }
    if ch == 43 {
        push_token(mutref tokens, tk_plus, "+", index, index + 1);
        return index + 1;
    }
    if ch == 42 {
        push_token(mutref tokens, tk_star, "*", index, index + 1);
        return index + 1;
    }
    if ch == 37 {
        push_token(mutref tokens, tk_percent, "%", index, index + 1);
        return index + 1;
    }
    if ch == 63 {
        push_token(mutref tokens, tk_question, "?", index, index + 1);
        return index + 1;
    }
    return -1;
}

fn try_operator(text: str, tokens: mutref list<token>, index: i32, ch: i32) -> i32 {
    if ch == 45 {
        let next = str_get(text, index + 1);
        match next {
            Some(other) => {
                if other == 62 {
                    push_token(mutref tokens, tk_arrow, "->", index, index + 2);
                    return index + 2;
                }
                push_token(mutref tokens, tk_minus, "-", index, index + 1);
                return index + 1;
            },
            None => {
                push_token(mutref tokens, tk_minus, "-", index, index + 1);
                return index + 1;
            },
        }
    }
    if ch == 61 {
        let next = str_get(text, index + 1);
        match next {
            Some(other) => {
                if other == 61 {
                    push_token(mutref tokens, tk_eqeq, "==", index, index + 2);
                    return index + 2;
                }
                if other == 62 {
                    push_token(mutref tokens, tk_fat_arrow, "=>", index, index + 2);
                    return index + 2;
                }
                push_token(mutref tokens, tk_eq, "=", index, index + 1);
                return index + 1;
            },
            None => {
                push_token(mutref tokens, tk_eq, "=", index, index + 1);
                return index + 1;
            },
        }
    }
    if ch == 33 {
        let next = str_get(text, index + 1);
        match next {
            Some(other) => {
                if other == 61 {
                    push_token(mutref tokens, tk_noteq, "!=", index, index + 2);
                    return index + 2;
                }
                push_token(mutref tokens, tk_unknown, "!", index, index + 1);
                return index + 1;
            },
            None => {
                push_token(mutref tokens, tk_unknown, "!", index, index + 1);
                return index + 1;
            },
        }
    }
    if ch == 60 {
        let next = str_get(text, index + 1);
        match next {
            Some(other) => {
                if other == 61 {
                    push_token(mutref tokens, tk_lte, "<=", index, index + 2);
                    return index + 2;
                }
                push_token(mutref tokens, tk_lt, "<", index, index + 1);
                return index + 1;
            },
            None => {
                push_token(mutref tokens, tk_lt, "<", index, index + 1);
                return index + 1;
            },
        }
    }
    if ch == 62 {
        let next = str_get(text, index + 1);
        match next {
            Some(other) => {
                if other == 61 {
                    push_token(mutref tokens, tk_gte, ">=", index, index + 2);
                    return index + 2;
                }
                push_token(mutref tokens, tk_gt, ">", index, index + 1);
                return index + 1;
            },
            None => {
                push_token(mutref tokens, tk_gt, ">", index, index + 1);
                return index + 1;
            },
        }
    }
    return -1;
}

pub fn lex(text: str) -> list<token>
audit {
    intent("Tokenize a Nauqtype source file into a regular token stream");
    mutates();
    effects();
}
{
    let mut tokens: list<token> = list();
    let mut index = 0;
    let length = str_len(text);

    while index < length {
        // M58.2: two adjacent dots are always one `..` token (maximal munch,
        // before any other rule that starts with `.`), and a lone `.` that
        // directly follows a `..` token is a plain `.`, never a leading-dot
        // float (`1...2` is `1`, `..`, `.`, `2`).
        let dot_end = scan_range_dots(mutref tokens, text, index, length);
        if dot_end >= 0 {
            index = dot_end;
            continue;
        }
        let leading_dot_end = scan_leading_dot_number(text, index, length);
        if leading_dot_end >= 0 {
            push_token(mutref tokens, tk_malformed_float_lit, slice_text(text, index, leading_dot_end), index, leading_dot_end);
            index = leading_dot_end;
            continue;
        }
        let current = str_get(text, index);
        match current {
            Some(ch) => {
                if is_space(ch) {
                    index = index + 1;
                } else {
                    let after_comment = try_comment_or_slash(text, mutref tokens, index, length, ch);
                    if after_comment >= 0 {
                        index = after_comment;
                    } else {
                        let after_single = try_single_char(mutref tokens, index, ch);
                        if after_single >= 0 {
                            index = after_single;
                        } else {
                            let after_operator = try_operator(text, mutref tokens, index, ch);
                            if after_operator >= 0 {
                                index = after_operator;
                            } else {
                                if ch == 34 {
                                    let string_value = scan_string_value(text, index, length);
                                    push_token(mutref tokens, tk_string_lit, string_value.text, index, string_value.end);
                                    index = string_value.end;
                                } else {
                                    if is_digit(ch) {
                                        let number = scan_number(text, index, length);
                                        let value = slice_text(text, index, number.end);
                                        push_token(mutref tokens, number.kind, value, index, number.end);
                                        index = number.end;
                                    } else {
                                        if is_alpha(ch) {
                                            let end = scan_ident_end(text, index, length);
                                            let value = slice_text(text, index, end);
                                            let kind = keyword_kind(value);
                                            push_token(mutref tokens, kind, value, index, end);
                                            index = end;
                                        } else {
                                            let value = slice_text(text, index, index + 1);
                                            push_token(mutref tokens, tk_unknown, value, index, index + 1);
                                            index = index + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            None => {
                index = length;
            },
        }
    }

    list_push(mutref tokens, eof_token(length));
    return tokens;
}
