pub fn compiler_help_text() -> str
audit {
    intent("Return the stable Nauqtype compiler command summary");
    mutates();
    effects();
}
{
    return "Nauqtype compiler\n\nUsage:\n  nauqc <command> [options]\n\nCommands:\n  check <source> [--diagnostics text|json]\n  emit-c <source> [-o <output>]\n  facts <source> [--format v1|v2|v3]\n  review <source> [--format v1|v2|v3|v4]\n  review-diff <before> <after> [--format v1|v2]\n  change-report <before> <after> [--policy <policy>] --format v1|v2|v3\n  refactor-rename <source> <stable-id> <new-name>\n  policy-check <source> <policy-path>\n  fmt [--check] <source>\n  build <source> [-o <output>]\n  run <source> [-o <output>]\n  test\n  prove\n  prove-seed <stage1-c> <stage2-c>\n  prove-selfhost\n  prove-corpus\n  help, --help, -h\n  version, --version, -V\n\nNo arguments preserve the legacy selfhost bootstrap mode.";
}

pub fn compiler_version() -> str
audit {
    intent("Return the checked compiler version identity");
    mutates();
    effects();
}
{
    return "0.3.0-alpha.1";
}

pub fn compiler_version_text() -> str
audit {
    intent("Render the stable Nauqtype compiler version line");
    mutates();
    effects();
}
{
    return str_concat("nauqc ", compiler_version());
}
