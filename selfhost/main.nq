use ast;
use borrow;
use c_emit;
use files;
use handoff;
use ir;
use diag;
use facts;
use fmt;
use lexer;
use parser;
use proof;
use review;
use resolve;
use source;
use text;
use typecheck;
use workspace;

enum driver_mode {
    driver_legacy,
    driver_check,
    driver_emit_c,
    driver_facts,
    driver_facts_v2,
    driver_facts_v3,
    driver_review,
    driver_review_v2,
    driver_review_diff,
    driver_review_diff_v2,
    driver_change_report,
    driver_refactor_rename,
    driver_policy_check,
    driver_fmt,
    driver_fmt_check,
    driver_build,
    driver_run,
    driver_prove,
    driver_prove_seed,
    driver_prove_selfhost,
    driver_prove_corpus,
    driver_test,
    driver_invalid,
}

type driver_request {
    mode: driver_mode,
    entry_path: str,
    entry_module: str,
    workspace_root: str,
    output_path: str,
    extra_text: str,
    error_message: str,
}

fn make_driver_request(mode: driver_mode, entry_path: str, entry_module: str, workspace_root: str, output_path: str, extra_text: str, error_message: str) -> driver_request {
    if entry_path != "" and entry_module != "" {
        let resolved = resolve_workspace_entry(entry_path);
        if not resolved.valid {
            return driver_request {
                mode: driver_invalid,
                entry_path: "",
                entry_module: "",
                workspace_root: ".",
                output_path: "",
                extra_text: "",
                error_message: resolved.error_message,
            };
        }
        return driver_request {
            mode: mode,
            entry_path: entry_path,
            entry_module: resolved.module_name,
            workspace_root: resolved.source_root,
            output_path: output_path,
            extra_text: extra_text,
            error_message: error_message,
        };
    }
    return driver_request {
        mode: mode,
        entry_path: entry_path,
        entry_module: entry_module,
        workspace_root: workspace_root,
        output_path: output_path,
        extra_text: extra_text,
        error_message: error_message,
    };
}

fn queue_if_missing(pending: mutref list<str>, seen: ref list<str>, name: str) -> unit {
    if list_contains(ref seen, name) {
        return;
    }
    if list_contains(ref pending, name) {
        return;
    }
    list_push(mutref pending, name);
    return;
}

fn module_reaches_start(start: str, uses: ref list<module_use>) -> bool {
    let mut pending: list<str> = list();
    let mut seen: list<str> = list();
    let mut cursor = 0;
    list_push(mutref pending, start);
    while cursor < list_len(ref pending) {
        let current = list_get(ref pending, cursor);
        match current {
            Some(module_name) => {
                if not list_contains(ref seen, module_name) {
                    list_push(mutref seen, module_name);
                    let mut use_index = 0;
                    while use_index < list_len(ref uses) {
                        let entry = list_get(ref uses, use_index);
                        match entry {
                            Some(value) => {
                                if value.module == module_name {
                                    if value.name == start {
                                        return true;
                                    }
                                    queue_if_missing(mutref pending, ref seen, value.name);
                                }
                            },
                            None => {
                            },
                        }
                        use_index = use_index + 1;
                    }
                }
            },
            None => {
            },
        }
        cursor = cursor + 1;
    }
    return false;
}

fn detect_import_cycles(modules: ref list<str>, uses: ref list<module_use>, diags: mutref list<diag>) -> unit {
    let mut index = 0;
    while index < list_len(ref modules) {
        let entry = list_get(ref modules, index);
        match entry {
            Some(module_name) => {
                if module_reaches_start(module_name, ref uses) {
                    list_push(mutref diags, make_diag(module_name, 0, "import cycle detected"));
                    return;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

fn emit_all(diags: ref list<diag>) -> unit {
    let mut index = 0;
    while index < list_len(ref diags) {
        let entry = list_get(ref diags, index);
        match entry {
            Some(value) => {
                emit_diag(value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return;
}

type module_source_result {
    valid: bool,
    file: source_file,
    error_message: str,
}

fn make_module_source_result(valid: bool, file: source_file, error_message: str) -> module_source_result {
    return module_source_result { valid: valid, file: file, error_message: error_message };
}

fn read_module_source(name: str, workspace_root: str, entry_module: str, entry_path: str) -> module_source_result {
    if entry_path != "" and name == entry_module {
        match read_source_at_path(entry_path, entry_module) {
            Ok(file) => { return make_module_source_result(true, file, ""); },
            Err(err) => { return make_module_source_result(false, make_source_file(name, ""), io_err_text(err)); },
        }
    }
    let route = resolve_workspace_module_path(workspace_root, name);
    if not route.valid {
        return make_module_source_result(false, make_source_file(name, ""), route.error_message);
    }
    match read_source_at_path(route.source_path, name) {
        Ok(file) => { return make_module_source_result(true, file, ""); },
        Err(err) => { return make_module_source_result(false, make_source_file(name, ""), io_err_text(err)); },
    }
}

fn load_module_graph(name: str, workspace_root: str, entry_module: str, entry_path: str, loading_path: str, seen_modules: mutref list<str>, loaded_modules: mutref list<str>, sources: mutref list<source_file>, items: mutref list<top_item>, uses: mutref list<module_use>, scopes: mutref list<body_scope>, bindings: mutref list<body_binding>, refs: mutref list<name_ref>, type_refs: mutref list<type_ref>, function_facts: mutref list<function_fact>, function_param_facts: mutref list<function_param_fact>, variant_facts: mutref list<variant_fact>, variant_payload_facts: mutref list<variant_payload_fact>, const_facts: mutref list<const_fact>, call_facts: mutref list<call_fact>, pattern_facts: mutref list<pattern_ctor_fact>, typed_bindings: mutref list<typed_binding_fact>, field_facts: mutref list<field_fact>, match_arms: mutref list<match_arm_fact>, local_inits: mutref list<local_init_fact>, return_facts: mutref list<return_expr_fact>, condition_facts: mutref list<condition_fact>, assignment_facts: mutref list<assignment_fact>, stmt_facts: mutref list<stmt_fact>, diags: mutref list<diag>) -> unit {
    if list_contains(ref seen_modules, name) {
        return;
    }
    let stack_key = str_concat(str_concat("|", name), "|");
    if text_contains(loading_path, stack_key) {
        list_push(mutref diags, make_diag(name, 0, "import cycle detected"));
        return;
    }
    let loaded_file = read_module_source(name, workspace_root, entry_module, entry_path);
    if not loaded_file.valid {
        list_push(mutref diags, make_diag(name, 0, loaded_file.error_message));
        return;
    }
    let file = loaded_file.file;
    let tokens = lex(file.text);
    let imports = extract_uses(ref tokens);
    let next_loading_path = str_concat(loading_path, stack_key);
    let mut import_index = 0;
    while import_index < list_len(ref imports) {
        let entry = list_get(ref imports, import_index);
        match entry {
            Some(import_name) => {
                load_module_graph(import_name, workspace_root, entry_module, entry_path, next_loading_path, mutref seen_modules, mutref loaded_modules, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);
            },
            None => {
            },
        }
        import_index = import_index + 1;
    }
    if list_contains(ref seen_modules, name) {
        return;
    }
    list_push(mutref seen_modules, name);
    list_push(mutref loaded_modules, name);
    list_push(mutref sources, file);
    parse_file(file.name, ref tokens, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref diags);
    collect_typecheck_facts(file.name, ref tokens, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref diags);
    collect_value_type_facts(file.name, ref tokens, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref diags);
    collect_stmt_facts(file.name, ref tokens, mutref stmt_facts, mutref diags);
    return;
}

fn option_text(value: option<str>) -> str {
    match value {
        Some(text) => {
            return text;
        },
        None => {
            return "";
        },
    }
}

fn invalid_request(message: str) -> driver_request {
    return make_driver_request(driver_invalid, "", "", ".", "", "", message);
}

fn slice_text_without_trailing_cr(text: str, start: i32, end: i32) -> str {
    if end > start {
        let last_entry = str_get(text, end - 1);
        match last_entry {
            Some(value) => {
                if value == 13 {
                    return slice_text(text, start, end - 1);
                }
            },
            None => {
            },
        }
    }
    return slice_text(text, start, end);
}

fn usage_text() -> str {
    return "usage: nauqc check <source> [--diagnostics text|json] | nauqc emit-c <source> [-o <output>] | nauqc facts <source> [--format v1|v2|v3] | nauqc review <source> [--format v1|v2] | nauqc review-diff <before> <after> [--format v1|v2] | nauqc change-report <before> <after> [--policy <policy>] --format v1 | nauqc refactor-rename <source> <stable-id> <new-name> | nauqc policy-check <source> <policy-path> | nauqc fmt [--check] <source> | nauqc build <source> [-o <output>] | nauqc run <source> [-o <output>] | nauqc test | nauqc prove | nauqc prove-seed <stage1-c> <stage2-c> | nauqc prove-selfhost | nauqc prove-corpus";
}

fn build_emit_output_path(source_path: str, explicit_output: str) -> str {
    if explicit_output != "" {
        return explicit_output;
    }
    return replace_extension(source_path, ".c");
}

fn default_build_dir(source_path: str) -> str {
    return join_path(path_dir(source_path), "build");
}

fn default_build_c_path(source_path: str) -> str {
    return join_path(default_build_dir(source_path), str_concat(path_stem(source_path), ".c"));
}

fn default_build_exe_path(source_path: str) -> str {
    return join_path(default_build_dir(source_path), path_stem(source_path));
}

fn build_c_output_path(source_path: str, explicit_output: str) -> str {
    if explicit_output != "" and str_ends_with(explicit_output, ".c") {
        return explicit_output;
    }
    return default_build_c_path(source_path);
}

fn build_exe_output_path(source_path: str, explicit_output: str) -> str {
    if explicit_output != "" and not str_ends_with(explicit_output, ".c") {
        return explicit_output;
    }
    return default_build_exe_path(source_path);
}

fn path_relative_to_cwd(path: str, cwd: str) -> str {
    let prefix = str_concat(cwd, "/");
    if str_starts_with(path, prefix) {
        return slice_text(path, str_len(prefix), str_len(path));
    }
    return path;
}

fn parse_driver_request() -> driver_request {
    let argc = arg_count();
    if argc <= 1 {
        return make_driver_request(driver_legacy, "main.nq", "main", ".", "build/main.c", "", "");
    }

    let command = option_text(arg_get(1));
    if command == "check" {
        if argc != 3 and argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `check`");
        }
        let mut diagnostics_format = "text";
        if argc == 5 {
            if option_text(arg_get(3)) != "--diagnostics" {
                return invalid_request("expected `--diagnostics` after the source path");
            }
            diagnostics_format = option_text(arg_get(4));
            if diagnostics_format != "text" and diagnostics_format != "json" {
                return invalid_request("expected diagnostics format `text` or `json`");
            }
        }
        return make_driver_request(driver_check, source_path, entry_module, path_dir(source_path), "", diagnostics_format, "");
    }

    if command == "emit-c" {
        if argc != 3 and argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `emit-c`");
        }
        let mut explicit_output = "";
        if argc == 5 {
            let flag = option_text(arg_get(3));
            if flag != "-o" and flag != "--output" {
                return invalid_request("expected `-o` or `--output` after the source path");
            }
            explicit_output = option_text(arg_get(4));
            if explicit_output == "" {
                return invalid_request("missing output path for `emit-c`");
            }
        }
        return make_driver_request(driver_emit_c, source_path, entry_module, path_dir(source_path), build_emit_output_path(source_path, explicit_output), "", "");
    }

    if command == "facts" {
        if argc != 3 and argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `facts`");
        }
        if argc == 5 {
            let flag = option_text(arg_get(3));
            if flag != "--format" {
                return invalid_request("expected `--format` after the facts source path");
            }
            let format = option_text(arg_get(4));
            if format == "v1" {
                return make_driver_request(driver_facts, source_path, entry_module, path_dir(source_path), "", "", "");
            }
            if format == "v2" {
                return make_driver_request(driver_facts_v2, source_path, entry_module, path_dir(source_path), "", "", "");
            }
            if format == "v3" {
                return make_driver_request(driver_facts_v3, source_path, entry_module, path_dir(source_path), "", "", "");
            }
            return invalid_request("expected facts format `v1`, `v2`, or `v3`");
        }
        return make_driver_request(driver_facts, source_path, entry_module, path_dir(source_path), "", "", "");
    }

    if command == "review" {
        if argc != 3 and argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `review`");
        }
        if argc == 5 {
            let flag = option_text(arg_get(3));
            if flag != "--format" {
                return invalid_request("expected `--format` after the review source path");
            }
            let format = option_text(arg_get(4));
            if format == "v1" {
                return make_driver_request(driver_review, source_path, entry_module, path_dir(source_path), "", "", "");
            }
            if format == "v2" {
                return make_driver_request(driver_review_v2, source_path, entry_module, path_dir(source_path), "", "", "");
            }
            return invalid_request("expected review format `v1` or `v2`");
        }
        return make_driver_request(driver_review, source_path, entry_module, path_dir(source_path), "", "", "");
    }

    if command == "review-diff" {
        if argc != 4 and argc != 6 {
            return invalid_request(usage_text());
        }
        let before_path = option_text(arg_get(2));
        let after_path = option_text(arg_get(3));
        let before_module = path_stem(before_path);
        let after_module = path_stem(after_path);
        if before_path == "" or before_module == "" {
            return invalid_request("missing before source path for `review-diff`");
        }
        if after_path == "" or after_module == "" {
            return invalid_request("missing after source path for `review-diff`");
        }
        if argc == 6 {
            let flag = option_text(arg_get(4));
            if flag != "--format" {
                return invalid_request("expected `--format` after the review-diff paths");
            }
            let format = option_text(arg_get(5));
            if format == "v1" {
                return make_driver_request(driver_review_diff, before_path, before_module, path_dir(before_path), after_path, "", "");
            }
            if format == "v2" {
                return make_driver_request(driver_review_diff_v2, before_path, before_module, path_dir(before_path), after_path, "", "");
            }
            return invalid_request("expected review-diff format `v1` or `v2`");
        }
        return make_driver_request(driver_review_diff, before_path, before_module, path_dir(before_path), after_path, "", "");
    }

    if command == "change-report" {
        if argc != 6 and argc != 8 {
            return invalid_request(usage_text());
        }
        let before_path = option_text(arg_get(2));
        let after_path = option_text(arg_get(3));
        let before_module = path_stem(before_path);
        let mut policy_path = "";
        let mut format_flag_index = 4;
        if before_path == "" or before_module == "" {
            return invalid_request("missing before source path for `change-report`");
        }
        if after_path == "" or path_stem(after_path) == "" {
            return invalid_request("missing after source path for `change-report`");
        }
        if argc == 8 {
            let policy_flag = option_text(arg_get(4));
            if policy_flag != "--policy" {
                return invalid_request("expected `--policy` before the change-report policy path");
            }
            policy_path = option_text(arg_get(5));
            if policy_path == "" {
                return invalid_request("missing policy path for `change-report`");
            }
            format_flag_index = 6;
        }
        let flag = option_text(arg_get(format_flag_index));
        let format = option_text(arg_get(format_flag_index + 1));
        if flag != "--format" or format != "v1" {
            return invalid_request("expected change-report format `v1`");
        }
        return make_driver_request(driver_change_report, before_path, before_module, path_dir(before_path), after_path, policy_path, "");
    }

    if command == "refactor-rename" {
        if argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        let stable_id = option_text(arg_get(3));
        let new_name = option_text(arg_get(4));
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `refactor-rename`");
        }
        if stable_id == "" {
            return invalid_request("missing stable id for `refactor-rename`");
        }
        if new_name == "" {
            return invalid_request("missing new name for `refactor-rename`");
        }
        return make_driver_request(driver_refactor_rename, source_path, entry_module, path_dir(source_path), stable_id, new_name, "");
    }

    if command == "policy-check" {
        if argc != 4 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        let policy_path = option_text(arg_get(3));
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `policy-check`");
        }
        if policy_path == "" {
            return invalid_request("missing policy path for `policy-check`");
        }
        return make_driver_request(driver_policy_check, source_path, entry_module, path_dir(source_path), policy_path, "", "");
    }

    if command == "fmt" {
        if argc != 3 and argc != 4 {
            return invalid_request(usage_text());
        }
        let mut source_path = option_text(arg_get(2));
        let mut check_only = false;
        if argc == 4 {
            let first = option_text(arg_get(2));
            let second = option_text(arg_get(3));
            if first == "--check" {
                source_path = second;
                check_only = true;
            } else {
                if second == "--check" {
                    source_path = first;
                    check_only = true;
                } else {
                    return invalid_request("expected `--check` before or after the fmt source path");
                }
            }
        }
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request("missing source path for `fmt`");
        }
        if check_only {
            return make_driver_request(driver_fmt_check, source_path, entry_module, path_dir(source_path), "", "", "");
        }
        return make_driver_request(driver_fmt, source_path, entry_module, path_dir(source_path), "", "", "");
    }

    if command == "build" or command == "run" {
        if argc != 3 and argc != 5 {
            return invalid_request(usage_text());
        }
        let source_path = option_text(arg_get(2));
        let entry_module = path_stem(source_path);
        if source_path == "" or entry_module == "" {
            return invalid_request(str_concat("missing source path for `", str_concat(command, "`")));
        }
        let mut explicit_output = "";
        if argc == 5 {
            let flag = option_text(arg_get(3));
            if flag != "-o" and flag != "--output" {
                return invalid_request("expected `-o` or `--output` after the source path");
            }
            explicit_output = option_text(arg_get(4));
            if explicit_output == "" {
                return invalid_request(str_concat("missing output path for `", str_concat(command, "`")));
            }
        }
        if command == "build" {
            return make_driver_request(driver_build, source_path, entry_module, path_dir(source_path), explicit_output, "", "");
        }
        return make_driver_request(driver_run, source_path, entry_module, path_dir(source_path), explicit_output, "", "");
    }

    if command == "prove-selfhost" {
        if argc != 2 {
            return invalid_request(usage_text());
        }
        return make_driver_request(driver_prove_selfhost, option_text(arg_get(0)), "", ".", "", "", "");
    }

    if command == "prove-corpus" {
        if argc != 2 {
            return invalid_request(usage_text());
        }
        return make_driver_request(driver_prove_corpus, option_text(arg_get(0)), "", ".", "", "", "");
    }

    if command == "prove" {
        if argc != 2 {
            return invalid_request(usage_text());
        }
        return make_driver_request(driver_prove, option_text(arg_get(0)), "", ".", "", "", "");
    }

    if command == "prove-seed" {
        if argc != 4 {
            return invalid_request(usage_text());
        }
        return make_driver_request(driver_prove_seed, option_text(arg_get(2)), "", ".", option_text(arg_get(3)), "", "");
    }

    if command == "test" {
        if argc != 2 {
            return invalid_request(usage_text());
        }
        return make_driver_request(driver_test, option_text(arg_get(0)), "", ".", "", "", "");
    }

    if command == "" {
        return invalid_request(usage_text());
    }
    return invalid_request(str_concat("unknown stage1 driver command: ", command));
}

fn write_c_output(output_path: str, rendered_c: str, diags: mutref list<diag>) -> unit {
    let ensure_result = ensure_parent_dir(output_path);
    match ensure_result {
        Ok(_) => {
        },
        Err(err) => {
            list_push(mutref diags, make_diag(output_path, 0, io_err_text(err)));
            return;
        },
    }

    let write_result = write_rendered_c(output_path, rendered_c);
    match write_result {
        Ok(_) => {
        },
        Err(err) => {
            list_push(mutref diags, make_diag(output_path, 0, io_err_text(err)));
        },
    }
    return;
}

fn run_pipeline(workspace_root: str, entry_module: str, entry_path: str, output_path: str, write_output: bool, diagnostics_json: bool, success_message: str) -> i32 {
    let mut seen: list<str> = list();
    let mut loaded: list<str> = list();
    let mut sources: list<source_file> = list();
    let mut items: list<top_item> = list();
    let mut uses: list<module_use> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut function_facts: list<function_fact> = list();
    let mut function_param_facts: list<function_param_fact> = list();
    let mut variant_facts: list<variant_fact> = list();
    let mut variant_payload_facts: list<variant_payload_fact> = list();
    let mut const_facts: list<const_fact> = list();
    let mut call_facts: list<call_fact> = list();
    let mut pattern_facts: list<pattern_ctor_fact> = list();
    let mut typed_bindings: list<typed_binding_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut match_arms: list<match_arm_fact> = list();
    let mut local_inits: list<local_init_fact> = list();
    let mut return_facts: list<return_expr_fact> = list();
    let mut condition_facts: list<condition_fact> = list();
    let mut assignment_facts: list<assignment_fact> = list();
    let mut stmt_facts: list<stmt_fact> = list();
    let mut resolved_bindings: list<typed_binding_fact> = list();
    let mut pattern_bindings: list<pattern_binding_fact> = list();
    let mut checked_modules: list<checked_module> = list();
    let mut checked_functions: list<checked_function> = list();
    let mut checked_bindings: list<checked_binding> = list();
    let mut checked_params: list<checked_param> = list();
    let mut checked_consts: list<checked_const_decl> = list();
    let mut checked_type_shapes: list<checked_type_shape> = list();
    let mut checked_type_decls: list<checked_type_decl> = list();
    let mut checked_field_decls: list<checked_field_decl> = list();
    let mut checked_enum_decls: list<checked_enum_decl> = list();
    let mut checked_variant_decls: list<checked_variant_decl> = list();
    let mut checked_variant_payload_decls: list<checked_variant_payload_decl> = list();
    let mut checked_blocks: list<checked_block> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut checked_match_arms: list<checked_match_arm> = list();
    let mut checked_patterns: list<checked_pattern> = list();
    let mut checked_pattern_children: list<checked_pattern_child> = list();
    let mut checked_pattern_bindings: list<checked_pattern_binding> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();
    let mut ir_programs: list<ir_program> = list();
    let mut ir_function_sigs: list<ir_function_sig> = list();
    let mut ir_functions: list<ir_function> = list();
    let mut ir_locals: list<ir_local> = list();
    let mut ir_consts: list<ir_const_decl> = list();
    let mut ir_blocks: list<ir_block> = list();
    let mut ir_statements: list<ir_stmt> = list();
    let mut ir_match_arms: list<ir_match_arm> = list();
    let mut ir_patterns: list<ir_pattern> = list();
    let mut ir_pattern_children: list<ir_pattern_child> = list();
    let mut ir_expressions: list<ir_expr> = list();
    let mut ir_expr_children: list<ir_expr_child> = list();
    let mut ir_field_values: list<ir_field_value> = list();
    let mut ir_type_shapes: list<ir_type_shape> = list();
    let mut ir_struct_decls: list<ir_struct_decl> = list();
    let mut ir_field_decls: list<ir_field_decl> = list();
    let mut ir_enum_decls: list<ir_enum_decl> = list();
    let mut ir_variant_decls: list<ir_variant_decl> = list();
    let mut ir_variant_payload_decls: list<ir_variant_payload_decl> = list();
    let mut c_lines: list<str> = list();
    let mut diags: list<diag> = list();
    load_module_graph(entry_module, workspace_root, entry_module, entry_path, "", mutref seen, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);

    resolve_modules(ref loaded, ref uses, ref items, mutref diags);
    resolve_types(ref type_refs, ref uses, ref items, mutref diags);
    resolve_bodies(ref scopes, ref bindings, ref refs, ref uses, ref items, mutref diags);
    typecheck_modules_for_entry(ref function_facts, ref variant_facts, ref call_facts, ref pattern_facts, ref uses, ref items, entry_module, true, mutref diags);
    typecheck_const_facts(ref const_facts, ref sources, mutref diags);
    typecheck_value_facts_with_stmt_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref return_facts, ref condition_facts, ref assignment_facts, ref stmt_facts, ref uses, ref items, ref sources, mutref diags);
    collect_resolved_binding_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref uses, ref items, ref sources, mutref resolved_bindings, mutref pattern_bindings, mutref diags);

    let checked_summary = build_checked_handoff(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref resolved_bindings, ref field_facts, ref match_arms, ref pattern_bindings, ref stmt_facts, ref uses, ref items, ref sources, mutref checked_modules, mutref checked_functions, mutref checked_bindings, mutref checked_params, mutref checked_consts, mutref checked_type_shapes, mutref checked_type_decls, mutref checked_field_decls, mutref checked_enum_decls, mutref checked_variant_decls, mutref checked_variant_payload_decls, mutref checked_blocks, mutref checked_statements, mutref checked_match_arms, mutref checked_patterns, mutref checked_pattern_children, mutref checked_pattern_bindings, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref diags);
    let borrow_summary = check_checked_handoff_borrows(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements, ref checked_match_arms, ref checked_pattern_bindings, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, mutref diags);
    let ir_summary = build_ir_program_for_entry(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_consts, ref checked_type_shapes, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements, ref checked_match_arms, ref checked_patterns, ref checked_pattern_children, ref checked_pattern_bindings, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, entry_module, true, mutref ir_programs, mutref ir_function_sigs, mutref ir_functions, mutref ir_locals, mutref ir_consts, mutref ir_blocks, mutref ir_statements, mutref ir_match_arms, mutref ir_patterns, mutref ir_pattern_children, mutref ir_expressions, mutref ir_expr_children, mutref ir_field_values, mutref ir_type_shapes, mutref ir_struct_decls, mutref ir_field_decls, mutref ir_enum_decls, mutref ir_variant_decls, mutref ir_variant_payload_decls, mutref diags);
    let mut c_summary = make_c_emit_summary(0, 0, 0);
    if write_output {
        c_summary = emit_c_program(ref ir_programs, ref ir_function_sigs, ref ir_functions, ref ir_locals, ref ir_consts, ref ir_blocks, ref ir_statements, ref ir_match_arms, ref ir_patterns, ref ir_pattern_children, ref ir_expressions, ref ir_expr_children, ref ir_field_values, ref ir_type_shapes, ref ir_struct_decls, ref ir_field_decls, ref ir_enum_decls, ref ir_variant_decls, ref ir_variant_payload_decls, mutref c_lines, mutref diags);
    }

    if list_len(ref diags) == 0 and write_output {
        let rendered_c = render_c_lines(ref c_lines);
        write_c_output(output_path, rendered_c, mutref diags);
    }

    if list_len(ref diags) > 0 {
        if diagnostics_json {
            emit_diagnostics_json(ref diags);
        } else {
            emit_all(ref diags);
        }
        return 1;
    }

    if checked_summary.function_count < 1 {
        eprint_line("stage1 internal error: checked handoff has no functions");
        return 1;
    }
    if checked_summary.block_count < 1 {
        eprint_line("stage1 internal error: checked handoff has no blocks");
        return 1;
    }
    if borrow_summary.function_count < checked_summary.function_count {
        eprint_line("stage1 internal error: borrow pass skipped checked functions");
        return 1;
    }
    if ir_summary.function_count < checked_summary.function_count {
        eprint_line("stage1 internal error: IR lowering skipped checked functions");
        return 1;
    }
    if write_output {
        if c_summary.function_count < ir_summary.function_count {
            eprint_line("stage1 internal error: C emission skipped IR functions");
            return 1;
        }
        if c_summary.line_count < 1 {
            eprint_line("stage1 internal error: C emission produced no lines");
            return 1;
        }
    }

    if diagnostics_json {
        print_line("{");
        print_line("  \"version\": \"diagnostics/v1\",");
        print_line("  \"command\": \"check\",");
        print_line("  \"ok\": true,");
        print_line("  \"diagnostics\": []");
        print_line("}");
    }
    if success_message != "" {
        print_line(success_message);
    }
    return 0;
}

fn run_facts(workspace_root: str, entry_module: str, entry_path: str, format_version: i32) -> i32 {
    let mut seen: list<str> = list();
    let mut loaded: list<str> = list();
    let mut sources: list<source_file> = list();
    let mut items: list<top_item> = list();
    let mut uses: list<module_use> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut function_facts: list<function_fact> = list();
    let mut function_param_facts: list<function_param_fact> = list();
    let mut variant_facts: list<variant_fact> = list();
    let mut variant_payload_facts: list<variant_payload_fact> = list();
    let mut const_facts: list<const_fact> = list();
    let mut call_facts: list<call_fact> = list();
    let mut pattern_facts: list<pattern_ctor_fact> = list();
    let mut typed_bindings: list<typed_binding_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut match_arms: list<match_arm_fact> = list();
    let mut local_inits: list<local_init_fact> = list();
    let mut return_facts: list<return_expr_fact> = list();
    let mut condition_facts: list<condition_fact> = list();
    let mut assignment_facts: list<assignment_fact> = list();
    let mut stmt_facts: list<stmt_fact> = list();
    let mut resolved_bindings: list<typed_binding_fact> = list();
    let mut pattern_bindings: list<pattern_binding_fact> = list();
    let mut checked_modules: list<checked_module> = list();
    let mut checked_functions: list<checked_function> = list();
    let mut checked_bindings: list<checked_binding> = list();
    let mut checked_params: list<checked_param> = list();
    let mut checked_consts: list<checked_const_decl> = list();
    let mut checked_type_shapes: list<checked_type_shape> = list();
    let mut checked_type_decls: list<checked_type_decl> = list();
    let mut checked_field_decls: list<checked_field_decl> = list();
    let mut checked_enum_decls: list<checked_enum_decl> = list();
    let mut checked_variant_decls: list<checked_variant_decl> = list();
    let mut checked_variant_payload_decls: list<checked_variant_payload_decl> = list();
    let mut checked_blocks: list<checked_block> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut checked_match_arms: list<checked_match_arm> = list();
    let mut checked_patterns: list<checked_pattern> = list();
    let mut checked_pattern_children: list<checked_pattern_child> = list();
    let mut checked_pattern_bindings: list<checked_pattern_binding> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();
    let mut diags: list<diag> = list();

    load_module_graph(entry_module, workspace_root, entry_module, entry_path, "", mutref seen, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);

    resolve_modules(ref loaded, ref uses, ref items, mutref diags);
    resolve_types(ref type_refs, ref uses, ref items, mutref diags);
    resolve_bodies(ref scopes, ref bindings, ref refs, ref uses, ref items, mutref diags);
    typecheck_modules_for_entry(ref function_facts, ref variant_facts, ref call_facts, ref pattern_facts, ref uses, ref items, entry_module, false, mutref diags);
    typecheck_const_facts(ref const_facts, ref sources, mutref diags);
    typecheck_value_facts_with_stmt_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref return_facts, ref condition_facts, ref assignment_facts, ref stmt_facts, ref uses, ref items, ref sources, mutref diags);
    collect_resolved_binding_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref uses, ref items, ref sources, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
    let checked_summary = build_checked_handoff(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref resolved_bindings, ref field_facts, ref match_arms, ref pattern_bindings, ref stmt_facts, ref uses, ref items, ref sources, mutref checked_modules, mutref checked_functions, mutref checked_bindings, mutref checked_params, mutref checked_consts, mutref checked_type_shapes, mutref checked_type_decls, mutref checked_field_decls, mutref checked_enum_decls, mutref checked_variant_decls, mutref checked_variant_payload_decls, mutref checked_blocks, mutref checked_statements, mutref checked_match_arms, mutref checked_patterns, mutref checked_pattern_children, mutref checked_pattern_bindings, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref diags);
    let borrow_summary = check_checked_handoff_borrows(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements, ref checked_match_arms, ref checked_pattern_bindings, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, mutref diags);

    if list_len(ref diags) > 0 {
        emit_all(ref diags);
        return 1;
    }
    if checked_summary.function_count < 1 or borrow_summary.function_count < checked_summary.function_count {
        eprint_line("stage1 internal error: facts safety pass skipped checked functions");
        return 1;
    }

    let mut summary = make_facts_summary(0, 0, 0, 0);
    if format_version == 3 {
        summary = emit_workspace_facts(workspace_root, entry_module, ref loaded, ref items, ref uses, ref variant_facts, ref field_facts, ref bindings, ref call_facts);
    } else {
        summary = emit_facts_format(entry_module, ref loaded, ref items, ref uses, ref scopes, ref bindings, ref refs, ref type_refs, ref variant_facts, ref field_facts, ref call_facts, ref function_facts, ref local_inits, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, ref checked_statements, format_version);
    }
    if summary.module_count < 1 {
        eprint_line("stage1 internal error: facts output has no modules");
        return 1;
    }
    return 0;
}

fn collect_facts_ready_project(workspace_root: str, entry_module: str, entry_path: str, loaded: mutref list<str>, sources: mutref list<source_file>, items: mutref list<top_item>, uses: mutref list<module_use>, scopes: mutref list<body_scope>, bindings: mutref list<body_binding>, refs: mutref list<name_ref>, type_refs: mutref list<type_ref>, variant_facts: mutref list<variant_fact>, field_facts: mutref list<field_fact>, call_facts: mutref list<call_fact>, checked_expressions_out: mutref list<checked_expr>, checked_expr_children_out: mutref list<checked_expr_child>, checked_struct_fields_out: mutref list<checked_struct_field_init>, checked_statements_out: mutref list<checked_stmt>, diags: mutref list<diag>) -> bool {
    let mut seen: list<str> = list();
    let mut function_facts: list<function_fact> = list();
    let mut function_param_facts: list<function_param_fact> = list();
    let mut variant_payload_facts: list<variant_payload_fact> = list();
    let mut const_facts: list<const_fact> = list();
    let mut pattern_facts: list<pattern_ctor_fact> = list();
    let mut typed_bindings: list<typed_binding_fact> = list();
    let mut match_arms: list<match_arm_fact> = list();
    let mut local_inits: list<local_init_fact> = list();
    let mut return_facts: list<return_expr_fact> = list();
    let mut condition_facts: list<condition_fact> = list();
    let mut assignment_facts: list<assignment_fact> = list();
    let mut stmt_facts: list<stmt_fact> = list();
    let mut resolved_bindings: list<typed_binding_fact> = list();
    let mut pattern_bindings: list<pattern_binding_fact> = list();
    let mut checked_modules: list<checked_module> = list();
    let mut checked_functions: list<checked_function> = list();
    let mut checked_bindings: list<checked_binding> = list();
    let mut checked_params: list<checked_param> = list();
    let mut checked_consts: list<checked_const_decl> = list();
    let mut checked_type_shapes: list<checked_type_shape> = list();
    let mut checked_type_decls: list<checked_type_decl> = list();
    let mut checked_field_decls: list<checked_field_decl> = list();
    let mut checked_enum_decls: list<checked_enum_decl> = list();
    let mut checked_variant_decls: list<checked_variant_decl> = list();
    let mut checked_variant_payload_decls: list<checked_variant_payload_decl> = list();
    let mut checked_blocks: list<checked_block> = list();
    let mut checked_match_arms: list<checked_match_arm> = list();
    let mut checked_patterns: list<checked_pattern> = list();
    let mut checked_pattern_children: list<checked_pattern_child> = list();
    let mut checked_pattern_bindings: list<checked_pattern_binding> = list();

    load_module_graph(entry_module, workspace_root, entry_module, entry_path, "", mutref seen, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);

    resolve_modules(ref loaded, ref uses, ref items, mutref diags);
    resolve_types(ref type_refs, ref uses, ref items, mutref diags);
    resolve_bodies(ref scopes, ref bindings, ref refs, ref uses, ref items, mutref diags);
    typecheck_modules_for_entry(ref function_facts, ref variant_facts, ref call_facts, ref pattern_facts, ref uses, ref items, entry_module, false, mutref diags);
    typecheck_const_facts(ref const_facts, ref sources, mutref diags);
    typecheck_value_facts_with_stmt_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref return_facts, ref condition_facts, ref assignment_facts, ref stmt_facts, ref uses, ref items, ref sources, mutref diags);
    collect_resolved_binding_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref uses, ref items, ref sources, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
    let checked_summary = build_checked_handoff(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref resolved_bindings, ref field_facts, ref match_arms, ref pattern_bindings, ref stmt_facts, ref uses, ref items, ref sources, mutref checked_modules, mutref checked_functions, mutref checked_bindings, mutref checked_params, mutref checked_consts, mutref checked_type_shapes, mutref checked_type_decls, mutref checked_field_decls, mutref checked_enum_decls, mutref checked_variant_decls, mutref checked_variant_payload_decls, mutref checked_blocks, mutref checked_statements_out, mutref checked_match_arms, mutref checked_patterns, mutref checked_pattern_children, mutref checked_pattern_bindings, mutref checked_expressions_out, mutref checked_expr_children_out, mutref checked_struct_fields_out, mutref diags);
    let borrow_summary = check_checked_handoff_borrows(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements_out, ref checked_match_arms, ref checked_pattern_bindings, ref checked_expressions_out, ref checked_expr_children_out, ref checked_struct_fields_out, mutref diags);

    if list_len(ref diags) > 0 {
        return false;
    }
    if checked_summary.function_count < 1 or borrow_summary.function_count < checked_summary.function_count {
        list_push(mutref diags, make_diag(entry_module, 0, "stage1 internal error: tooling facts safety pass skipped checked functions"));
        return false;
    }
    return true;
}

fn run_refactor_rename(workspace_root: str, entry_module: str, entry_path: str, target_id: str, new_name: str) -> i32 {
    let mut loaded: list<str> = list();
    let mut sources: list<source_file> = list();
    let mut items: list<top_item> = list();
    let mut uses: list<module_use> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut variant_facts: list<variant_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut call_facts: list<call_fact> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut diags: list<diag> = list();
    if not collect_facts_ready_project(workspace_root, entry_module, entry_path, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref variant_facts, mutref field_facts, mutref call_facts, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref checked_statements, mutref diags) {
        emit_all(ref diags);
        return 1;
    }
    return emit_refactor_rename_plan(workspace_root, entry_module, entry_path, ref items, ref uses, ref scopes, ref bindings, ref refs, ref type_refs, ref variant_facts, ref field_facts, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, ref checked_statements, target_id, new_name);
}

fn run_policy_check(workspace_root: str, entry_module: str, entry_path: str, policy_path: str) -> i32 {
    let mut loaded: list<str> = list();
    let mut sources: list<source_file> = list();
    let mut items: list<top_item> = list();
    let mut uses: list<module_use> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut variant_facts: list<variant_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut call_facts: list<call_fact> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut diags: list<diag> = list();
    if not collect_facts_ready_project(workspace_root, entry_module, entry_path, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref variant_facts, mutref field_facts, mutref call_facts, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref checked_statements, mutref diags) {
        emit_all(ref diags);
        return 1;
    }
    return emit_policy_check(workspace_root, entry_module, ref items, ref uses, ref variant_facts, ref field_facts, ref bindings, policy_path);
}

fn collect_review_ready_project(workspace_root: str, entry_module: str, entry_path: str, sources: mutref list<source_file>, uses: mutref list<module_use>, items: mutref list<top_item>, function_facts: mutref list<function_fact>, variant_facts: mutref list<variant_fact>, function_param_facts: mutref list<function_param_fact>, assignment_facts: mutref list<assignment_fact>, call_facts: mutref list<call_fact>, local_inits: mutref list<local_init_fact>, diags: mutref list<diag>) -> bool {
    let mut seen: list<str> = list();
    let mut loaded: list<str> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut variant_payload_facts: list<variant_payload_fact> = list();
    let mut const_facts: list<const_fact> = list();
    let mut pattern_facts: list<pattern_ctor_fact> = list();
    let mut typed_bindings: list<typed_binding_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut match_arms: list<match_arm_fact> = list();
    let mut return_facts: list<return_expr_fact> = list();
    let mut condition_facts: list<condition_fact> = list();
    let mut stmt_facts: list<stmt_fact> = list();
    let mut resolved_bindings: list<typed_binding_fact> = list();
    let mut pattern_bindings: list<pattern_binding_fact> = list();
    let mut checked_modules: list<checked_module> = list();
    let mut checked_functions: list<checked_function> = list();
    let mut checked_bindings: list<checked_binding> = list();
    let mut checked_params: list<checked_param> = list();
    let mut checked_consts: list<checked_const_decl> = list();
    let mut checked_type_shapes: list<checked_type_shape> = list();
    let mut checked_type_decls: list<checked_type_decl> = list();
    let mut checked_field_decls: list<checked_field_decl> = list();
    let mut checked_enum_decls: list<checked_enum_decl> = list();
    let mut checked_variant_decls: list<checked_variant_decl> = list();
    let mut checked_variant_payload_decls: list<checked_variant_payload_decl> = list();
    let mut checked_blocks: list<checked_block> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut checked_match_arms: list<checked_match_arm> = list();
    let mut checked_patterns: list<checked_pattern> = list();
    let mut checked_pattern_children: list<checked_pattern_child> = list();
    let mut checked_pattern_bindings: list<checked_pattern_binding> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();

    load_module_graph(entry_module, workspace_root, entry_module, entry_path, "", mutref seen, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);

    resolve_modules(ref loaded, ref uses, ref items, mutref diags);
    resolve_types(ref type_refs, ref uses, ref items, mutref diags);
    resolve_bodies(ref scopes, ref bindings, ref refs, ref uses, ref items, mutref diags);
    typecheck_modules_for_entry(ref function_facts, ref variant_facts, ref call_facts, ref pattern_facts, ref uses, ref items, entry_module, false, mutref diags);
    typecheck_const_facts(ref const_facts, ref sources, mutref diags);
    typecheck_value_facts_with_stmt_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref return_facts, ref condition_facts, ref assignment_facts, ref stmt_facts, ref uses, ref items, ref sources, mutref diags);
    collect_resolved_binding_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref uses, ref items, ref sources, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
    let checked_summary = build_checked_handoff(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref resolved_bindings, ref field_facts, ref match_arms, ref pattern_bindings, ref stmt_facts, ref uses, ref items, ref sources, mutref checked_modules, mutref checked_functions, mutref checked_bindings, mutref checked_params, mutref checked_consts, mutref checked_type_shapes, mutref checked_type_decls, mutref checked_field_decls, mutref checked_enum_decls, mutref checked_variant_decls, mutref checked_variant_payload_decls, mutref checked_blocks, mutref checked_statements, mutref checked_match_arms, mutref checked_patterns, mutref checked_pattern_children, mutref checked_pattern_bindings, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref diags);
    let borrow_summary = check_checked_handoff_borrows(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements, ref checked_match_arms, ref checked_pattern_bindings, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, mutref diags);

    if list_len(ref diags) > 0 {
        return false;
    }
    if checked_summary.function_count < 1 or borrow_summary.function_count < checked_summary.function_count {
        list_push(mutref diags, make_diag(entry_module, 0, "stage1 internal error: review safety pass skipped checked functions"));
        return false;
    }
    return true;
}

fn run_review(workspace_root: str, entry_module: str, entry_path: str, use_v2: bool) -> i32 {
    let mut seen: list<str> = list();
    let mut loaded: list<str> = list();
    let mut sources: list<source_file> = list();
    let mut items: list<top_item> = list();
    let mut uses: list<module_use> = list();
    let mut scopes: list<body_scope> = list();
    let mut bindings: list<body_binding> = list();
    let mut refs: list<name_ref> = list();
    let mut type_refs: list<type_ref> = list();
    let mut function_facts: list<function_fact> = list();
    let mut function_param_facts: list<function_param_fact> = list();
    let mut variant_facts: list<variant_fact> = list();
    let mut variant_payload_facts: list<variant_payload_fact> = list();
    let mut const_facts: list<const_fact> = list();
    let mut call_facts: list<call_fact> = list();
    let mut pattern_facts: list<pattern_ctor_fact> = list();
    let mut typed_bindings: list<typed_binding_fact> = list();
    let mut field_facts: list<field_fact> = list();
    let mut match_arms: list<match_arm_fact> = list();
    let mut local_inits: list<local_init_fact> = list();
    let mut return_facts: list<return_expr_fact> = list();
    let mut condition_facts: list<condition_fact> = list();
    let mut assignment_facts: list<assignment_fact> = list();
    let mut stmt_facts: list<stmt_fact> = list();
    let mut resolved_bindings: list<typed_binding_fact> = list();
    let mut pattern_bindings: list<pattern_binding_fact> = list();
    let mut checked_modules: list<checked_module> = list();
    let mut checked_functions: list<checked_function> = list();
    let mut checked_bindings: list<checked_binding> = list();
    let mut checked_params: list<checked_param> = list();
    let mut checked_consts: list<checked_const_decl> = list();
    let mut checked_type_shapes: list<checked_type_shape> = list();
    let mut checked_type_decls: list<checked_type_decl> = list();
    let mut checked_field_decls: list<checked_field_decl> = list();
    let mut checked_enum_decls: list<checked_enum_decl> = list();
    let mut checked_variant_decls: list<checked_variant_decl> = list();
    let mut checked_variant_payload_decls: list<checked_variant_payload_decl> = list();
    let mut checked_blocks: list<checked_block> = list();
    let mut checked_statements: list<checked_stmt> = list();
    let mut checked_match_arms: list<checked_match_arm> = list();
    let mut checked_patterns: list<checked_pattern> = list();
    let mut checked_pattern_children: list<checked_pattern_child> = list();
    let mut checked_pattern_bindings: list<checked_pattern_binding> = list();
    let mut checked_expressions: list<checked_expr> = list();
    let mut checked_expr_children: list<checked_expr_child> = list();
    let mut checked_struct_fields: list<checked_struct_field_init> = list();
    let mut diags: list<diag> = list();
    load_module_graph(entry_module, workspace_root, entry_module, entry_path, "", mutref seen, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref function_facts, mutref function_param_facts, mutref variant_facts, mutref variant_payload_facts, mutref const_facts, mutref call_facts, mutref pattern_facts, mutref typed_bindings, mutref field_facts, mutref match_arms, mutref local_inits, mutref return_facts, mutref condition_facts, mutref assignment_facts, mutref stmt_facts, mutref diags);

    resolve_modules(ref loaded, ref uses, ref items, mutref diags);
    resolve_types(ref type_refs, ref uses, ref items, mutref diags);
    resolve_bodies(ref scopes, ref bindings, ref refs, ref uses, ref items, mutref diags);
    typecheck_modules_for_entry(ref function_facts, ref variant_facts, ref call_facts, ref pattern_facts, ref uses, ref items, entry_module, false, mutref diags);
    typecheck_const_facts(ref const_facts, ref sources, mutref diags);
    typecheck_value_facts_with_stmt_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref return_facts, ref condition_facts, ref assignment_facts, ref stmt_facts, ref uses, ref items, ref sources, mutref diags);
    collect_resolved_binding_facts(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref typed_bindings, ref field_facts, ref match_arms, ref local_inits, ref uses, ref items, ref sources, mutref resolved_bindings, mutref pattern_bindings, mutref diags);
    let checked_summary = build_checked_handoff(ref function_facts, ref function_param_facts, ref variant_facts, ref variant_payload_facts, ref const_facts, ref scopes, ref resolved_bindings, ref field_facts, ref match_arms, ref pattern_bindings, ref stmt_facts, ref uses, ref items, ref sources, mutref checked_modules, mutref checked_functions, mutref checked_bindings, mutref checked_params, mutref checked_consts, mutref checked_type_shapes, mutref checked_type_decls, mutref checked_field_decls, mutref checked_enum_decls, mutref checked_variant_decls, mutref checked_variant_payload_decls, mutref checked_blocks, mutref checked_statements, mutref checked_match_arms, mutref checked_patterns, mutref checked_pattern_children, mutref checked_pattern_bindings, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref diags);
    let borrow_summary = check_checked_handoff_borrows(ref checked_functions, ref checked_bindings, ref checked_params, ref checked_type_decls, ref checked_field_decls, ref checked_enum_decls, ref checked_variant_decls, ref checked_variant_payload_decls, ref checked_blocks, ref checked_statements, ref checked_match_arms, ref checked_pattern_bindings, ref checked_expressions, ref checked_expr_children, ref checked_struct_fields, mutref diags);

    if list_len(ref diags) > 0 {
        emit_all(ref diags);
        return 1;
    }
    if checked_summary.function_count < 1 or borrow_summary.function_count < checked_summary.function_count {
        eprint_line("stage1 internal error: review safety pass skipped checked functions");
        return 1;
    }

    let mut review_summary = make_review_summary(0, 0, 0, 1);
    if use_v2 {
        review_summary = emit_review_v2(entry_module, ref sources, ref uses, ref items, ref variant_facts, ref function_facts, ref function_param_facts, ref assignment_facts, ref call_facts, ref local_inits);
    } else {
        review_summary = emit_review(entry_module, ref sources, ref uses, ref function_facts, ref function_param_facts, ref assignment_facts, ref call_facts, ref local_inits);
    }
    if review_summary.error_count > 0 {
        return 1;
    }
    return 0;
}

fn run_review_diff(before_path: str, after_path: str, use_v2: bool) -> i32 {
    let before_entry = resolve_workspace_entry(before_path);
    let after_entry = resolve_workspace_entry(after_path);
    if not before_entry.valid {
        eprint_line(before_entry.error_message);
        return 1;
    }
    if not after_entry.valid {
        eprint_line(after_entry.error_message);
        return 1;
    }
    let before_module = before_entry.module_name;
    let before_workspace = before_entry.source_root;
    let after_module = after_entry.module_name;
    let after_workspace = after_entry.source_root;

    let mut before_sources: list<source_file> = list();
    let mut before_uses: list<module_use> = list();
    let mut before_items: list<top_item> = list();
    let mut before_functions: list<function_fact> = list();
    let mut before_variants: list<variant_fact> = list();
    let mut before_params: list<function_param_fact> = list();
    let mut before_assignments: list<assignment_fact> = list();
    let mut before_calls: list<call_fact> = list();
    let mut before_locals: list<local_init_fact> = list();
    let mut before_diags: list<diag> = list();
    let mut after_sources: list<source_file> = list();
    let mut after_uses: list<module_use> = list();
    let mut after_items: list<top_item> = list();
    let mut after_functions: list<function_fact> = list();
    let mut after_variants: list<variant_fact> = list();
    let mut after_params: list<function_param_fact> = list();
    let mut after_assignments: list<assignment_fact> = list();
    let mut after_calls: list<call_fact> = list();
    let mut after_locals: list<local_init_fact> = list();
    let mut after_diags: list<diag> = list();

    let before_ok = collect_review_ready_project(before_workspace, before_module, before_path, mutref before_sources, mutref before_uses, mutref before_items, mutref before_functions, mutref before_variants, mutref before_params, mutref before_assignments, mutref before_calls, mutref before_locals, mutref before_diags);
    let after_ok = collect_review_ready_project(after_workspace, after_module, after_path, mutref after_sources, mutref after_uses, mutref after_items, mutref after_functions, mutref after_variants, mutref after_params, mutref after_assignments, mutref after_calls, mutref after_locals, mutref after_diags);
    if not before_ok or not after_ok {
        emit_all(ref before_diags);
        emit_all(ref after_diags);
        return 1;
    }

    let summary = emit_review_diff_format(before_module, ref before_sources, ref before_uses, ref before_items, ref before_functions, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, after_module, ref after_sources, ref after_uses, ref after_items, ref after_functions, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, use_v2);
    if summary.error_count > 0 {
        return 1;
    }
    return 0;
}

fn run_change_report(before_path: str, after_path: str, policy_path: str) -> i32 {
    let before_entry = resolve_workspace_entry(before_path);
    let after_entry = resolve_workspace_entry(after_path);
    if not before_entry.valid {
        return emit_change_report_load_error(path_stem(before_path), path_stem(after_path), before_entry.error_message);
    }
    if not after_entry.valid {
        return emit_change_report_load_error(before_entry.module_name, path_stem(after_path), after_entry.error_message);
    }
    let before_module = before_entry.module_name;
    let before_workspace = before_entry.source_root;
    let after_module = after_entry.module_name;
    let after_workspace = after_entry.source_root;

    let mut before_sources: list<source_file> = list();
    let mut before_uses: list<module_use> = list();
    let mut before_items: list<top_item> = list();
    let mut before_functions: list<function_fact> = list();
    let mut before_variants: list<variant_fact> = list();
    let mut before_params: list<function_param_fact> = list();
    let mut before_assignments: list<assignment_fact> = list();
    let mut before_calls: list<call_fact> = list();
    let mut before_locals: list<local_init_fact> = list();
    let mut before_diags: list<diag> = list();
    let mut after_sources: list<source_file> = list();
    let mut after_uses: list<module_use> = list();
    let mut after_items: list<top_item> = list();
    let mut after_functions: list<function_fact> = list();
    let mut after_variants: list<variant_fact> = list();
    let mut after_params: list<function_param_fact> = list();
    let mut after_assignments: list<assignment_fact> = list();
    let mut after_calls: list<call_fact> = list();
    let mut after_locals: list<local_init_fact> = list();
    let mut after_diags: list<diag> = list();

    let before_ok = collect_review_ready_project(before_workspace, before_module, before_path, mutref before_sources, mutref before_uses, mutref before_items, mutref before_functions, mutref before_variants, mutref before_params, mutref before_assignments, mutref before_calls, mutref before_locals, mutref before_diags);
    let after_ok = collect_review_ready_project(after_workspace, after_module, after_path, mutref after_sources, mutref after_uses, mutref after_items, mutref after_functions, mutref after_variants, mutref after_params, mutref after_assignments, mutref after_calls, mutref after_locals, mutref after_diags);
    if not before_ok or not after_ok {
        return emit_change_report_load_error(before_module, after_module, "checked inputs could not be loaded");
    }

    let mut policy_summary = make_policy_validation_summary(false, 0, 0, false);
    if policy_path != "" {
        let mut loaded: list<str> = list();
        let mut sources: list<source_file> = list();
        let mut items: list<top_item> = list();
        let mut uses: list<module_use> = list();
        let mut scopes: list<body_scope> = list();
        let mut bindings: list<body_binding> = list();
        let mut refs: list<name_ref> = list();
        let mut type_refs: list<type_ref> = list();
        let mut variant_facts: list<variant_fact> = list();
        let mut field_facts: list<field_fact> = list();
        let mut call_facts: list<call_fact> = list();
        let mut checked_expressions: list<checked_expr> = list();
        let mut checked_expr_children: list<checked_expr_child> = list();
        let mut checked_struct_fields: list<checked_struct_field_init> = list();
        let mut checked_statements: list<checked_stmt> = list();
        let mut diags: list<diag> = list();
        if not collect_facts_ready_project(after_workspace, after_module, after_path, mutref loaded, mutref sources, mutref items, mutref uses, mutref scopes, mutref bindings, mutref refs, mutref type_refs, mutref variant_facts, mutref field_facts, mutref call_facts, mutref checked_expressions, mutref checked_expr_children, mutref checked_struct_fields, mutref checked_statements, mutref diags) {
            return emit_change_report_load_error(before_module, after_module, "policy target facts could not be loaded");
        }
        policy_summary = validate_policy_summary(after_workspace, ref items, ref uses, ref variant_facts, ref field_facts, ref bindings, policy_path);
    }

    let summary = emit_change_report(before_module, ref before_sources, ref before_uses, ref before_items, ref before_functions, ref before_variants, ref before_params, ref before_assignments, ref before_calls, ref before_locals, after_module, ref after_sources, ref after_uses, ref after_items, ref after_functions, ref after_variants, ref after_params, ref after_assignments, ref after_calls, ref after_locals, policy_summary.provided, policy_path, policy_summary.target_count, policy_summary.error_count, policy_summary.malformed);
    if summary.error_count > 0 {
        return 1;
    }
    return 0;
}

fn emit_text_output(text: str, to_stderr: bool) -> unit {
    let mut start = 0;
    let mut index = 0;
    while index < str_len(text) {
        let entry = str_get(text, index);
        match entry {
            Some(value) => {
                if value == 10 {
                    let line = slice_text_without_trailing_cr(text, start, index);
                    if to_stderr {
                        eprint_line(line);
                    } else {
                        print_line(line);
                    }
                    start = index + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    if start < str_len(text) {
        let tail = slice_text_without_trailing_cr(text, start, str_len(text));
        if to_stderr {
            eprint_line(tail);
        } else {
            print_line(tail);
        }
    }
    return;
}

fn emit_process_output(result: process_result) -> unit {
    if result.stdout != "" {
        emit_text_output(result.stdout, false);
    }
    if result.stderr != "" {
        emit_text_output(result.stderr, true);
    }
    return;
}

fn compile_emitted_c(c_path: str, exe_path: str) -> result<process_result, io_err> {
    let ensure_result = ensure_parent_dir(exe_path);
    match ensure_result {
        Ok(_) => {
        },
        Err(err) => {
            return Err(err);
        },
    }

    let mut cc_args: list<str> = list();
    list_push(mutref cc_args, "-std=c11");
    list_push(mutref cc_args, "-D_POSIX_C_SOURCE=200809L");
    list_push(mutref cc_args, "-Istdlib");
    list_push(mutref cc_args, c_path);
    list_push(mutref cc_args, "stdlib/runtime.c");
    list_push(mutref cc_args, "-o");
    list_push(mutref cc_args, exe_path);
    let system_cc = run_process("cc", ref cc_args, ".");
    match system_cc {
        Ok(status) => {
            return Ok(status);
        },
        Err(system_err) => {
            let mut zig_args: list<str> = list();
            list_push(mutref zig_args, "cc");
            list_push(mutref zig_args, "-std=c11");
            list_push(mutref zig_args, "-D_POSIX_C_SOURCE=200809L");
            list_push(mutref zig_args, "-Istdlib");
            list_push(mutref zig_args, c_path);
            list_push(mutref zig_args, "stdlib/runtime.c");
            list_push(mutref zig_args, "-o");
            list_push(mutref zig_args, exe_path);
            let linux_zig = run_process(".deps/ziglang/zig", ref zig_args, ".");
            match linux_zig {
                Ok(status) => {
                    return Ok(status);
                },
                Err(_) => {
                },
            }
            let windows_zig = run_process(".deps/ziglang/zig.exe", ref zig_args, ".");
            match windows_zig {
                Ok(status) => {
                    return Ok(status);
                },
                Err(_) => {
                },
            }
            return Err(system_err);
        },
    }
}

fn run_build_command(request: driver_request, execute_program: bool) -> i32 {
    let c_path = build_c_output_path(request.entry_path, request.output_path);
    let exe_path = build_exe_output_path(request.entry_path, request.output_path);
    let emit_code = run_pipeline(request.workspace_root, request.entry_module, request.entry_path, c_path, true, false, "");
    if emit_code != 0 {
        return emit_code;
    }

    let compile_result = compile_emitted_c(c_path, exe_path);
    match compile_result {
        Ok(compile_status) => {
            if compile_status.exit_code != 0 {
                emit_process_output(compile_status);
                return compile_status.exit_code;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return 1;
        },
    }

    if not execute_program {
        return 0;
    }

    let empty_args: list<str> = list();
    let run_cwd = path_dir(request.entry_path);
    let run_path = path_relative_to_cwd(exe_path, run_cwd);
    let run_result = run_process(run_path, ref empty_args, run_cwd);
    match run_result {
        Ok(run_status) => {
            emit_process_output(run_status);
            return run_status.exit_code;
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return 1;
        },
    }
}

fn main() -> i32 {
    let request = parse_driver_request();
    match request.mode {
        driver_legacy => {
            return run_pipeline(request.workspace_root, request.entry_module, request.entry_path, request.output_path, true, false, "stage1 front-end ok");
        },
        driver_check => {
            return run_pipeline(request.workspace_root, request.entry_module, request.entry_path, "", false, request.extra_text == "json", "");
        },
        driver_emit_c => {
            return run_pipeline(request.workspace_root, request.entry_module, request.entry_path, request.output_path, true, false, "");
        },
        driver_facts => {
            return run_facts(request.workspace_root, request.entry_module, request.entry_path, 1);
        },
        driver_facts_v2 => {
            return run_facts(request.workspace_root, request.entry_module, request.entry_path, 2);
        },
        driver_facts_v3 => {
            return run_facts(request.workspace_root, request.entry_module, request.entry_path, 3);
        },
        driver_review => {
            return run_review(request.workspace_root, request.entry_module, request.entry_path, false);
        },
        driver_review_v2 => {
            return run_review(request.workspace_root, request.entry_module, request.entry_path, true);
        },
        driver_review_diff => {
            return run_review_diff(request.entry_path, request.output_path, false);
        },
        driver_review_diff_v2 => {
            return run_review_diff(request.entry_path, request.output_path, true);
        },
        driver_change_report => {
            return run_change_report(request.entry_path, request.output_path, request.extra_text);
        },
        driver_refactor_rename => {
            return run_refactor_rename(request.workspace_root, request.entry_module, request.entry_path, request.output_path, request.extra_text);
        },
        driver_policy_check => {
            return run_policy_check(request.workspace_root, request.entry_module, request.entry_path, request.output_path);
        },
        driver_fmt => {
            return run_fmt(request.entry_path, false);
        },
        driver_fmt_check => {
            return run_fmt(request.entry_path, true);
        },
        driver_build => {
            return run_build_command(request, false);
        },
        driver_run => {
            return run_build_command(request, true);
        },
        driver_prove => {
            return run_all_proofs(request.entry_path);
        },
        driver_prove_seed => {
            return run_seed_structural_compare(request.entry_path, request.output_path);
        },
        driver_test => {
            return run_nauq_tests(request.entry_path);
        },
        driver_prove_selfhost => {
            return run_selfhost_proof(request.entry_path);
        },
        driver_prove_corpus => {
            return run_example_corpus(request.entry_path);
        },
        driver_invalid => {
            print_line(request.error_message);
            return 1;
        },
    }
}
