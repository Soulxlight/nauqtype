use source;
use text;

pub enum diag_severity {
    diag_error,
    diag_warning,
}

pub enum diag_category {
    diag_lex,
    diag_parse,
    diag_contract,
    diag_import,
    diag_resolve,
    diag_type,
    diag_propagate,
    diag_try,
    diag_borrow,
    diag_handoff,
    diag_ir,
    diag_c,
    diag_workspace,
    diag_io,
    diag_internal,
}

pub type diag {
    code: str,
    category: diag_category,
    severity: diag_severity,
    source_name: str,
    start: i32,
    end: i32,
    message: str,
    note: str,
    help: str,
}

type diag_position {
    offset: i32,
    line: i32,
    column: i32,
}

pub fn make_diagnostic(code: str, category: diag_category, severity: diag_severity, source_name: str, start: i32, end: i32, message: str, note: str, help: str) -> diag
audit {
    intent("Build a diagnostic with stable producer identity and an exclusive byte span");
    mutates();
    effects();
}
{
    return diag {
        code: code,
        category: category,
        severity: severity,
        source_name: source_name,
        start: start,
        end: end,
        message: message,
        note: note,
        help: help,
    };
}

pub fn make_error(code: str, category: diag_category, source_name: str, start: i32, end: i32, message: str) -> diag
audit {
    intent("Build a stable error diagnostic from producer-owned identity and location truth");
    mutates();
    effects();
}
{
    return make_diagnostic(code, category, diag_error, source_name, start, end, message, "", "");
}

pub fn make_warning(code: str, category: diag_category, source_name: str, start: i32, end: i32, message: str) -> diag
audit {
    intent("Build a stable warning diagnostic from producer-owned identity and location truth");
    mutates();
    effects();
}
{
    return make_diagnostic(code, category, diag_warning, source_name, start, end, message, "", "");
}

fn severity_text(severity: diag_severity) -> str {
    match severity {
        diag_error => { return "error"; },
        diag_warning => { return "warning"; },
    }
}

fn category_text(category: diag_category) -> str {
    match category {
        diag_lex => { return "LEX"; },
        diag_parse => { return "PARSE"; },
        diag_contract => { return "CONTRACT"; },
        diag_import => { return "IMPORT"; },
        diag_resolve => { return "RESOLVE"; },
        diag_type => { return "TYPE"; },
        diag_propagate => { return "PROPAGATE"; },
        diag_try => { return "TRY"; },
        diag_borrow => { return "BORROW"; },
        diag_handoff => { return "HANDOFF"; },
        diag_ir => { return "IR"; },
        diag_c => { return "C"; },
        diag_workspace => { return "WORKSPACE"; },
        diag_io => { return "IO"; },
        diag_internal => { return "INTERNAL"; },
    }
}

fn lookup_source(sources: ref list<source_file>, name: str) -> option<source_file> {
    let mut index = 0;
    while index < list_len(ref sources) {
        let entry = list_get(ref sources, index);
        match entry {
            Some(value) => {
                if value.name == name {
                    return Some(value);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return None;
}

fn source_position(text_value: str, requested: i32) -> diag_position {
    let mut offset = requested;
    if offset < 0 {
        offset = 0;
    }
    if offset > str_len(text_value) {
        offset = str_len(text_value);
    }
    let mut line = 1;
    let mut column = 1;
    let mut index = 0;
    while index < offset {
        let current = str_get(text_value, index);
        match current {
            Some(value) => {
                if value == 10 {
                    line = line + 1;
                    column = 1;
                } else {
                    column = column + 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return diag_position { offset: offset, line: line, column: column };
}

fn rendered_without_source(entry: diag) -> str {
    let identity = str_concat(str_concat(category_text(entry.category), "["), str_concat(entry.code, "]"));
    return str_concat(str_concat(str_concat(entry.source_name, ": "), identity), str_concat(": ", entry.message));
}

fn rendered_with_source(entry: diag, file: source_file) -> str {
    let origin = source_origin_at(file, entry.start, entry.end);
    if not origin.valid { return rendered_without_source(entry); }
    let position = source_position(file.original_text, origin.start);
    let location = str_concat(str_concat(str_concat(file.path, ":"), i32_to_str(position.line)), str_concat(":", i32_to_str(position.column)));
    let identity = str_concat(str_concat(category_text(entry.category), "["), str_concat(entry.code, "]"));
    let rendered = str_concat(str_concat(str_concat(location, ": "), identity), str_concat(": ", entry.message));
    if origin.context != "" { return concat4(rendered, " [generic instance ", origin.context, "]"); }
    return rendered;
}

fn diagnostic_note_with_origin(entry: diag, sources: ref list<source_file>) -> str {
    match lookup_source(ref sources, entry.source_name) {
        Some(file) => {
            let origin = source_origin_at(file, entry.start, entry.end);
            if origin.valid and origin.context != "" {
                let context = str_concat("generic instance: ", origin.context);
                if entry.note == "" { return context; }
                return concat3(entry.note, "\n", context);
            }
        },
        None => {},
    }
    return entry.note;
}

pub fn validate_diagnostic_origins(entries: mutref list<diag>, sources: ref list<source_file>) -> unit
audit {
    intent("Fail the build before output publication if any elaborated diagnostic lacks a truthful original range");
    mutates(entries);
    effects();
}
{
    let count = list_len(ref entries);
    let mut index = 0;
    while index < count {
        match list_get(ref entries, index) {
            Some(entry) => {
                if entry.start >= 0 {
                    match lookup_source(ref sources, entry.source_name) {
                        Some(file) => {
                            if file.has_generics or file.origin_map != "" or file.text != file.original_text {
                                let origin = source_origin_at(file, entry.start, entry.end);
                                if not origin.valid {
                                    list_push(mutref entries, make_error("NQ-GENERIC-009", diag_internal, file.name, -1, -1, "diagnostic range has no valid original source origin"));
                                }
                            }
                        },
                        None => {
                            if source_graph_has_generics(ref sources) {
                                list_push(mutref entries, make_error("NQ-GENERIC-009", diag_internal, entry.source_name, -1, -1, "located diagnostic has no source in the captured generic graph"));
                            }
                        },
                    }
                }
            },
            None => {},
        }
        index = index + 1;
    }
    return;
}

pub fn diagnostic_origin_cases() -> bool
audit {
    intent("Check that an unprojectable warning becomes a real build failure instead of silently losing its span");
    mutates();
    effects();
}
{
    let mut file = make_source_file("probe", "abcde");
    file.text = "x y";
    file.has_generics = true;
    file.origin_map = "0:1:4:5:A;2:3:0:1:B;3:3:5:5:;";
    let sources = [file];
    let mut entries = [make_warning("NQ-TEST-001", diag_contract, "probe", 0, 3, "test warning")];
    if diagnostics_have_errors(ref entries) { return false; }
    validate_diagnostic_origins(mutref entries, ref sources);
    if list_len(ref entries) != 2 or not diagnostics_have_errors(ref entries) { return false; }
    match list_get(ref entries, 1) { Some(value) => { if value.code != "NQ-GENERIC-009" { return false; } }, None => { return false; }, }
    let mut missing = [make_warning("NQ-TEST-001", diag_contract, "missing", 0, 1, "unknown located warning")];
    validate_diagnostic_origins(mutref missing, ref sources);
    if list_len(ref missing) != 2 or not diagnostics_have_errors(ref missing) { return false; }
    match list_get(ref missing, 1) { Some(value) => { if value.code != "NQ-GENERIC-009" { return false; } }, None => { return false; }, }
    let mut locationless = [make_warning("NQ-TEST-001", diag_contract, "missing", -1, -1, "intentional locationless warning")];
    validate_diagnostic_origins(mutref locationless, ref sources);
    return list_len(ref locationless) == 1 and not diagnostics_have_errors(ref locationless);
}

fn rendered_diag(entry: diag, sources: ref list<source_file>) -> str {
    if entry.start >= 0 {
        let found = lookup_source(ref sources, entry.source_name);
        match found {
            Some(file) => { return rendered_with_source(entry, file); },
            None => {
            },
        }
    }
    return rendered_without_source(entry);
}

pub fn emit_diag(entry: diag) -> unit
audit {
    intent("Print a deterministic compatibility diagnostic message to stderr");
    mutates();
    effects(print);
}
{
    eprint_line(rendered_without_source(entry));
    emit_diag_detail_lines(entry);
    return;
}

// M58.1: text output carries the same note and help text JSON carries, one
// `note: <text>` / `help: <text>` line each, after the message line.
pub fn diagnostic_detail_lines(entry: diag) -> list<str>
audit {
    intent("Render the note and help lines that follow a text diagnostic's message line");
    mutates();
    effects();
}
{
    let mut lines: list<str> = list();
    if entry.note != "" { list_push(mutref lines, str_concat("note: ", entry.note)); }
    if entry.help != "" { list_push(mutref lines, str_concat("help: ", entry.help)); }
    return lines;
}

fn emit_diag_detail_lines(entry: diag) -> unit {
    let lines = diagnostic_detail_lines(entry);
    for line in lines { eprint_line(line); }
    return;
}

pub fn emit_diag_with_sources(entry: diag, sources: ref list<source_file>) -> unit
audit {
    intent("Print a deterministic diagnostic with the physical source location when available");
    mutates();
    effects(print);
}
{
    eprint_line(rendered_diag(entry, ref sources));
    emit_diag_detail_lines(entry);
    return;
}

pub fn diagnostics_have_errors(entries: ref list<diag>) -> bool
audit {
    intent("Report whether a diagnostic collection contains a build-failing error");
    mutates();
    effects();
}
{
    let mut index = 0;
    while index < list_len(ref entries) {
        let entry = list_get(ref entries, index);
        match entry {
            Some(value) => {
                match value.severity {
                    diag_error => { return true; },
                    diag_warning => {
                    },
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return false;
}

fn emit_position_json(prefix: str, position: diag_position, suffix: str) -> unit {
    let line = str_concat(str_concat(prefix, "{ \"offset\": "), i32_to_str(position.offset));
    let with_line = str_concat(str_concat(line, ", \"line\": "), i32_to_str(position.line));
    let with_column = str_concat(str_concat(with_line, ", \"column\": "), i32_to_str(position.column));
    print_line(str_concat(str_concat(with_column, " }"), suffix));
    return;
}

fn emit_span_json(entry: diag, sources: ref list<source_file>) -> unit {
    if entry.start >= 0 and entry.end >= entry.start {
        let found = lookup_source(ref sources, entry.source_name);
        match found {
            Some(file) => {
                let origin = source_origin_at(file, entry.start, entry.end);
                if not origin.valid { print_line("      \"span\": null,"); return; }
                let start = source_position(file.original_text, origin.start);
                let end = source_position(file.original_text, origin.end);
                print_line("      \"span\": {");
                print_line(str_concat(str_concat("        \"path\": ", json_quote(file.path)), ","));
                emit_position_json("        \"start\": ", start, ",");
                emit_position_json("        \"end\": ", end, "");
                print_line("      },");
                return;
            },
            None => {
            },
        }
    }
    print_line("      \"span\": null,");
    return;
}

pub fn emit_diagnostics_json(entries: ref list<diag>, sources: ref list<source_file>) -> unit
audit {
    intent("Emit truthful stage1 diagnostics in the stable diagnostics JSON v1 envelope");
    mutates();
    effects(print);
}
{
    print_line("{");
    print_line("  \"version\": \"diagnostics/v1\",");
    print_line("  \"command\": \"check\",");
    if diagnostics_have_errors(ref entries) {
        print_line("  \"ok\": false,");
    } else {
        print_line("  \"ok\": true,");
    }
    print_line("  \"diagnostics\": [");
    let mut index = 0;
    while index < list_len(ref entries) {
        let entry = list_get(ref entries, index);
        match entry {
            Some(value) => {
                print_line("    {");
                print_line(str_concat(str_concat("      \"code\": ", json_quote(value.code)), ","));
                print_line(str_concat(str_concat("      \"category\": ", json_quote(category_text(value.category))), ","));
                print_line(str_concat(str_concat("      \"severity\": ", json_quote(severity_text(value.severity))), ","));
                print_line(str_concat(str_concat("      \"message\": ", json_quote(value.message)), ","));
                emit_span_json(value, ref sources);
                let note = diagnostic_note_with_origin(value, ref sources);
                if note == "" {
                    print_line("      \"notes\": [],");
                } else {
                    print_line(str_concat(str_concat("      \"notes\": [", json_quote(note)), "],"));
                }
                if value.help == "" {
                    print_line("      \"help\": null,");
                } else {
                    print_line(str_concat(str_concat("      \"help\": ", json_quote(value.help)), ","));
                }
                let mut suffix = "";
                if index + 1 < list_len(ref entries) {
                    suffix = ",";
                }
                print_line(str_concat("      \"rendered\": ", json_quote(rendered_diag(value, ref sources))));
                print_line(str_concat("    }", suffix));
            },
            None => {
            },
        }
        index = index + 1;
    }
    print_line("  ]");
    print_line("}");
    return;
}
