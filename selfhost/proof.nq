use files;
use text;

type norm_mapping {
    original: str,
    replacement: str,
}

type norm_token {
    text: str,
    next_index: i32,
}

type norm_line {
    text: str,
    next_index: i32,
    done: bool,
}

type corpus_case {
    name: str,
    source_path: str,
    expected_exit_code: i32,
    expected_stdout: str,
}

fn concat5(a: str, b: str, c: str, d: str, e: str) -> str {
    return str_concat(a, concat4(b, c, d, e));
}

fn lines_to_text(lines: ref list<str>) -> str {
    let mut out = "";
    let mut index = 0;
    while index < list_len(ref lines) {
        let entry = list_get(ref lines, index);
        match entry {
            Some(line) => {
                out = str_concat(out, line);
                out = str_concat(out, "\n");
            },
            None => {
            },
        }
        index = index + 1;
    }
    return out;
}

fn proof_summary_path() -> str {
    return "build/proof/summary.json";
}

fn proof_phase_enabled(command: str, id: str) -> bool {
    if starts_with_at(id, 0, "selfhost.") {
        return command == "prove" or command == "prove-selfhost";
    }
    if starts_with_at(id, 0, "corpus.") {
        return command == "prove" or command == "prove-corpus";
    }
    if starts_with_at(id, 0, "tooling.") {
        return command == "prove";
    }
    return false;
}

fn proof_phase_rank(id: str) -> i32 {
    if id == "selfhost.copy" {
        return 1;
    }
    if id == "selfhost.stage1_build" {
        return 2;
    }
    if id == "selfhost.stage2_run" {
        return 3;
    }
    if id == "selfhost.structural_c_compare" {
        return 4;
    }
    if id == "corpus.emit_c" {
        return 5;
    }
    if id == "corpus.build" {
        return 6;
    }
    if id == "corpus.run" {
        return 7;
    }
    if id == "corpus.structural_c_compare" {
        return 8;
    }
    if id == "tooling.golden" {
        return 9;
    }
    if id == "tooling.policy" {
        return 10;
    }
    if id == "tooling.refactor" {
        return 11;
    }
    if id == "tooling.formatter" {
        return 12;
    }
    return 0;
}

fn proof_phase_status(command: str, ok: bool, failed_phase: str, id: str) -> str {
    if not proof_phase_enabled(command, id) {
        return "skipped";
    }
    if ok {
        return "passed";
    }
    if id == failed_phase {
        return "failed";
    }
    let failed_rank = proof_phase_rank(failed_phase);
    let current_rank = proof_phase_rank(id);
    if failed_rank > 0 and current_rank > 0 and current_rank < failed_rank {
        return "passed";
    }
    return "skipped";
}

fn proof_group_status(command: str, ok: bool, failed_phase: str, group_name: str) -> str {
    if group_name == "selfhost" {
        if command != "prove" and command != "prove-selfhost" {
            return "skipped";
        }
    }
    if group_name == "corpus" {
        if command != "prove" and command != "prove-corpus" {
            return "skipped";
        }
    }
    if group_name == "tooling" {
        if command != "prove" {
            return "skipped";
        }
    }
    if ok {
        return "passed";
    }
    if starts_with_at(failed_phase, 0, str_concat(group_name, ".")) {
        return "failed";
    }
    if group_name == "selfhost" {
        return "passed";
    }
    if group_name == "corpus" and starts_with_at(failed_phase, 0, "tooling.") {
        return "passed";
    }
    return "skipped";
}

fn append_proof_phase(lines: mutref list<str>, command: str, ok: bool, failed_phase: str, id: str, trailing_comma: bool) -> unit {
    let mut suffix = "";
    if trailing_comma {
        suffix = ",";
    }
    list_push(mutref lines, concat5("    { \"id\": \"", id, "\", \"status\": \"", proof_phase_status(command, ok, failed_phase, id), str_concat("\" }", suffix)));
    return;
}

fn append_proof_phases(lines: mutref list<str>, command: str, ok: bool, failed_phase: str) -> unit {
    list_push(mutref lines, "  \"phases\": [");
    append_proof_phase(mutref lines, command, ok, failed_phase, "selfhost.copy", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "selfhost.stage1_build", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "selfhost.stage2_run", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "selfhost.structural_c_compare", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "corpus.emit_c", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "corpus.build", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "corpus.run", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "corpus.structural_c_compare", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "tooling.golden", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "tooling.policy", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "tooling.refactor", true);
    append_proof_phase(mutref lines, command, ok, failed_phase, "tooling.formatter", false);
    list_push(mutref lines, "  ],");
    return;
}

fn locked_corpus_case_count() -> i32 {
    let mut cases: list<corpus_case> = list();
    push_locked_example_corpus(mutref cases);
    return list_len(ref cases);
}

fn write_proof_summary(command: str, ok: bool, failed_phase: str) -> bool {
    let path = proof_summary_path();
    let dir_result = ensure_parent_dir(path);
    match dir_result {
        Ok(_) => {
        },
        Err(err) => {
            eprint_line(str_concat("failed to prepare proof summary: ", io_err_text(err)));
            return false;
        },
    }

    let selfhost_status = proof_group_status(command, ok, failed_phase, "selfhost");
    let corpus_status = proof_group_status(command, ok, failed_phase, "corpus");
    let tooling_status = proof_group_status(command, ok, failed_phase, "tooling");
    let mut corpus_cases = 0;
    if command == "prove" or command == "prove-corpus" {
        corpus_cases = locked_corpus_case_count();
    }

    let mut lines: list<str> = list();
    list_push(mutref lines, "{");
    list_push(mutref lines, "  \"version\": 1,");
    list_push(mutref lines, concat3("  \"command\": \"", command, "\","));
    list_push(mutref lines, concat3("  \"ok\": ", bool_text(ok), ","));
    list_push(mutref lines, concat3("  \"failed_phase\": \"", failed_phase, "\","));
    append_proof_phases(mutref lines, command, ok, failed_phase);
    list_push(mutref lines, "  \"selfhost\": {");
    list_push(mutref lines, concat3("    \"status\": \"", selfhost_status, "\","));
    list_push(mutref lines, concat3("    \"structural_c_equal\": ", bool_text(selfhost_status == "passed"), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"corpus\": {");
    list_push(mutref lines, concat3("    \"status\": \"", corpus_status, "\","));
    list_push(mutref lines, concat3("    \"cases\": ", i32_to_str(corpus_cases), ""));
    list_push(mutref lines, "  },");
    list_push(mutref lines, "  \"tooling\": {");
    list_push(mutref lines, concat3("    \"status\": \"", tooling_status, "\""));
    list_push(mutref lines, "  }");
    list_push(mutref lines, "}");
    let write_result = write_file(path, lines_to_text(ref lines));
    match write_result {
        Ok(_) => {
            return true;
        },
        Err(err) => {
            eprint_line(str_concat("failed to write proof summary: ", io_err_text(err)));
            return false;
        },
    }
}

fn make_norm_mapping(original: str, replacement: str) -> norm_mapping {
    return norm_mapping {
        original: original,
        replacement: replacement,
    };
}

fn make_corpus_case(name: str, source_path: str, expected_exit_code: i32, expected_stdout: str) -> corpus_case {
    return corpus_case {
        name: name,
        source_path: source_path,
        expected_exit_code: expected_exit_code,
        expected_stdout: expected_stdout,
    };
}

fn make_norm_token(text: str, next_index: i32) -> norm_token {
    return norm_token {
        text: text,
        next_index: next_index,
    };
}

fn make_norm_line(text: str, next_index: i32, done: bool) -> norm_line {
    return norm_line {
        text: text,
        next_index: next_index,
        done: done,
    };
}

fn no_norm_token() -> norm_token {
    return make_norm_token("", -1);
}

fn is_ws(ch: i32) -> bool {
    return ch == 32 or ch == 9 or ch == 10 or ch == 13;
}

fn is_digit(ch: i32) -> bool {
    return ch >= 48 and ch <= 57;
}

fn is_ident_char(ch: i32) -> bool {
    if ch >= 48 and ch <= 57 {
        return true;
    }
    if ch >= 65 and ch <= 90 {
        return true;
    }
    if ch >= 97 and ch <= 122 {
        return true;
    }
    return ch == 95;
}

fn trim_slice(text: str, start: i32, end: i32) -> str {
    let mut left = start;
    let mut right = end;
    while left < right and is_ws(char_at(text, left)) {
        left = left + 1;
    }
    while right > left and is_ws(char_at(text, right - 1)) {
        right = right - 1;
    }
    return slice_text(text, left, right);
}

fn mapping_lookup(mappings: ref list<norm_mapping>, original: str) -> option<str> {
    let mut index = 0;
    while index < list_len(ref mappings) {
        let entry = list_get(ref mappings, index);
        match entry {
            Some(value) => {
                if value.original == original {
                    return Some(value.replacement);
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return None;
}

fn mapping_get_or_add(mappings: mutref list<norm_mapping>, original: str) -> str {
    let found = mapping_lookup(ref mappings, original);
    match found {
        Some(value) => {
            return value;
        },
        None => {
            let replacement = i32_to_str(list_len(ref mappings) + 1);
            list_push(mutref mappings, make_norm_mapping(original, replacement));
            return replacement;
        },
    }
}

fn scan_digits(text: str, index: i32) -> i32 {
    let mut cursor = index;
    while cursor < str_len(text) and is_digit(char_at(text, cursor)) {
        cursor = cursor + 1;
    }
    return cursor;
}

fn scan_ident(text: str, index: i32) -> i32 {
    let mut cursor = index;
    while cursor < str_len(text) and is_ident_char(char_at(text, cursor)) {
        cursor = cursor + 1;
    }
    return cursor;
}

fn normalize_binding_at(line: str, index: i32, mappings: mutref list<norm_mapping>) -> norm_token {
    if not starts_with_at(line, index, "nqv_") {
        return no_norm_token();
    }
    let digit_start = index + 4;
    let digit_end = scan_digits(line, digit_start);
    if digit_end == digit_start {
        return no_norm_token();
    }
    if digit_end >= str_len(line) or char_at(line, digit_end) != 95 {
        return no_norm_token();
    }
    let name_start = digit_end + 1;
    let name_end = scan_ident(line, name_start);
    if name_end == name_start {
        return no_norm_token();
    }
    let original = slice_text(line, digit_start, digit_end);
    let replacement = mapping_get_or_add(mutref mappings, original);
    let name = slice_text(line, name_start, name_end);
    return make_norm_token(concat4("nqv_", replacement, "_", name), name_end);
}

fn normalize_tmp_at(line: str, index: i32, mappings: mutref list<norm_mapping>) -> norm_token {
    if not starts_with_at(line, index, "nq_tmp_") {
        return no_norm_token();
    }
    let digit_start = index + 7;
    let digit_end = scan_digits(line, digit_start);
    if digit_end == digit_start {
        return no_norm_token();
    }
    let original = slice_text(line, digit_start, digit_end);
    let replacement = mapping_get_or_add(mutref mappings, original);
    return make_norm_token(str_concat("nq_tmp_", replacement), digit_end);
}

fn normalize_line(line: str, binding_mappings: mutref list<norm_mapping>, tmp_mappings: mutref list<norm_mapping>) -> str {
    let mut out = "";
    let mut index = 0;
    while index < str_len(line) {
        let mut matched = false;
        let binding = normalize_binding_at(line, index, mutref binding_mappings);
        if binding.next_index >= 0 {
            out = str_concat(out, binding.text);
            index = binding.next_index;
            matched = true;
        }
        if not matched {
            let tmp = normalize_tmp_at(line, index, mutref tmp_mappings);
            if tmp.next_index >= 0 {
                out = str_concat(out, tmp.text);
                index = tmp.next_index;
                matched = true;
            }
        }
        if not matched {
            out = str_concat(out, slice_text(line, index, index + 1));
            index = index + 1;
        }
    }
    return out;
}

fn normalize_structural_c(text: str) -> str {
    let mut binding_mappings: list<norm_mapping> = list();
    let mut tmp_mappings: list<norm_mapping> = list();
    let mut out = "";
    let mut start = 0;
    let mut index = 0;
    while index < str_len(text) {
        if char_at(text, index) == 10 {
            let line = trim_slice(text, start, index);
            if line != "" {
                let normalized = normalize_line(line, mutref binding_mappings, mutref tmp_mappings);
                if out == "" {
                    out = normalized;
                } else {
                    out = concat3(out, "\n", normalized);
                }
            }
            start = index + 1;
        }
        index = index + 1;
    }
    if start < str_len(text) {
        let line = trim_slice(text, start, str_len(text));
        if line != "" {
            let normalized = normalize_line(line, mutref binding_mappings, mutref tmp_mappings);
            if out == "" {
                out = normalized;
            } else {
                out = concat3(out, "\n", normalized);
            }
        }
    }
    return out;
}

fn next_normalized_line(text: str, start: i32, binding_mappings: mutref list<norm_mapping>, tmp_mappings: mutref list<norm_mapping>) -> norm_line {
    let mut cursor = start;
    while cursor < str_len(text) {
        let mut line_end = cursor;
        while line_end < str_len(text) and char_at(text, line_end) != 10 {
            line_end = line_end + 1;
        }
        let mut next_index = line_end;
        if next_index < str_len(text) {
            next_index = next_index + 1;
        }
        let line = trim_slice(text, cursor, line_end);
        if line != "" {
            return make_norm_line(normalize_line(line, mutref binding_mappings, mutref tmp_mappings), next_index, false);
        }
        cursor = next_index;
    }
    return make_norm_line("", cursor, true);
}

fn structural_c_equal(left: str, right: str) -> bool {
    let mut left_binding_mappings: list<norm_mapping> = list();
    let mut left_tmp_mappings: list<norm_mapping> = list();
    let mut right_binding_mappings: list<norm_mapping> = list();
    let mut right_tmp_mappings: list<norm_mapping> = list();
    let mut left_index = 0;
    let mut right_index = 0;
    while true {
        let left_line = next_normalized_line(left, left_index, mutref left_binding_mappings, mutref left_tmp_mappings);
        let right_line = next_normalized_line(right, right_index, mutref right_binding_mappings, mutref right_tmp_mappings);
        if left_line.done and right_line.done {
            return true;
        }
        if left_line.done or right_line.done {
            return false;
        }
        if left_line.text != right_line.text {
            return false;
        }
        left_index = left_line.next_index;
        right_index = right_line.next_index;
    }
    return false;
}

fn normalize_newlines(text: str) -> str {
    let mut out = "";
    let mut index = 0;
    while index < str_len(text) {
        let ch = char_at(text, index);
        if ch != 13 {
            out = str_concat(out, slice_text(text, index, index + 1));
        }
        index = index + 1;
    }
    return out;
}

fn output_matches(actual: str, expected: str) -> bool {
    return normalize_newlines(actual) == normalize_newlines(expected);
}

fn copy_file_text(source_path: str, dest_path: str) -> result<unit, io_err> {
    let ensure_result = ensure_parent_dir(dest_path);
    match ensure_result {
        Ok(_) => {
        },
        Err(err) => {
            return Err(err);
        },
    }
    let data = read_file(source_path);
    match data {
        Ok(text) => {
            return write_file(dest_path, text);
        },
        Err(err) => {
            return Err(err);
        },
    }
}

fn copy_selfhost_module(proof_dir: str, module_name: str) -> result<unit, io_err> {
    let file_name = str_concat(module_name, ".nq");
    return copy_file_text(join_path("selfhost", file_name), join_path(proof_dir, file_name));
}

fn push_selfhost_modules(modules: mutref list<str>) -> unit {
    list_push(mutref modules, "ast");
    list_push(mutref modules, "borrow");
    list_push(mutref modules, "c_emit");
    list_push(mutref modules, "diag");
    list_push(mutref modules, "facts");
    list_push(mutref modules, "files");
    list_push(mutref modules, "fmt");
    list_push(mutref modules, "handoff");
    list_push(mutref modules, "ir");
    list_push(mutref modules, "lexer");
    list_push(mutref modules, "main");
    list_push(mutref modules, "parser");
    list_push(mutref modules, "proof");
    list_push(mutref modules, "resolve");
    list_push(mutref modules, "review");
    list_push(mutref modules, "source");
    list_push(mutref modules, "text");
    list_push(mutref modules, "token");
    list_push(mutref modules, "typecheck");
    return;
}

fn copy_selfhost_workspace(proof_dir: str) -> result<unit, io_err> {
    let dir_result = create_dir_all(proof_dir);
    match dir_result {
        Ok(_) => {
        },
        Err(err) => {
            return Err(err);
        },
    }
    let mut modules: list<str> = list();
    push_selfhost_modules(mutref modules);
    let mut index = 0;
    while index < list_len(ref modules) {
        let entry = list_get(ref modules, index);
        match entry {
            Some(name) => {
                let copied = copy_selfhost_module(proof_dir, name);
                match copied {
                    Ok(_) => {
                    },
                    Err(err) => {
                        return Err(err);
                    },
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return create_dir_all(proof_dir);
}

fn emit_process_output(result: process_result) -> unit {
    if result.stdout != "" {
        print_line(result.stdout);
    }
    if result.stderr != "" {
        eprint_line(result.stderr);
    }
    return;
}

fn stage1_ok_output(text: str) -> bool {
    if text == "stage1 front-end ok\n" {
        return true;
    }
    let expected = "stage1 front-end ok";
    if str_len(text) == str_len(expected) + 2 {
        if slice_text(text, 0, str_len(expected)) == expected and char_at(text, str_len(expected)) == 13 and char_at(text, str_len(expected) + 1) == 10 {
            return true;
        }
    }
    return false;
}

