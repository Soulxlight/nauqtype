fn run_json_golden_result(label: str, result: result<process_result, io_err>, golden_path: str) -> bool {
    match result {
        Ok(status) => {
            return driver_json_matches_golden(label, status, golden_path);
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return false;
        },
    }
}

fn run_json_contains_result(label: str, result: result<process_result, io_err>, first: str, second: str, third: str) -> bool {
    match result {
        Ok(status) => {
            return driver_json_contains3(label, status, first, second, third);
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return false;
        },
    }
}

fn run_quiet_result(label: str, result: result<process_result, io_err>) -> bool {
    match result {
        Ok(status) => {
            return driver_step_ok(label, status);
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return false;
        },
    }
}

fn run_formatter_tooling_checks(driver_path: str, failed_phase: mutref str) -> bool {
    let mut paths: list<str> = list();
    push_locked_formatter_examples(mutref paths);
    let mut index = 0;
    while index < list_len(ref paths) {
        let entry = list_get(ref paths, index);
        match entry {
            Some(value) => {
                if not run_quiet_result(str_concat("fmt --check ", value), run_driver_fmt_check(driver_path, value)) {
                    failed_phase = "tooling.formatter";
                    return false;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return true;
}

fn run_supervised_workflow_gate(driver_path: str, failed_phase: mutref str) -> bool {
    let before_path = "tests/fixtures/supervised_workflow/before/main.nq";
    let after_path = "tests/fixtures/supervised_workflow/after/main.nq";
    let policy_path = "tests/fixtures/supervised_workflow/policy.json";
    let refactor_target = "binding:fn:main::apply:1:bonus@25";

    if not run_quiet_result("supervised workflow check", run_driver_check(driver_path, after_path)) {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("supervised facts v2", run_driver_facts(driver_path, after_path, "v2"), "tests/golden/supervised_workflow/facts_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("supervised review v2", run_driver_review(driver_path, after_path, "v2"), "tests/golden/supervised_workflow/review_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("supervised review-diff v2", run_driver_review_diff(driver_path, before_path, after_path, "v2"), "tests/golden/supervised_workflow/review_diff_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("supervised change-report policy v1", run_driver_change_report(driver_path, before_path, after_path, policy_path), "tests/golden/supervised_workflow/change_report_policy_v1.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("supervised policy-check v1", run_driver_policy_check(driver_path, after_path, policy_path), "tests/golden/supervised_workflow/policy_check_v1.json") {
        failed_phase = "tooling.policy";
        return false;
    }

    let mut before_refactor_text = "";
    if not read_text_or_report(after_path, "failed to read supervised workflow refactor fixture", mutref before_refactor_text) {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_golden_result("supervised refactor-rename v1", run_driver_refactor_rename(driver_path, after_path, refactor_target, "extra"), "tests/golden/supervised_workflow/refactor_rename_v1.json") {
        failed_phase = "tooling.refactor";
        return false;
    }
    let mut after_refactor_text = "";
    if not read_text_or_report(after_path, "failed to reread supervised workflow refactor fixture", mutref after_refactor_text) {
        failed_phase = "tooling.refactor";
        return false;
    }
    if before_refactor_text != after_refactor_text {
        eprint_line("supervised workflow refactor-rename mutated the fixture");
        failed_phase = "tooling.refactor";
        return false;
    }
    return true;
}

fn evidence_parity_run_ok(driver_path: str, after_path: str) -> bool {
    let run_result = run_driver_run(driver_path, after_path);
    match run_result {
        Ok(status) => {
            if status.exit_code != 13 {
                eprint_line("evidence parity run returned unexpected exit code");
                emit_process_output(status);
                return false;
            }
            if status.stdout != "" or status.stderr != "" {
                eprint_line("evidence parity run produced unexpected output");
                emit_process_output(status);
                return false;
            }
            return true;
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            return false;
        },
    }
}

fn run_evidence_parity_gate(driver_path: str, failed_phase: mutref str) -> bool {
    let before_path = "tests/fixtures/evidence_parity/before/main.nq";
    let after_path = "tests/fixtures/evidence_parity/after/main.nq";
    let policy_path = "tests/fixtures/evidence_parity/policy.json";

    if not run_quiet_result("evidence parity check", run_driver_check(driver_path, after_path)) {
        failed_phase = "tooling.golden";
        return false;
    }
    if not evidence_parity_run_ok(driver_path, after_path) {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("evidence parity facts v2", run_driver_facts(driver_path, after_path, "v2"), "tests/golden/evidence_parity/facts_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("evidence parity review v2", run_driver_review(driver_path, after_path, "v2"), "tests/golden/evidence_parity/review_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("evidence parity review-diff v2", run_driver_review_diff(driver_path, before_path, after_path, "v2"), "tests/golden/evidence_parity/review_diff_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("evidence parity change-report policy v1", run_driver_change_report(driver_path, before_path, after_path, policy_path), "tests/golden/evidence_parity/change_report_policy_v1.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("evidence parity policy-check v1", run_driver_policy_check(driver_path, after_path, policy_path), "tests/golden/evidence_parity/policy_check_v1.json") {
        failed_phase = "tooling.policy";
        return false;
    }

    let mut before_refactor_text = "";
    if not read_text_or_report(after_path, "failed to read evidence parity refactor fixture", mutref before_refactor_text) {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_golden_result("evidence parity refactor field v1", run_driver_refactor_rename(driver_path, after_path, "field:helper::Box::value", "amount"), "tests/golden/evidence_parity/refactor_rename_field_v1.json") {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_golden_result("evidence parity refactor variant v1", run_driver_refactor_rename(driver_path, after_path, "variant:helper::Choice::Use", "Keep"), "tests/golden/evidence_parity/refactor_rename_variant_v1.json") {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_golden_result("evidence parity refactor const v1", run_driver_refactor_rename(driver_path, after_path, "const:helper::base_score", "starting_score"), "tests/golden/evidence_parity/refactor_rename_const_v1.json") {
        failed_phase = "tooling.refactor";
        return false;
    }
    let mut after_refactor_text = "";
    if not read_text_or_report(after_path, "failed to reread evidence parity refactor fixture", mutref after_refactor_text) {
        failed_phase = "tooling.refactor";
        return false;
    }
    if before_refactor_text != after_refactor_text {
        eprint_line("evidence parity refactor-rename mutated the fixture");
        failed_phase = "tooling.refactor";
        return false;
    }
    return true;
}

fn run_tooling_confidence_gate(driver_path: str, failed_phase: mutref str) -> bool {
    if not run_json_golden_result("facts v1", run_driver_facts(driver_path, "tests/fixtures/facts/main.nq", ""), "tests/golden/facts/main.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("facts v2", run_driver_facts(driver_path, "tests/fixtures/facts/main.nq", "v2"), "tests/golden/facts/main-v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("facts named args v2", run_driver_facts(driver_path, "tests/fixtures/facts/named_args_main.nq", "v2"), "tests/golden/facts/named-args-v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("review v2", run_driver_review(driver_path, "tests/fixtures/review_v2.nq", "v2"), "tests/golden/review/review_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("review-diff v1", run_driver_review_diff(driver_path, "tests/fixtures/review_diff/before/main.nq", "tests/fixtures/review_diff/after/main.nq", ""), "tests/golden/review/review_diff_v1.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("review-diff v2", run_driver_review_diff(driver_path, "tests/fixtures/review_diff/before/main.nq", "tests/fixtures/review_diff/after/main.nq", "v2"), "tests/golden/review/review_diff_v2.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("change-report v1", run_driver_change_report(driver_path, "tests/fixtures/review_diff/before/main.nq", "tests/fixtures/review_diff/after/main.nq", ""), "tests/golden/review/change_report_v1.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_golden_result("change-report policy v1", run_driver_change_report(driver_path, "tests/fixtures/review_diff/before/main.nq", "tests/fixtures/review_diff/after/main.nq", "tests/fixtures/policy/change_report_policy.json"), "tests/golden/review/change_report_policy_v1.json") {
        failed_phase = "tooling.golden";
        return false;
    }
    if not run_json_contains_result("refactor-rename field", run_driver_refactor_rename(driver_path, "tests/fixtures/facts/main.nq", "field:helper::Box::value", "renamed_value"), "\"ok\": true", "\"target_id\": \"field:helper::Box::value\"", "\"replacement\": \"renamed_value\"") {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_contains_result("refactor-rename named arg", run_driver_refactor_rename(driver_path, "tests/fixtures/facts/named_args_main.nq", "binding:fn:named_args_helper::combine:1:scale@38", "multiplier"), "\"ok\": true", "\"span\": {", "\"replacement\": \"multiplier\"") {
        failed_phase = "tooling.refactor";
        return false;
    }
    if not run_json_contains_result("policy-check fixture", run_driver_policy_check(driver_path, "tests/fixtures/facts/main.nq", "tests/fixtures/policy/facts_policy.json"), "\"ok\": true", "\"errors\": 0", "\"known\": true") {
        failed_phase = "tooling.policy";
        return false;
    }
    if not run_json_contains_result("policy-check selfhost", run_driver_policy_check(driver_path, "selfhost/main.nq", "nauqtype.policy.json"), "\"ok\": true", "\"errors\": 0", "\"target_id\": \"fn:c_emit::emit_c_program\"") {
        failed_phase = "tooling.policy";
        return false;
    }
    if not run_supervised_workflow_gate(driver_path, mutref failed_phase) {
        return false;
    }
    if not run_evidence_parity_gate(driver_path, mutref failed_phase) {
        return false;
    }
    if not run_formatter_tooling_checks(driver_path, mutref failed_phase) {
        return false;
    }
    return true;
}

fn run_corpus_case(driver_path: str, entry: corpus_case, failed_phase: mutref str) -> bool {
    let emit_path = corpus_emit_c_path(entry.name);
    let emit_result = run_driver_emit_c(driver_path, entry.source_path, emit_path);
    match emit_result {
        Ok(status) => {
            if not driver_step_ok(str_concat("emit-c ", entry.name), status) {
                failed_phase = "corpus.emit_c";
                return false;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "corpus.emit_c";
            return false;
        },
    }

    let mut emit_c = "";
    if not read_text_or_report(emit_path, str_concat("failed to read emitted C for ", entry.name), mutref emit_c) {
        failed_phase = "corpus.emit_c";
        return false;
    }

    let build_result = run_driver_build(driver_path, entry.source_path);
    match build_result {
        Ok(status) => {
            if not driver_step_ok(str_concat("build ", entry.name), status) {
                failed_phase = "corpus.build";
                return false;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "corpus.build";
            return false;
        },
    }

    let build_c_path = default_build_c_path(entry.source_path);
    let mut build_c = "";
    if not read_text_or_report(build_c_path, str_concat("failed to read build C for ", entry.name), mutref build_c) {
        failed_phase = "corpus.build";
        return false;
    }
    if not structural_c_equal(emit_c, build_c) {
        eprint_line(str_concat("corpus proof failed: emit/build C changed for ", entry.name));
        failed_phase = "corpus.structural_c_compare";
        return false;
    }

    let run_result = run_driver_run(driver_path, entry.source_path);
    match run_result {
        Ok(status) => {
            if status.exit_code != entry.expected_exit_code {
                eprint_line(str_concat("corpus proof failed: unexpected exit code for ", entry.name));
                emit_process_output(status);
                failed_phase = "corpus.run";
                return false;
            }
            if not output_matches(status.stdout, entry.expected_stdout) or status.stderr != "" {
                eprint_line(str_concat("corpus proof failed: unexpected stdout/stderr for ", entry.name));
                emit_process_output(status);
                failed_phase = "corpus.run";
                return false;
            }
            if has_stage1_failure_text(status) {
                eprint_line(str_concat("corpus proof failed: stage1 diagnostic text for ", entry.name));
                emit_process_output(status);
                failed_phase = "corpus.run";
                return false;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "corpus.run";
            return false;
        },
    }

    let mut run_c = "";
    if not read_text_or_report(build_c_path, str_concat("failed to read run C for ", entry.name), mutref run_c) {
        failed_phase = "corpus.structural_c_compare";
        return false;
    }
    if not structural_c_equal(emit_c, run_c) {
        eprint_line(str_concat("corpus proof failed: emit/run C changed for ", entry.name));
        failed_phase = "corpus.structural_c_compare";
        return false;
    }

    return true;
}

fn run_example_corpus_inner(driver_path: str, failed_phase: mutref str) -> i32 {
    let mut cases: list<corpus_case> = list();
    push_locked_example_corpus(mutref cases);
    let mut index = 0;
    while index < list_len(ref cases) {
        let entry = list_get(ref cases, index);
        match entry {
            Some(value) => {
                if not run_corpus_case(driver_path, value, mutref failed_phase) {
                    return 1;
                }
            },
            None => {
            },
        }
        index = index + 1;
    }
    return 0;
}

pub fn run_example_corpus(driver_path: str) -> i32
audit {
    intent("Run the stage1-owned locked example corpus gate");
    mutates();
    effects(print, io);
}
{
    let mut failed_phase = "";
    let result = run_example_corpus_inner(driver_path, mutref failed_phase);
    if not write_proof_summary("prove-corpus", result == 0, failed_phase) {
        return 1;
    }
    if result == 0 {
        print_line("example corpus ok");
    }
    return result;
}

fn run_selfhost_proof_inner(driver_path: str, failed_phase: mutref str) -> i32 {
    let proof_dir = "build/proof/selfhost";
    let copied = copy_selfhost_workspace(proof_dir);
    match copied {
        Ok(_) => {
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "selfhost.copy";
            return 1;
        },
    }

    let entry_path = join_path(proof_dir, "main.nq");
    let stage1_result = run_driver_build(driver_path, entry_path);
    match stage1_result {
        Ok(status) => {
            if status.exit_code != 0 {
                emit_process_output(status);
                failed_phase = "selfhost.stage1_build";
                return status.exit_code;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "selfhost.stage1_build";
            return 1;
        },
    }

    let c_path = join_path(join_path(proof_dir, "build"), "main.c");
    let stage1_c_result = read_file(c_path);
    let mut stage1_c = "";
    match stage1_c_result {
        Ok(text) => {
            stage1_c = text;
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "selfhost.stage1_build";
            return 1;
        },
    }

    let stage2_path = join_path("build", "main");
    let stage2_result = run_stage2(stage2_path, proof_dir);
    match stage2_result {
        Ok(status) => {
            if status.exit_code != 0 {
                emit_process_output(status);
                failed_phase = "selfhost.stage2_run";
                return status.exit_code;
            }
            if not stage1_ok_output(status.stdout) or status.stderr != "" {
                emit_process_output(status);
                eprint_line("selfhost proof failed: stage2 smoke output changed");
                failed_phase = "selfhost.stage2_run";
                return 1;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "selfhost.stage2_run";
            return 1;
        },
    }

    let stage2_c_result = read_file(c_path);
    match stage2_c_result {
        Ok(stage2_c) => {
            if not structural_c_equal(stage1_c, stage2_c) {
                eprint_line("selfhost proof failed: normalized structural C changed between stage1 and stage2");
                failed_phase = "selfhost.structural_c_compare";
                return 1;
            }
        },
        Err(err) => {
            eprint_line(io_err_text(err));
            failed_phase = "selfhost.structural_c_compare";
            return 1;
        },
    }

    return 0;
}

pub fn run_selfhost_proof(driver_path: str) -> i32
audit {
    intent("Run the stage1-owned copied-selfhost proof gate");
    mutates();
    effects(print, io);
}
{
    let mut failed_phase = "";
    let result = run_selfhost_proof_inner(driver_path, mutref failed_phase);
    if not write_proof_summary("prove-selfhost", result == 0, failed_phase) {
        return 1;
    }
    if result == 0 {
        print_line("selfhost proof ok");
    }
    return result;
}

pub fn run_all_proofs(driver_path: str) -> i32
audit {
    intent("Run the stage1-owned transition proof and corpus gates");
    mutates();
    effects(print, io);
}
{
    let mut failed_phase = "";
    let selfhost_result = run_selfhost_proof_inner(driver_path, mutref failed_phase);
    if selfhost_result != 0 {
        write_proof_summary("prove", false, failed_phase);
        return selfhost_result;
    }
    print_line("selfhost proof ok");
    let corpus_result = run_example_corpus_inner(driver_path, mutref failed_phase);
    if corpus_result != 0 {
        write_proof_summary("prove", false, failed_phase);
        return corpus_result;
    }
    print_line("example corpus ok");
    if not run_tooling_confidence_gate(driver_path, mutref failed_phase) {
        write_proof_summary("prove", false, failed_phase);
        return 1;
    }
    if not write_proof_summary("prove", true, "") {
        return 1;
    }
    print_line("nauqtype proof ok");
    return 0;
}
