pub enum body_binding_kind {
    bind_param,
    bind_let,
    bind_pattern,
}

// M58.1 initializer scope: `at` is the declaration position (identity, spans
// and evidence); `visible_from` is the first source position at which a
// reference sees the binding. Every lookup family selects candidates with
// `visible_from <= reference.at`. The default `at + 1` keeps the strict
// `at < reference.at` rule for forms whose visibility did not change
// (parameters, pattern, `for` and let-else bindings); `let`-family locals
// become visible at the end of their statement (the `;`).
pub fn default_visible_from(at: i32) -> i32
audit {
    intent("Give a binding the strict after-its-declaration visibility position");
    mutates();
    effects();
}
{
    return at + 1;
}

pub type body_binding {
    module: str,
    function_name: str,
    scope_id: i32,
    name: str,
    at: i32,
    kind: body_binding_kind,
    visible_from: i32,
}

pub fn make_body_binding(module: str, function_name: str, scope_id: i32, name: str, at: i32, kind: body_binding_kind) -> body_binding
audit {
    intent("Build a flat local-binding record for selfhost resolver work");
    mutates();
    effects();
}
{
    return body_binding {
        module: module,
        function_name: function_name,
        scope_id: scope_id,
        name: name,
        at: at,
        kind: kind,
        visible_from: default_visible_from(at),
    };
}

pub fn body_binding_visible_from(value: body_binding, visible_from: i32) -> body_binding
audit {
    intent("Set the initializer-scope visibility position of a local binding");
    mutates();
    effects();
}
{
    let mut binding = value;
    binding.visible_from = visible_from;
    return binding;
}

