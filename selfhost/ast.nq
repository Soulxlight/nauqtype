use text;

pub enum top_item_kind {
    item_fn,
    item_type,
    item_enum,
    item_variant,
    item_const,
}

pub type top_item {
    module: str,
    name: str,
    kind: top_item_kind,
    is_public: bool,
    is_generated: bool,
    at: i32,
}

pub fn make_top_item(module: str, name: str, kind: top_item_kind, is_public: bool, at: i32) -> top_item
audit {
    intent("Build a flat top-level item summary record");
    mutates();
    effects();
}
{
    return top_item {
        module: module,
        name: name,
        kind: kind,
        is_public: is_public,
        is_generated: false,
        at: at,
    };
}

pub fn generated_nominal_origin(items: ref list<top_item>, name: str) -> str
audit {
    intent("Resolve only an exact registry-authenticated generated nominal declaration, never a prefix or short-name guess");
    mutates();
    effects();
}
{
    if not str_starts_with(name, "__nqg_") { return ""; }
    let mut origin = "";
    for item in items {
        if item.is_generated and item.name == name {
            let mut nominal = false;
            match item.kind { item_type => { nominal = true; }, item_enum => { nominal = true; }, _ => {}, }
            if nominal {
                if origin != "" and origin != item.module { return ""; }
                origin = item.module;
            }
        }
    }
    return origin;
}

