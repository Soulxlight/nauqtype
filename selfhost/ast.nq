}

pub type local_init_fact {
    module: str,
    function_name: str,
    scope_id: i32,
    name: str,
    at: i32,
    expected_type_name: str,
    expected_is_borrow: bool,
    is_mutable: bool,
    expr_start: i32,
    expr_end: i32,
    expr_kind: expr_fact_kind,
    expr_name: str,
    expr_member_name: str,
    propagation_label: str,
    checked_error_name: str,
    visible_from: i32,
}

pub fn make_local_init_fact(module: str, function_name: str, scope_id: i32, name: str, at: i32, expected_type_name: str, expected_is_borrow: bool, is_mutable: bool, expr_start: i32, expr_end: i32, expr_kind: expr_fact_kind, expr_name: str, expr_member_name: str, propagation_label: str) -> local_init_fact
audit {
    intent("Build a flat annotated-local fact record for the next selfhost type-checker slice");
    mutates();
    effects();
}
{
    return local_init_fact {
        module: module,
        function_name: function_name,
        scope_id: scope_id,
        name: name,
        at: at,
        expected_type_name: expected_type_name,
        expected_is_borrow: expected_is_borrow,
        is_mutable: is_mutable,
        expr_start: expr_start,
        expr_end: expr_end,
        expr_kind: expr_kind,
        expr_name: expr_name,
        expr_member_name: expr_member_name,
        propagation_label: propagation_label,
        checked_error_name: "",
        visible_from: default_visible_from(at),
    };
}

pub fn local_init_visible_from(value: local_init_fact, visible_from: i32) -> local_init_fact
audit {
    intent("Set the initializer-scope visibility position of a local initializer fact");
    mutates();
    effects();
}
{
    let mut local = value;
    local.visible_from = visible_from;
    return local;
}

