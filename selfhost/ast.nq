        bound_end_end: -1,
    };
}

pub fn make_field_assign_stmt_fact(module: str, function_name: str, scope_id: i32, at: i32, name: str, field_name: str, expr_start: i32, expr_end: i32, expr_kind: expr_fact_kind, expr_name: str, expr_member_name: str) -> stmt_fact
audit {
    intent("Build a direct owned-local field assignment fact for the checked handoff");
    mutates();
    effects();
}
{
    return stmt_fact {
        module: module,
        function_name: function_name,
        scope_id: scope_id,
        at: at,
        kind: stmt_field_assign,
        name: name,
        field_name: field_name,
        is_mutable: false,
        expr_start: expr_start,
        expr_end: expr_end,
        expr_kind: expr_kind,
        expr_name: expr_name,
        expr_member_name: expr_member_name,
        child_scope_id: -1,
        alt_scope_id: -1,
        for_kind: for_list,
        index_name: "",
        index_at: -1,
        bound_end_start: -1,
        bound_end_end: -1,
    };
}

pub type pattern_binding_fact {
    module: str,
    function_name: str,
    scope_id: i32,
    name: str,
    at: i32,
    type_name: str,
    type_arg1_name: str,
    type_arg2_name: str,
    is_borrow: bool,
    borrow_mutable: bool,
}

pub fn make_pattern_binding_fact(module: str, function_name: str, scope_id: i32, name: str, at: i32, type_name: str, type_arg1_name: str, type_arg2_name: str, is_borrow: bool, borrow_mutable: bool) -> pattern_binding_fact
audit {
    intent("Build a typed pattern-binding fact record for the structured checked handoff");
    mutates();
    effects();
}
{
    return pattern_binding_fact {
        module: module,
        function_name: function_name,
        scope_id: scope_id,
