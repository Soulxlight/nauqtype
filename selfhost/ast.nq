        name: name,
        field_name: "",
        is_mutable: is_mutable,
        expr_start: expr_start,
        expr_end: expr_end,
        expr_kind: expr_kind,
        expr_name: expr_name,
        expr_member_name: expr_member_name,
        child_scope_id: -1,
        alt_scope_id: -1,
        for_kind: for_list,
        index_name: "",
        index_at: -1,
