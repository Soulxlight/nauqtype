# Normalize repository text files to LF across platforms.
* text=auto eol=lf

# Source, docs, fixtures, schemas, and golden outputs are text.
*.c text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.nq text eol=lf
*.py text eol=lf
*.txt text eol=lf

# Keep future binary artifacts out of line-ending normalization.
*.dll binary
*.exe binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.wasm binary
*.zip binary

# Checksum-bound historical source bytes must not be normalized or reformatted.
# Active selfhost sources retain the normal text and whitespace rules above.
bootstrap/seed/source-snapshot/** -text -whitespace
bootstrap/seed/generator-flags.txt -text
