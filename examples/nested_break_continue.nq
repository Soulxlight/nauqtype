fn main() -> i32 {
    let mut index = 0;
    let mut total = 0;
    while index < 8 {
        index = index + 1;
        if index < 7 {
            if index == 2 {
                continue;
            }
            if index == 5 {
                break;
            }
            total = total + index;
        }
    }
    return total + 34;
}
