type Pair {
    left: i32,
    right: i32,
    total: i32,
}

fn make_pair(left: i32, right: i32) -> Pair {
    return Pair { left: left, right: right, total: left + right };
}

fn add_bonus(pair: Pair, bonus: i32) -> Pair {
    let next_total = pair.total + bonus;
    return Pair { from pair, total: next_total };
}

fn main() -> i32 {
    let base = make_pair(10, 20);
    let updated = add_bonus(base, 12);
    return updated.total;
}
