use qualified_data_helper;

fn score(choice: Choice) -> i32 {
    match choice {
        qualified_data_helper::Score(value) => {
            return value;
        },
        qualified_data_helper::Empty => {
            return 0;
        },
    }
}

fn main() -> i32 {
    let box = qualified_data_helper::Box { value: 20 };
    let choice = qualified_data_helper::Score(22);
    return box.value + score(choice);
}
