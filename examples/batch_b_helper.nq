pub fn add_pair(left: i32, right: i32) -> i32
audit {
    intent("Add a pair of values for the Batch B example");
    mutates();
    effects();
}
{
    return left + right;
}

pub fn choose(flag: bool, yes: i32, no: i32) -> i32
audit {
    intent("Choose one value from an explicit boolean condition");
    mutates();
    effects();
}
{
    if flag {
        return yes;
    }
    return no;
}
