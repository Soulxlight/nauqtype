pub fn add(left: i32, right: i32) -> i32
audit {
    intent("Add two values for the qualified-call chain example");
    mutates();
    effects();
}
{
    return left + right;
}

pub fn double(value: i32) -> i32
audit {
    intent("Double a value for the qualified-call chain example");
    mutates();
    effects();
}
{
    return value + value;
}
