fn main() -> i32
audit {
    intent("Exercise list-only for iteration with nested continue and break control flow");
    mutates(total);
    effects();
}
{
    let numbers: list<i32> = [5, 7, 11, 19];
    let mut total: i32 = 0;
    for value in numbers {
        if value == 7 {
            continue;
        }
        total = total + value;
        if total > 20 {
            break;
        }
    }
    return total;
}
