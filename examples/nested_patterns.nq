fn main() -> i32
audit {
    intent("Classify a nested optional value with an explicit literal case and fallback.");
    mutates();
    effects();
}
{
    let value: option<option<i32>> = Some(Some(42));
    match value {
        Some(Some(42)) => {
            return 42;
        },
        _ => {
            return 0;
        },
    }
}
