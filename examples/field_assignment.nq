type Score {
    current: i32,
    bonus: i32,
}

fn main() -> i32
audit {
    intent("Update one owned mutable record field without widening mutation authority.");
    mutates();
    effects();
}
{
    let mut score = Score {
        current: 40,
        bonus: 2,
    };
    score.current = score.current + score.bonus;
    return score.current;
}
