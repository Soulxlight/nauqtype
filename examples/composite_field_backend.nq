type Marker {
    code: i32,
}

type Bundle {
    values: list<Marker>,
    maybe: option<bool>,
    outcome: result<Marker, io_err>,
}

fn values_len(values: ref list<Marker>) -> i32 {
    return list_len(values);
}

fn main() -> i32 {
    let values: list<Marker> = [Marker { code: 40 }, Marker { code: 2 }];
    let bundle = Bundle {
        values: values,
        maybe: Some(true),
        outcome: Ok(Marker { code: 9 }),
    };
    return values_len(ref bundle.values);
}
